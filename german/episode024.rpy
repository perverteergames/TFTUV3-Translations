    centered "{=chapter_heading}EPISODE 24{/=chapter_heading}"

# game/episode024.rpy:47
translate german episode024_4c6cc17f:

    # ag "Good afternoon, Velnia."
    ag "Guten Abend, Velnia."

# game/episode024.rpy:48
translate german episode024_f785cd82:

    # ag "Are these quarters luxurious enough for you?"
    ag "Sind diese Quartiere luxuriös genug für dich?"

# game/episode024.rpy:50
translate german episode024_1c0234c6:

    # vel "Fuck you, Agust."
    vel "Fick dich, Agust."

# game/episode024.rpy:53
translate german episode024_079df4ea:

    # ag "Not at all."
    ag "Überhaupt nicht."

# game/episode024.rpy:54
translate german episode024_3fec40c6:

    # ag "You see, Velnia, you are the only member of the Council still alive, apart from me of course."
    ag "Du siehst, Velnia, du bist das einzige noch lebende Mitglied des Rates, außer mir natürlich."

# game/episode024.rpy:55
translate german episode024_9d6890c9:

    # ag "As you know, the others met their demise in that very tragic accident."
    ag "Wie du weißt, kamen die anderen bei diesem tragischen Unfall ums Leben."

# game/episode024.rpy:57
translate german episode024_ba6ec454:

    # vel "You fucking murdered them, Agust."
    vel "Du hast sie alle umgebracht, Agust."

# game/episode024.rpy:59
translate german episode024_cb14ced1:

    # ag "That’s not the official story, I can assure you."
    ag "Das ist nicht die offizielle Version, das kann ich dir versichern."

# game/episode024.rpy:61
translate german episode024_02f7cbc7:

    # ag "I’m sure the investigators would be perplexed by the eviscerated hearts inside those bodies."
    ag "Ich bin mir sicher, die Ermittler wären verblüfft über die herausgerissenen Herzen in diesen Körpern."

# game/episode024.rpy:63
translate german episode024_40b1dbe6:

    # ag "Aren’t you glad we were apparently made of much stronger stuff and managed to survive?"
    ag "Bist du nicht froh, dass wir offenbar aus viel robusterem Holz geschnitzt waren und überlebt haben?"

# game/episode024.rpy:65
translate german episode024_3ab0b0b0:

    # vel "You disgust me."
    vel "Du ekelst mich an."

# game/episode024.rpy:67
translate german episode024_68a8fd1f:

    # ag "I’m sure you feel that way."
    ag "Ich bin mir sicher, dass du das auch so empfindest."

# game/episode024.rpy:69
translate german episode024_7ec801e2:

    # ag "They crave a leader in these dark times."
    ag "Sie sehnen sich in diesen dunklen Zeiten nach einem Anführer."

# game/episode024.rpy:70
translate german episode024_33db95b9:

    # ag "A leader who will guide them on the path to achieve the supremacy the Sovereignty so rightly deserves."
    ag "Ein Anführer, der sie auf dem Weg zur Erlangung der Vorherrschaft leitet, die die Souveränität so rechtmäßig verdient."

# game/episode024.rpy:73
translate german episode024_0c121629:

    # vel "Spare me the sanctimonious bullshit and just kill me."
    vel "Erspar mir den heuchlerischen Scheiß und bring mich einfach um."

# game/episode024.rpy:75
translate german episode024_963f63ed:

    # ag "I’m afraid I can’t do that."
    ag "Das kann ich leider nicht tun."

# game/episode024.rpy:76
translate german episode024_e17b1d2a:

    # ag "Yet..."
    ag "Jetzt..."

# game/episode024.rpy:77
translate german episode024_f2bc97b6:

    # ag "You see, there’s some information I need from you."
    ag "Siehst du, ich brauche ein paar Informationen von dir."

# game/episode024.rpy:78
translate german episode024_bc4e544e:

    # ag "Documents you’ve kept."
    ag "Dokumente, die du aufbewahrt hast."

# game/episode024.rpy:81
translate german episode024_c749e135:

    # vel "I don’t know what you’re talking about."
    vel "Ich weiß nicht, wovon du redest."

# game/episode024.rpy:82
translate german episode024_7ec08692:

    # ag "Sure you do."
    ag "Sicher tust du."

# game/episode024.rpy:83
translate german episode024_5aeb54ca:

    # ag "But maybe I can refresh your memory."
    ag "Vielleicht kann ich dein Gedächtnis auffrischen."

# game/episode024.rpy:85
translate german episode024_2b870632:

    # "*SNAP*"
    "*SCHNAPP*"

# game/episode024.rpy:86
translate german episode024_c1066646:

    # vel "Aaaah! Aaah! You motherfucker!"
    vel "Aaaah! Aaah! Du Bastard!"

# game/episode024.rpy:87
translate german episode024_d5926495:

    # ag "I’ve just shattered your left kneecap, so I would be careful not to put any weight on that leg if they ever take you down from this wall."
    ag "Ich habe dir gerade die linke Kniescheibe zertrümmert, also pass auf, dass du dein Bein nicht belastest, falls sie dich jemals von dieser Wand runterholen."

# game/episode024.rpy:89
translate german episode024_e452b1b2:

    # vel "Do you think torturing me is going to make me spill any secrets?"
    vel "Glaubst du etwa, dass ich irgendwelche Geheimnisse verraten werde, wenn du mich folterst?"

# game/episode024.rpy:91
translate german episode024_c21f539c:

    # ag "Yes, as a matter of fact."
    ag "Ja, tatsächlich."

# game/episode024.rpy:93
translate german episode024_db476e3d:

    # ag "I’m going to keep you alive until you beg me to share every secret you know."
    ag "Ich werde dich am Leben erhalten, bis du mich anflehen wirst, dir jedes Geheimnis zu verraten, das du kennst."

# game/episode024.rpy:95
translate german episode024_4d3a8584:

    # ag "So you will tell me where you keep your records, or suffer the consequences."
    ag "Also sag mir, wo du deine Aufzeichnungen aufbewahrst, oder du wirst die Konsequenzen tragen."

# game/episode024.rpy:97
translate german episode024_987a9bfd:

    # vel "Do your worst."
    vel "Mach dein Schlimmstes."

# game/episode024.rpy:99
translate german episode024_35ea8b90:

    # ag "Oh, I certainly will."
    ag "Oh ja, das werde ich ganz bestimmt."

# game/episode024.rpy:209
translate german ep024_tubloshi_2bc2599c:

    # "Our delegation was led to the same hall we were in when we visited the Tubloshi earlier."
    "Unsere Delegation wurde in denselben Saal geführt, in dem wir uns bereits bei unserem vorherigen Besuch bei den Tubloshi aufgehalten hatten."

# game/episode024.rpy:214
translate german ep024_tubloshi_62375ff4:

    # "The captain of the ship, Kyl Zaghav, sat himself down and motioned for us to sit as well."
    "Der Kapitän des Schiffes, Kyl Zaghav, setzte sich und bedeutete uns, uns ebenfalls zu setzen."

# game/episode024.rpy:215
translate german ep024_tubloshi_37b60198:

    # "As soon as we faced him, the captain began to speak, with Hannah translating."
    "Sobald wir vor ihm standen, begann der Kapitän zu sprechen, wobei Hannah übersetzte."

# game/episode024.rpy:218
translate german ep024_tubloshi_94625ce8:

    # ha "[p_name] of the Humans, you honor us with your presence."
    ha "[p_name] der Menschen, beehre uns mit deiner Anwesenheit."

# game/episode024.rpy:219
translate german ep024_tubloshi_5bc7bd2c:

    # ha "We are of course delighted if your visit is a mere social call, but we would treasure it even more if there was a higher purpose behind it."
    ha "Wir freuen uns natürlich auch über einen rein privaten Besuch, aber wir würden ihn noch mehr schätzen, wenn er einem höheren Zweck dient."

# game/episode024.rpy:220
translate german ep024_tubloshi_41a6c793:

    # c "There certainly is."
    c "Das gibt es ganz bestimmt."

# game/episode024.rpy:222
translate german ep024_tubloshi_928f5818:

    # ha "[p_name] of the Humans, why have you come?"
    ha "[p_name] der Menschen, warum bist du gekommen?"

# game/episode024.rpy:224
translate german ep024_tubloshi_35cb38d9:

    # c "There certainly is a higher purpose."
    c "Das hat ganz sicher einen höheren Sinn."

# game/episode024.rpy:226
translate german ep024_tubloshi_b5cec404:

    # c "As you might know, I originally hail from the Sovereignty."
    c "Wie du vielleicht weißt, stamme ich ursprünglich aus der Souveränität."

# game/episode024.rpy:227
translate german ep024_tubloshi_60b89451:

    # c "I recognize the Sovereignty for what it is, a corrupt dictatorship, that’s quickly sliding into even darker moral territory."
    c "Ich erkenne die Souveränität als das, was sie ist: eine korrupte Diktatur, die schnell in noch düsterere moralische Gefilde abgleitet."

# game/episode024.rpy:228
translate german ep024_tubloshi_c23eef8b:

    # c "My father has recently become Regent of the Sovereignty, a position of power that soon will very likely be absolute."
    c "Mein Vater ist vor kurzem zum Regenten der Souveränität ernannt worden, eine Machtposition, die sehr wahrscheinlich bald absolut sein wird."

# game/episode024.rpy:229
translate german ep024_tubloshi_fa6f50ea:

    # c "I have reason to believe that the Sovereignty is planning on aggressively expanding its borders, subjugating any species that it encounters."
    c "Ich habe Grund zu der Annahme, dass die Souveränität plant, ihre Grenzen aggressiv auszudehnen und jede Spezies zu unterwerfen, die ihr begegnet."

# game/episode024.rpy:231
translate german ep024_tubloshi_b8b827f8:

    # c "The Sovereignty under his leadership will stop at nothing to usurp any civilized system currently in existence."
    c "Die Souveränität unter seiner Führung wird vor nichts zurückschrecken, um jedes derzeit existierende zivilisierte System zu stürzen."

# game/episode024.rpy:233
translate german ep024_tubloshi_3a4d01e4:

    # c "I aim to lead that alliance and put a stop to my father and the Sovereignty once and for all."
    c "Ich habe mir vorgenommen, dieses Bündnis anzuführen und meinem Vater und der Souveränität ein für alle Mal ein Ende zu setzen."

# game/episode024.rpy:235
translate german ep024_tubloshi_963e22b3:

    # ha "A noble cause indeed."
    ha "Das ist in der Tat ein edles Anliegen."

# game/episode024.rpy:236
translate german ep024_tubloshi_41bc59b9:

    # ha "The news you bring is troublesome, but our own intelligence corroborates your claims."
    ha "Die Neuigkeiten, die du bringst, sind beunruhigend, aber unsere eigenen Geheimdienste bestätigen deine Behauptungen."

# game/episode024.rpy:237
translate german ep024_tubloshi_b94b9b3f:

    # ha "We have received reports of violent border skirmishes and incursions into territory unclaimed by the Sovereignty."
    ha "Uns liegen Berichte über gewaltsame Grenzscharmützel und das Eindringen in Gebiete vor, die nicht von der Souveränität beansprucht werden."

# game/episode024.rpy:238
translate german ep024_tubloshi_bd809c7b:

    # ha "Already, the Sovereignty has found allies in its conquest."
    ha "Die Souveränität hat bereits Verbündete bei ihren Eroberungen gefunden."

# game/episode024.rpy:239
translate german ep024_tubloshi_8e1f8d95:

    # ha "We know of several weaker systems that have rallied behind the Sovereignty’s cause."
    ha "Wir kennen mehrere schwächere Systeme, die sich hinter die Sache der Souveränität gestellt haben."

# game/episode024.rpy:240
translate german ep024_tubloshi_a89172f7:

    # ha "What they hope to gain is unclear, as the Sovereignty will either enslave or slaughter them in the end, as is their wont."
    ha "Was sie sich davon erhoffen, ist unklar, da die Souveränität sie am Ende entweder versklaven oder abschlachten wird, wie es ihre Art ist."

# game/episode024.rpy:241
translate german ep024_tubloshi_d512b57a:

    # ha "You speak of your father with such vehemence."
    ha "Du sprichst mit solcher Vehemenz von deinem Vater."

# game/episode024.rpy:242
translate german ep024_tubloshi_81b47b30:

    # ha "Tell me, is there a personal reason for your willingness to take on an empire as big as the Sovereignty?"
    ha "Sag mal, gibt es einen persönlichen Grund für deine Bereitschaft, es mit einem so großen Imperium wie der Souveränität aufzunehmen?"

# game/episode024.rpy:244
translate german ep024_tubloshi_29b2589a:

    # c "Yes, there is."
    c "Ja, das gibt es."

# game/episode024.rpy:245
translate german ep024_tubloshi_8574ccc4:

    # c "My father has hurt me and my family on several occasions."
    c "Mein Vater hat mich und meine Familie schon mehrmals verletzt."

# game/episode024.rpy:247
translate german ep024_tubloshi_fcf1fa80:

    # c "For that alone, I want him dead."
    c "Allein deswegen will ich ihn tot sehen."

# game/episode024.rpy:250
translate german ep024_tubloshi_15b2c0ac:

    # ha "Am I correct in understanding that you’re asking us to join the alliance against the Sovereignty?"
    ha "Verstehe ich das richtig, dass ihr uns auffordert, uns dem Bündnis gegen die Souveränität anzuschließen?"

# game/episode024.rpy:252
translate german ep024_tubloshi_25ad6410:

    # c "Yes, you are."
    c "Ja, bist du."

# game/episode024.rpy:254
translate german ep024_tubloshi_336ef893:

    # c "A race of mighty warriors like the Tubloshi will surely be an incentive for others to join forces."
    c "Ein Volk so mächtiger Krieger wie die Tubloshi wird sicherlich ein Anreiz für andere sein, sich ihnen anzuschließen."

# game/episode024.rpy:256
translate german ep024_tubloshi_1939e747:

    # c "Your heroism is unparalleled and an inspiration for us all."
    c "Dein Heldenmut ist beispiellos und eine Inspiration für uns alle."

# game/episode024.rpy:257
translate german ep024_tubloshi_670dc06d:

    # c "I’m asking you humbly to become our first partners in this endeavor."
    c "Ich bitte dich demütigst, unser erster Partner bei diesem Vorhaben zu werden."

# game/episode024.rpy:262
translate german ep024_tubloshi_336ef893_1:

    # c "A race of mighty warriors like the Tubloshi will surely be an incentive for others to join forces."
    c "Ein Volk so mächtiger Krieger wie die Tubloshi wird sicherlich ein Anreiz für andere sein, sich ihnen anzuschließen."

# game/episode024.rpy:264
translate german ep024_tubloshi_1939e747_1:

    # c "Your heroism is unparalleled and an inspiration for us all."
    c "Dein Heldenmut ist beispiellos und eine Inspiration für uns alle."

# game/episode024.rpy:265
translate german ep024_tubloshi_670dc06d_1:

    # c "I’m asking you humbly to become our first partners in this endeavor."
    c "Ich bitte dich demütigst, unser erster Partner bei diesem Vorhaben zu werden."

# game/episode024.rpy:269
translate german ep024_tubloshi_77e9a3a2:

    # c "The Sovereignty is a strong opponent, but not undefeatable."
    c "The Sovereignty ist ein starker Gegner, aber nicht unbesiegbar."

# game/episode024.rpy:272
translate german ep024_tubloshi_36d34802:

    # c "Together we will be able to put a stop to the Sovereignty and make the galaxy a better place for us all."
    c "Gemeinsam werden wir der Souveränität ein Ende setzen und die Galaxie zu einem besseren Ort für uns alle machen können."

# game/episode024.rpy:275
translate german ep024_tubloshi_23840c62:

    # ha "Thank you for your kind words, [p_name] of the Humans."
    ha "Danke für deine freundlichen Worte, [p_name] der Menschen."

# game/episode024.rpy:276
translate german ep024_tubloshi_bea80d6a:

    # ha "We will now deliberate and let you know our verdict as soon as possible."
    ha "Wir werden uns nun beraten und dir unser Urteil so schnell wie möglich mitteilen."

# game/episode024.rpy:277
translate german ep024_tubloshi_9be85a46:

    # c "Thank you, Honorable Captain Kyl Zaghav."
    c "Danke, ehrenwerter Kapitän Kyl Zaghav."

# game/episode024.rpy:280
translate german ep024_tubloshi_ce434b12:

    # ha "We will take your request advisement and let you know our verdict as soon as possible, [p_name] of the Humans."
    ha "Wir werden deine Anfrage prüfen und dir unser Urteil so schnell wie möglich mitteilen, [p_name] der Menschen."

# game/episode024.rpy:281
translate german ep024_tubloshi_4c0ec1ad:

    # c "Thank you, Captain Kyl Zaghav."
    c "Danke, Captain Kyl Zaghav."

# game/episode024.rpy:282
translate german ep024_tubloshi_3c6cfad8:

    # "We took our leave of the Tubloshi and left the dining hall with Hannah."
    "Wir verabschiedeten uns von den Tubloshi und verließen mit Hannah den Speisesaal."

# game/episode024.rpy:454
translate german ep024_hannah_649b5e7a:

    # "The translator wasn’t hard to find, as she came walking toward me in the hallway."
    "Die Übersetzerin war nicht schwer zu finden, denn sie kam mir im Flur entgegen."

# game/episode024.rpy:455
translate german ep024_hannah_93f03eea:

    # c "Hannah, am I glad to see you."
    c "Hannah, bin ich froh, dich zu sehen!"

# game/episode024.rpy:460
translate german ep024_hannah_6297a344:

    # ha "You too, [p_name]."
    ha "Du auch, [p_name]."

# game/episode024.rpy:461
translate german ep024_hannah_9a5e2ecb:

    # ha "I was dying for the greeting ceremony to be over."
    ha "Ich wollte unbedingt, dass die Begrüßungszeremonie endlich vorbei ist."

# game/episode024.rpy:462
translate german ep024_hannah_241c7773:

    # ha "Could we have a word in private?"
    ha "Könnten wir kurz unter vier Augen sprechen?"

# game/episode024.rpy:463
translate german ep024_hannah_4e8c7062:

    # c "Of course."
    c "Natürlich."

# game/episode024.rpy:465
translate german ep024_hannah_4a6a4976:

    # "I followed Hannah through the bowels of the Tubloshi warship until we reached her private quarters."
    "Ich folgte Hannah durch die Eingeweide des Kriegsschiffs Tubloshi, bis wir ihre Privatgemächer erreichten."

# game/episode024.rpy:466
translate german ep024_hannah_1a74d9bb:

    # c "Still holed up in here, I see."
    c "Immer noch hier drin, wie ich sehe."

# game/episode024.rpy:469
translate german ep024_hannah_45aa049d:

    # "As I closed the door, Hannah turned around and faced me."
    "Als ich die Tür schloss, drehte sich Hannah um und sah mich an."

# game/episode024.rpy:470
translate german ep024_hannah_2f552008:

    # c "So...{w} You’re pregnant."
    c "Also...{w} Du bist schwanger."

# game/episode024.rpy:472
translate german ep024_hannah_b73ca50f:

    # ha "I am."
    ha "Das bin ich."

# game/episode024.rpy:473
translate german ep024_hannah_6ecef24a:

    # ha "Before you ask anything else, it’s yours."
    ha "Bevor du irgendetwas anderes fragst, es gehört dir."

# game/episode024.rpy:474
translate german ep024_hannah_bd2dbd8b:

    # c "It’s mine?!"
    c "Das ist meins?!"

# game/episode024.rpy:475
translate german ep024_hannah_b4d20e22:

    # c "But how?"
    c "Aber wie?"

# game/episode024.rpy:477
translate german ep024_hannah_6522642f:

    # ha "Well, cumming inside me during our first encounter might have contributed to the fact."
    ha "Nun ja, dass er bei unserer ersten Begegnung in mir gekommen ist, könnte dazu beigetragen haben."

# game/episode024.rpy:478
translate german ep024_hannah_f7cafb46:

    # c "But it’s been over nine months since I last saw you."
    c "Aber es ist schon über neun Monate her, seit ich dich das letzte Mal gesehen habe."

# game/episode024.rpy:479
translate german ep024_hannah_c6417b60:

    # c "Looking at how you’ve grown, you can’t be much further than your second trimester."
    c "Wenn ich sehe, wie du gewachsen bist, kannst du nicht viel weiter als im zweiten Trimester sein."

# game/episode024.rpy:481
translate german ep024_hannah_5e5aa4be:

    # ha "You’re right."
    ha "Du hast recht."

# game/episode024.rpy:483
translate german ep024_hannah_f0015089:

    # ha "But the baby is yours."
    ha "Aber das Baby ist deins."

# game/episode024.rpy:484
translate german ep024_hannah_7029aaf9:

    # ha "Allow me to explain."
    ha "Lass mich das erklären."

# game/episode024.rpy:486
translate german ep024_hannah_9cfe9237:

    # c "Before you do that, I just want to say that I’m over the moon to hear this news."
    c "Bevor du das tust, wollte ich nur sagen, dass ich überglücklich bin, diese Nachricht zu hören."

# game/episode024.rpy:488
translate german ep024_hannah_db8b2056:

    # "By the way her posture changed, I could tell that a load had been lifted from Hannah’s shoulders."
    "An ihrer veränderten Körperhaltung konnte ich erkennen, dass Hannah eine Last von den Schultern genommen worden war."

# game/episode024.rpy:490
translate german ep024_hannah_01fb9ee3:

    # "I took her into my arms and kissed her."
    "Ich nahm sie in meine Arme und küsste sie."

# game/episode024.rpy:492
translate german ep024_hannah_68bdda20:

    # ha "I found out I was pregnant a few weeks after you left."
    ha "Ich habe ein paar Wochen nach deiner Abreise herausgefunden, dass ich schwanger bin."

# game/episode024.rpy:493
translate german ep024_hannah_106d4499:

    # ha "Kyl Zaghav allowed me to contact you, which is a rare privilege."
    ha "Kyl Zaghav hat mir erlaubt, dich zu kontaktieren, was ein seltenes Privileg ist."

# game/episode024.rpy:494
translate german ep024_hannah_52c7b361:

    # ha "I tried for months to reach you, but my messages never arrived."
    ha "Ich habe monatelang versucht, dich zu erreichen, aber meine Nachrichten sind nie angekommen."

# game/episode024.rpy:495
translate german ep024_hannah_a090bea3:

    # c "I think I know why, we were held hostage in a secret facility for months after we left you."
    c "Ich glaube, ich weiß warum: Wir wurden monatelang in einer geheimen Einrichtung als Geiseln gehalten, nachdem wir dich verlassen hatten."

# game/episode024.rpy:497
translate german ep024_hannah_b3cc9a09:

    # ha "That must be it."
    ha "Das muss es sein."

# game/episode024.rpy:498
translate german ep024_hannah_c4b028ff:

    # ha "I kept sending messages until the Tubloshi put me on ice."
    ha "Ich habe so lange Nachrichten geschickt, bis Tubloshi mich auf Eis gelegt hat."

# game/episode024.rpy:499
translate german ep024_hannah_7f6b1596:

    # c "Put you on ice?"
    c "Dich auf Eis gelegt?"

# game/episode024.rpy:501
translate german ep024_hannah_8b8a2425:

    # ha "We’ve just returned from a long campaign deep inside Gapilr territory."
    ha "Wir sind gerade von einer langen Kampagne tief im Gebiet von Gapilr zurückgekehrt."

# game/episode024.rpy:502
translate german ep024_hannah_c34e4ec8:

    # ha "As you might know, the Gapilr are infamous for their xenophobia."
    ha "Wie du vielleicht weißt, sind die Gapilr berüchtigt für ihre Fremdenfeindlichkeit."

# game/episode024.rpy:504
translate german ep024_hannah_65decd24:

    # ha "So for my own and our little one’s safety, I agreed for my body to be frozen."
    ha "Also, um meine eigene Sicherheit und die unseres Kleinen zu gewährleisten, habe ich zugestimmt, dass mein Körper eingefroren wird."

# game/episode024.rpy:517
translate german ep024_hannah_f8df78b0:

    # ha "It’s in my contract with the Tubloshi, as a mandatory security action, actually."
    ha "Das steht so in meinem Vertrag mit den Tubloshi, als obligatorische Sicherheitsmaßnahme."

# game/episode024.rpy:518
translate german ep024_hannah_da7c2369:

    # ha "I’ve spent the past months in stasis, while the Tubloshi carried out their search-and-rescue mission."
    ha "Ich habe die letzten Monate im Stasiszustand verbracht, während die Tubloshi ihre Such- und Rettungsmission durchgeführt haben."

# game/episode024.rpy:519
translate german ep024_hannah_e2480862:

    # c "So freezing you actually put the pregnancy on pause?"
    c "Hat das Einfrieren die Schwangerschaft also tatsächlich pausiert?"

# game/episode024.rpy:521
translate german ep024_hannah_86fb188b:

    # ha "Yes, everything."
    ha "Ja, alles."

# game/episode024.rpy:522
translate german ep024_hannah_ce50a678:

    # ha "It’s perfectly safe, the Tubloshi do it all the time."
    ha "Das ist völlig ungefährlich, die Tubloshi machen das ständig."

# game/episode024.rpy:523
translate german ep024_hannah_256e0c02:

    # ha "It’s supposedly more efficient."
    ha "Es soll angeblich effizienter sein."

# game/episode024.rpy:524
translate german ep024_hannah_4ed3d0ba:

    # c "I guess it is."
    c "Ich denke schon."

# game/episode024.rpy:555
translate german ep024_hannah_0aa27963:

    # c "You look so beautiful though."
    c "Du siehst aber wunderschön aus."

# game/episode024.rpy:557
translate german ep024_hannah_037dc296:

    # ha "Thank you."
    ha "Danke."

# game/episode024.rpy:558
translate german ep024_hannah_5828f39e:

    # ha "I’m so happy to have found you again."
    ha "Ich bin so froh, dich wiedergefunden zu haben."

# game/episode024.rpy:591
translate german ep024_hannah_e73494e2:

    # "As soon as we crossed the threshold, I spun Hannah around and kissed her."
    "Sobald wir die Schwelle überschritten hatten, drehte ich Hannah herum und küsste sie."

# game/episode024.rpy:592
translate german ep024_hannah_d7aa6482:

    # c "I wanted to do that the moment I saw you."
    c "Das wollte ich schon in dem Moment machen, als ich dich gesehen habe."

# game/episode024.rpy:594
translate german ep024_hannah_c5a32e91:

    # ha "It’s been so long."
    ha "Das ist ja ewig her!"

# game/episode024.rpy:596
translate german ep024_hannah_27851ff7:

    # ha "How have you been?"
    ha "Wie geht\'s dir?"

# game/episode024.rpy:597
translate german ep024_hannah_ae9e479d:

    # c "So much has happened since I last saw you."
    c "Seit ich dich das letzte Mal gesehen habe, ist so viel passiert."

# game/episode024.rpy:598
translate german ep024_hannah_95708ff1:

    # c "I want to tell you all about it."
    c "Ich will dir alles erzählen."

# game/episode024.rpy:599
translate german ep024_hannah_1fe2e969:

    # ha "I’d like to know everything about it."
    ha "Ich möchte alles darüber wissen."

# game/episode024.rpy:600
translate german ep024_hannah_6a2d884e:

    # ha "And we’re not in a hurry, because the Tubloshi have just returned from a long campaign deep inside Gapilr territory."
    ha "Und wir haben es nicht eilig, denn die Tubloshi sind gerade von einem langen Feldzug tief im Gebiet von Gapilr zurückgekehrt."

# game/episode024.rpy:601
translate german ep024_hannah_8fad738a:

    # ha "They need to do some necessary repairs and recuperate."
    ha "Die müssen dringend Reparaturen durchführen und sich erholen."

# game/episode024.rpy:603
translate german ep024_hannah_ca39f3e6:

    # ha "We were there for so long, I thought I’d never see another human being again."
    ha "Wir waren so lange da, ich dachte schon, ich würde nie wieder einen anderen Menschen sehen."

# game/episode024.rpy:605
translate german ep024_hannah_1dbe00a5:

    # ha "And then your message came through."
    ha "Und dann kam deine Nachricht an."

# game/episode024.rpy:606
translate german ep024_hannah_fdf07b2c:

    # ha "I’m so glad I found you again."
    ha "Ich bin so froh, dass ich du wiedergefunden habe."

# game/episode024.rpy:607
translate german ep024_hannah_e0224be1:

    # c "Me too."
    c "Ich auch."

# game/episode024.rpy:608
translate german ep024_hannah_4d12095d:

    # c "I want us to talk much more, but there’s also something else I’d like to do."
    c "Ich würde mich freuen, wenn wir noch viel mehr miteinander reden würden, aber da ist auch noch etwas anderes, was ich gerne machen würde."

# game/episode024.rpy:609
translate german ep024_hannah_9b2f95fe:

    # ha "Oh..."
    ha "Oh..."

# game/episode024.rpy:613
translate german ep024_hannah_7f4b7dea:

    # c "I don’t want to leave you and the baby with the Tubloshi again."
    c "Ich will dich und das Baby nicht schon wieder bei den Tubloshi lassen."

# game/episode024.rpy:616
translate german ep024_hannah_4f46ca17:

    # c "I don’t want to leave you with the Tubloshi again."
    c "Ich will du nicht schon wieder mit den Tubloshi allein lassen."

# game/episode024.rpy:618
translate german ep024_hannah_f240407e:

    # ha "You might not have to."
    ha "Das musst du vielleicht gar nicht."

# game/episode024.rpy:619
translate german ep024_hannah_54f26d64:

    # ha "The Sovereignty has been a thorn in the side for many people, the Tubloshi included."
    ha "Die Souveränität war für viele ein Dorn im Auge, auch für die Tubloshi."

# game/episode024.rpy:620
translate german ep024_hannah_541f423e:

    # ha "And Kyl Zaghav hasn’t forgotten what you did, returning Kyl Tavort’s body."
    ha "Und Kyl Zaghav hat nicht vergessen, was du getan hast, nämlich Kyl Tavorts Leiche zurückzubringen."

# game/episode024.rpy:621
translate german ep024_hannah_bb1fe40e:

    # ha "So I think your proposal will go over well with the rest of the warriors."
    ha "Ich denke, dein Vorschlag wird bei den anderen Kriegern gut ankommen."

# game/episode024.rpy:626
translate german ep024_hannah_435ba5c2:

    # ha "I’m not sure what your plans are, but I guess we’ll be forming a fleet of some sort?"
    ha "Ich bin mir nicht sicher, was eure Pläne sind, aber ich schätze, wir werden eine Art Flotte bilden?"

# game/episode024.rpy:627
translate german ep024_hannah_0aeb7fea:

    # c "Yes, I think so, once the rest of the Tubloshi warships join us."
    c "Ja, ich denke schon, sobald die restlichen Tubloshi-Kriegsschiffe zu uns stoßen."

# game/episode024.rpy:629
translate german ep024_hannah_e0d4e590:

    # ha "I mean, we’ll have to coordinate a lot of things."
    ha "Ich meine, wir müssen eine Menge Dinge koordinieren."

# game/episode024.rpy:630
translate german ep024_hannah_acf0af71:

    # c "Yes, coordination is key with these things."
    c "Ja, bei solchen Dingen ist Koordination das A und O."

# game/episode024.rpy:631
translate german ep024_hannah_3ae20e73:

    # ha "We’ll coordinate the hell out of each other!"
    ha "Wir werden uns bis zum Umfallen abstimmen!"

# game/episode024.rpy:632
translate german ep024_hannah_7727957c:

    # c "I can’t wait."
    c "Ich kann es kaum erwarten."

# game/episode024.rpy:635
translate german ep024_hannah_dad47d1a:

    # "I kissed her again and rested my hand on the pregnant swell of her belly."
    "Ich küsste sie erneut und legte meine Hand auf die gewölbte, schwangere Partie ihres Bauches."

# game/episode024.rpy:638
translate german ep024_hannah_d2c55b63:

    # "I kissed her again and rested my hand on the soft skin of her belly."
    "Ich küsste sie erneut und legte meine Hand auf die weiche Haut ihres Bauches."

# game/episode024.rpy:651
translate german ep024_uailea_87716c3d:

    # "Our arrival on Uailea went about the same way as it did months ago."
    "Unsere Ankunft auf Uailea verlief ungefähr genauso wie vor Monaten."

# game/episode024.rpy:652
translate german ep024_uailea_0125436f:

    # "The Tubloshi fleet hadn’t followed us to the Rhenkoy homeworld, as the presence of a foreign armada might be misinterpreted as a prelude to violence."
    "Die Tubloshi-Flotte war uns nicht bis zur Rhenkoy-Heimatwelt gefolgt, da die Anwesenheit einer fremden Armada als Vorbote von Gewalt missverstanden werden könnte."

# game/episode024.rpy:656
translate german ep024_uailea_13b298c2:

    # "Ziv reached out to the Council of Nkoy to kickstart the Rhenkoy bureaucracy and then the waiting began."
    "Ziv wandte sich an den Rat von Nköy, um die Rhenköy-Bürokratie in Gang zu bringen, und dann begann das Warten."

# game/episode024.rpy:660
translate german ep024_uailea_506af255:

    # "Several construction crews were busy working on buildings and fixing up public spaces."
    "Mehrere Bautrupps waren mit Arbeiten an Gebäuden und der Instandsetzung öffentlicher Plätze beschäftigt."

# game/episode024.rpy:661
translate german ep024_uailea_4d2fc95b:

    # c "Looks like the capital is one big construction pit."
    c "Die Hauptstadt scheint ja eine einzige große Baustelle zu sein."

# game/episode024.rpy:663
translate german ep024_uailea_5316d325:

    # zi "Yes, the Council finally approved a lot of overdue maintenance."
    zi "Ja, der Stadtrat hat endlich viele längst überfällige Instandhaltungsarbeiten genehmigt."

# game/episode024.rpy:664
translate german ep024_uailea_b31c45bb:

    # zi "People have been complaining for years, but the Nkoy finally voted in favor after being deadlocked for so long."
    zi "Die Leute beschweren sich schon seit Jahren, aber die Nkoy hat nach so langer Pattsituation endlich dafür gestimmt."

# game/episode024.rpy:665
translate german ep024_uailea_e2ea2432:

    # c "Nkoy Rhedia broke that deadlock?"
    c "Nkoy Rhedia hat die Pattsituation aufgelöst?"

# game/episode024.rpy:666
translate german ep024_uailea_7cdc14bd:

    # zi "I think so, yes."
    zi "Ich denke schon, ja."

# game/episode024.rpy:667
translate german ep024_uailea_f5c46100:

    # c "I hope they’re not too busy to handle our request for help, in that case."
    c "Ich hoffe, die haben dann nicht zu viel zu tun, um sich um unsere Hilfsanfrage zu kümmern."

# game/episode024.rpy:668
translate german ep024_uailea_bd7a4bb1:

    # zi "I’m sure they’re not too busy for something like that."
    zi "Ich bin mir sicher, dass die für sowas nicht zu beschäftigt sind."

# game/episode024.rpy:671
translate german ep024_uailea_b4d13737:

    # "The Rhenkoy capital didn’t look much different when we went out for a stroll, but the atmosphere had decidedly changed."
    "Die Hauptstadt Rhenköy sah bei unserem Spaziergang nicht viel anders aus, aber die Atmosphäre hatte sich merklich verändert."

# game/episode024.rpy:672
translate german ep024_uailea_31aa43a2:

    # "There was a large police presence throughout the city and several buildings were under permanent guard."
    "In der ganzen Stadt war ein großes Polizeiaufgebot zu sehen, und mehrere Gebäude wurden permanent bewacht."

# game/episode024.rpy:674
translate german ep024_uailea_a847c7d5:

    # "Most Rhenkoy hurried through the streets, as if they wanted to reach their destination with as little exposure to the outside as possible."
    "Die meisten Rhenköy eilten durch die Straßen, als wollten sie ihr Ziel erreichen, ohne dabei so viel Kontakt zur Außenwelt wie möglich zu haben."

# game/episode024.rpy:675
translate german ep024_uailea_18d629d3:

    # c "Is it me, or does everybody seem rather tense?"
    c "Bilde ich mir das nur ein, oder wirken alle ziemlich angespannt?"

# game/episode024.rpy:677
translate german ep024_uailea_95ef5465:

    # zi "Yes, I’ve noticed it too."
    zi "Ja, mir ist das auch aufgefallen."

# game/episode024.rpy:680
translate german ep024_uailea_c2d5fa07:

    # zi "Nkoy Arlya is under heavy guard as well."
    zi "Nkoy Arlya wird ebenfalls stark bewacht."

# game/episode024.rpy:682
translate german ep024_uailea_adbd7b61:

    # c "I thought locking up Nkoy Rhedia would have nipped any resistance in the bud."
    c "Ich dachte, wenn man Nkoy Rhedia einsperrt, hätte das jeglichen Widerstand im Keim erstickt."

# game/episode024.rpy:685
translate german ep024_uailea_4f557c2f:

    # c "So, either the police are doing a very good job preventing any attacks, or the Council is using the supposed threat as a pretext to tighten their grip."
    c "Also, entweder leistet die Polizei hervorragende Arbeit bei der Verhinderung von Angriffen, oder der Stadtrat nutzt die vermeintliche Bedrohung als Vorwand, um seine Macht zu verschärfen."

# game/episode024.rpy:687
translate german ep024_uailea_1fd9c02d:

    # zi "Textbook fear-mongering, I’d say."
    zi "Panikmache wie aus dem Lehrbuch, würde ich sagen."

# game/episode024.rpy:688
translate german ep024_uailea_9f85b645:

    # c "Yeah."
    c "Ja."

# game/episode024.rpy:690
translate german ep024_uailea_58f5b829:

    # zi "I worry about that too."
    zi "Darüber mache ich mir auch Sorgen."

# game/episode024.rpy:694
translate german ep024_uailea_a6c2add9:

    # "I decided on using the apartment as my base of operations and slept there for several nights as the Council supposedly deliberated about our request."
    "Ich beschloss, die Wohnung als meine Operationsbasis zu nutzen und schlief dort mehrere Nächte, während der Rat angeblich über unseren Antrag beriet."

# game/episode024.rpy:701
translate german ep024_uailea_rhedia_eaafebec:

    # "Nkoy Rhedia surprised me with a visit before the Council even responded formally to our request."
    "Nkoy Rhedia überraschte mich mit einem Besuch, noch bevor der Rat formell auf unsere Anfrage geantwortet hatte."

# game/episode024.rpy:702
translate german ep024_uailea_rhedia_41f44719:

    # rh "Good day, [p_name]."
    rh "Guten Tag, [p_name]."

# game/episode024.rpy:703
translate german ep024_uailea_rhedia_2a50a53f:

    # rh "I hope your stay with us is to your liking so far?"
    rh "Ich hoffe, dir gefällt dein Aufenthalt bei uns bisher?"

# game/episode024.rpy:704
translate german ep024_uailea_rhedia_fee8c54c:

    # c "It is, thank you."
    c "Das ist es, danke."

# game/episode024.rpy:706
translate german ep024_uailea_rhedia_7967e074:

    # rh "I didn’t expect you back so soon."
    rh "Ich hätte nicht gedacht, dass du so schnell wieder da bist."

# game/episode024.rpy:707
translate german ep024_uailea_rhedia_b3d8af51:

    # c "We weren’t planning on returning here again, but circumstances have changed."
    c "Wir hatten eigentlich nicht vor, hierher zurückzukommen, aber die Umstände haben sich geändert."

# game/episode024.rpy:708
translate german ep024_uailea_rhedia_2e411744:

    # rh "Yes, your petition mentioned as much."
    rh "Ja, das wurde in deiner Petition erwähnt."

# game/episode024.rpy:709
translate german ep024_uailea_rhedia_f6dabdde:

    # rh "We will talk more of this during the Council session."
    rh "Wir werden das in der Ratssitzung weiter besprechen."

# game/episode024.rpy:711
translate german ep024_uailea_rhedia_55cee9e4:

    # c "So I have noticed."
    c "Mir ist das auch aufgefallen."

# game/episode024.rpy:712
translate german ep024_uailea_rhedia_45b54f81:

    # c "I take it the construction works in the capital are a planet-wide effort?"
    c "Ich nehme an, die Bauarbeiten in der Hauptstadt sind ein weltweites Projekt?"

# game/episode024.rpy:716
translate german ep024_uailea_rhedia_2a305044:

    # c "I’m glad to hear it."
    c "Das freut mich zu hören."

# game/episode024.rpy:717
translate german ep024_uailea_rhedia_f721d406:

    # rh "And I am glad you allowed me the opportunity to do so."
    rh "Und ich bin froh, dass du mir die Gelegenheit dazu gegeben hast."

# game/episode024.rpy:718
translate german ep024_uailea_rhedia_86047b2e:

    # rh "Helping the alliance you seek to create very much aligns with the Council’s vision for the Rhenkoy."
    rh "Die Unterstützung der Allianz, die du anstrebst, deckt sich sehr gut mit der Vision des Rates für Rhenköy."

# game/episode024.rpy:720
translate german ep024_uailea_rhedia_bf7d0256:

    # rh "We have been getting requests for aid from other worlds that are already threatened by the Sovereignty."
    rh "Wir erhalten Hilfsanfragen aus anderen Welten, die bereits von der Souveränität bedroht werden."

# game/episode024.rpy:721
translate german ep024_uailea_rhedia_af5282bb:

    # rh "Allying ourselves with you would enable us to provide the help those worlds desperately seek."
    rh "Ein Bündnis mit dir würde es uns ermöglichen, die Hilfe zu leisten, die diese Welten so dringend benötigen."

# game/episode024.rpy:722
translate german ep024_uailea_rhedia_6a309441:

    # c "I very much hope the other members of the Council can be persuaded."
    c "Ich hoffe sehr, dass die anderen Mitglieder des Rates überzeugt werden können."

# game/episode024.rpy:723
translate german ep024_uailea_rhedia_007e6f49:

    # rh "So do I."
    rh "Ich auch."

# game/episode024.rpy:724
translate german ep024_uailea_rhedia_e48fb42e:

    # c "Does Arlya still have some sway over the public opinion?"
    c "Hat Arlya immer noch Einfluss auf die öffentliche Meinung?"

# game/episode024.rpy:726
translate german ep024_uailea_rhedia_8bb7ac46:

    # rh "Some, but not as much as before."
    rh "Einige, aber nicht mehr so ​​viele wie früher."

# game/episode024.rpy:728
translate german ep024_uailea_rhedia_7bda230e:

    # rh "She has been tried and sentenced during your absence and is currently being held in a prison facility."
    rh "Sie wurde während deiner Abwesenheit vor Gericht gestellt und verurteilt und befindet sich derzeit in einer Haftanstalt."

# game/episode024.rpy:730
translate german ep024_uailea_rhedia_15f26050:

    # rh "She’s not allowed to communicate with the outside world, but her followers sometimes succeed in smuggling her writings out of the prison."
    rh "Es ist ihr nicht erlaubt, mit der Außenwelt zu kommunizieren, aber ihren Anhängern gelingt es manchmal, ihre Schriften aus dem Gefängnis zu schmuggeln."

# game/episode024.rpy:733
translate german ep024_uailea_rhedia_bed52dc3:

    # rh "So her follower numbers are slowly, but surely dwindling."
    rh "Ihre Followerzahlen schrumpfen also langsam, aber sicher."

# game/episode024.rpy:734
translate german ep024_uailea_rhedia_b9aa15aa:

    # c "I’m happy to hear that."
    c "Das freut mich zu hören."

# game/episode024.rpy:735
translate german ep024_uailea_rhedia_79702fd2:

    # rh "I have another meeting planned, so I have to leave you now."
    rh "Ich habe noch ein anderes Meeting geplant, deshalb muss ich jetzt gehen."

# game/episode024.rpy:737
translate german ep024_uailea_rhedia_037e2ea4:

    # rh "I just wanted you to know that the Council will process your petition very soon."
    rh "Ich wollte dir nur Bescheid geben, dass der Stadtrat deine Petition sehr bald bearbeiten wird."

# game/episode024.rpy:739
translate german ep024_uailea_rhedia_88fb1e09:

    # "Rhedia left the apartment and I began to feel more hopeful than before we set foot on Uailea."
    "Rhedia verließ die Wohnung und ich begann, hoffnungsvoller zu sein als vor unserer Ankunft auf Uailea."

# game/episode024.rpy:746
translate german ep024_uailea_arlya_017e8cd7:

    # "Nkoy Arlya surprised me with a visit before the Council even responded formally to our request."
    "Nkoy Arlya überraschte mich mit einem Besuch, noch bevor der Rat formell auf unsere Anfrage geantwortet hatte."

# game/episode024.rpy:747
translate german ep024_uailea_arlya_2c7f61ee:

    # c "Nkoy Arlya, what a pleasant surprise."
    c "Nkoy Arlya, was für eine angenehme Überraschung."

# game/episode024.rpy:749
translate german ep024_uailea_arlya_381fcd7d:

    # arl "Good day, [p_name]."
    arl "Guten Tag, [p_name]."

# game/episode024.rpy:750
translate german ep024_uailea_arlya_4de43917:

    # arl "I didn’t expect to see you again."
    arl "Ich hätte nicht gedacht, dass ich dich wiedersehe."

# game/episode024.rpy:751
translate german ep024_uailea_arlya_b3d8af51:

    # c "We weren’t planning on returning here again, but circumstances have changed."
    c "Wir hatten eigentlich nicht vor, hierher zurückzukommen, aber die Umstände haben sich geändert."

# game/episode024.rpy:752
translate german ep024_uailea_arlya_685023d8:

    # arl "So I’ve read in your petition."
    arl "Ich habe eure Petition gelesen."

# game/episode024.rpy:753
translate german ep024_uailea_arlya_6e42ee1b:

    # c "Has the Council decided yet?"
    c "Hat der Stadtrat schon entschieden?"

# game/episode024.rpy:755
translate german ep024_uailea_arlya_d4d75c7c:

    # arl "Not yet, I haven’t come in an official capacity."
    arl "Noch nicht, ich bin nicht in offizieller Funktion hier."

# game/episode024.rpy:756
translate german ep024_uailea_arlya_89aefe22:

    # c "I see."
    c "Verstehe."

# game/episode024.rpy:758
translate german ep024_uailea_arlya_534ebdf4:

    # arl "I’ll come right to the point."
    arl "Ich komme gleich zur Sache."

# game/episode024.rpy:759
translate german ep024_uailea_arlya_6ffac024:

    # arl "As you know, I have a lot of sway with the Council."
    arl "Wie du weißt, habe ich großen Einfluss im Stadtrat."

# game/episode024.rpy:760
translate german ep024_uailea_arlya_70379705:

    # arl "There is no question that my vote will decide whether the Council views your petition favorably or denies it."
    arl "Es steht außer Frage, dass meine Stimme darüber entscheiden wird, ob der Stadtrat Ihre Petition positiv bewertet oder ablehnt."

# game/episode024.rpy:761
translate german ep024_uailea_arlya_6e0e3cff:

    # c "An appeal to your sense of moral obligation is probably not enough?"
    c "Ein Appell an dein moralisches Pflichtgefühl reicht wahrscheinlich nicht aus?"

# game/episode024.rpy:763
translate german ep024_uailea_arlya_fa424a59:

    # arl "I have a very keen moral sense, but this is also a business transaction."
    arl "Ich habe einen sehr ausgeprägten Moralkodex, aber das hier ist auch ein Geschäftsabschluss."

# game/episode024.rpy:764
translate german ep024_uailea_arlya_20280865:

    # arl "You require the diplomatic prowess of the Rhenkoy to garner allies and support."
    arl "Du benötigen das diplomatische Geschick der Rhenköy, um Verbündete und Unterstützung zu gewinnen."

# game/episode024.rpy:766
translate german ep024_uailea_arlya_fd27da06:

    # c "I wouldn’t go that far."
    c "So weit würde ich nicht gehen."

# game/episode024.rpy:767
translate german ep024_uailea_arlya_36e6b775:

    # c "We’d struggle for sure, I’ll admit that much."
    c "Da würden wir sicher zu kämpfen haben, das gebe ich zu."

# game/episode024.rpy:768
translate german ep024_uailea_arlya_06751024:

    # c "But you mentioned a business transaction, so I assume there’s something you want in return for influencing the Council?"
    c "Aber du hast von einer Geschäftstransaktion gesprochen, also nehme ich an, dass du im Gegenzug für deine Einflussnahme auf den Rat etwas willst?"

# game/episode024.rpy:772
translate german ep024_uailea_arlya_9550fc22:

    # arl "Furthermore, I want a sizeable cut from the spoils of war."
    arl "Außerdem will ich einen ordentlichen Anteil an der Kriegsbeute."

# game/episode024.rpy:776
translate german ep024_uailea_arlya_2e7d94f6:

    # c "I’m sure we can come to an arrangement."
    c "Ich bin sicher, wir können eine Einigung erzielen."

# game/episode024.rpy:778
translate german ep024_uailea_arlya_7ff9d097:

    # arl "I’m happy to hear that."
    arl "Das freut mich zu hören."

# game/episode024.rpy:781
translate german ep024_uailea_arlya_011ea9f8:

    # arl "Our agreement will be witnessed and filed with the League of Dipoturn to ensure it’s legally binding and that the Council will be none the wiser."
    arl "Unsere Vereinbarung wird bezeugt und bei der Liga von Dipoturn eingereicht, um sicherzustellen, dass sie rechtsverbindlich ist und der Rat nichts davon mitbekommt."

# game/episode024.rpy:782
translate german ep024_uailea_arlya_950daf31:

    # c "You have it all planned out."
    c "Du hast alles durchgeplant."

# game/episode024.rpy:784
translate german ep024_uailea_arlya_8b0c8f38:

    # arl "I didn’t come this far without any planning."
    arl "Ich bin nicht ohne Planung so weit gekommen."

# game/episode024.rpy:788
translate german ep024_uailea_arlya_12724fac:

    # c "It’s all about power for you, isn’t it?"
    c "Bei dir dreht sich alles nur um Macht, nicht wahr?"

# game/episode024.rpy:789
translate german ep024_uailea_arlya_66b0fab7:

    # c "I’ll take my chances with the Council."
    c "Ich versuche mein Glück beim Stadtrat."

# game/episode024.rpy:791
translate german ep024_uailea_arlya_3e8ff3ca:

    # arl "They’ll refuse."
    arl "Die werden sich weigern."

# game/episode024.rpy:794
translate german ep024_uailea_arlya_e97724d8:

    # arl "You have a lot to learn if you want to play the political game."
    arl "Du hast noch viel zu lernen, wenn du im politischen Spiel mitspielen willst."

# game/episode024.rpy:795
translate german ep024_uailea_arlya_9e2fa476:

    # c "I have no interest in playing games."
    c "Ich habe kein Interesse an Spielchen."

# game/episode024.rpy:796
translate german ep024_uailea_arlya_876e637c:

    # arl "That’s very clear."
    arl "Das ist ganz klar."

# game/episode024.rpy:797
translate german ep024_uailea_arlya_381fcd7d_1:

    # arl "Good day, [p_name]."
    arl "Guten Tag, [p_name]."

# game/episode024.rpy:798
translate german ep024_uailea_arlya_b98da319:

    # arl "You’ll learn of the Council’s decision and the consequences of your mistake very soon."
    arl "Du wirst die Entscheidung des Stadtrats und die Konsequenzen deines Fehlers sehr bald erfahren."

# game/episode024.rpy:807
translate german ep024_uailea_arlya_bribe_aee68192:

    # man "[p_name] Valenmann de Lonval?"
    man "[p_name] Valenmann de Lonval?"

# game/episode024.rpy:808
translate german ep024_uailea_arlya_bribe_24c7ada5:

    # c "Yes?"
    c "Ja?"

# game/episode024.rpy:811
translate german ep024_uailea_arlya_bribe_7b7a5678:

    # c "Yes, of course."
    c "Ja, natürlich."

# game/episode024.rpy:813
translate german ep024_uailea_arlya_bribe_0307612a:

    # man "Nkoy Arlya has prepared some documents for you to sign."
    man "Nkoy Arlya hat einige Dokumente für dich zum Unterschreiben vorbereitet."

# game/episode024.rpy:815
translate german ep024_uailea_arlya_bribe_90897e30:

    # man "By signing these documents, you agree to be bound by the terms listed inside."
    man "Durch die Unterzeichnung dieser Dokumente erklären Sie sich mit den darin aufgeführten Bedingungen einverstanden."

# game/episode024.rpy:816
translate german ep024_uailea_arlya_bribe_24f2842b:

    # man "Failure to honor the terms of the agreement will result in disciplinary action courtesy of the League of Dipoturn and any associates."
    man "Die Nichteinhaltung der Vertragsbedingungen wird disziplinarische Maßnahmen seitens der League of Dipoturn und ihrer Partner nach sich ziehen."

# game/episode024.rpy:831
translate german ep024_uailea_arlya_bribe_d0b4789f:

    # c "Alright, just tell me where."
    c "Okay, sag mir einfach wo."

# game/episode024.rpy:832
translate german ep024_uailea_arlya_bribe_3e65e1a8:

    # man "Please press your finger on the tab."
    man "Bitte drück deinen Finger auf die Lasche."

# game/episode024.rpy:833
translate german ep024_uailea_arlya_bribe_6f263c98:

    # man "Thank you."
    man "Danke."

# game/episode024.rpy:834
translate german ep024_uailea_arlya_bribe_450d23ff:

    # c "That’s it?"
    c "Das war\'s schon?"

# game/episode024.rpy:836
translate german ep024_uailea_arlya_bribe_a20285ac:

    # man "Thank you for your cooperation."
    man "Danke für Ihre Mitarbeit."

# game/episode024.rpy:837
translate german ep024_uailea_arlya_bribe_359e3689:

    # man "Have a nice day."
    man "Schönen Tag noch."

# game/episode024.rpy:843
translate german ep024_uailea_arlya_bribe_2cb8356a:

    # c "I’ve changed my mind, I’m not signing."
    c "Ich hab\'s mir anders überlegt, ich unterschreibe nicht."

# game/episode024.rpy:844
translate german ep024_uailea_arlya_bribe_6241c132:

    # man "That’s a shame, sir."
    man "Das ist aber schade, mein Herr."

# game/episode024.rpy:845
translate german ep024_uailea_arlya_bribe_87cf6fd9:

    # man "Are you absolutely certain?"
    man "Bist du dir ganz sicher?"

# game/episode024.rpy:846
translate german ep024_uailea_arlya_bribe_36391c9b:

    # c "Yes, I am."
    c "Ja, das bin ich."

# game/episode024.rpy:847
translate german ep024_uailea_arlya_bribe_9a89c0ea:

    # man "Very good."
    man "Sehr gut."

# game/episode024.rpy:849
translate german ep024_uailea_arlya_bribe_464e9811:

    # man "The other signatory will be informed of your decision and the relevant documents will be destroyed."
    man "Der andere Unterzeichner wird über Ihre Entscheidung informiert und die entsprechenden Dokumente werden vernichtet."

# game/episode024.rpy:850
translate german ep024_uailea_arlya_bribe_359e3689_1:

    # man "Have a nice day."
    man "Schönen Tag noch."

# game/episode024.rpy:852
translate german ep024_uailea_arlya_bribe_dfd24b29:

    # "The android left me and I was alone again, a sinking feeling permeating, despite having done the right thing."
    "Der Android hat mich verlassen und ich war wieder allein, ein beklemmendes Gefühl überkam mich, obwohl ich das Richtige getan hatte."

# game/episode024.rpy:860
translate german ep024_uailea_council_8da9ace5:

    # "A couple of days after Rhedia’s visit, the Council invited us to join them."
    "Ein paar Tage nach Rhedias Besuch lud uns der Rat ein, uns ihnen anzuschließen."

# game/episode024.rpy:861
translate german ep024_uailea_council_a0573492:

    # "Ziv, Nadya and I were led to the Council chambers."
    "Ziv, Nadya und ich wurden in den Ratssaal geführt."

# game/episode024.rpy:862
translate german ep024_uailea_council_0ad24223:

    # "The Nkoy’s were already there, Rhedia presiding as the head of the Council."
    "Die Nkoys waren bereits da, Rhedia führte den Vorsitz im Rat."

# game/episode024.rpy:864
translate german ep024_uailea_council_af192209:

    # rh "Welcome, [p_name], Ziv and Nadya."
    rh "Willkommen, [p_name], Ziv und Nadya."

# game/episode024.rpy:865
translate german ep024_uailea_council_73d0143d:

    # rh "The Council is now in session and will now respond to your petition."
    rh "Der Stadtrat ist jetzt in Sitzung und wird nun auf Ihre Petition antworten."

# game/episode024.rpy:866
translate german ep024_uailea_council_330e1759:

    # rh "On the matter of providing diplomatic services to a Coalition against the aggression of the Sovereignty, the Council has reached a verdict."
    rh "In der Frage der Bereitstellung diplomatischer Dienste für eine Koalition gegen die Aggression der Souveränität hat der Rat ein Urteil gefällt."

# game/episode024.rpy:868
translate german ep024_uailea_council_944f9e24:

    # rh "The Rhenkoy will provide diplomatic assistance as outlined in your petition."
    rh "Die Rhenköy werden dir die in deiner Petition beschriebene diplomatische Unterstützung leisten."

# game/episode024.rpy:869
translate german ep024_uailea_council_302086bf:

    # rh "We will work closely together with you as we begin our outreach to other potential allies."
    rh "Wir werden eng mit dir zusammenarbeiten, wenn wir mit unserer Kontaktaufnahme zu anderen potenziellen Verbündeten beginnen."

# game/episode024.rpy:870
translate german ep024_uailea_council_b3585248:

    # rh "Your petition also mentioned the Tubloshi and their military strength."
    rh "In deiner Petition wurde auch die Tubloshi und ihre militärische Stärke erwähnt."

# game/episode024.rpy:872
translate german ep024_uailea_council_25a9e27e:

    # rh "Their battle prowess may provide a powerful incentive for others to join the fight, but we will of course explore other avenues as well."
    rh "Ihre Kampfkraft mag für andere ein starker Anreiz sein, sich dem Kampf anzuschließen, aber wir werden natürlich auch andere Wege erkunden."

# game/episode024.rpy:874
translate german ep024_uailea_council_51f3ac73:

    # rh "They will forward any request you have to us and will keep you up to date with our own progress."
    rh "Sie werden uns jede Anfrage weiterleiten und dich über unsere eigenen Fortschritte auf dem Laufenden halten."

# game/episode024.rpy:878
translate german ep024_uailea_council_19eec105:

    # c "Thank you very much."
    c "Vielen Dank."

# game/episode024.rpy:879
translate german ep024_uailea_council_783e2571:

    # c "We look forward to working together."
    c "Wir freuen uns auf die Zusammenarbeit."

# game/episode024.rpy:880
translate german ep024_uailea_council_f8108235:

    # c "Together we will build the largest and most powerful alliance ever known."
    c "Gemeinsam werden wir das größte und mächtigste Bündnis aller Zeiten aufbauen."

# game/episode024.rpy:882
translate german ep024_uailea_council_55cc7e5f:

    # rh "The Rhenkoy are honored to be part of this effort."
    rh "The Rhenkoy fühlen sich geehrt, Teil dieser Aktion zu sein."

# game/episode024.rpy:883
translate german ep024_uailea_council_ecbb56aa:

    # rh "This Council session is now adjourned."
    rh "Diese Ratssitzung ist hiermit beendet."

# game/episode024.rpy:885
translate german ep024_uailea_council_588712c7:

    # "The Nkoy got up and left, leaving the three of us to process this news."
    "Der Nkoy stand auf und ging, sodass wir drei diese Nachricht erst einmal verarbeiten mussten."

# game/episode024.rpy:887
translate german ep024_uailea_council_fb444bdc:

    # na "Well, it seems like we did it."
    na "Nun ja, es scheint, als hätten wir es geschafft."

# game/episode024.rpy:888
translate german ep024_uailea_council_68b6cf4f:

    # c "Yes, it seems we did."
    c "Ja, anscheinend schon."

# game/episode024.rpy:889
translate german ep024_uailea_council_f7d69d1b:

    # c "Allying ourselves with an outcast seems to have paid off in the end."
    c "Es scheint sich am Ende ausgezahlt zu haben, dass wir uns mit einem Außenseiter verbündet haben."

# game/episode024.rpy:891
translate german ep024_uailea_council_ebfcb5c0:

    # zi "Yes, it may have been a gamble, but I’m glad it worked to our advantage."
    zi "Ja, es war vielleicht ein Wagnis, aber ich bin froh, dass es sich zu unserem Vorteil ausgewirkt hat."

# game/episode024.rpy:893
translate german ep024_uailea_council_3155f938:

    # na "Agreed, let’s go tell the others."
    na "Einverstanden, lass uns den anderen Bescheid sagen."

# game/episode024.rpy:895
translate german ep024_uailea_council_5723e9cd:

    # "Leaving the Council chambers, we went to the Bastard to bring everyone up to speed."
    "Nachdem wir den Ratssaal verlassen hatten, gingen wir zum Bastard, um alle auf den neuesten Stand zu bringen."

# game/episode024.rpy:900
translate german ep024_uailea_council_f44dd42f:

    # "One day after the visit of the representative of the League of Dipoturn, the Council invited us to join them."
    "Einen Tag nach dem Besuch des Vertreters der Liga von Dipoturn lud uns der Rat ein, uns ihnen anzuschließen."

# game/episode024.rpy:902
translate german ep024_uailea_council_7766e056:

    # "A couple of days after Arlya’s visit, the Council invited us to join them."
    "Ein paar Tage nach Arlyas Besuch lud uns der Rat ein, uns ihnen anzuschließen."

# game/episode024.rpy:903
translate german ep024_uailea_council_a0573492_1:

    # "Ziv, Nadya and I were led to the Council chambers."
    "Ziv, Nadya und ich wurden in den Ratssaal geführt."

# game/episode024.rpy:906
translate german ep024_uailea_council_1fad64a5:

    # "The Nkoy’s were already there, Arlya presiding as the head of the Council and smiling pleasantly."
    "Die Nkoys waren bereits da, Arlya führte den Vorsitz als Oberhaupt des Rates und lächelte freundlich."

# game/episode024.rpy:908
translate german ep024_uailea_council_685ccc33:

    # "The Nkoy’s were already there, Arlya presiding as the head of the Council and smirking ominously."
    "Die Nkoys waren bereits da, Arlya führte als Oberhaupt des Rates den Vorsitz und grinste ominös."

# game/episode024.rpy:909
translate german ep024_uailea_council_579c71e6:

    # arl "Welcome all."
    arl "Willkommen alle."

# game/episode024.rpy:910
translate german ep024_uailea_council_e7652b19:

    # arl "The Council of Nkoy is now in session."
    arl "Der Rat von Nkoy ist jetzt in Sitzung."

# game/episode024.rpy:911
translate german ep024_uailea_council_366fd428:

    # arl "We are formally responding to a petition for diplomatic aid."
    arl "Wir antworten hiermit offiziell auf ein Hilfsgesuch um diplomatische Unterstützung."

# game/episode024.rpy:914
translate german ep024_uailea_council_dc834bcc:

    # arl "The Council has decided to deny your request."
    arl "Der Rat hat beschlossen, Ihren Antrag abzulehnen."

# game/episode024.rpy:916
translate german ep024_uailea_council_209fe013:

    # arl "The Rhenkoy will not render their diplomatic services to you."
    arl "Die Rhenköy werden dir ihre diplomatischen Dienste nicht leisten."

# game/episode024.rpy:917
translate german ep024_uailea_council_9179fbdf:

    # c "You’re making a mistake."
    c "Du machst einen Fehler."

# game/episode024.rpy:919
translate german ep024_uailea_council_be8ca7fe:

    # na "The Sovereignty will trample you without mercy, neutrality be damned."
    na "Die Souveränität wird dich gnadenlos niedertrampeln, Neutralität sei verdammt."

# game/episode024.rpy:921
translate german ep024_uailea_council_22ddc95b:

    # zi "You disgust me, Arlya."
    zi "Du ekelst mich an, Arlya."

# game/episode024.rpy:922
translate german ep024_uailea_council_3f65bf79:

    # zi "You’re corrupting the Rhenkoy from the inside out."
    zi "Du verdirbst den Rhenköy von innen heraus."

# game/episode024.rpy:923
translate german ep024_uailea_council_a38778a6:

    # zi "And the other Nkoy are letting you get away with it."
    zi "Und die anderen Nkoy lassen dich damit durchkommen."

# game/episode024.rpy:925
translate german ep024_uailea_council_6c8fe3ac:

    # arl "Spending this much time with non-Rhenkoy has made you stray from the path."
    arl "So viel Zeit mit Leuten zu verbringen, die nicht zu Rhenkoy gehören, hat dich vom rechten Weg abgebracht."

# game/episode024.rpy:928
translate german ep024_uailea_council_fcc5255f:

    # zi "You’re seriously quoting a dissident fundamentalist as gospel now?"
    zi "Du zitierst jetzt ernsthaft einen abtrünnigen Fundamentalisten als unumstößliche Wahrheit?"

# game/episode024.rpy:929
translate german ep024_uailea_council_4a5e48f6:

    # zi "And you all just let her?"
    zi "Und ihr habt sie einfach so gelassen?"

# game/episode024.rpy:933
translate german ep024_uailea_council_17f657c9:

    # woman "Your tone and demeanour are unacceptable here in these hallowed Council halls."
    woman "Dein Tonfall und dein Benehmen sind hier in diesen ehrwürdigen Ratssälen inakzeptabel."

# game/episode024.rpy:935
translate german ep024_uailea_council_56a1837f:

    # arl "You are the one who has lost their way, Ziv."
    arl "Du bist derjenige, der sich verirrt hat, Ziv."

# game/episode024.rpy:936
translate german ep024_uailea_council_f4b564c9:

    # arl "This session is over."
    arl "Diese Session ist beendet."

# game/episode024.rpy:938
translate german ep024_uailea_council_38adc7ce:

    # "The Nkoy got up and left, leaving the three of us fuming."
    "Der Nkoy stand auf und ging, und wir drei waren stinksauer."

# game/episode024.rpy:940
translate german ep024_uailea_council_c75788ef:

    # zi "They’re so shortsighted!"
    zi "Die sind so kurzsichtig!"

# game/episode024.rpy:942
translate german ep024_uailea_council_6d073341:

    # na "That Arlya seems to have a firm grip on the Council."
    na "Arlya scheint den Rat fest im Griff zu haben."

# game/episode024.rpy:943
translate german ep024_uailea_council_83110c5b:

    # c "She mentioned as much when she visited me earlier."
    c "Das hat sie schon bei ihrem Besuch vorhin erwähnt."

# game/episode024.rpy:945
translate german ep024_uailea_council_4a9d1064:

    # na "What did she want?"
    na "Was wollte sie?"

# game/episode024.rpy:946
translate german ep024_uailea_council_cfca75b7:

    # c "A bribe."
    c "Ein Bestechungsgeld."

# game/episode024.rpy:947
translate german ep024_uailea_council_1b8b2634:

    # c "I said no."
    c "Ich hab nein gesagt."

# game/episode024.rpy:949
translate german ep024_uailea_council_0c10fe4d:

    # na "And rightly so, alliances shouldn’t be built on the promise of personal gain."
    na "Und das zu Recht, Allianzen sollten nicht auf dem Versprechen des persönlichen Vorteils aufgebaut werden."

# game/episode024.rpy:951
translate german ep024_uailea_council_f0f69dd4:

    # zi "Agreed."
    zi "Einverstanden."

# game/episode024.rpy:952
translate german ep024_uailea_council_1f0c1c31:

    # c "It does leave us without an ally though."
    c "Das lässt uns allerdings ohne Verbündeten zurück."

# game/episode024.rpy:954
translate german ep024_uailea_council_f3a94386:

    # na "The diplomatic skills of the Rhenkoy aren’t easily replicated, but there must be other options we can explore."
    na "Die diplomatischen Fähigkeiten der Rhenköys lassen sich nicht so einfach nachahmen, aber es muss doch noch andere Möglichkeiten geben, die wir erkunden können."

# game/episode024.rpy:956
translate german ep024_uailea_council_d6f079c4:

    # zi "I will ask around if there are any Rhenkoy who wish to join us."
    zi "Ich frage mal rum, ob es irgendwelche Rhenköy gibt, die sich uns anschließen wollen."

# game/episode024.rpy:957
translate german ep024_uailea_council_2cf8360d:

    # c "Will they break from the Rhenkoy hierarchy that easily?"
    c "Werden sie sich so einfach von der Rhenköy-Hierarchie lösen?"

# game/episode024.rpy:960
translate german ep024_uailea_council_58b03bdb:

    # zi "I’ll keep you posted."
    zi "Ich halte dich auf dem Laufenden."

# game/episode024.rpy:961
translate german ep024_uailea_council_fd885045:

    # c "Thanks, if you need anything, just let me know."
    c "Danke. Wenn du was brauchst, sag einfach Bescheid."

# game/episode024.rpy:963
translate german ep024_uailea_council_32e618b3:

    # "Leaving the Council chambers, we each went our separate ways."
    "Nachdem wir den Ratssaal verlassen hatten, gingen wir alle unserer Wege."

# game/episode024.rpy:966
translate german ep024_uailea_council_372892a9:

    # arl "The Council has decided to honor your request."
    arl "Der Rat hat beschlossen, Ihrem Antrag stattzugeben."

# game/episode024.rpy:967
translate german ep024_uailea_council_7a8fc0da:

    # arl "The diplomatic services of the Rhenkoy are at your disposal."
    arl "Die diplomatischen Dienste des Rhenköy stehen dir zur Verfügung."

# game/episode024.rpy:969
translate german ep024_uailea_council_e17b136a:

    # arl "We will coordinate with you to begin our outreach to other potential allies."
    arl "Wir werden uns mit dir abstimmen, um unsere Kontaktaufnahme mit anderen potenziellen Verbündeten zu beginnen."

# game/episode024.rpy:970
translate german ep024_uailea_council_aa557927:

    # arl "Your petition mentioned the Tubloshi."
    arl "In deiner Petition wurde die Tubloshi erwähnt."

# game/episode024.rpy:971
translate german ep024_uailea_council_fb98be03:

    # arl "Their military might is a powerful incentive for others to join, but we will explore other avenues as well."
    arl "Ihre militärische Stärke ist ein starker Anreiz für andere, sich anzuschließen, aber wir werden auch andere Wege erkunden."

# game/episode024.rpy:972
translate german ep024_uailea_council_c7a05c06:

    # arl "A liaison will be appointed and will act as our eyes and ears."
    arl "Es wird ein Verbindungsmann ernannt, der als unsere Augen und Ohren fungieren wird."

# game/episode024.rpy:973
translate german ep024_uailea_council_52e472f0:

    # arl "They will forward any request you have to us and will keep you up to date with our own progress."
    arl "Sie werden uns jede Anfrage weiterleiten und Sie über unsere eigenen Fortschritte auf dem Laufenden halten."

# game/episode024.rpy:974
translate german ep024_uailea_council_19eec105_1:

    # c "Thank you very much."
    c "Vielen Dank."

# game/episode024.rpy:975
translate german ep024_uailea_council_783e2571_1:

    # c "We look forward to working together."
    c "Wir freuen uns auf die Zusammenarbeit."

# game/episode024.rpy:976
translate german ep024_uailea_council_f8108235_1:

    # c "Together we will build the largest and most powerful alliance ever known."
    c "Gemeinsam werden wir das größte und mächtigste Bündnis aller Zeiten aufbauen."

# game/episode024.rpy:978
translate german ep024_uailea_council_de2441a4:

    # arl "The Rhenkoy are honored to be part of this effort."
    arl "The Rhenkoy fühlen sich geehrt, Teil dieser Aktion zu sein."

# game/episode024.rpy:979
translate german ep024_uailea_council_3f0b8629:

    # arl "This Council session is now adjourned."
    arl "Diese Ratssitzung ist hiermit beendet."

# game/episode024.rpy:981
translate german ep024_uailea_council_588712c7_1:

    # "The Nkoy got up and left, leaving the three of us to process this news."
    "Der Nkoy stand auf und ging, sodass wir drei diese Nachricht erst einmal verarbeiten mussten."

# game/episode024.rpy:983
translate german ep024_uailea_council_fb444bdc_1:

    # na "Well, it seems like we did it."
    na "Nun ja, es scheint, als hätten wir es geschafft."

# game/episode024.rpy:984
translate german ep024_uailea_council_e89de6b6:

    # c "Yes, but I hope the benefits will outweigh the costs."
    c "Ja, aber ich hoffe, dass die Vorteile die Kosten überwiegen werden."

# game/episode024.rpy:986
translate german ep024_uailea_council_f5978c11:

    # zi "That’s always the question, sadly."
    zi "Das ist leider immer die Frage."

# game/episode024.rpy:987
translate german ep024_uailea_council_eb13a208:

    # c "At any rate, I’d say this is a win for us."
    c "Jedenfalls würde ich sagen, das ist ein Gewinn für uns."

# game/episode024.rpy:988
translate german ep024_uailea_council_3155f938_1:

    # na "Agreed, let’s go tell the others."
    na "Einverstanden, lass uns den anderen Bescheid sagen."

# game/episode024.rpy:990
translate german ep024_uailea_council_5723e9cd_1:

    # "Leaving the Council chambers, we went to the Bastard to bring everyone up to speed."
    "Nachdem wir den Ratssaal verlassen hatten, gingen wir ins „Bastard“, um alle auf den neuesten Stand zu bringen."

# game/episode024.rpy:1100
translate german ep024_uailea_ziv_97571168:

    # "I didn’t see much of Ziv during my stay at the apartment."
    "Ich habe Ziv während meines Aufenthalts in der Wohnung nicht oft gesehen."

# game/episode024.rpy:1101
translate german ep024_uailea_ziv_622497b9:

    # "She was out to drum up diplomatic support and visited several settlements on Uailea."
    "Sie war bestrebt, diplomatische Unterstützung zu gewinnen und besuchte mehrere Siedlungen auf Uailea."

# game/episode024.rpy:1103
translate german ep024_uailea_ziv_bb748e2c:

    # "Ziv returned after two weeks of travelling and came immediately to the apartment."
    "Ziv kehrte nach zweiwöchiger Reise zurück und kam sofort in die Wohnung."

# game/episode024.rpy:1104
translate german ep024_uailea_ziv_38232650:

    # c "Hey, how have you been?"
    c "Hey, wie geht\'s dir?"

# game/episode024.rpy:1105
translate german ep024_uailea_ziv_72cc9a88:

    # zi "Good, considering, very tired though."
    zi "Gut, den Umständen entsprechend, bin aber sehr müde."

# game/episode024.rpy:1106
translate german ep024_uailea_ziv_0da57f1a:

    # c "I can imagine."
    c "Das kann ich mir vorstellen."

# game/episode024.rpy:1107
translate german ep024_uailea_ziv_54027a63:

    # c "Any luck?"
    c "Irgendwelche Neuigkeiten?"

