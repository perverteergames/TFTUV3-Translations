translate portuguese ep025_erigone_grove_0f96da3e:

    # "I saw Eva floating by underneath me, her eyes closed and seemingly at peace."
    "Eu vi Eva boiando abaixo de olhos fechados, em aparente tranquilidade."

# game/episode025.rpy:2049
translate portuguese ep025_erigone_grove_16731746:

    # "She opened her eyes when I came down to the lake shore and swam toward me."
    "Ela abriu os olhos quando cheguei perto da beira do lago e nadou na minha direção."

# game/episode025.rpy:2054
translate portuguese ep025_erigone_grove_5e0497d9:

    # e "You made it!"
    e "Você veio!"

# game/episode025.rpy:2055
translate portuguese ep025_erigone_grove_9aa7a3a2:

    # c "I did."
    c "Vim mesmo."

# game/episode025.rpy:2056
translate portuguese ep025_erigone_grove_517e6dfd:

    # c "You’ve chosen a beautiful spot."
    c "Você escolheu um ótimo lugar."

# game/episode025.rpy:2057
translate portuguese ep025_erigone_grove_a0f909c0:

    # e "It certainly is."
    e "É lindo, né?"

# game/episode025.rpy:2058
translate portuguese ep025_erigone_grove_144fb847:

    # e "Peaceful too."
    e "E bem tranquilo."

# game/episode025.rpy:2059
translate portuguese ep025_erigone_grove_a6cfbab8:

    # e "Come in, the water is lovely!"
    e "Entra, a água está ótima!"

# game/episode025.rpy:2060
translate portuguese ep025_erigone_grove_efa643f0:

    # "I undressed and joined Eva in the lake."
    "Eu tirei a roupa e entrei no lago com a Eva."

# game/episode025.rpy:2062
translate portuguese ep025_erigone_grove_a07ab27e:

    # c "You’re right, the water’s very nice."
    c "Realmente, a água está bem legalzinha."

# game/episode025.rpy:2063
translate portuguese ep025_erigone_grove_5e476468:

    # e "And we won’t be disturbed for several hours."
    e "E não vamos ser incomodados por várias horas."

# game/episode025.rpy:2064
translate portuguese ep025_erigone_grove_6867cf43:

    # c "The Queen has made her wishes known?"
    c "A Rainha deu suas ordens, é?"

# game/episode025.rpy:2065
translate portuguese ep025_erigone_grove_7c7fea12:

    # e "She certainly has."
    e "Com certeza."

# game/episode025.rpy:2067
translate portuguese ep025_erigone_grove_af41fe81:

    # e "I’ve attended enough meetings for a lifetime."
    e "Já participei de reuniões demais para uma vida."

# game/episode025.rpy:2069
translate portuguese ep025_erigone_grove_fc9e09e8:

    # e "Though I’m sure there’ll be more tomorrow."
    e "Mas não duvido nada que vai ter mais amanhã."

# game/episode025.rpy:2070
translate portuguese ep025_erigone_grove_99847fd1:

    # c "Poor you."
    c "Tadinha."

# game/episode025.rpy:2071
translate portuguese ep025_erigone_grove_b24aeeb2:

    # c "Is it very tedious?"
    c "São chatas?"

# game/episode025.rpy:2073
translate portuguese ep025_erigone_grove_e097b611:

    # e "No, not that."
    e "Não, não é isso."

# game/episode025.rpy:2074
translate portuguese ep025_erigone_grove_10016cc8:

    # e "I can actually contribute from time to time."
    e "Eu até que contribuo de vez em quando."

# game/episode025.rpy:2075
translate portuguese ep025_erigone_grove_96e3df36:

    # e "It’s just the duration and amount that wear me out."
    e "O problema é que demoram tanto, e também tem o cansaço que elas causam."

# game/episode025.rpy:2077
translate portuguese ep025_erigone_grove_3a1da560:

    # e "So, I’ve instructed my guards not to let anyone but the crew through."
    e "Aí eu mandei as guardas não deixarem ninguém além da tripulação passar."

# game/episode025.rpy:2079
translate portuguese ep025_erigone_grove_282ac659:

    # e "I’ve instructed my guards not to let anyone but the crew through."
    e "Eu mandei as guardas não deixarem ninguém além da tripulação passar."

# game/episode025.rpy:2080
translate portuguese ep025_erigone_grove_5d61f0b7:

    # c "So we have some time alone."
    c "Então temos um tempo a sós."

# game/episode025.rpy:2082
translate portuguese ep025_erigone_grove_5efd9aa2:

    # e "We could, but we won’t."
    e "Até que poderíamos, mas não vamos."

# game/episode025.rpy:2083
translate portuguese ep025_erigone_grove_d03c9e8a:

    # c "No?"
    c "Não?"

# game/episode025.rpy:2088
translate portuguese ep025_erigone_grove_911b42c9:

    # "Eva clearly wasn’t in the mood for teasing, because she kissed me full on the mouth in response."
    "Eva obviamente não estava no clima para essas provocações, respondendo com um beijo na boca."

# game/episode025.rpy:2093
translate portuguese ep025_erigone_grove_12643476:

    # e "I like this much better than swimming."
    e "Gosto muito mais disso que de nadar."

# game/episode025.rpy:2094
translate portuguese ep025_erigone_grove_8125aa90:

    # c "No argument here."
    c "Não vou reclamar."

# game/episode025.rpy:2099
translate portuguese ep025_erigone_grove_a3869d96:

    # "We continued kissing."
    "Nós continuamos beijando."

# game/episode025.rpy:2100
translate portuguese ep025_erigone_grove_0445fee3:

    # "I was just about to remove Eva’s bikini top, when we heard a scuffle overhead."
    "Eu já ia remover o top da Eva quando ouvimos um barulho."

# game/episode025.rpy:2101
translate portuguese ep025_erigone_grove_6dabe0c0:

    # "Thinking it was one of the guards interrupting us, we both spun toward the noise."
    "Achando que era uma das guardas nos interrompendo, viramos na direção do barulho."

# game/episode025.rpy:2103
translate portuguese ep025_erigone_grove_3ed1d679:

    # ra "Oh...{w} Er...{w} Sorry."
    ra "Ah...{w} Ahm...{w} Desculpa."

# game/episode025.rpy:2104
translate portuguese ep025_erigone_grove_4a1b4791:

    # ra "Sorry...{w} I..."
    ra "Desculpa...{w} Eu..."

# game/episode025.rpy:2105
translate portuguese ep025_erigone_grove_d21e5593:

    # e "Hey, Raene!"
    e "Oi, Raene!"

# game/episode025.rpy:2106
translate portuguese ep025_erigone_grove_9f646294:

    # e "Come to take a swim?"
    e "Veio nadar?"

# game/episode025.rpy:2108
translate portuguese ep025_erigone_grove_c821d075:

    # ra "Yes, they told me that-"
    ra "Sim, elas me falaram que-"

# game/episode025.rpy:2109
translate portuguese ep025_erigone_grove_a8a299ff:

    # ra "This was-"
    ra "Aqui era-"

# game/episode025.rpy:2110
translate portuguese ep025_erigone_grove_094fb69c:

    # ra "I’m sorry, I should leave you two alone."
    ra "Desculpa, é melhor deixar vocês a sós."

# game/episode025.rpy:2113
translate portuguese ep025_erigone_grove_54d97523:

    # "Eva and I exchanged a meaningful look."
    "Eu e Eva olhamos um para o outro."

# game/episode025.rpy:2115
translate portuguese ep025_erigone_grove_f0ea3cf0:

    # e "No, stay, come and join us!"
    e "Não, que isso, fica aqui com a gente!"

# game/episode025.rpy:2120
translate portuguese ep025_erigone_grove_674a4186:

    # "Raene looked as if she were about to flee in shame for a split second, but eventually made her way down to us."
    "Por um momento,Raene parecia que estava para correr de vergonha, mas eventualmente veio na nossa direção."

# game/episode025.rpy:2122
translate portuguese ep025_erigone_grove_2392320f:

    # ra "They told me at the Citadel that this was the best place to bathe."
    ra "Elas me disseram lá na Cidadela que esse era o melhor lugar para se banhar."

# game/episode025.rpy:2124
translate portuguese ep025_erigone_grove_82b28e59:

    # ra "They told me at the Shipyards that this was the best place to bathe."
    ra "Elas me disseram lá nas Docas que esse era o melhor lugar para se banhar."

# game/episode025.rpy:2125
translate portuguese ep025_erigone_grove_6e0004c4:

    # e "Yes, the water is not too cold and the trees provide cover against the sun."
    e "Sim, a água não é gelada demais e as árvores protegem do sol."

# game/episode025.rpy:2127
translate portuguese ep025_erigone_grove_e07afa80:

    # "Raene tested the water and then dove straight in."
    "Raene testou a água e já foi entrando."

# game/episode025.rpy:2128
translate portuguese ep025_erigone_grove_0e873730:

    # ra "Yes, it’s great."
    ra "Sim, está ótima."

# game/episode025.rpy:2129
translate portuguese ep025_erigone_grove_f492ca24:

    # ra "I’ll swim a few laps and then leave you two alone, if that’s okay?"
    ra "Vou nadar um pouco e aí deixo vocês em paz, tudo bem?"

# game/episode025.rpy:2130
translate portuguese ep025_erigone_grove_f07e88b8:

    # c "You’re welcome to stay as long as you like, Raene."
    c "Raene, pode ficar o quanto quiser."

# game/episode025.rpy:2132
translate portuguese ep025_erigone_grove_26c4803d:

    # ra "Yes, but...{w} It looked like I was interrupting something."
    ra "Sim, mas...{w} Parecia que eu estava interrompendo alguma coisa."

# game/episode025.rpy:2136
translate portuguese ep025_erigone_grove_20532180:

    # c "We’ll let you know as soon as the lake is free."
    c "A gente te avisa assim que o lago ficar livre."

# game/episode025.rpy:2137
translate portuguese ep025_erigone_grove_5582558c:

    # ra "Thank you."
    ra "Obrigada."

# game/episode025.rpy:2142
translate portuguese ep025_erigone_grove_9ffbd7a3:

    # "Raene fled the scene and Eva burst out laughing as soon as she was out of earshot."
    "Raene saiu rapidamente e Eva começou a rir assim que ela não conseguia mais nos ouvir."

# game/episode025.rpy:2143
translate portuguese ep025_erigone_grove_2a0da401:

    # e "She couldn’t have picked a worse moment!"
    e "Ela não poderia ter escolhido um pior momento!"

# game/episode025.rpy:2144
translate portuguese ep025_erigone_grove_0e750d6d:

    # c "Nope!"
    c "Não mesmo!"

# game/episode025.rpy:2146
translate portuguese ep025_erigone_grove_9cf18b47:

    # "Raene’s interruption had killed the mood somewhat."
    "A interrupção de Raene meio que acabou com o clima."

# game/episode025.rpy:2147
translate portuguese ep025_erigone_grove_7b8d6cbc:

    # "We were both suddenly very aware that we were surrounded by Acarhyn who could walk in on us, or hear us at the very least."
    "De repente percebemos que estávamos cercados por Acarhyn que podiam aparecer a qualquer hora, ou no mínimo nos ouvir."

# game/episode025.rpy:2148
translate portuguese ep025_erigone_grove_7b9e9bd8:

    # "Eva and I opted for a leisurely swim and enjoying the relative peace and quiet for about an hour."
    "Eu e Eva optamos por uma nadada básica e aproveitamos a relativa paz e quietude por mais ou menos uma hora."

# game/episode025.rpy:2151
translate portuguese ep025_erigone_grove_9095f7e8:

    # "We then headed back to the Citadel and the daily worries."
    "Aí voltamos para a Cidadela e as preocupações de sempre."

# game/episode025.rpy:2153
translate portuguese ep025_erigone_grove_b060eca6:

    # "We then headed back to the Shipyards and the daily worries."
    "Aí voltamos para as Docas e as preocupações de sempre."

# game/episode025.rpy:2163
translate portuguese ep025_erigone_thyia_087f7784:

    # "Thyia rushed into my quarters right before we were to head out on the Bastard."
    "Thyia veio correndo no meu quarto pouco antes de irmos embora na Bastarda."

# game/episode025.rpy:2164
translate portuguese ep025_erigone_thyia_99174a9e:

    # th "[p_name_short]!"
    th "[p_name_short]!"

# game/episode025.rpy:2169
translate portuguese ep025_erigone_thyia_b692e7c6:

    # th "I wanted to catch you before we meet up with the rest of the crew."
    th "Queria falar com você antes da reunião com o resto do pessoal."

# game/episode025.rpy:2170
translate portuguese ep025_erigone_thyia_81bd4fc0:

    # c "Is everything all right?"
    c "Está tudo certo?"

# game/episode025.rpy:2171
translate portuguese ep025_erigone_thyia_a73c59c9:

    # th "Yes, I’m great!"
    th "Sim, estou ótima!"

# game/episode025.rpy:2172
translate portuguese ep025_erigone_thyia_c54d5ac4:

    # th "[p_name_short], I’m pregnant!"
    th "[p_name_short], eu estou grávida!"

# game/episode025.rpy:2180
translate portuguese ep025_erigone_thyia_bfc58ed0:

    # "I took Thyia in my arms and kissed her."
    "Eu abracei Thyia e a beijei."

# game/episode025.rpy:2181
translate portuguese ep025_erigone_thyia_294a14ec:

    # c "I’m so happy for us!"
    c "Estou tão feliz pela gente!"

# game/episode025.rpy:2182
translate portuguese ep025_erigone_thyia_e7b05aa3:

    # c "Did you find out today?"
    c "Você ficou sabendo hoje?"

# game/episode025.rpy:2187
translate portuguese ep025_erigone_thyia_4f7d1f6d:

    # th "Yes, I did a test and came as soon as I had the results."
    th "Sim, fiz um teste e vim assim que vi o resultado."

# game/episode025.rpy:2188
translate portuguese ep025_erigone_thyia_31c65f6b:

    # th "You can’t imagine how happy I am right now!"
    th "Você não imagina como eu estou feliz agora!"

# game/episode025.rpy:2189
translate portuguese ep025_erigone_thyia_0fff20cd:

    # c "Well, I have an idea."
    c "Bom, tenho certa ideia."

# game/episode025.rpy:2190
translate portuguese ep025_erigone_thyia_aaa71be3:

    # c "Wow, Thyia."
    c "Nossa, Thyia."

# game/episode025.rpy:2191
translate portuguese ep025_erigone_thyia_6faf9a48:

    # c "I certainly didn’t think we’d end up here when I first walked into your workshop."
    c "Eu não esperava que a gente fosse parar aqui quando apareci na sua oficina."

# game/episode025.rpy:2196
translate portuguese ep025_erigone_thyia_3527b82e:

    # th "Me neither."
    th "Nem eu."

# game/episode025.rpy:2201
translate portuguese ep025_erigone_thyia_1a0d3ff2:

    # th "Though you were a great lay, even then."
    th "Mas mesmo naquela época, você foi ótimo na cama."

# game/episode025.rpy:2202
translate portuguese ep025_erigone_thyia_c5b5e2f0:

    # c "Well, thanks, I guess."
    c "Poxa, obrigado né."

# game/episode025.rpy:2203
translate portuguese ep025_erigone_thyia_8b3783c9:

    # c "Are you sure you want to go out there today?"
    c "Tem certeza que quer sair hoje?"

# game/episode025.rpy:2204
translate portuguese ep025_erigone_thyia_2199d990:

    # c "Things could get dangerous."
    c "Pode ser perigoso."

# game/episode025.rpy:2209
translate portuguese ep025_erigone_thyia_438f1a42:

    # th "Of course I’m coming along."
    th "Claro que eu vou junto."

# game/episode025.rpy:2210
translate portuguese ep025_erigone_thyia_8dcc99bb:

    # th "We’ve faced far worse."
    th "A gente já encarou coisa muito pior."

# game/episode025.rpy:2211
translate portuguese ep025_erigone_thyia_a000cb6c:

    # th "Just promise me we’ll celebrate afterward."
    th "Só promete que depois vamos comemorar."

# game/episode025.rpy:2212
translate portuguese ep025_erigone_thyia_420ed5ed:

    # c "Of course we will!"
    c "Pode apostar que sim!"

# game/episode025.rpy:2213
translate portuguese ep025_erigone_thyia_3320a95b:

    # c "You’ve made me a very happy man."
    c "Você me fez um homem muito feliz."

# game/episode025.rpy:2218
translate portuguese ep025_erigone_thyia_ebb6a693:

    # th "I know, I’m over the moon too!"
    th "Eu sei, também estou nas nuvens!"

# game/episode025.rpy:2223
translate portuguese ep025_erigone_thyia_4116f27b:

    # "Figuring we had a moment before we needed to go back to the Bastard, Thyia and I fell on my bed."
    "Já que tínhamos um tempinho até precisar voltar para a Bastarda, eu e Thyia pulamos na cama."

# game/episode025.rpy:2224
translate portuguese ep025_erigone_thyia_08c8a242:

    # th "I never would have thought becoming a mother was in the cards for me."
    th "Nunca imaginei que um dia eu seria mãe."

# game/episode025.rpy:2225
translate portuguese ep025_erigone_thyia_a018ec5a:

    # c "Now all I have to arrange is that wedding in a white dress."
    c "Agora só preciso arranjar o casamento e vestido branquinho."

# game/episode025.rpy:2226
translate portuguese ep025_erigone_thyia_9c184efd:

    # th "Don’t joke about that, I was very serious about that when I was six years old."
    th "Não brinca com isso, eu levava isso super a sério quando tinha uns 6."

# game/episode025.rpy:2227
translate portuguese ep025_erigone_thyia_374b1df4:

    # c "Who says I’m joking?"
    c "Quem disse que é brincadeira?"

# game/episode025.rpy:2228
translate portuguese ep025_erigone_thyia_b5e13411:

    # th "I’ll believe it when you put a ring on my finger."
    th "Só acredito quando botar um anel no meu dedo."

# game/episode025.rpy:2229
translate portuguese ep025_erigone_thyia_b7f4b180:

    # c "Noted."
    c "Saquei."

# game/episode025.rpy:2234
translate portuguese ep025_erigone_thyia_63804e0e:

    # "We were silent for a while, kissing intermittently."
    "Ficamos um tempo em silêncio, beijando de vez em quando."

# game/episode025.rpy:2239
translate portuguese ep025_erigone_thyia_45fbdaf6:

    # c "How did U.R.G.H. take the news?"
    c "Como que o A.F.F. recebeu a notícia?"

# game/episode025.rpy:2244
translate portuguese ep025_erigone_thyia_497cb3b0:

    # th "I haven’t told him yet."
    th "Ainda não contei para ele."

# game/episode025.rpy:2245
translate portuguese ep025_erigone_thyia_9d145fe1:

    # th "But I’m sure he’ll be one happy robot uncle."
    th "Mas aposto que vai ser ficar feliz de ser um tio robô."

# game/episode025.rpy:2246
translate portuguese ep025_erigone_thyia_82527de3:

    # c "Maybe he can suggest some baby names?"
    c "Talvez ele poderia sugerir nomes para o bebê?"

# game/episode025.rpy:2247
translate portuguese ep025_erigone_thyia_df458003:

    # th "If you want to call your future child by an acronym, sure go ahead."
    th "Se você quiser que o nome do nosso futuro bebê de uma sigla, vá em frente."

# game/episode025.rpy:2252
translate portuguese ep025_erigone_thyia_2ec64e18:

    # "I kissed Thyia’s smiling face as I stroked the soft skin of her belly where our child was slowly growing."
    "Eu beijei o rosto sorridente da Thyia e acariciei sua barriguinha onde o nosso bebê crescia aos poucos."

# game/episode025.rpy:2258
translate portuguese ep025_erigone_thyia_8881d68c:

    # c "Guess we should see how the others are doing."
    c "Bom, melhor ver o que os outros estão fazendo."

# game/episode025.rpy:2259
translate portuguese ep025_erigone_thyia_88a83eb9:

    # th "I guess so."
    th "Verdade."

# game/episode025.rpy:2265
translate portuguese ep025_citadel_rahia_9debba44:

    # "Rahia sent me a message after the council meeting."
    "Rahia me enviou uma mensagem depois da reunião do conselho."

# game/episode025.rpy:2266
translate portuguese ep025_citadel_rahia_203aab11:

    # "She invited me to her quarters for drinks."
    "Ela me convidou para seu quarto para beber."

# game/episode025.rpy:2268
translate portuguese ep025_citadel_rahia_985bde48:

    # rah "There you are."
    rah "Aí está."

# game/episode025.rpy:2269
translate portuguese ep025_citadel_rahia_e1c69249:

    # rah "Have a seat while I fetch us something to drink."
    rah "Senta, vou pegar alguma coisa para beber."

# game/episode025.rpy:2271
translate portuguese ep025_citadel_rahia_1a3b2fbf:

    # "I had settled on one of the chairs as Rahia handed me a drink."
    "Eu sentei numa cadeira e Rahia me deu um drink."

# game/episode025.rpy:2272
translate portuguese ep025_citadel_rahia_c7c59c2a:

    # rah "I must confess, I didn’t think you’d all be back here."
    rah "Sinceramente, não achei que você voltaria aqui."

# game/episode025.rpy:2274
translate portuguese ep025_citadel_rahia_efa9590e:

    # c "My sister is Queen of Erigone after all."
    c "A minha irmã é a Rainha de Erigone, né."

# game/episode025.rpy:2276
translate portuguese ep025_citadel_rahia_0ba31678:

    # c "Eva is Queen of Erigone after all."
    c "Eva é a Rainha de Erigone, né."

# game/episode025.rpy:2277
translate portuguese ep025_citadel_rahia_55d312af:

    # rah "Sure, but we all know she didn’t choose this life and is a reluctant participant at best."
    rah "Sim, mas todos sabemos que ela não escolheu essa vida, e no máximo participa contra a vontade."

# game/episode025.rpy:2278
translate portuguese ep025_citadel_rahia_de30e703:

    # c "I won’t argue that."
    c "Não vou negar."

# game/episode025.rpy:2279
translate portuguese ep025_citadel_rahia_4501725b:

    # c "But the situation with the Sovereignty is desperate."
    c "Mas a situação com a Soberania está desesperadora."

# game/episode025.rpy:2281
translate portuguese ep025_citadel_rahia_c8ae4ae3:

    # rah "So I’ve heard."
    rah "Fiquei sabendo."

# game/episode025.rpy:2282
translate portuguese ep025_citadel_rahia_3cd694c4:

    # rah "The intelligence reports I have received so far are very worrying."
    rah "Nossos relatórios de inteligência que recebi até agora são preocupantes."

# game/episode025.rpy:2283
translate portuguese ep025_citadel_rahia_e5b2e1aa:

    # rah "The Sovereignty has taken many systems by surprise and even where there’s organized resistance they just steamroll over the defenders."
    rah "A Soberania pegou vários sistemas de surpresa. Até onde tem resistência organizada eles acabam com todas as defesas."

# game/episode025.rpy:2284
translate portuguese ep025_citadel_rahia_6da4cc39:

    # c "Their advance must falter at some point and we aim to be the wrench to jam those proverbial gears."
    c "Esse avanço deles tem que dar uma reduzida eventualmente, e estamos esperando esse momento para arruinar os planos deles."

# game/episode025.rpy:2287
translate portuguese ep025_citadel_rahia_e722ddfd:

    # rah "You’re all but certain of the support of the Warrior caste."
    rah "Você já tem o apoio das Guerreiras praticamente garantido."

# game/episode025.rpy:2288
translate portuguese ep025_citadel_rahia_c6b178a5:

    # c "If the civil war is won in our favor."
    c "Se a gente ganhar essa guerra civil."

# game/episode025.rpy:2290
translate portuguese ep025_citadel_rahia_48101fb8:

    # rah "Yes, that will be the deciding factor."
    rah "Sim, esse vai ser o fator decisivo."

# game/episode025.rpy:2291
translate portuguese ep025_citadel_rahia_f217913a:

    # rah "But if we lose, I don’t think Erigone will be a hospitable home to the Warrior caste any longer."
    rah "Mas se perdermos, acho que Erigone não seria mais um local acolhedor para as Guerreiras."

# game/episode025.rpy:2292
translate portuguese ep025_citadel_rahia_bdea6038:

    # rah "What remains of the Warriors will join your cause in any event."
    rah "O que restar da caste apoiaria a sua causa de qualquer forma."

# game/episode025.rpy:2295
translate portuguese ep025_citadel_rahia_fe2ff987:

    # rah "I must warn you, the support of the Warrior caste is built on a shaky foundation."
    rah "Mas devo avisar, o apoio das Guerreiras não é tão sólido."

# game/episode025.rpy:2296
translate portuguese ep025_citadel_rahia_d2651920:

    # rah "The civilians have spoken in your favor."
    rah "A população ficou a seu favor."

# game/episode025.rpy:2297
translate portuguese ep025_citadel_rahia_3d533b14:

    # rah "It’s thanks to their lobbying that we have agreed to help your alliance against the Sovereignty."
    rah "É graças ao apoio delas que decidimos apoiar sua aliança contra a Soberania."

# game/episode025.rpy:2298
translate portuguese ep025_citadel_rahia_d6e7093f:

    # c "This is because I went into the Hunt as a free agent?"
    c "Isso porque eu decidi participar da Caçada sem tomar um lado?"

# game/episode025.rpy:2300
translate portuguese ep025_citadel_rahia_2242ea58:

    # rah "Yes."
    rah "Sim."

# game/episode025.rpy:2301
translate portuguese ep025_citadel_rahia_3b539bdc:

    # rah "Your unwillingness to ally with a faction has raised questions about your dedication to the Acarhyn, and by extension, Our Queen’s."
    rah "A sua relutância para se aliar com uma facção levantou questionamentos sobre a sua dedicação às Acarhyn, e por consequência, a Nossa Rainha."

# game/episode025.rpy:2302
translate portuguese ep025_citadel_rahia_5c14ecc1:

    # c "As you said before, my sister is a reluctant Queen at best, but that doesn’t mean she won’t stand up to defend the wellbeing of the Acarhyn."
    c "Como você disse, a minha irmã é no máximo uma Rainha contra a própria vontade, mas não quer dizer que ela não vá defender o bem-estar das Acarhyn."

# game/episode025.rpy:2303
translate portuguese ep025_citadel_rahia_01390aaa:

    # c "Eva is one of the most compassionate and responsible people I’ve known."
    c "Eva é uma das pessoas mais compreensíveis e responsáveis que eu conheço."

# game/episode025.rpy:2305
translate portuguese ep025_citadel_rahia_172cba37:

    # c "Frankly, it’s disconcerting that she’s the offspring of Agust, because our father is anything but compassionate."
    c "Sinceramente, é triste que ela é filha do Agust, porque o nosso pai é tudo menos compreensivo."

# game/episode025.rpy:2306
translate portuguese ep025_citadel_rahia_056aab39:

    # c "She takes after our mother, I suppose."
    c "Acho que ela puxou da nossa mãe."

# game/episode025.rpy:2308
translate portuguese ep025_citadel_rahia_8d8b0a55:

    # rah "I’m sure being her brother accounts for a large portion of your good opinion of Our Queen."
    rah "Eu imagino que ser irmão dela é grande parte da sua opinião de nossa Rainha."

# game/episode025.rpy:2309
translate portuguese ep025_citadel_rahia_778e96fa:

    # rah "Nevertheless, I have seen the qualities you describe and I’m sure they’ll have a positive bearing on how the Warrior caste will evaluate their contribution to your proposed alliance."
    rah "De qualquer forma, eu vejo as qualidades que você descreve, e tenho certeza que terão um efeito positivo em como a caste Guerreira avalia a própria contribuição à aliança que você propôs."

# game/episode025.rpy:2312
translate portuguese ep025_citadel_rahia_6c1cb0e5:

    # rah "I too have seen the qualities you describe and I’m sure they’ll have a positive bearing on how the Warrior caste will evaluate their contribution to your proposed alliance."
    rah "Eu também vejo as qualidades que você descreve, e tenho certeza que terão um efeito positivo em como a caste Guerreira avalia a própria contribuição à aliança que você propôs."

# game/episode025.rpy:2313
translate portuguese ep025_citadel_rahia_b9aa15aa:

    # c "I’m happy to hear that."
    c "Muito bom saber disso."

# game/episode025.rpy:2315
translate portuguese ep025_citadel_rahia_ba4086f9:

    # c "I noticed you didn’t mention Eva’s pregnancy during the council meeting."
    c "Percebi que você não falou da gravidez da Eva na reunião do conselho."

# game/episode025.rpy:2317
translate portuguese ep025_citadel_rahia_69722e27:

    # rah "I have congratulated Her Majesty in private and I’m sure many Acarhyn have done so as well."
    rah "Eu parabenizei a Majestade em particular, e imagino que várias Acarhyn também devem ter feito."

# game/episode025.rpy:2318
translate portuguese ep025_citadel_rahia_10c95f7a:

    # rah "Other than that, her pregnancy is a private matter."
    rah "Tirando isso, sua gravidez é um assunto privado."

# game/episode025.rpy:2319
translate portuguese ep025_citadel_rahia_78882bb1:

    # c "So the fact that her title isn’t really all that accurate any longer won’t be a problem?"
    c "Então o fato do título dela não estar mais tão correto não vai ser problema?"

# game/episode025.rpy:2320
translate portuguese ep025_citadel_rahia_b19e1ece:

    # rah "That only mattered when Our Queen ascended the throne, now it’s of no consequence."
    rah "Isso só importou quando Nossa Rainha subiu ao trono, agora não importa mais."

# game/episode025.rpy:2321
translate portuguese ep025_citadel_rahia_b97b9b35:

    # rah "Purely a private matter, as I said."
    rah "Como eu disse, é um assunto privado."

# game/episode025.rpy:2322
translate portuguese ep025_citadel_rahia_35d51394:

    # c "I thought Acarhyn pregnancies were commonly celebrated openly, because they’re so rare."
    c "Eu pensei que as Acarhyn comemoravam publicamente a gravidez, porque são tão raras."

# game/episode025.rpy:2323
translate portuguese ep025_citadel_rahia_f0e5acb2:

    # rah "Yes, they are."
    rah "Sim, e são."

# game/episode025.rpy:2325
translate portuguese ep025_citadel_rahia_af28d272:

    # rah "But our Queen is not of Acarhyn progeny, as it was written in our sacred texts."
    rah "Mas a Rainha não tem o sangue Acarhyn, como previsto nas nossas escrituras sagradas."

# game/episode025.rpy:2326
translate portuguese ep025_citadel_rahia_1601a205:

    # rah "The birth of the Queen’s child will be celebrated of course and it will receive the respect it is due."
    rah "Claro, o nascimento do bebê da Rainha será comemorado e receberá o devido respeito."

# game/episode025.rpy:2327
translate portuguese ep025_citadel_rahia_69fe7104:

    # rah "The Queen’s child will however not inherit Her titles."
    rah "Mas a filha da Rainha não pode herdar seus títulos."

# game/episode025.rpy:2328
translate portuguese ep025_citadel_rahia_aef0feab:

    # rah "The Scriptures proscribe that we will need to find a new Queen when the sad day when our current Queen passes away arrives."
    rah "A Escritura dita que vamos precisar encontrar uma nova Rainha quando o triste dia que a nossa atual Rainha morrer."

# game/episode025.rpy:2329
translate portuguese ep025_citadel_rahia_89aefe22:

    # c "I see."
    c "Entendi."

# game/episode025.rpy:2330
translate portuguese ep025_citadel_rahia_443f11ca:

    # c "Let’s hope that day is very far away."
    c "Tomara que esse dia esteja longe."

# game/episode025.rpy:2332
translate portuguese ep025_citadel_rahia_b32cc4ce:

    # rah "Yes, indeed."
    rah "Sim, realmente."

# game/episode025.rpy:2333
translate portuguese ep025_citadel_rahia_d5ef88c1:

    # rah "But I believe I must congratulate you as well?"
    rah "Mas acredito que tenho que te parabenizar também?"

# game/episode025.rpy:2334
translate portuguese ep025_citadel_rahia_2bea3f61:

    # rah "You are the father of the Queen’s child, are you not?"
    rah "Você é o pai da criança da Rainha, não é?"

# game/episode025.rpy:2335
translate portuguese ep025_citadel_rahia_36391c9b:

    # c "Yes, I am."
    c "Sou sim."

# game/episode025.rpy:2337
translate portuguese ep025_citadel_rahia_a8dc6197:

    # rah "Congratulations!"
    rah "Parabéns!"

# game/episode025.rpy:2339
translate portuguese ep025_citadel_rahia_6b36c4a3:

    # rah "Our Queen has chosen a strong and formidable father for Her child and a ensured pure bloodline."
    rah "A Rainha escolheu um pai forte e formidável para sua criança, garantindo uma linhagem pura."

# game/episode025.rpy:2341
translate portuguese ep025_citadel_rahia_931264ac:

    # rah "Our Queen has chosen a strong and formidable father for Her child."
    rah "A Rainha escolheu um pai forte e formidável para sua criança."

# game/episode025.rpy:2342
translate portuguese ep025_citadel_rahia_e897fbb0:

    # c "Thank you."
    c "Obrigado."

# game/episode025.rpy:2343
translate portuguese ep025_citadel_rahia_1f242f46:

    # "Rahia poured me another drink and toasted to Eva and me."
    "Rahia encheu mais um drink para mim e fez um brinde a Eva e eu."

# game/episode025.rpy:2344
translate portuguese ep025_citadel_rahia_a9acc340:

    # c "Are you confident about coming strike against the Priest caste?"
    c "Você está confiante nesse ataque contra as Sacerdotisas?"

# game/episode025.rpy:2346
translate portuguese ep025_citadel_rahia_3f0d6424:

    # rah "Yes, of course."
    rah "Sim, claro."

# game/episode025.rpy:2347
translate portuguese ep025_citadel_rahia_46238996:

    # rah "Otherwise the proposal wouldn’t have been presented at the council meeting."
    rah "Caso contrário, a proposta não teria sido apresentada na reunião do conselho."

# game/episode025.rpy:2348
translate portuguese ep025_citadel_rahia_d8da34fc:

    # rah "This battle will be divisive and I have every reason to believe we’ll prevail against the Priests."
    rah "Essa batalha vai ser decisiva, e tenho muito motivo para acreditar que vamos ganhar das Sacerdotisas."

# game/episode025.rpy:2349
translate portuguese ep025_citadel_rahia_0ad27cb3:

    # c "I got a feeling that Erigone was a powder keg right from the start."
    c "Eu tenho a leve sensação que Erigone já era um vespeiro desde o começo."

# game/episode025.rpy:2351
translate portuguese ep025_citadel_rahia_baff7580:

    # rah "You’re not wrong."
    rah "Você não está errado."

# game/episode025.rpy:2352
translate portuguese ep025_citadel_rahia_106905b7:

    # c "Erylin’s betrayal must have weakened the Priest caste?"
    c "A traição da Erylin deve ter enfraquecido as Sacerdotisas?"

# game/episode025.rpy:2354
translate portuguese ep025_citadel_rahia_6713b367:

    # rah "So we thought at first."
    rah "Foi o que pensamos no começo."

# game/episode025.rpy:2356
translate portuguese ep025_citadel_rahia_c8261e9f:

    # rah "But her daughter has proven to be a formidable foe."
    rah "Mas sua filha demonstrou ser uma inimiga formidável."

# game/episode025.rpy:2358
translate portuguese ep025_citadel_rahia_72758bbd:

    # rah "But her acolyte has proven to be a formidable foe."
    rah "Mas sua assistente demonstrou ser uma inimiga formidável."

# game/episode025.rpy:2359
translate portuguese ep025_citadel_rahia_a3891dd8:

    # rah "Keodele combines religious zeal with a surprising intelligence."
    rah "Keodele combina fervor religioso com uma inteligência surpreendente."

# game/episode025.rpy:2361
translate portuguese ep025_citadel_rahia_545c809a:

    # rah "I guess those qualities didn’t blossom in her mother’s shadow."
    rah "Acho que essas qualidades não surgiram na sombra da mãe."

# game/episode025.rpy:2363
translate portuguese ep025_citadel_rahia_103c4b9b:

    # rah "I guess those qualities didn’t blossom in her mistress’s shadow."
    rah "Acho que essas qualidades não surgiram na sombra da chefe."

# game/episode025.rpy:2364
translate portuguese ep025_citadel_rahia_8973c4b6:

    # c "You respect her?"
    c "Você respeita ela?"

# game/episode025.rpy:2366
translate portuguese ep025_citadel_rahia_3edece7f:

    # rah "I do."
    rah "Sim."

# game/episode025.rpy:2367
translate portuguese ep025_citadel_rahia_e2a290d6:

    # rah "Though that doesn’t mean I will crush her without a second thought."
    rah "Mas isso não quer dizer que não vou acabar com ela sem pestanejar."

# game/episode025.rpy:2368
translate portuguese ep025_citadel_rahia_ff53a985:

    # c "That’s the spirit!"
    c "Assim que eu gosto!"

# game/episode025.rpy:2370
translate portuguese ep025_citadel_rahia_98af0a72:

    # "Rahia grinned at me and lifted her glass in a mock toast."
    "Rahia sorriu e levantou sua taça fingindo um brinde."

# game/episode025.rpy:2372
translate portuguese ep025_citadel_rahia_7900f151:

    # "We drank in silence for a while."
    "Nós bebemos em silêncio por um tempo."

# game/episode025.rpy:2373
translate portuguese ep025_citadel_rahia_1f022f28:

    # c "How have you been these past few months?"
    c "Como você tem passado esses meses?"

# game/episode025.rpy:2374
translate portuguese ep025_citadel_rahia_a1b29e56:

    # c "We didn’t have a chance to speak after our escape from the Citadel."
    c "Não tivemos a chance de conversar depois que a gente escapou da Cidadela."

# game/episode025.rpy:2376
translate portuguese ep025_citadel_rahia_9e72ccb6:

    # rah "Yes, that was a close one."
    rah "Sim, aquilo foi por pouco."

# game/episode025.rpy:2377
translate portuguese ep025_citadel_rahia_8255f750:

    # c "I was afraid you hadn’t survived that ambush."
    c "Eu estava preocupado que você não tinha sobrevivido a emboscada."

# game/episode025.rpy:2379
translate portuguese ep025_citadel_rahia_bd378a86:

    # rah "It takes more than a few Priests with guns to kill me."
    rah "Precisaria de mais de umas Sacerdotisas com armas para me matar."

# game/episode025.rpy:2380
translate portuguese ep025_citadel_rahia_fcfe0ac7:

    # c "So it would seem."
    c "É o que parece."

# game/episode025.rpy:2382
translate portuguese ep025_citadel_rahia_12265739:

    # rah "After that, it has been a constant effort to keep the Priest caste at bay."
    rah "Desde então, foi um esforço constante só manter as Sacerdotisas sob controle."

# game/episode025.rpy:2383
translate portuguese ep025_citadel_rahia_2ada6bcf:

    # rah "We never reached the Shipyards, though I’m glad to hear you managed to get there in time."
    rah "Nós nunca chegamos nas Docas, mas ainda bem que você conseguiu chegar a tempo."

# game/episode025.rpy:2384
translate portuguese ep025_citadel_rahia_b8c01745:

    # rah "After you left, the complex was completely overrun by the Priests."
    rah "Depois que você foi embora, o lugar foi completamente tomado pelas Sacerdotisas."

# game/episode025.rpy:2386
translate portuguese ep025_citadel_rahia_2def532e:

    # rah "We were forced to retreat back to the Citadel and regroup."
    rah "Fomos forçadas a recuar até a Cidadela e reagrupar."

# game/episode025.rpy:2387
translate portuguese ep025_citadel_rahia_71834c88:

    # rah "It seems the operation to retake Aegisthus Shipyards took a lot from the Priest caste, because the following weeks were relatively uneventful."
    rah "Parece que a operação para retomar as Docas Aegisthus custou muito para as Sacerdotisas, visto que as semanas seguintes foram bem tranquilas."

# game/episode025.rpy:2388
translate portuguese ep025_citadel_rahia_9fdc8492:

    # rah "That allowed us to rebuild our defences and plan our next move."
    rah "Isso permitiu que reconstruíssemos nossas defesas e planejar a próxima parte do plano."

# game/episode025.rpy:2389
translate portuguese ep025_citadel_rahia_5863eac4:

    # rah "From that moment on, we’ve been engaged in one skirmish after another."
    rah "Desse momento em diante, nós acabamos travando uma batalha depois da outra."

# game/episode025.rpy:2390
translate portuguese ep025_citadel_rahia_0cceddc1:

    # rah "The planned battle should break the Priest caste once and for all."
    rah "A batalha que planejamos deve acabar de uma vez com as Sacerdotisas."

# game/episode025.rpy:2394
translate portuguese ep025_citadel_rahia_5151b780:

    # c "Is there anything we could do to help?"
    c "Tem algo que a gente pode fazer para ajudar?"

# game/episode025.rpy:2396
translate portuguese ep025_citadel_rahia_e98a264f:

    # c "I really hope you do."
    c "Tomara que sim."

# game/episode025.rpy:2397
translate portuguese ep025_citadel_rahia_1f6dc7f5:

    # c "Good luck, Rahia."
    c "Boa sorte, Rahia."

# game/episode025.rpy:2399
translate portuguese ep025_citadel_rahia_8aa92628:

    # rah "Thank you."
    rah "Obrigada."

# game/episode025.rpy:2401
translate portuguese ep025_citadel_rahia_275b766b:

    # rah "I would like to request a favor."
    rah "Eu gostaria de pedir um favor."

# game/episode025.rpy:2402
translate portuguese ep025_citadel_rahia_24c7ada5:

    # c "Yes?"
    c "Sim?"

# game/episode025.rpy:2404
translate portuguese ep025_citadel_rahia_18162f24:

    # rah "We have some air support available, but most of it was stationed at the Shipyards."
    rah "Temos suporte aéreo, mas a maioria estava nas Docas."

# game/episode025.rpy:2405
translate portuguese ep025_citadel_rahia_2acaadf4:

    # c "So the Priests now control it?"
    c "Então estão sob controle das Sacerdotisas?"

# game/episode025.rpy:2406
translate portuguese ep025_citadel_rahia_dd8ffa8a:

    # rah "We managed to sabotage a great deal of the fleet, so we’re more or less evenly matched."
    rah "Conseguimos sabotar boa parte da frota, então estamos mais ou menos iguais."

# game/episode025.rpy:2407
translate portuguese ep025_citadel_rahia_37c8a675:

    # rah "Your assistance from the air could prove vital though."
    rah "Mas a sua assistência aérea poderia ser vital."

# game/episode025.rpy:2408
translate portuguese ep025_citadel_rahia_a85e3f0a:

    # c "You’re asking me to risk the Bastard?"
    c "Você está pedindo para eu arriscar a Bastarda?"

# game/episode025.rpy:2410
translate portuguese ep025_citadel_rahia_a4d95c53:

    # rah "Yes, I am."
    rah "Estou."

# game/episode025.rpy:2411
translate portuguese ep025_citadel_rahia_1fbaeba0:

    # rah "There are some parts of the operation where your ship could play a vital role."
    rah "Tem certas partes da operação que sua nave poderia ter um papel importantíssima."

# game/episode025.rpy:2412
translate portuguese ep025_citadel_rahia_c83a9ff0:

    # rah "Needless to say, any support would mean a great deal to the Warrior caste and for the battles to come."
    rah "Óbvio, qualquer apoio seria muito importante para as Guerreiras e as batalhas à frente."

# game/episode025.rpy:2413
translate portuguese ep025_citadel_rahia_c2653538:

    # c "We’d build up some credit with you."
    c "Vamos ter uma moral com vocês."

# game/episode025.rpy:2415
translate portuguese ep025_citadel_rahia_900ebd7a:

    # rah "Yes, to put it bluntly."
    rah "Falando mais diretamente, sim."

# game/episode025.rpy:2416
translate portuguese ep025_citadel_rahia_a3b94c44:

    # c "I’ll talk with the crew, but I think we might be able to help."
    c "Vou conversar com a tripulação, mas acho que podemos dar uma ajuda."

# game/episode025.rpy:2418
translate portuguese ep025_citadel_rahia_605349a6:

    # rah "Good, once you’ve confirmed everything, I’ll have my team reach out to your pilot and engineer."
    rah "Ótimo, quando conseguir confirmar, meu time vai entrar em contato com sua piloto e engenheira."

# game/episode025.rpy:2419
translate portuguese ep025_citadel_rahia_d7009c60:

    # c "I’ll let you know as soon as I’ve spoken to them."
    c "Eu te aviso assim que falar com elas."

# game/episode025.rpy:2423
translate portuguese ep025_citadel_rahia_c4569f55:

    # rah "Good, the sooner we know, the better."
    rah "Que bom. Quanto mais cedo, melhor."

# game/episode025.rpy:2424
translate portuguese ep025_citadel_rahia_98d23f61:

    # c "Understood, though there’s time for another drink, isn’t there?"
    c "Entendido. Mas você teria tempo para outro drink?"

# game/episode025.rpy:2425
translate portuguese ep025_citadel_rahia_8957a449:

    # rah "Certainly."
    rah "Certamente."

# game/episode025.rpy:2427
translate portuguese ep025_citadel_rahia_a535112c:

    # "Rahia poured another measure and we toasted."
    "Rahia encheu outro drink e nós brindamos."

# game/episode025.rpy:2428
translate portuguese ep025_citadel_rahia_2c68d665:

    # c "To Erigone!"
    c "A Erigone"

# game/episode025.rpy:2429
translate portuguese ep025_citadel_rahia_030dc579:

    # rah "To Erigone!"
    rah "A Erigone!"

# game/episode025.rpy:2431
translate portuguese ep025_citadel_rahia_7d46a611:

    # "Rahia sighed and stared into the candle flames."
    "Rahia suspirou e olhou para a chama das velas."

# game/episode025.rpy:2432
translate portuguese ep025_citadel_rahia_ba49644f:

    # c "Now that’s one world-weary sigh!"
    c "Nossa, que suspiro cansado esse!"

# game/episode025.rpy:2434
translate portuguese ep025_citadel_rahia_30e09462:

    # rah "I know..."
    rah "Eu sei..."

# game/episode025.rpy:2435
translate portuguese ep025_citadel_rahia_d52fda1e:

    # rah "The past few months have just been a string of meetings, battles and more meetings."
    rah "Esses meses têm sido reunião após reunião, lutas e depois mais reuniões."

# game/episode025.rpy:2436
translate portuguese ep025_citadel_rahia_604cb9e8:

    # rah "No time to really rest."
    rah "Não tem tempo para descansar."

# game/episode025.rpy:2437
translate portuguese ep025_citadel_rahia_cb5ac097:

    # c "I thought you warriors lived for this kind of thing?"
    c "Eu pensei que vocês guerreiras viviam para isso?"

# game/episode025.rpy:2438
translate portuguese ep025_citadel_rahia_80c34c24:

    # c "The thrill of the fight and all that?"
    c "A emoção da batalha e tal?"

# game/episode025.rpy:2440
translate portuguese ep025_citadel_rahia_dc0be4cd:

    # rah "To an extent, yes."
    rah "De certa forma, sim."

# game/episode025.rpy:2441
translate portuguese ep025_citadel_rahia_5ee7a71c:

    # rah "But you need other experiences to contrast that feeling."
    rah "Mas as pessoas precisam de outras experiências diferentes dessa sensação."

# game/episode025.rpy:2442
translate portuguese ep025_citadel_rahia_57829623:

    # c "Such as?"
    c "Tipo?"

# game/episode025.rpy:2444
translate portuguese ep025_citadel_rahia_db3e1298:

    # rah "A feast, the pleasure of cleaning your weapons, a good fuck."
    rah "Um banquete, o prazer de limpar suas armas, uma boa transa."

# game/episode025.rpy:2446
translate portuguese ep025_citadel_rahia_89aefe22_1:

    # c "I see."
    c "Entendi."

# game/episode025.rpy:2447
translate portuguese ep025_citadel_rahia_264bcc90:

    # c "I can’t say that cleaning weapons soothes me in any way, but I know a little about those other things..."
    c "Não vou dizer que limpar armas me acalma, mas conheço um pouquinho sobre as outras coisas..."

# game/episode025.rpy:2448
translate portuguese ep025_citadel_rahia_e9208006:

    # rah "I enjoyed our time together when you were first on Erigone."
    rah "Eu gostei do tempo que passamos juntos na sua primeira visita a Erigone."

# game/episode025.rpy:2451
translate portuguese ep025_citadel_rahia_c4274e59:

    # c "As did I."
    c "Também gostei."

# game/episode025.rpy:2452
translate portuguese ep025_citadel_rahia_9db24395:

    # c "There’s no reason why we shouldn’t again."
    c "Não tem por que não fazer de novo."

# game/episode025.rpy:2453
translate portuguese ep025_citadel_rahia_fb6e1766:

    # rah "I was thinking the same thing."
    rah "Eu estava pensando a mesma coisa, sabia?"

# game/episode025.rpy:2456
translate portuguese ep025_citadel_rahia_6d67280f:

    # c "I have fond memories of that too."
    c "Também tenho boas memórias disso."

# game/episode025.rpy:2457
translate portuguese ep025_citadel_rahia_a9fec553:

    # c "Things have changed considerably for me though."
    c "Mas as coisas mudaram bastante para mim."

# game/episode025.rpy:2458
translate portuguese ep025_citadel_rahia_cf42a02f:

    # rah "No need to explain, I understand."
    rah "Não precisa explicar, eu entendo."

# game/episode025.rpy:2459
translate portuguese ep025_citadel_rahia_dd20ffbf:

    # c "Thanks."
    c "Obrigado."

# game/episode025.rpy:2460
translate portuguese ep025_citadel_rahia_15aeab89:

    # c "Another toast then."
    c "Então vamos fazer outro brinde"

# game/episode025.rpy:2463
translate portuguese ep025_citadel_rahia_5935db8e:

    # c "In that case, I’ll propose another toast."
    c "Nesse caso, vou propor outro brinde."

# game/episode025.rpy:2466
translate portuguese ep025_citadel_rahia_c5a9fb6b:

    # c "In fact, I’ll go ask them now."
    c "Aliás, vou perguntar agora."

# game/episode025.rpy:2468
translate portuguese ep025_citadel_rahia_c4569f55_1:

    # rah "Good, the sooner we know, the better."
    rah "Ótimo. Quanto mais cedo soubermos, melhor."

# game/episode025.rpy:2469
translate portuguese ep025_citadel_rahia_c1cfe906:

    # c "Thanks for the drink, Rahia."
    c "Obrigado pelo drink, Rahia."

# game/episode025.rpy:2470
translate portuguese ep025_citadel_rahia_0f81ac82:

    # rah "You’re welcome."
    rah "De nada."

# game/episode025.rpy:2475
translate portuguese ep025_rahia_toast_f5ea2ce8:

    # c "To feasting, fucking and cleaning!"
    c "Um brinde a banquetes, transa e limpeza!"

# game/episode025.rpy:2477
translate portuguese ep025_rahia_toast_83305be6:

    # "Rahia smiled as we clinked glasses and downed our drinks."
    "Rahia sorriu enquanto brindávamos e tomávamos drinks."

# game/episode025.rpy:2478
translate portuguese ep025_rahia_toast_c4e6a284:

    # c "Thanks for the drinks, Rahia."
    c "Obrigado pelos drinks, Rahia."

# game/episode025.rpy:2480
translate portuguese ep025_rahia_toast_0f81ac82:

    # rah "You’re welcome."
    rah "De nada."

# game/episode025.rpy:2481
translate portuguese ep025_rahia_toast_7b8ebafe:

    # c "I’ll inform my crew about the request you’ve made and I’ll let you know our decision."
    c "Vou avisar a tripulação do seu pedido e te aviso da decisão."

# game/episode025.rpy:2482
translate portuguese ep025_rahia_toast_c4569f55:

    # rah "Good, the sooner we know, the better."
    rah "Ótimo. Quanto mais rápido soubermos, melhor."

# game/episode025.rpy:2487
translate portuguese ep025_shipyard_keodele_14f0842c:

    # "Not long after Keodele’s sermon, I received a message from her."
    "Pouco depois do sermão de Keodele, recebi uma mensagem dela."

# game/episode025.rpy:2488
translate portuguese ep025_shipyard_keodele_6028caf0:

    # "The High Priestess wanted to meet me in her quarters to discuss some religious matters."
    "A Sacerdotisa Chefe queria me encontrar nos seus aposentos para discutir uns assuntos religiosos."

# game/episode025.rpy:2489
translate portuguese ep025_shipyard_keodele_b25a9cda:

    # "Not really looking forward to a prayer session, but aware of the negative consequences a refusal might cause, I headed to her rooms."
    "Eu não estava muito a fim de rezar, mas sabia muito bem as consequências que poderiam acontecer se eu recusasse. Então fui nos seus aposentos."

# game/episode025.rpy:2491
translate portuguese ep025_shipyard_keodele_8e9ff71d:

    # "Keodele’s quarters were as spartan as ours, the Priest caste evidently had to adjust quickly when they were forced to make the shipyards their permanent base."
    "Os aposentos da Keodele era tão espartano quanto os outros. Ficou claro que as Sacerdotisas tiveram que se ajustar rapidamente quando foram forçadas a fazer das docas a sua base permanente."

# game/episode025.rpy:2492
translate portuguese ep025_shipyard_keodele_81b14739:

    # keo "[p_name], how good of you to come."
    keo "[p_name], que bom que veio."

# game/episode025.rpy:2493
translate portuguese ep025_shipyard_keodele_f88b5373:

    # keo "I was hoping to speak to you in private."
    keo "Eu estava querendo conversar com você a sós."

# game/episode025.rpy:2494
translate portuguese ep025_shipyard_keodele_77a39991:

    # c "Of course, what’s on your mind?"
    c "Claro. E aí, está pensando no quê?"

# game/episode025.rpy:2496
translate portuguese ep025_shipyard_keodele_bee2f2fe:

    # keo "What do you think of my Brutes?"
    keo "O que você acha das minhas Brutamontes?"

# game/episode025.rpy:2500
translate portuguese ep025_shipyard_keodele_08c6301b:

    # c "I can see their value on the battlefield, but forcing civilians to undergo the changes is completely unethical."
    c "Eu consigo ver o valor delas no campo de batalha, mas forçar civis a essas mudanças não é nada ético."

# game/episode025.rpy:2502
translate portuguese ep025_shipyard_keodele_4769c997:

    # keo "Your sister voiced the same complaints."
    keo "Sua irmã reclamou da mesma coisa."

# game/episode025.rpy:2504
translate portuguese ep025_shipyard_keodele_17eb9c1e:

    # keo "Our Queen voiced the same complaints."
    keo "Nossa Rainha reclamou da mesma coisa."

# game/episode025.rpy:2506
translate portuguese ep025_shipyard_keodele_9e6fa6ea:

    # keo "Dire times ask for desperate measures."
    keo "Tempos difíceis requererem medidas drásticas."

# game/episode025.rpy:2507
translate portuguese ep025_shipyard_keodele_12880e23:

    # c "I’m sure you think that, but it’s a decision that will come to haunt you once all this is over."
    c "Você pode até achar isso, mas é uma decisão que vai te perseguir quando isso acabar."

# game/episode025.rpy:2508
translate portuguese ep025_shipyard_keodele_e1eafa0a:

    # keo "I’ll do my penance once our Creator judges me in the Afterlife."
    keo "Vou pagar pelos meus pecados quando a Criadora me julgar no Além."

# game/episode025.rpy:2511
translate portuguese ep025_shipyard_keodele_7c0d8e3b:

    # c "They’re formidable opponents for sure, and they might just give you an edge on the battlefield."
    c "Elas são inimigas formidáveis, e podem te dar uma vantagem no campo de batalha."

# game/episode025.rpy:2512
translate portuguese ep025_shipyard_keodele_74386315:

    # keo "I just believe they will win the day once we engage in the final battle with the Warriors."
    keo "Acredito que elas trarão vitória na batalha final contra as Guerreiras."

# game/episode025.rpy:2513
translate portuguese ep025_shipyard_keodele_9d5f9eb5:

    # c "Has there been a lot of pushback on recruiting civilians to become Brutes?"
    c "Você recebeu muita reclamação com isso de recrutar civis para transformar em Brutamontes?"

# game/episode025.rpy:2515
translate portuguese ep025_shipyard_keodele_1be1c7d3:

    # keo "Our Queen has strongly voiced her concerns."
    keo "Nossa rainha deixou bem clara a sua preocupação."

# game/episode025.rpy:2516
translate portuguese ep025_shipyard_keodele_2f54e67f:

    # keo "I respect Her opinion, of course, but this is all necessary."
    keo "Claro que respeito Sua opinião, mas isso se faz necessário."

# game/episode025.rpy:2517
translate portuguese ep025_shipyard_keodele_ed665da8:

    # keo "I will take full responsibility for my actions."
    keo "Eu aceitarei minha total responsabilidade."

# game/episode025.rpy:2518
translate portuguese ep025_shipyard_keodele_0e76002e:

    # keo "We need to win this conflict in order to secure the future of the Acarhyn."
    keo "Temos que vencer esse conflito para garantir o futuro das Acarhyn."

# game/episode025.rpy:2519
translate portuguese ep025_shipyard_keodele_78aad86d:

    # keo "With the Brutes, our ground troops are bolstered tremendously."
    keo "Com as Brutamontes, a nossa infantaria ficou muito mais poderosa."

# game/episode025.rpy:2520
translate portuguese ep025_shipyard_keodele_0efdefb5:

    # keo "Our air strike group has recently been weakened by cowardly sabotage by the Warrior caste."
    keo "O nosso batalhão aéreo foi enfraquecido recentemente por uma sabotagem covarde das Guerreiras."

# game/episode025.rpy:2522
translate portuguese ep025_shipyard_keodele_e9ff472f:

    # keo "Your crew and your ship would be a valuable ally in the battle to come."
    keo "Sua tripulação e nave seriam aliados valiosos na batalha que teremos."

# game/episode025.rpy:2523
translate portuguese ep025_shipyard_keodele_46ca07d8:

    # keo "Your support would also be a great incentive to join the alliance against the Sovereignty."
    keo "Seu apoio também serviria de grande incentivo para entrar na aliança contra a Soberania."

# game/episode025.rpy:2524
translate portuguese ep025_shipyard_keodele_89aefe22:

    # c "I see."
    c "Entendi."

# game/episode025.rpy:2525
translate portuguese ep025_shipyard_keodele_a3b94c44:

    # c "I’ll talk with the crew, but I think we might be able to help."
    c "Vou falar com o pessoal, mas acho que podemos ajudar."

# game/episode025.rpy:2527
translate portuguese ep025_shipyard_keodele_54c2cb25:

    # keo "Once you’ve secured your team’s cooperation, I’ll have my Priests reach out to your pilot and engineer."
    keo "Quando garantir a cooperação da sua tripulação, farei as minhas Sacerdotisas entrarem em contanto com sua piloto e engenheira."

# game/episode025.rpy:2528
translate portuguese ep025_shipyard_keodele_d7009c60:

    # c "I’ll let you know as soon as I’ve spoken to them."
    c "Eu te aviso assim que falar com eles."

# game/episode025.rpy:2530
translate portuguese ep025_shipyard_keodele_c40230f2:

    # keo "I’m very happy to hear that."
    keo "Isso me deixa muito feliz."

# game/episode025.rpy:2531
translate portuguese ep025_shipyard_keodele_dbb4454e:

    # keo "I must say that your return was very unexpected, but very welcome."
    keo "Devo dizer que seu retorno foi inesperado, mas bem-vindo."

# game/episode025.rpy:2532
translate portuguese ep025_shipyard_keodele_a0412bcf:

    # keo "We have missed Our Queen and Her return will bolster our resolve."
    keo "Sentimos falta da nossa Rainha, e Seu retorno fortalecerá nossa determinação."

# game/episode025.rpy:2533
translate portuguese ep025_shipyard_keodele_0fae8de8:

    # c "Returning at some point was always in the cards, but the situation with the Sovereignty expedited things considerably."
    c "Voltar sempre foi uma possibilidade, mas a situação com a Soberania apressou bastante as coisas."

# game/episode025.rpy:2534
translate portuguese ep025_shipyard_keodele_2bf9c9ef:

    # keo "I can imagine."
    keo "Imagino."

# game/episode025.rpy:2535
translate portuguese ep025_shipyard_keodele_49611fea:

    # c "I’m glad you think my sister’s presence will be beneficial to morale."
    c "Que bom que você acha que a presença da minha irmã vai ajudar na moral."

# game/episode025.rpy:2537
translate portuguese ep025_shipyard_keodele_ba4086f9:

    # c "I noticed you didn’t mention Eva’s pregnancy during the council meeting."
    c "Percebi que você não mencionou a gravidez da Eva na reunião do conselho."

# game/episode025.rpy:2539
translate portuguese ep025_shipyard_keodele_56a2dc83:

    # keo "Her pregnancy is a private matter, but I have congratulated her of course."
    keo "Sua gravidez é algo privado, mas obviamente a parabenizei."

# game/episode025.rpy:2540
translate portuguese ep025_shipyard_keodele_78882bb1:

    # c "So the fact that her title isn’t really all that accurate any longer won’t be a problem?"
    c "Então o fato do título dela não ser mais tão correto não vai ser um problema?"

# game/episode025.rpy:2541
translate portuguese ep025_shipyard_keodele_4308a8a1:

    # keo "Not at all."
    keo "Nem um pouco."

# game/episode025.rpy:2542
translate portuguese ep025_shipyard_keodele_6bb89801:

    # keo "The Scriptures are very clear on the terms by which Our Queen should ascend the throne."
    keo "As Escrituras são bem claras quanto aos termos pelos quais Nossa Rainha deve subir ao trono."

# game/episode025.rpy:2543
translate portuguese ep025_shipyard_keodele_7fe58b24:

    # keo "It tells us nothing about her status during her reign as Queen."
    keo "Não diz nada sobre o que ela é durante seu reinado como Rainha."

# game/episode025.rpy:2545
translate portuguese ep025_shipyard_keodele_4d8342eb:

    # keo "So, as I said, it’s a private matter."
    keo "Então, como eu disse, é um assunto privado."

# game/episode025.rpy:2546
translate portuguese ep025_shipyard_keodele_35d51394:

    # c "I thought Acarhyn pregnancies were commonly celebrated openly, because they’re so rare."
    c "Achei que gravidez das Acarhyn era comemorada abertamente, visto que são tão raras."

# game/episode025.rpy:2548
translate portuguese ep025_shipyard_keodele_215c23fb:

    # keo "Acarhyn reproduction is a struggle, as intended by our Creator."
    keo "Reprodução paras as Acarhyn é difícil, como determinou nossa Criadora."

# game/episode025.rpy:2549
translate portuguese ep025_shipyard_keodele_54c6266b:

    # keo "It’s a process where we come out stronger, and a successful pregnancy is therefore a cause for celebration."
    keo "É um processo onde saímos mais forte, fazendo uma gravidez de sucesso ser causa para comemoração."

# game/episode025.rpy:2550
translate portuguese ep025_shipyard_keodele_3ffce95e:

    # keo "But our Queen is not of Acarhyn progeny, as it was written in our sacred texts."
    keo "Mas a Rainha não tem o sangue Acarhyn, como previsto nas nossas escrituras sagradas."

# game/episode025.rpy:2551
translate portuguese ep025_shipyard_keodele_1b19fdab:

    # keo "We will of course celebrate the birth of the Queen’s child and we will accord the child the respect it is due."
    keo "Claro que vamos comemorar o nascimento do bebê da Rainha e concederemos à criança o devido respeito."

# game/episode025.rpy:2552
translate portuguese ep025_shipyard_keodele_19bc7da2:

    # keo "The Queen’s child will however not inherit Her titles."
    keo "Mas a filha da Rainha não pode herdar seus títulos."

# game/episode025.rpy:2553
translate portuguese ep025_shipyard_keodele_ab00c714:

    # keo "Our Creator has proscribed that we begin our Quest for a Queen anew, should the sad day arrive when our current Queen expires."
    keo "Nossa Criadora decretou que devemos buscar uma nova Rainha, caso chegue o triste dia que nossa atual Rainha venha a falecer."

# game/episode025.rpy:2554
translate portuguese ep025_shipyard_keodele_89aefe22_1:

    # c "I see."
    c "Entendi."

# game/episode025.rpy:2555
translate portuguese ep025_shipyard_keodele_443f11ca:

    # c "Let’s hope that day is very far away."
    c "Tomara que esse dia esteja bem longe."

# game/episode025.rpy:2556
translate portuguese ep025_shipyard_keodele_1b2a1b25:

    # keo "Yes, indeed."
    keo "De fato."

# game/episode025.rpy:2558
translate portuguese ep025_shipyard_keodele_b6a69a0c:

    # keo "I believe I must congratulate you as well?"
    keo "Acredito que devo parabenizá-lo também?"

# game/episode025.rpy:2560
translate portuguese ep025_shipyard_keodele_d4e457ad:

    # keo "You are the father of the Queen’s child, are you not?"
    keo "Você é o pai do bebê da Rainha, não é?"

# game/episode025.rpy:2561
translate portuguese ep025_shipyard_keodele_36391c9b:

    # c "Yes, I am."
    c "Sou sim."

# game/episode025.rpy:2563
translate portuguese ep025_shipyard_keodele_5f550245:

    # keo "My congratulations on behalve of the Priest caste."
    keo "Dou os parabéns em nome das Sacerdotisas."

# game/episode025.rpy:2564
translate portuguese ep025_shipyard_keodele_a7c08f9b:

    # keo "The assurance of a pure bloodline is one of the most important tenets of the Acarhyn faith."
    keo "Garantir a pureza da linhagem é um dos pilares mais importantes da fé das Acarhyn."

# game/episode025.rpy:2565
translate portuguese ep025_shipyard_keodele_0c5952da:

    # keo "It warms my heart to think that our Queen has chosen a strong and formidable father, in accordance to the strictures laid out by our Creator."
    keo "Fico muito feliz em saber que nossa Rainha escolheu um pai tão forte e formidável, de acordo com as escrituras deixadas por nossa Criadora."

# game/episode025.rpy:2566
translate portuguese ep025_shipyard_keodele_01a76e03:

    # keo "This favorable fact will of course increase my fellow Acarhyn’s confidence in the rule of our Queen."
    keo "Esse fato favorável certamente aumentará a confiança das Acarhyn na liderança de nossa Rainha."

# game/episode025.rpy:2567
translate portuguese ep025_shipyard_keodele_bc1b3c5e:

    # c "Thank you, and I’m happy to hear this is such good news."
    c "Obrigado, e fico muito feliz em saber que é notícia tão boa."

# game/episode025.rpy:2568
translate portuguese ep025_shipyard_keodele_9dc0c389:

    # c "Your ascendancy to the rank of High Priestess seems to have been a positive development as well?"
    c "A sua ascensão ao rank de Sacerdotisa Chefe também parece ter sido algo positivo?"

# game/episode025.rpy:2570
translate portuguese ep025_shipyard_keodele_995981de:

    # keo "I think so, yes."
    keo "Acho que sim."

# game/episode025.rpy:2572
translate portuguese ep025_shipyard_keodele_58a32917:

    # keo "My mother’s reign as High Priestess wasn’t without controversy."
    keo "O reinado da minha mãe como Sacerdotisa Chefe teve certa controvérsia."

# game/episode025.rpy:2574
translate portuguese ep025_shipyard_keodele_6b62c38f:

    # keo "Erylin’s reign as High Priestess wasn’t without controversy."
    keo "O reinado de Erylin como Sacerdotisa Chefe teve certa controvérsia."

# game/episode025.rpy:2575
translate portuguese ep025_shipyard_keodele_8bfed9cf:

    # c "I reckon Erylin leaving Erigone with the Confessor was even more controversial."
    c "Acho que Erylin saindo de Erigone com o Confessor deve ter sido ainda mais controverso."

# game/episode025.rpy:2577
translate portuguese ep025_shipyard_keodele_7dd119ec:

    # keo "Very much so."
    keo "E muito."

# game/episode025.rpy:2580
translate portuguese ep025_shipyard_keodele_9cff2fd9:

    # keo "My mother has always vied for power, so it didn’t come as a surprise that she left everything behind so suddenly."
    keo "Minha mãe sempre foi sedenta por poder, então não foi surpresa ela ter deixado tudo para trás tão de repente."

# game/episode025.rpy:2582
translate portuguese ep025_shipyard_keodele_e7baf65a:

    # keo "Erylin has always vied for power, so it didn’t come as a surprise that she left everything behind so suddenly."
    keo "Erylin sempre foi sedenta por poder, então não foi surpresa ela ter deixado tudo para trás tão de repente."

# game/episode025.rpy:2583
translate portuguese ep025_shipyard_keodele_e542fee5:

    # c "Leaving you to pick up the pieces."
    c "Deixando que você cuidasse do estrago."

# game/episode025.rpy:2585
translate portuguese ep025_shipyard_keodele_25fe5716:

    # keo "Yes."
    keo "Sim."

# game/episode025.rpy:2586
translate portuguese ep025_shipyard_keodele_40e82afb:

    # keo "There were others who wanted the title, but my zeal won over almost all dissenters."
