    # woman "Erigone welcomes the Virgin Queen."
    woman "Erigone dá boas-vindas à Rainha Virgem."

# game/episode025.rpy:88
translate portuguese episode025_6d1b41ec:

    # woman "Commander Rahia would like to request an official audience."
    woman "Comandante Rahia gostaria de pedir uma audiência oficial."

# game/episode025.rpy:89
translate portuguese episode025_9c06534a:

    # woman "Guest rooms are being prepared as we speak."
    woman "Estamos preparando acomodações neste exato momento."

# game/episode025.rpy:90
