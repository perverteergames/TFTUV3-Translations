# game/episode024.rpy:42
translate portuguese episode024_4c6cc17f:

    # ag "Good afternoon, Velnia."
    ag "Boa tarde, Velnia."

# game/episode024.rpy:43
translate portuguese episode024_f785cd82:

    # ag "Are these quarters luxurious enough for you?"
    ag "Esses aposentos estão luxuosos o bastante para você?"

# game/episode024.rpy:44
translate portuguese episode024_1c0234c6:

    # vel "Fuck you, Agust."
    vel "Vai se foder, Agust."

# game/episode024.rpy:45
translate portuguese episode024_ae2c8342:

    # ag "I think the proper style of address would be “Your Highness”."
    ag "Acho que a maneira correta de falar comigo seria “Vossa Alteza”."

# game/episode024.rpy:46
translate portuguese episode024_013936f4:

    # vel "You already have me in a cell, chained to a wall, and now you’ve come to gloat?"
    vel "Você já me botou numa cela, acorrentada a uma parede, e ainda veio se vangloriar?"

# game/episode024.rpy:47
translate portuguese episode024_079df4ea:

    # ag "Not at all."
    ag "Nada disso."

# game/episode024.rpy:48
translate portuguese episode024_3fec40c6:

    # ag "You see, Velnia, you are the only member of the Council still alive, apart from me of course."
    ag "É que Velnia, você é a única membro do conselho ainda é viva. Tirando eu, é claro."

# game/episode024.rpy:49
translate portuguese episode024_9d6890c9:

    # ag "As you know, the others met their demise in that very tragic accident."
    ag "Como sabe, os outros encontraram seu fim naquele terrível acidente."

# game/episode024.rpy:51
translate portuguese episode024_ba6ec454:

    # vel "You fucking murdered them, Agust."
    vel "Você matou eles, Agust."

# game/episode024.rpy:53
translate portuguese episode024_cb14ced1:

    # ag "That’s not the official story, I can assure you."
    ag "Essa não é a história oficial, isso eu te garanto."

# game/episode024.rpy:54
translate portuguese episode024_7ff5a9d8:

    # ag "That unfortunate explosion made sure that a proper forensic investigation wasn’t possible."
    ag "Aquela triste explosão garantiu que não seria possível uma investigação forense."

# game/episode024.rpy:55
translate portuguese episode024_02f7cbc7:

    # ag "I’m sure the investigators would be perplexed by the eviscerated hearts inside those bodies."
    ag "Imagino que os investigadores ficariam confusos com os corações mutilados dentro daqueles corpos."

# game/episode024.rpy:56
translate portuguese episode024_41cc9250:

    # ag "Who knew that the members of the Council all had such weak hearts that just spontaneously burst inside their chests on that unfateful evening?"
    ag "Quem diria que todos os membros do Conselho tinham corações tão fracos que explodiriam por si só dentro de seus peitos naquela noite banal?"

# game/episode024.rpy:57
translate portuguese episode024_40b1dbe6:

    # ag "Aren’t you glad we were apparently made of much stronger stuff and managed to survive?"
    ag "Não está feliz que aparentemente somos feitos de algo mais resistente e conseguimos sobreviver?"

# game/episode024.rpy:59
translate portuguese episode024_3ab0b0b0:

    # vel "You disgust me."
    vel "Você me dá nojo."

# game/episode024.rpy:61
translate portuguese episode024_68a8fd1f:

    # ag "I’m sure you feel that way."
    ag "Imagino que se sinta assim."

# game/episode024.rpy:62
translate portuguese episode024_d1f02865:

    # ag "The people of the Sovereignty love me, though."
    ag "Mas o pessoal da Soberania me adora."

# game/episode024.rpy:63
translate portuguese episode024_7ec801e2:

    # ag "They crave a leader in these dark times."
    ag "Eles precisam de um líder nesses tempos difíceis."

# game/episode024.rpy:64
translate portuguese episode024_33db95b9:

    # ag "A leader who will guide them on the path to achieve the supremacy the Sovereignty so rightly deserves."
    ag "Um líder que os guiará o caminho da supremacia que a Soberania tanto merece."

# game/episode024.rpy:65
translate portuguese episode024_ef579122:

    # ag "The era of human domination has finally begun, and I will be its shepherd."
    ag "A era da dominação humana finalmente começou, e eu serei o seu pastor"

# game/episode024.rpy:67
translate portuguese episode024_0c121629:

    # vel "Spare me the sanctimonious bullshit and just kill me."
    vel "Me poupe dessa merda hipócrita e me mata logo."

# game/episode024.rpy:69
translate portuguese episode024_963f63ed:

    # ag "I’m afraid I can’t do that."
    ag "Infelizmente, não posso fazer isso."

# game/episode024.rpy:70
translate portuguese episode024_e17b1d2a:

    # ag "Yet..."
    ag "Ainda..."

# game/episode024.rpy:71
translate portuguese episode024_f2bc97b6:

    # ag "You see, there’s some information I need from you."
    ag "É que tem uma informação que eu preciso tirar de você."

# game/episode024.rpy:72
translate portuguese episode024_bc4e544e:

    # ag "Documents you’ve kept."
    ag "Documentos que você guardou."

# game/episode024.rpy:73
translate portuguese episode024_7d23adc6:

    # ag "Surveillance footage and logs about me, which could put a dent in the trust the good people of the Sovereignty have in me, should they fall into the wrong hands."
    ag "Gravações de segurança e registre sobre mim, que, caso caíssem nas mãos erradas, poderiam causar um problema na confiança que as pessoas Soberania puseram em mim."

# game/episode024.rpy:75
translate portuguese episode024_c749e135:

    # vel "I don’t know what you’re talking about."
    vel "Não sei do que você está falando."

# game/episode024.rpy:76
translate portuguese episode024_7ec08692:

    # ag "Sure you do."
    ag "Sabe sim."

# game/episode024.rpy:77
translate portuguese episode024_5aeb54ca:

    # ag "But maybe I can refresh your memory."
    ag "Mas talvez eu possa refrescar sua memória."

# game/episode024.rpy:79
translate portuguese episode024_2b870632:

    # "*SNAP*"
    "*CRAC*"

# game/episode024.rpy:80
translate portuguese episode024_c1066646:

    # vel "Aaaah! Aaah! You motherfucker!"
    vel "Aaaah! Aah! seu filho da puta!"

# game/episode024.rpy:81
translate portuguese episode024_d5926495:

    # ag "I’ve just shattered your left kneecap, so I would be careful not to put any weight on that leg if they ever take you down from this wall."
    ag "Acabei de quebrar o seu joelho, então cuidado para não botar peso nessa perna se um dia te tirarem dessa parede."

# game/episode024.rpy:83
translate portuguese episode024_e452b1b2:

    # vel "Do you think torturing me is going to make me spill any secrets?"
    vel "Você acha que eu vou te contar os meus segredos se me torturar?"

# game/episode024.rpy:85
translate portuguese episode024_c21f539c:

    # ag "Yes, as a matter of fact."
    ag "Na verdade, sim."

# game/episode024.rpy:86
translate portuguese episode024_1137f862:

    # ag "First, I will break every bone in your body, and when I’m done, I’ll reknit your entire skeleton and start all over again."
    ag "Primeiro, vou quebrar cada osso do seu corpo. Quando terminar, vou consertar seu esqueleto todo e começar tudo de novo."

# game/episode024.rpy:87
translate portuguese episode024_db476e3d:

    # ag "I’m going to keep you alive until you beg me to share every secret you know."
    ag "Vou te manter viva até você me implorar para contar até o último detalhe."

# game/episode024.rpy:88
translate portuguese episode024_fd97081c:

    # ag "The people of the Sovereignty deserve strong leadership, a leader with a spotless history, untainted by any missteps."
    ag "As pessoas da Soberania merecem uma liderança forte, um líder com um histórico perfeito, livre de qualquer falha."

# game/episode024.rpy:89
translate portuguese episode024_4d3a8584:

    # ag "So you will tell me where you keep your records, or suffer the consequences."
    ag "Então você vai me dizer onde guarda seus registros, ou sofrer as consequências."

# game/episode024.rpy:91
translate portuguese episode024_987a9bfd:

    # vel "Do your worst."
    vel "Faça o seu pior."

# game/episode024.rpy:93
translate portuguese episode024_35ea8b90:

    # ag "Oh, I certainly will."
    ag "Ah, pode apostar que vou."

# game/episode024.rpy:94
translate portuguese episode024_9dfe1ef1:

    # vel "Aaaaah!{w} AAAAAAAAH!"
    vel "Aaaaah!{w} AAAAAAAAH!"

