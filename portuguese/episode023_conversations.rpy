    ur "Devo informar que isto é muito impróprio."

# game/episode023_conversations.rpy:1374
translate portuguese ep023_thyia_talk_78fe5465:

    # c "I see you have given your robot the power of speech."
    c "Desde que deu o poder da fala ao seu robô."

# game/episode023_conversations.rpy:1376
translate portuguese ep023_thyia_talk_451d90c7:

