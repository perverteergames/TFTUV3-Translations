    # "I kissed her again, and we settled on her bed."
    "Eu beijei ela de novo e deitamos na cama dela."

# game/episode023_conversations.rpy:179
translate portuguese ep023_lilly_talk_91f732d4:

    # l "Hey [p_name_short], you’re looking well."
    l "Oi, [p_name_short]. Você parece bem."

# game/episode023_conversations.rpy:180
translate portuguese ep023_lilly_talk_669912bb:

    # c "I’m feeling a little better."
    c "Estou um pouco melhor."

# game/episode023_conversations.rpy:182
translate portuguese ep023_lilly_talk_24818aa2:

    # l "Happy to hear that."
    l "Bom saber."

# game/episode023_conversations.rpy:183
translate portuguese ep023_lilly_talk_0e93075b:

    # c "Do you have a moment for me?"
    c "Você tem um momentinho?"

# game/episode023_conversations.rpy:184
translate portuguese ep023_lilly_talk_a114f3f8:

    # l "Of course."
    l "Claro."

# game/episode023_conversations.rpy:185
translate portuguese ep023_lilly_talk_964bfe12:

    # c "Have you kept up with the news reports from the Sovereignty?"
    c "Você tem acompanhado as notícias da Soberania?"

# game/episode023_conversations.rpy:187
translate portuguese ep023_lilly_talk_e1c95b98:

    # l "Yes, I was about to message you about that."
    l "Sim, já ia te mandar uma mensagem."

# game/episode023_conversations.rpy:188
translate portuguese ep023_lilly_talk_6e581b9c:

    # l "I’ve scraped together what I could find."
    l "Eu juntei tudo que consegui encontrar."

# game/episode023_conversations.rpy:189
translate portuguese ep023_lilly_talk_bcdf24db:

    # c "Anything recent?"
    c "Algo recente?"

# game/episode023_conversations.rpy:190
translate portuguese ep023_lilly_talk_0e437111:

    # c "About Agust, I mean?"
    c "Digo, sobre o Agust?"

# game/episode023_conversations.rpy:192
translate portuguese ep023_lilly_talk_9de3509c:

    # l "Oh yes, and you’re not going to like it."
    l "Sim, e você não vai gostar."

# game/episode023_conversations.rpy:194
translate portuguese ep023_lilly_talk_19c32bb6:

    # c "Nothing about Dad is ever good news, so hit me."
    c "Nada do Pai é boa notícia, manda."

# game/episode023_conversations.rpy:196
translate portuguese ep023_lilly_talk_b4567d78:

    # c "Nothing about my father is ever good news, so hit me."
    c "Nada do meu pai é boa notícia, manda."

# game/episode023_conversations.rpy:198
translate portuguese ep023_lilly_talk_968aa29f:

    # l "Remember those terrorist attacks?"
    l "Lembra daqueles ataques terroristas?"

# game/episode023_conversations.rpy:199
translate portuguese ep023_lilly_talk_822ac5fd:

    # c "Carried out by that group, the Auric Exemplar?"
    c "Daquele grupo, os Exemplares Áureos?"

# game/episode023_conversations.rpy:201
translate portuguese ep023_lilly_talk_ddf50bb8:

    # l "Exactly."
    l "Exatamente."

# game/episode023_conversations.rpy:202
translate portuguese ep023_lilly_talk_3ba007ba:

    # l "Their terror campaign has continued pretty much unabated."
    l "A campanha de terror deles continuou sem interrupção."

# game/episode023_conversations.rpy:203
translate portuguese ep023_lilly_talk_ef07bc6d:

    # c "Nothing new there, then."
    c "Então sem novidades."

# game/episode023_conversations.rpy:204
translate portuguese ep023_lilly_talk_bda440cc:

    # l "No, not until a few weeks ago."
    l "Não até umas semanas atrás."

# game/episode023_conversations.rpy:206
translate portuguese ep023_lilly_talk_057ecc94:

    # l "Dad’s return wasn’t mentioned in any news feeds I could find."
    l "A volta do pai não foi mencionada em nenhum noticiário pelo que eu tenha visto."

# game/episode023_conversations.rpy:208
translate portuguese ep023_lilly_talk_c43de77d:

    # l "Agust’s return wasn’t mentioned in any news feeds I could find."
    l "A volta do Agust não foi mencionada em nenhum noticiário pelo que eu tenha visto."

# game/episode023_conversations.rpy:209
translate portuguese ep023_lilly_talk_9994ddd6:

    # l "Not even the TGN Ypotryll was reported back."
    l "Nem o MTG Ypotryll reportou chegada."

# game/episode023_conversations.rpy:210
translate portuguese ep023_lilly_talk_0a583fd9:

    # c "He needed medical treatment after the procedure on Petrarch, didn’t he?"
    c "Ele precisou de tratamento médico depois do procedimento em Petrarch, não foi?"

# game/episode023_conversations.rpy:211
translate portuguese ep023_lilly_talk_eaa6292b:

    # c "So maybe he got treated for that heart attack in some clandestine facility."
    c "Então talvez trataram aquele ataque cardíaco em algum lugar clandestino."

# game/episode023_conversations.rpy:213
translate portuguese ep023_lilly_talk_43ed8f16:

    # l "Maybe."
    l "Talvez."

# game/episode023_conversations.rpy:214
translate portuguese ep023_lilly_talk_506afec7:

    # l "The fact is, for the past few weeks his name is suddenly mentioned again."
    l "Mas o fato é que depois de semanas, o nome dele apareceu de novo."

# game/episode023_conversations.rpy:215
translate portuguese ep023_lilly_talk_543f4480:

    # l "Like he popped up suddenly."
    l "Como se tivesse aparecido do nada."

# game/episode023_conversations.rpy:216
translate portuguese ep023_lilly_talk_e7d9561d:

    # c "Like the cockroach that he is."
    c "Quem nem a barata que ele é."

# game/episode023_conversations.rpy:217
translate portuguese ep023_lilly_talk_cfe6f443:

    # c "So he got a mention in the business section of some provincial newspaper?"
    c "Então o nome dele apareceu na sessão de negócios do jornal, foi?"

# game/episode023_conversations.rpy:218
translate portuguese ep023_lilly_talk_43e4d03b:

    # c "“Local businessman returns home, is still an insufferable cunt”, something like that?"
    c "“Empresário local volta para casa, ainda sendo um babaca insuportável”, algo assim?"

# game/episode023_conversations.rpy:220
translate portuguese ep023_lilly_talk_4241539e:

    # l "No, this is something major."
    l "Não, isso é importante."

# game/episode023_conversations.rpy:221
translate portuguese ep023_lilly_talk_83ad2999:

    # l "There have been assassination attempts on members of the Sovereignty Council before."
    l "Já houveram tentativas de assassinato dos membros da Soberania antes."

# game/episode023_conversations.rpy:222
translate portuguese ep023_lilly_talk_8e40b069:

    # l "Some were successful, others were thwarted."
    l "Alguns tiveram sucesso, outras foram impedidas."

# game/episode023_conversations.rpy:223
translate portuguese ep023_lilly_talk_1e57b8f9:

    # l "This time, when the Council was officially in session, they were wiped out by someone or something."
    l "Dessa vez, quando o Conselho estava numa sessão oficial, eles todos foram mortos por alguém ou alguma coisa."

# game/episode023_conversations.rpy:224
translate portuguese ep023_lilly_talk_364b6f7d:

    # c "But not all of them..."
    c "Mas não todos..."

# game/episode023_conversations.rpy:226
translate portuguese ep023_lilly_talk_0fab2e42:

    # l "No, Dad survived somehow."
    l "Não, o Pai deu um  jeito de sobreviver."

# game/episode023_conversations.rpy:228
translate portuguese ep023_lilly_talk_c36f3cdb:

    # l "No, Agust survived somehow."
    l "Não, Agust deu um  jeito de sobreviver."

# game/episode023_conversations.rpy:229
translate portuguese ep023_lilly_talk_4c633a45:

    # l "He was the only one."
    l "Só ele que sobreviveu."

# game/episode023_conversations.rpy:230
translate portuguese ep023_lilly_talk_68d3aa61:

    # l "But if there are any other survivors, nothing was reported about them escaping."
    l "Mas se outras pessoas sobreviveram, ninguém falou nada sobre elas escapando."

# game/episode023_conversations.rpy:231
translate portuguese ep023_lilly_talk_60ba8799:

    # c "What happened exactly?"
    c "O que aconteceu exatamente?"

# game/episode023_conversations.rpy:232
translate portuguese ep023_lilly_talk_fd8a48b4:

    # l "Several explosions were reported, as well as a couple of power surges."
    l "Reportaram várias explosões, e uns picos de energia."

# game/episode023_conversations.rpy:233
translate portuguese ep023_lilly_talk_710277d4:

    # l "No tactical strike teams were spotted beforehand, nor any orbital assault."
    l "Não viram nenhum time tático, nem um ataque orbital."

# game/episode023_conversations.rpy:234
translate portuguese ep023_lilly_talk_b0ae2781:

    # l "Nobody knows what caused all that, but a state of emergency has been declared until further notice."
    l "Ninguém sabe o que causou, mas declararam estado de emergência até segunda ordem."

# game/episode023_conversations.rpy:235
translate portuguese ep023_lilly_talk_8d34f3be:

    # c "I think I have a pretty clear idea about who is responsible for those surges and explosions."
    c "Acho que tenho uma boa ideia de que foi responsável por esses picos de energia e explosões."

# game/episode023_conversations.rpy:238
translate portuguese ep023_lilly_talk_e9354ca6:

    # l "Yes, Dad is involved somehow, isn’t he?"
    l "É, o Pai deve estar envolvido de alguma forma, né?"

# game/episode023_conversations.rpy:240
translate portuguese ep023_lilly_talk_0e9c3796:

    # l "Yes, Agust is involved somehow, isn’t he?"
    l "É, o Agust deve estar envolvido de alguma forma, né?"

# game/episode023_conversations.rpy:241
translate portuguese ep023_lilly_talk_50b90fc2:

    # c "He sure is."
    c "Com certeza."

# game/episode023_conversations.rpy:242
translate portuguese ep023_lilly_talk_1c356b9f:

    # c "I would go as far to say that he is directly responsible."
    c "Eu diria até que ele é diretamente responsável."

# game/episode023_conversations.rpy:243
translate portuguese ep023_lilly_talk_dbae051e:

    # c "Him and his newfound powers."
    c "Ele e as habilidades novas."

# game/episode023_conversations.rpy:244
translate portuguese ep023_lilly_talk_9d06a1f3:

    # l "You mean he murdered the Council?"
    l "Então quer dizer que ele matou o Conselho?"

# game/episode023_conversations.rpy:245
translate portuguese ep023_lilly_talk_31a9e8a5:

    # c "An indefinite state of emergency has been declared, right?"
    c "Declararam um estado de emergência sem fim, não foi?"

# game/episode023_conversations.rpy:246
translate portuguese ep023_lilly_talk_cd115d85:

    # c "And who’s the new single ruler, controlling everything from the Department of Interplanetary Exploration to the Navy now that the Council has conveniently died out?"
    c "E quem é o novo mandante, controlando tudo desde o Departamento de Exploração Interplanetária à Marinha, agora que o Conselho convenientemente morreu?"

# game/episode023_conversations.rpy:249
translate portuguese ep023_lilly_talk_0de97101:

    # l "Dad is..."
    l "O Pai..."

# game/episode023_conversations.rpy:251
translate portuguese ep023_lilly_talk_380dc5c3:

    # l "Agust is..."
    l "O Agust..."

# game/episode023_conversations.rpy:252
translate portuguese ep023_lilly_talk_f9c698b6:

    # c "Exactly."
    c "Exato."

# game/episode023_conversations.rpy:253
translate portuguese ep023_lilly_talk_b0567354:

    # c "He was the one who announced the state of emergency, wasn’t he?"
    c "Foi ele que anunciou o estado de emergência, não foi?"

# game/episode023_conversations.rpy:254
translate portuguese ep023_lilly_talk_bc5c265b:

    # l "Yes."
    l "Sim."

# game/episode023_conversations.rpy:255
translate portuguese ep023_lilly_talk_0366f5cd:

    # c "You said that nobody knows what caused the slaughter of the Council."
    c "Você disse que ninguém sabe o que causou as mortes do Conselho."

# game/episode023_conversations.rpy:256
translate portuguese ep023_lilly_talk_ee80afa4:

    # l "That’s right."
    l "Isso."

# game/episode023_conversations.rpy:257
translate portuguese ep023_lilly_talk_aa51f567:

    # l "There’s a press conference today about it."
    l "Vai ter uma coletiva de imprensa hoje."

# game/episode023_conversations.rpy:258
translate portuguese ep023_lilly_talk_e6de724f:

    # l "In fact, it has already started."
    l "Aliás, já até começou."

# game/episode023_conversations.rpy:260
translate portuguese ep023_lilly_talk_6b5587f5:

    # c "Could you pull up that feed?"
    c "Pode abrir isso aí?"

# game/episode023_conversations.rpy:261
translate portuguese ep023_lilly_talk_705a04b2:

    # l "Sure."
    l "Sim."

# game/episode023_conversations.rpy:263
translate portuguese ep023_lilly_talk_b8ea7b92:

    # ag "...dark times."
    ag "... tempos sombrios."

# game/episode023_conversations.rpy:264
translate portuguese ep023_lilly_talk_ce56c559:

    # ag "The enemy has struck a terrible blow, right in the heart of our beloved Sovereignty."
    ag "O inimigo desferiu um golpe terrível, direto no coração da nossa amada Soberania."

# game/episode023_conversations.rpy:265
translate portuguese ep023_lilly_talk_61245719:

    # ag "The Council is no more, murdered in cold blood."
    ag "O conselho não existe mais, assassinados a sangue frio."

# game/episode023_conversations.rpy:267
translate portuguese ep023_lilly_talk_79605fb3:

    # ag "I was able to escape the slaughter and was rescued by the brave men and women of our armed forces."
    ag "Eu consegui escapar da matança e fui resgatado pelos homens e mulheres corajosos das nossas forças armadas."

# game/episode023_conversations.rpy:268
translate portuguese ep023_lilly_talk_a42ccf26:

    # ag "As proclaimed earlier, the state of emergency will continue until the investigation into this grave matter has been concluded and the culprits have been found and executed for their heinous crimes."
    ag "Como foi proclamado antes, o estado de emergência continuará até a investigação deste assunto sério for concluída e os culpados forem encontrados e executados por seus crimes hediondos."

# game/episode023_conversations.rpy:269
translate portuguese ep023_lilly_talk_59ad64cd:

    # ag "The investigation team is still working hard on their findings, but I can already divulge that the attack was likely carried out by enemy agents."
    ag "O time de investigação ainda está trabalhando duro com o que encontraram, mas já posso divulgar que o ataque provavelmente foi iniciado por agentes externos."

# game/episode023_conversations.rpy:270
translate portuguese ep023_lilly_talk_43bdf796:

    # ag "Enemy agents who received help from traitors inside the Sovereignty."
    ag "Agentes inimigos que receberam ajuda de traidores dentro da Soberania."

# game/episode023_conversations.rpy:272
translate portuguese ep023_lilly_talk_126d3194:

    # ag "Traitors like the Auric Exemplar."
    ag "Traidores como os Exemplares Áureos."

# game/episode023_conversations.rpy:273
translate portuguese ep023_lilly_talk_39bb1b77:

    # ag "As Regent, I will make sure that the cowardly attackers will be prosecuted to the fullest extent of the law."
    ag "Como Regente, vou me certificar que os covardes serão processados com todo o rigor da lei."

# game/episode023_conversations.rpy:274
translate portuguese ep023_lilly_talk_7aae6468:

    # ag "I will shepherd our Sovereignty to newfound heights of greatness."
    ag "Eu levarei a nossa Soberania a novas alturas."

# game/episode023_conversations.rpy:275
translate portuguese ep023_lilly_talk_a69cadac:

    # ag "The Sovereignty will never bow to terror, and so I’ve asked the Terran Galactic Navy to carry out a series of punitive actions against those territories that have a history of being outright hostile and disloyal to our great nation."
    ag "A Soberania nunca se curvará diante de terror. Sendo assim, eu pedi à Marinha Terrana Galáctica para tomar uma série de ações punitivas contra os territórios que possuem uma história de hostilidade e deslealdade com a nossa grande nação."

# game/episode023_conversations.rpy:276
translate portuguese ep023_lilly_talk_c1c5bf79:

    # ag "Orbital bombardments are being carried out in the Dra-Hynyn and Ovalt Vhil systems at this time."
    ag "Bombardeios orbitais estão sendo feitos nos sistemas Dra-Hynyn e Ovalt Vhil nesse momento."

# game/episode023_conversations.rpy:277
translate portuguese ep023_lilly_talk_aa344549:

    # ag "We will not hesitate to bring the full military might of the Sovereignty to bear against anyone who dares to oppose us."
    ag "Não hesitaremos em empregar todo o poderio militar da Soberania contra qualquer um que ousar nos opor."

# game/episode023_conversations.rpy:278
translate portuguese ep023_lilly_talk_07012cfd:

    # ag "The Sovereignty will prevail!"
    ag "A Soberania prevalecerá!"

# game/episode023_conversations.rpy:279
translate portuguese ep023_lilly_talk_cc0ff136:

    # ag "Long live the Sovereignty!"
    ag "Vida longa à Soberania!"

# game/episode023_conversations.rpy:280
translate portuguese ep023_lilly_talk_eba7a1ec:

    # c "I think I’ve heard enough."
    c "Acho que já vi demais."

# game/episode023_conversations.rpy:282
