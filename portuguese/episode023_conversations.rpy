    c "Essa informação é útil, obrigado."

# game/episode023_conversations.rpy:1640
translate portuguese ep023_vess_talk_7d07fee8:

    # c "I’ll send for you when I have need of you."
    c "Eu vou mandar te buscar quando precisar de você."

# game/episode023_conversations.rpy:1642
translate portuguese ep023_vess_talk_7cbc9c33:

    # ve "Of course, master."
    ve "Claro, mestre."

# game/episode023_conversations.rpy:1650
translate portuguese ep023_jade_celine_talk_375c1a73:

    # "Jade and Céline were both on the bridge, huddled over a monitor."
    "Jade e Céline estavam na ponte, perto de um monitor."

# game/episode023_conversations.rpy:1651
translate portuguese ep023_jade_celine_talk_ab3a42f6:

    # c "Hey, you two."
    c "Ei, gente."

# game/episode023_conversations.rpy:1654
translate portuguese ep023_jade_celine_talk_8e7e51e4:

    # "Both girls didn’t know how fast they could leave their chairs and embrace me."
    "As duas não sabiam o quão rápido sairiam das cadeiras para me abraçar."

# game/episode023_conversations.rpy:1656
translate portuguese ep023_jade_celine_talk_04638393:

    # "Jade kissed me full on the mouth and Céline followed her example."
    "Jade me beijou na boca, e Céline fez o mesmo."

# game/episode023_conversations.rpy:1659
translate portuguese ep023_jade_celine_talk_8ec79728:

    # "Céline didn’t rush to meet me, but kept a respectful distance and smiled at me."
    "Céline não correu para me encontrar, mantendo uma distância, e sorriu para mim."

# game/episode023_conversations.rpy:1660
translate portuguese ep023_jade_celine_talk_49e82bbf:

    # "Jade kissed me full on the mouth."
    "Jade me beijou na boca."

# game/episode023_conversations.rpy:1663
translate portuguese ep023_jade_celine_talk_fddd83b5:

    # "Jade didn’t rush to meet me, but kept a respectful distance and smiled at me."
    "Jade não correu para me encontrar, mantendo uma distância, e sorriu para mim."

# game/episode023_conversations.rpy:1664
translate portuguese ep023_jade_celine_talk_341c4182:

    # "Céline kissed me full on the mouth."
    "Céline me beijou na boca."

# game/episode023_conversations.rpy:1667
translate portuguese ep023_jade_celine_talk_50954f5b:

    # "Both girls turned around and smiled at me."
    "As duas se viraram e sorriram para mim."

# game/episode023_conversations.rpy:1669
translate portuguese ep023_jade_celine_talk_b003f0e2:

    # c "I take it you’re glad that I’m back?"
    c "Imagino que esteja feliz que eu voltei?"

# game/episode023_conversations.rpy:1671
translate portuguese ep023_jade_celine_talk_82b75a1c:

    # ce "Glad doesn’t even begin to describe it."
    ce "Feliz é pouco."

# game/episode023_conversations.rpy:1673
translate portuguese ep023_jade_celine_talk_83472d89:

    # c "I hope you’re glad that I’m back?"
    c "Espero que esteja feliz que eu voltei?"

# game/episode023_conversations.rpy:1675
translate portuguese ep023_jade_celine_talk_f617ee6b:

    # ce "Very much so."
    ce "E muito."

# game/episode023_conversations.rpy:1678
translate portuguese ep023_jade_celine_talk_27bd6c27:

    # j "Your mother told us you were out of the medbay, but I didn’t think you’d be walking around so soon."
    j "A sua mãe disse que você tinha saído da enfermaria, mas não sabia que você já ia estar andando tão cedo assim."

# game/episode023_conversations.rpy:1680
translate portuguese ep023_jade_celine_talk_2d5daaba:

    # j "Nadya told us you were out of the medbay, but I didn’t think you’d be walking around so soon."
    j "A Nadya disse que você tinha saído da enfermaria, mas não sabia que você já ia estar andando tão cedo assim."

# game/episode023_conversations.rpy:1681
translate portuguese ep023_jade_celine_talk_ac2bea30:

    # c "Me neither."
    c "Nem eu."

# game/episode023_conversations.rpy:1682
translate portuguese ep023_jade_celine_talk_62ba90cf:

    # j "Considering the feat you’ve pulled off, I was dreading you’d be in the medbay for months."
    j "Considerando o que você fez, eu estava com medo que você fosse passar meses na enfermaria."

# game/episode023_conversations.rpy:1683
translate portuguese ep023_jade_celine_talk_7fbf7a1b:

    # j "Then again, you came out of your coma pretty quick."
    j "Mas você acordou do coma bem rápido."

# game/episode023_conversations.rpy:1686
translate portuguese ep023_jade_celine_talk_86be07ff:

    # j "I’m so happy you’re back!"
    j "Estou tão feliz que você voltou!"

# game/episode023_conversations.rpy:1687
translate portuguese ep023_jade_celine_talk_f765b63f:

    # c "What were you girls working on?"
    c "O que vocês estão fazendo?"

# game/episode023_conversations.rpy:1689
translate portuguese ep023_jade_celine_talk_b3288799:

    # ce "We’ve just finalized the security checks for several software patches that Jade and I devised."
    ce "Finalizando as checagens de segurança de um bocado de atualização de segurança que eu e a Jade fixemos."

# game/episode023_conversations.rpy:1691
translate portuguese ep023_jade_celine_talk_27cacaa0:

    # j "The TGN Ypotryll was able to subvert all of our early-warning systems when they approached Petrarch."
    j "A MTG Ypotryll conseguiu escapar de todos os nossos sistemas quando chegou em Petrarch."

# game/episode023_conversations.rpy:1693
translate portuguese ep023_jade_celine_talk_7de62d30:

    # ce "The orbital probes didn’t pick up any activity, so we looked into why that happened."
    ce "As sondas orbitais não viram atividade nenhuma, então procuramos saber porquê."

# game/episode023_conversations.rpy:1694
translate portuguese ep023_jade_celine_talk_0d3cc6fd:

    # c "Did the battle cruiser use some sort of cloaking technique?"
    c "A nave usou algum tipo de sistema de camuflagem?"

# game/episode023_conversations.rpy:1696
translate portuguese ep023_jade_celine_talk_0f7028f9:

    # j "No, they didn’t."
    j "Não usaram."

# game/episode023_conversations.rpy:1697
translate portuguese ep023_jade_celine_talk_4108add7:

    # j "They managed to shut down those probes remotely."
    j "Eles desligaram as ondas orbitais remotamente."

# game/episode023_conversations.rpy:1698
translate portuguese ep023_jade_celine_talk_98f1938e:

    # c "I thought those probes were secured?"
    c "Eu achei que as ondas estavam protegidas?"

# game/episode023_conversations.rpy:1700
translate portuguese ep023_jade_celine_talk_9111b89d:

    # ce "Yes, they’re supposedly top of the line, military grade."
    ce "Sim, era para serem as melhores que tem, nível militar."

# game/episode023_conversations.rpy:1701
translate portuguese ep023_jade_celine_talk_6ac07940:

    # ce "So we combed through everything and Jade eventually found out how they did it."
    ce "Aí a gente deu uma olhada a fundo e a Jade descobriu como eles fizeram."

# game/episode023_conversations.rpy:1703
translate portuguese ep023_jade_celine_talk_07e636a4:

    # j "Those probes had a software backdoor."
    j "As sondas tinham uma brecha de software."

# game/episode023_conversations.rpy:1704
translate portuguese ep023_jade_celine_talk_4b70257c:

    # j "Really cleverly designed, so it could only have been done during production."
    j "Foi uma brecha bem feita, a única maneira de conseguir fazer isso é durante a produção."

# game/episode023_conversations.rpy:1705
translate portuguese ep023_jade_celine_talk_e25e4dfb:

    # j "The company that produces them is a large manufacturer of all kinds of technology in one of the neutral systems."
    j "A empresa que produz elas é uma fabricante de gigante de vários tipos de tecnologia em um dos sistemas neutros."

# game/episode023_conversations.rpy:1706
translate portuguese ep023_jade_celine_talk_67c94922:

    # j "Digging deeper, I found out that the company in turn is owned by another larger conglomerate."
    j "Dando uma pesquisada, eu vi que a empresa pertence a um outro conglomerado gigante."

# game/episode023_conversations.rpy:1708
translate portuguese ep023_jade_celine_talk_8cb7e1ad:

    # j "That’s when the shell companies started appearing."
    j "Foi aí que começaram a aparecer as empresas de fachada."

# game/episode023_conversations.rpy:1709
translate portuguese ep023_jade_celine_talk_ea1fbfc0:

    # j "I’m not a hundred percent sure, but I think the factory that produces the probes is ultimately owned by the Sovereignty."
    j "Não tenho certeza cem por cento, mas acho que a fábrica que produz essas sondas pertence à Soberania."

# game/episode023_conversations.rpy:1710
translate portuguese ep023_jade_celine_talk_e61351f2:

    # c "And they’re the only ones with access to the backdoor?"
    c "E só eles têm acesso a essa brecha?"

# game/episode023_conversations.rpy:1711
translate portuguese ep023_jade_celine_talk_e7bc106e:

    # j "Yes, I think so."
    j "Acho que sim."

# game/episode023_conversations.rpy:1713
translate portuguese ep023_jade_celine_talk_1112a797:

    # ce "So we got a little paranoid and spent the past weeks going over every piece of hardware and software."
    ce "Aí deu uma paranoia na gente, e passamos as últimas semanas vasculhando todo o hardware e software."

# game/episode023_conversations.rpy:1714
translate portuguese ep023_jade_celine_talk_15d9106e:

    # c "How bad was it?"
    c "Foi ruim?"

# game/episode023_conversations.rpy:1716
translate portuguese ep023_jade_celine_talk_16e9f3d6:

    # j "Not that bad, only minor stuff, apart from the compromised probes."
    j "Nem tanto, só umas coisas menores, tirando as sondas comprometidas."

# game/episode023_conversations.rpy:1717
translate portuguese ep023_jade_celine_talk_5b3ca3c7:

    # j "I’ve hardened the security of every system on the ship and any smart weapons we have on board."
    j "Eu melhorei todos os sistemas de segurança da nave e todas as armas inteligentes que temos a bordo."

# game/episode023_conversations.rpy:1719
translate portuguese ep023_jade_celine_talk_c852f547:

    # ce "Yes, we went through everything with a fine-toothed comb."
    ce "Sim, demos uma pesquisada bem a fundo."

# game/episode023_conversations.rpy:1720
translate portuguese ep023_jade_celine_talk_847fca40:

    # ce "So we’ll be better protected once the Sovereignty comes knocking."
    ce "Vamos estar melhor protegidos quando a Soberania aparecer."

# game/episode023_conversations.rpy:1721
translate portuguese ep023_jade_celine_talk_0a2ff617:

    # c "It’s likely that they will, so good job you two."
    c "E provavelmente vão mesmo, então ótimo trabalho."

# game/episode023_conversations.rpy:1722
translate portuguese ep023_jade_celine_talk_38694b92:

    # c "I’m planning on taking the fight to the Sovereignty, so being less vulnerable to their attacks is going to help for sure."
    c "Estou planejando trazer a luta até a Soberania, então vai ajudar bastante ficar menos vulnerável aos ataque deles."

# game/episode023_conversations.rpy:1723
translate portuguese ep023_jade_celine_talk_7f1b7b37:

    # c "I’m going to discuss the plans in more detail soon, so I’ll let you know once I’m ready."
    c "Assim que der eu vou discutir os planos mais a fundo, eu aviso quando estiver pronto."

# game/episode023_conversations.rpy:1725
translate portuguese ep023_jade_celine_talk_e5a13291:

    # ce "Of course."
    ce "Claro."

# game/episode023_conversations.rpy:1727
translate portuguese ep023_jade_celine_talk_46e89fb4:

    # j "If you need any technical input, we’re available."
    j "Se precisar de informações técnicas, estamos disponíveis."

# game/episode023_conversations.rpy:1729
translate portuguese ep023_jade_celine_talk_cfbbbaf7:

    # "I left both women to work on finalizing their security review."
    "Eu deixei as duas finalizando a análise de segurança."

# game/episode023_conversations.rpy:1737
translate portuguese ep023_raene_talk_04ddf849:

    # "I’d hoped to find Raene inside her quarters, but she wasn’t there."
    "Eu esperei encontrar a Raene no quarto dela, mas ela não estava."

# game/episode023_conversations.rpy:1739
translate portuguese ep023_raene_talk_f2d25239:

    # "The door to Ziv’s quarters was ajar, and I could hear voices inside."
    "A porta do quarto da Ziv estava aberta, eu ouvi umas vozes."

# game/episode023_conversations.rpy:1741
translate portuguese ep023_raene_talk_1755ffec:

    # "After knocking, Ziv invited me in."
    "Quando eu bati, Ziv pediu para entrar."

# game/episode023_conversations.rpy:1742
translate portuguese ep023_raene_talk_09f90eb8:

    # c "Ah, there you are."
    c "Ah, aí está."

# game/episode023_conversations.rpy:1744
translate portuguese ep023_raene_talk_96d563f1:

    # ra "[p_name_short]!"
    ra "[p_name_short]!"

# game/episode023_conversations.rpy:1746
translate portuguese ep023_raene_talk_e0dc1471:

    # "Both women got to their feet to embrace me, Raene got there first."
    "As duas se levantaram e vieram me abraçar, Raene chegou primeiro1"

# game/episode023_conversations.rpy:1748
translate portuguese ep023_raene_talk_62fa1ff8:

    # "Raene got to her feet to embrace me."
    "Raene  se levantou e veio me abraçar."

# game/episode023_conversations.rpy:1749
translate portuguese ep023_raene_talk_fb8f7e1b:

    # ra "I’m so glad you’re okay."
    ra "Estou tão feliz que você está bem."

# game/episode023_conversations.rpy:1752
translate portuguese ep023_raene_talk_d00e5854:

    # zi "I missed you, [p_name]."
    zi "Eu senti sua falta, [p_name]."

# game/episode023_conversations.rpy:1753
translate portuguese ep023_raene_talk_e6c98684:

    # zi "Sorry I couldn’t visit you more, but I was part of Thyia’s sabotage efforts, so Raene went in my stead."
    zi "Desculpa não ter te visitado mais, mas eu estava ajudando a Thyia a sabotar, então Raene foi no meu lugar."

# game/episode023_conversations.rpy:1754
translate portuguese ep023_raene_talk_48319372:

    # c "I don’t blame you one bit."
    c "Eu não te culpo nadinha."

# game/episode023_conversations.rpy:1755
translate portuguese ep023_raene_talk_2e57cd1b:

    # c "I’m so happy to see you both again."
    c "É tão bom ver vocês de novo."

# game/episode023_conversations.rpy:1757
translate portuguese ep023_raene_talk_fdd3d580:

    # c "I’m so happy to see you again."
    c "É tão bom te ver de novo."

# game/episode023_conversations.rpy:1758
translate portuguese ep023_raene_talk_e1229664:

    # c "How have you been holding up?"
    c "Como que tem estado?"

# game/episode023_conversations.rpy:1760
translate portuguese ep023_raene_talk_d8069bf6:

    # ra "Reasonably well."
    ra "Até que bem."

# game/episode023_conversations.rpy:1761
translate portuguese ep023_raene_talk_6867b753:

    # ra "Everyone was so unhappy during your stay in the medbay."
    ra "Todo mundo estava tão triste quando você estava na enfermaria."

# game/episode023_conversations.rpy:1762
translate portuguese ep023_raene_talk_9349e470:

    # ra "Eva’s recovery brought a short moment of joy, but that soon ended when you didn’t seem to make any progress."
    ra "A melhora da Eva trouxe um pequeno momento de alegria, mas isso não durou muito quando você não melhorou."

# game/episode023_conversations.rpy:1765
translate portuguese ep023_raene_talk_eb0700ab:

    # zi "The work on Petrarch kept us busy, but I could tell everyone was affected during the short moments of respite we had in the evenings."
    zi "Ficamos ocupadas com Petrarch, mas eu percebi meus pequenos momentos de descanso nas tardes que todo mundo tinha sido afetado ."

# game/episode023_conversations.rpy:1766
translate portuguese ep023_raene_talk_2536365d:

    # zi "Or maybe I’m projecting my own grief on everyone else."
    zi "Ou talvez eu só esteja projetando a minha tristeza em todo mundo."

# game/episode023_conversations.rpy:1768
translate portuguese ep023_raene_talk_f52d2748:

    # ra "No, I’m certain you’re not."
    ra "Não, não está."

# game/episode023_conversations.rpy:1770
translate portuguese ep023_raene_talk_369c871d:

    # ra "You can’t imagine our relief when we heard you’d woken up."
    ra "Você não pode imaginar o nosso alívio quando soubemos que você acordou."

# game/episode023_conversations.rpy:1771
translate portuguese ep023_raene_talk_02d0449c:

    # ra "And you’re walking around the ship, so you must be feeling better?"
    ra "E você já está andando pela nave. Quer dizer que já está se sentindo melhor então?"

# game/episode023_conversations.rpy:1772
translate portuguese ep023_raene_talk_173b7d9d:

    # c "Yes, much."
    c "Sim, muito melhor."

# game/episode023_conversations.rpy:1774
translate portuguese ep023_raene_talk_f583e47c:

    # c "I’m going back to my own quarters, Thim has released me from the medbay."
    c "Vou voltar para o meu quarto, o Thim me deu alta da enfermaria."

# game/episode023_conversations.rpy:1776
translate portuguese ep023_raene_talk_a7b02eb1:

    # c "I’m going back to my own quarters, the autodoc cleared me."
    c "Vou voltar para o meu quarto, o autodoc me deu alta da enfermaria."

# game/episode023_conversations.rpy:1779
translate portuguese ep023_raene_talk_53a169c5:

    # zi "That’s such good news."
    zi "Que ótima notícia."

# game/episode023_conversations.rpy:1781
translate portuguese ep023_raene_talk_3cd6f2ed:

    # ra "Do you feel any different after what happened on Petrarch?"
    ra "Você está sentindo alguma coisa diferente depois do que aconteceu em Petrarch?"

# game/episode023_conversations.rpy:1782
translate portuguese ep023_raene_talk_d44ef46a:

    # c "No, not when I do everyday stuff."
    c "Não, não quando eu faço as coisas do dia a dia."

# game/episode023_conversations.rpy:1783
translate portuguese ep023_raene_talk_bc878a25:

    # c "When I concentrate though, I can tap into a reservoir of power I didn’t have before."
    c "Mas quando eu me concentro, eu consigo acessar um poder que não tinha antes."

# game/episode023_conversations.rpy:1785
translate portuguese ep023_raene_talk_4633b687:

    # zi "That’s fascinating."
    zi "Fascinante."

# game/episode023_conversations.rpy:1787
translate portuguese ep023_raene_talk_d3fe6d3a:

    # zi "Is that what you used to heal Eva?"
    zi "Foi o que você usou para curar a Eva?"

# game/episode023_conversations.rpy:1788
translate portuguese ep023_raene_talk_b184f765:

    # c "I did, yes."
    c "Sim."

# game/episode023_conversations.rpy:1790
translate portuguese ep023_raene_talk_28bf0320:

    # ra "But using that power is dangerous, clearly."
    ra "Mas é obvio que usar esse poder é perigoso."

# game/episode023_conversations.rpy:1791
translate portuguese ep023_raene_talk_f7fa1676:

    # c "It is if I do it without restraint, as I did with Eva."
    c "Se eu usar sem restrição que nem fiz com a Eva, é."

# game/episode023_conversations.rpy:1793
translate portuguese ep023_raene_talk_1b997159:

    # zi "You think this power can be trained?"
    zi "Você acha que dá para treinar esse poder?"

# game/episode023_conversations.rpy:1794
translate portuguese ep023_raene_talk_4f7c2a96:

    # c "I think so, yes."
    c "Acho que sim."

# game/episode023_conversations.rpy:1796
translate portuguese ep023_raene_talk_a5a5cb93:

    # zi "In that case, it’s a tool you can’t ignore."
    zi "Nesse caso, é uma ferramenta que não dá para ignorar."

# game/episode023_conversations.rpy:1797
translate portuguese ep023_raene_talk_d624d8a9:

    # c "A tool or a weapon."
    c " Uma ferramenta ou uma arma."

# game/episode023_conversations.rpy:1798
translate portuguese ep023_raene_talk_d1b0f247:

    # c "In any case something I can’t ignore."
    c "Enfim, é uma coisa que eu não posso ignorar."

# game/episode023_conversations.rpy:1800
translate portuguese ep023_raene_talk_87443cf0:

    # "We were all silent for a while."
    "Todos ficamos um tempo em silêncio."

# game/episode023_conversations.rpy:1801
translate portuguese ep023_raene_talk_5a51c907:

    # "Raene was the first to break the silence."
    "Raene foi a primeira a quebrar o silêncio."

# game/episode023_conversations.rpy:1803
translate portuguese ep023_raene_talk_4957be66:

    # ra "I forgot to ask why you were looking for me."
    ra "Eu esqueci de perguntar porque você estava me procurando."

# game/episode023_conversations.rpy:1804
translate portuguese ep023_raene_talk_1437962e:

    # c "I just wanted to see you."
    c "Eu só queria te ver."

# game/episode023_conversations.rpy:1805
translate portuguese ep023_raene_talk_a9c3d37f:

    # c "You weren’t in your quarters, so I went and looked and found you here."
    c "Você não estava no seu quarto, então procurei e te encontrei aqui."

# game/episode023_conversations.rpy:1807
translate portuguese ep023_raene_talk_eb4f2bc2:

    # ra "Oh...{w} I...{w} Uh...{w} I just want to talk to Ziv."
    ra "Ah...{w} Eu...{w} Ahm...{w} Eu só queria falar com a Ziv."

# game/episode023_conversations.rpy:1808
translate portuguese ep023_raene_talk_ab828c75:

    # ra "Sorry, I’m making it worse by stammering."
    ra "Desculpa, só estou piorando as coisas gaguejando."

# game/episode023_conversations.rpy:1809
translate portuguese ep023_raene_talk_2f04a6c7:

    # ra "Now it sounds like we were-"
    ra "Agora parece que nós-"

# game/episode023_conversations.rpy:1810
translate portuguese ep023_raene_talk_62b1e80e:

    # ra "We were just talking."
    ra "A gente já estava falando."

# game/episode023_conversations.rpy:1811
translate portuguese ep023_raene_talk_64719ec2:

    # c "I know, Raene."
    c "Eu sei, Raene."

# game/episode023_conversations.rpy:1812
translate portuguese ep023_raene_talk_733ba312:

    # c "I have no reason to suspect otherwise."
    c "Não tenho por que suspeitar."

# game/episode023_conversations.rpy:1814
