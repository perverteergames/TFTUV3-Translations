# game/episode023_conversations.rpy:1368
translate portuguese ep023_thyia_talk_522b81a1:

    # th "[p_name], I’m so glad to see you back on your feet again!"
    th "[p_name], é tão bom te ver de pé de novo!"

# game/episode023_conversations.rpy:1369
