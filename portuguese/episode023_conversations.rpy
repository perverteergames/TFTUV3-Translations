    th "Esse é o Autômato Função Flexível."

# game/episode023_conversations.rpy:1381
translate portuguese ep023_thyia_talk_1fdb8646:

    # c "So U.R.G.H. for short?"
    c "Então A.F.F.?"

# game/episode023_conversations.rpy:1382
translate portuguese ep023_thyia_talk_28f503fc:

    # th "Yup."
    th "Aham."

# game/episode023_conversations.rpy:1383
translate portuguese ep023_thyia_talk_5e56c4a2:

    # c "“Urgh” sounds like a very apt name."
    c "“Aff” parece um nome bem apto."

# game/episode023_conversations.rpy:1386
