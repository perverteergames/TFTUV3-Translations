    th "Sim, e já estou me arrependendo."

# game/episode023_conversations.rpy:1377
translate portuguese ep023_thyia_talk_76bcacc7:

    # ur "I’m right here, you know."
    ur "Eu estou bem aqui, sabia?"

# game/episode023_conversations.rpy:1379
translate portuguese ep023_thyia_talk_011c4a2c:

    # th "Alright."
    th "Tá."

# game/episode023_conversations.rpy:1380
translate portuguese ep023_thyia_talk_f7733d3e:

