    # c "You were worried I wouldn’t be able to take the shock?"
    c "Você estava preocupada que eu não ia aguentar o choque?"

# game/episode023.rpy:1405
translate portuguese ep023_crew_610711a1:

    # na "Maybe...{w} Something like that."
