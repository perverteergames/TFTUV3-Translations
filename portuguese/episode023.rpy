    # na "I hope so, [p_name_short], I really hope so."
    na "Tomara, [p_name_short]. Tomara mesmo."

# game/episode023.rpy:1452
translate portuguese ep023_crew_56c3579f:

    # c "We’ll get through this."
    c "A gente supera."

# game/episode023.rpy:1453
translate portuguese ep023_crew_598fe70e:

    # c "Our child is going to grow up in peace with a loving mother and father."
    c "Nosso bebê vai crescer em paz com uma com um pai e mãe que amam ele."

# game/episode023.rpy:1456
translate portuguese ep023_crew_4a05bada:

    # "My mother smiled hopefully and rested her head against my shoulder."
    "Minha mãe sorriu e descansou a cabeça no meu ombro."

# game/episode023.rpy:1458
translate portuguese ep023_crew_aee88a27:

    # "Nadya smiled hopefully and rested her head against my shoulder."
    "Nadya mãe sorriu e descansou a cabeça no meu ombro."

# game/episode023.rpy:1460
translate portuguese ep023_crew_18902aa3:

    # na "Could you perhaps visit my quarters later?"
    na "Você poderia passar no meu quarto depois? "

# game/episode023.rpy:1461
