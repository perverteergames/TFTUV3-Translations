# game/episode025.rpy:2162
translate french ep025_erigone_grove_b060eca6:

    # "We then headed back to the Shipyards and the daily worries."
    "On est ensuite retournées aux Chantiers navals et à nos soucis quotidiens."

# game/episode025.rpy:2172
