    # "Thyia rushed into my quarters right before we were to head out on the Bastard."
    "Thyia a fait irruption dans mes quartiers juste avant qu’on ne parte à bord du Bastard."

# game/episode025.rpy:2173
translate french ep025_erigone_thyia_99174a9e:

    # th "[p_name_short]!"
    th "[p_name_short] !"

# game/episode025.rpy:2178
translate french ep025_erigone_thyia_b692e7c6:

    # th "I wanted to catch you before we meet up with the rest of the crew."
    th "Je voulais te parler avant qu’on rejoigne le reste de l’équipage."

# game/episode025.rpy:2179
translate french ep025_erigone_thyia_81bd4fc0:

    # c "Is everything all right?"
    c "Tout va bien ?"

# game/episode025.rpy:2180
translate french ep025_erigone_thyia_a73c59c9:

    # th "Yes, I’m great!"
    th "Oui, je vais super bien !"

# game/episode025.rpy:2181
translate french ep025_erigone_thyia_c54d5ac4:

    # th "[p_name_short], I’m pregnant!"
    th "[p_name_short], je suis enceinte !"

# game/episode025.rpy:2189
translate french ep025_erigone_thyia_bfc58ed0:

    # "I took Thyia in my arms and kissed her."
    "J’ai pris Thyia dans mes bras et je l’ai embrassée."

# game/episode025.rpy:2190
translate french ep025_erigone_thyia_294a14ec:

    # c "I’m so happy for us!"
    c "Je suis tellement heureux pour nous !"

# game/episode025.rpy:2191
translate french ep025_erigone_thyia_e7b05aa3:

    # c "Did you find out today?"
    c "Tu l’as découvert aujourd’hui ?"

# game/episode025.rpy:2196
translate french ep025_erigone_thyia_4f7d1f6d:

    # th "Yes, I did a test and came as soon as I had the results."
    th "Oui, j’ai fait un test et je suis venue dès que j’ai eu les résultats."

# game/episode025.rpy:2197
translate french ep025_erigone_thyia_31c65f6b:

    # th "You can’t imagine how happy I am right now!"
    th "Tu ne peux pas imaginer à quel point je suis heureuse en ce moment !"

# game/episode025.rpy:2198
translate french ep025_erigone_thyia_0fff20cd:

    # c "Well, I have an idea."
    c "Eh bien, j’en ai une petite idée."

# game/episode025.rpy:2199
translate french ep025_erigone_thyia_aaa71be3:

    # c "Wow, Thyia."
    c "Waouh, Thyia."

# game/episode025.rpy:2200
