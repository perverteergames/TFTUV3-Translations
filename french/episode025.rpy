    # c "Nope!"
    c "Non !"

# game/episode025.rpy:2155
translate french ep025_erigone_grove_9cf18b47:

    # "Raene’s interruption had killed the mood somewhat."
    "L’interruption de Raene avait un peu cassé l’ambiance."

# game/episode025.rpy:2156
