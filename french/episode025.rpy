    ra "Oui, mais… {w} On aurait dit que j’interrompais quelque chose."

# game/episode025.rpy:2145
translate french ep025_erigone_grove_20532180:

    # c "We’ll let you know as soon as the lake is free."
    c "On te préviendra dès que le lac sera libre."

# game/episode025.rpy:2146
