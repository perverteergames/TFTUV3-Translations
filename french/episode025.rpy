# game/episode025.rpy:60
translate french episode025_4ac55ba7:

    # centered "{=chapter_heading}EPISODE 25{/=chapter_heading}"
    centered "{=chapter_heading}ÉPISODE 25{/=chapter_heading}"

# game/episode025.rpy:69
translate french episode025_bd708d91:

    # "Our arrival at Erigone was a lot different compared to the last time we visited."
    "Notre arrivée sur Erigone était bien différente de notre dernière visite."

# game/episode025.rpy:70
translate french episode025_f7486443:

    # "The graveyard of destroyed ships didn’t surprise us, nor were we targeted by missiles this time around."
    "Le cimetière de vaisseaux détruits ne nous a pas surpris, et on n’a pas non plus été pris pour cible par des missiles cette fois-ci."

# game/episode025.rpy:71
translate french episode025_7c8c2ced:

    # "It probably helped that Eva knew the proper authorization codes."
    "Le fait qu’Eva connaisse les bons codes d’autorisation a sûrement aidé."

# game/episode025.rpy:72
translate french episode025_b128ff81:

    # "As soon as we broke orbit, the lush forests of Erigone greeted us."
    "Dès qu’on est sortis d’orbite, les forêts luxuriantes d’Erigone nous ont accueillis."

# game/episode025.rpy:77
translate french episode025_1b68d19c:

    # "The verdant sight was marred by large plumes of smoke in the distance."
    "Ce paysage verdoyant était gâché par d’énormes panaches de fumée au loin."

# game/episode025.rpy:78
translate french episode025_e57f93f3:

    # "We picked up a radio signal almost immediately."
    "On a capté un signal radio presque tout de suite."

# game/episode025.rpy:84
translate french episode025_daeeb94f:

    # av "The signal is from the Citadel."
    av "Le signal vient de la Citadelle."

# game/episode025.rpy:85
translate french episode025_5066ff8d:

    # c "Put it through."
    c "Fais passer ça."

# game/episode025.rpy:87
translate french episode025_a52c3096:

    # woman "Erigone welcomes the Virgin Queen."
    woman "Erigone souhaite la bienvenue à la Reine Vierge."

# game/episode025.rpy:88
translate french episode025_6d1b41ec:

    # woman "Commander Rahia would like to request an official audience."
    woman "La commandante Rahia souhaiterait demander une audience officielle."

# game/episode025.rpy:89
translate french episode025_9c06534a:

    # woman "Guest rooms are being prepared as we speak."
    woman "Les chambres d’hôtes sont en train d’être préparées au moment où on parle."

# game/episode025.rpy:90
translate french episode025_92474673:

    # e "We thank you."
    e "On te remercie."

# game/episode025.rpy:91
translate french episode025_f5627722:

    # e "Commander Rahia’s request is hereby granted."
    e "La demande de la commandante Rahia est par la présente acceptée."

# game/episode025.rpy:96
translate french episode025_337b3696:

    # c "I forgot how much it turns me on when you’re being all royal."
    c "J’avais oublié à quel point ça m’excite quand tu te comportes en vraie reine."

# game/episode025.rpy:97
translate french episode025_b750d9ea:

    # e "Shut up, or I’ll let them behead you."
    e "Tais-toi, ou je vais les laisser te décapiter."

# game/episode025.rpy:98
translate french episode025_248fa3d5:

    # c "Apologies, my Queen."
    c "Toutes mes excuses, ma reine."

# game/episode025.rpy:99
translate french episode025_8871399a:

    # c "It seems Rahia has survived whatever war they’ve been fighting with the Priest caste so far."
    c "On dirait que Rahia a survécu à la guerre qu’ils menaient jusqu’à présent contre la caste des Prêtres."

# game/episode025.rpy:100
translate french episode025_8184c7e4:

    # e "Yes, it seems so."
    e "Oui, on dirait bien."

# game/episode025.rpy:101
translate french episode025_0df4792a:

    # e "Did you notice that black smoke on the horizon?"
    e "Tu as remarqué cette fumée noire à l’horizon ?"

# game/episode025.rpy:102
translate french episode025_b184f765:

    # c "I did, yes."
    c "Oui, je l’ai vue."

# game/episode025.rpy:103
translate french episode025_26156857:

    # e "I don’t think the war with the Priest caste is over."
    e "Je ne pense pas que la guerre contre la caste des Prêtres soit terminée."

# game/episode025.rpy:104
translate french episode025_ac2bea30:

    # c "Me neither."
    c "Moi non plus."

# game/episode025.rpy:105
translate french episode025_495608ce:

    # c "Rahia will undoubtedly bring us up to speed."
    c "Rahia va sans aucun doute nous mettre au courant."

# game/episode025.rpy:108
translate french episode025_9d8ecbb9:

    # av "The signal is from the Aegisthus Shipyards."
    av "Le signal vient des chantiers navals d’Aegisthus."

# game/episode025.rpy:109
translate french episode025_5066ff8d_1:

    # c "Put it through."
    c "Fais passer ça."

# game/episode025.rpy:110
translate french episode025_e14b2a00:

    # woman "Erigone is overjoyed by the Virgin Queen’s renewed presence."
    woman "Erigone est ravie du retour de la Reine Vierge."

# game/episode025.rpy:111
translate french episode025_2fa03145:

    # woman "Head Priestess Keodele humbly requests an audience."
    woman "La Grande Prêtresse Keodele demande humblement une audience."

# game/episode025.rpy:112
translate french episode025_68c83f09:

    # woman "Guest lodgings are being prepared and will be ready once you have landed."
    woman "Les quartiers d’hôtes sont en cours de préparation et seront prêts dès que tu auras atterri."

# game/episode025.rpy:113
translate french episode025_92474673_1:

    # e "We thank you."
    e "On te remercie."

# game/episode025.rpy:114
translate french episode025_d5a50623:

    # e "The Head Priestess’s request is hereby granted."
    e "La demande de la grande prêtresse est par la présente acceptée."

# game/episode025.rpy:119
translate french episode025_337b3696_1:

    # c "I forgot how much it turns me on when you’re being all royal."
    c "J’avais oublié à quel point ça m’excite quand tu te comportes en vraie reine."

# game/episode025.rpy:120
translate french episode025_b750d9ea_1:

    # e "Shut up, or I’ll let them behead you."
    e "Tais-toi, ou je vais les laisser te décapiter."

# game/episode025.rpy:121
translate french episode025_248fa3d5_1:

    # c "Apologies, my Queen."
    c "Toutes mes excuses, ma reine."

# game/episode025.rpy:122
translate french episode025_a0812fc7:

    # c "It seems the acolyte has usurped the position of her former master."
    c "On dirait que l’acolyte a usurpé la place de son ancien maître."

# game/episode025.rpy:124
translate french episode025_b9da0975:

    # e "Like mother, like daughter..."
    e "Telle mère, telle fille…"

# game/episode025.rpy:125
translate french episode025_112e561f:

    # c "I hope she’s more malleable than her mother."
    c "J’espère qu’elle est plus malléable que sa mère."

# game/episode025.rpy:127
translate french episode025_3248ce92:

    # e "She didn’t strike me as an ambitious type."
    e "Elle ne m’a pas donné l’impression d’être du genre ambitieuse."

# game/episode025.rpy:128
translate french episode025_370293fd:

    # c "The quiet ones never do."
    c "Les plus discrètes ne le sont jamais."

# game/episode025.rpy:129
translate french episode025_0df4792a_1:

    # e "Did you notice that black smoke on the horizon?"
    e "Tu as remarqué cette fumée noire à l’horizon ?"

# game/episode025.rpy:130
translate french episode025_b184f765_1:

    # c "I did, yes."
    c "Oui, je l’ai vue."

# game/episode025.rpy:131
translate french episode025_d49884ae:

    # e "I think they’re still at war with the Warrior caste."
    e "Je crois qu’ils sont toujours en guerre contre la caste des guerriers."

# game/episode025.rpy:132
translate french episode025_a15e975e:

    # c "That seems likely."
    c "Ça semble probable."

# game/episode025.rpy:133
translate french episode025_7084f486:

    # c "I’m sure Keodele will fill us in on all that."
    c "Je suis sûr que Keodele nous mettra au courant de tout ça."

# game/episode025.rpy:140
translate french episode025_76280e80:

    # "We took our time adjusting to life in the Citadel."
    "On a pris notre temps pour s’adapter à la vie dans la Citadelle."

# game/episode025.rpy:141
translate french episode025_dfab6f02:

    # "A bustle of activity went on day and night, which was a marked change to living on the Bastard."
    "Il y avait une effervescence d’activité jour et nuit, ce qui changeait radicalement de la vie sur le Bastard."

# game/episode025.rpy:142
translate french episode025_a50c9c26:

    # "The Citadel and immediate environs were deemed safe and its border patrolled heavily."
    "La Citadelle et ses environs immédiats étaient considérés comme sûrs et ses frontières étaient étroitement surveillées."

# game/episode025.rpy:143
translate french episode025_69d45064:

    # "We were allowed to roam the Citadel grounds and the jungle surrounding the complex."
    "On nous a autorisés à nous promener dans l’enceinte de la Citadelle et dans la jungle qui entoure le complexe."

# game/episode025.rpy:144
translate french episode025_9935f772:

    # "Eva was often called into meetings, so we didn’t see much of her."
    "Eva était souvent convoquée à des réunions, donc on ne la voyait pas beaucoup."

# game/episode025.rpy:145
translate french episode025_6b459ae2:

    # "The others roamed the halls and enjoyed the short respite from being in transit for so long."
    "Les autres arpentaient les couloirs et profitaient de ce bref répit après un si long voyage."

# game/episode025.rpy:148
translate french episode025_8601b255:

    # "We took our time adjusting to life at the Shipyards."
    "On a pris notre temps pour s’adapter à la vie aux Chantiers navals."

# game/episode025.rpy:149
translate french episode025_dfab6f02_1:

    # "A bustle of activity went on day and night, which was a marked change to living on the Bastard."
    "Il y avait une effervescence d’activité jour et nuit, ce qui changeait radicalement de la vie sur le Bastard."

# game/episode025.rpy:150
translate french episode025_4be7fe43:

    # "The Shipyards and immediate environs were deemed safe and its border patrolled heavily."
    "Les Chantiers navals et leurs environs immédiats étaient considérés comme sûrs et leurs frontières étaient étroitement surveillées."

# game/episode025.rpy:151
translate french episode025_aceb520b:

    # "We were allowed to roam the grounds and the jungle surrounding the complex."
    "On nous a autorisés à nous promener dans l’enceinte et dans la jungle qui entoure le complexe."

# game/episode025.rpy:152
translate french episode025_dfd08f74:

    # "The crew enjoyed the short respite from being in transit for so long."
    "L’équipage a profité de ce court répit après un si long voyage."

# game/episode025.rpy:190
translate french ep025_erigone_rahia_9128cb48:

    # "The Citadel appeared to be in a state of emergency."
    "La Citadelle semblait être en état d’urgence."

# game/episode025.rpy:191
translate french ep025_erigone_rahia_aa77e911:

    # "Many warriors roamed the halls and the many open areas were used for weapons training."
    "De nombreux guerriers arpentaient les couloirs et les nombreux espaces ouverts servaient à l’entraînement au maniement des armes."

# game/episode025.rpy:192
translate french ep025_erigone_rahia_f61aa3e6:

    # "We were assigned the same rooms as before, Eva had the royal quarters at her disposal."
    "On nous a attribué les mêmes chambres qu’avant, tandis qu’Eva disposait des appartements royaux."

# game/episode025.rpy:193
translate french ep025_erigone_rahia_7a43811d:

    # "It was there that Rahia came to meet us later in the day."
    "C’est là que Rahia est venue nous retrouver plus tard dans la journée."

# game/episode025.rpy:198
translate french ep025_erigone_rahia_441f0136:

    # rah "Apologies for the delay, my Queen."
    rah "Désolée pour le retard, ma reine."

# game/episode025.rpy:199
translate french ep025_erigone_rahia_214e1a7e:

    # rah "It seems that my days are filled with overlong strategy meetings."
    rah "On dirait que mes journées sont remplies de réunions stratégiques interminables."

# game/episode025.rpy:200
translate french ep025_erigone_rahia_9c9cd6a3:

    # e "No apologies necessary."
    e "Pas besoin de t'excuser."

# game/episode025.rpy:201
translate french ep025_erigone_rahia_9be95fa2:

    # e "And please call me Eva when we’re in private."
    e "Et appelle-moi Eva quand on est entre nous."

# game/episode025.rpy:206
translate french ep025_erigone_rahia_d324f40b:

    # rah "Of course, Your Majesty."
    rah "Bien sûr, Votre Majesté."

# game/episode025.rpy:207
translate french ep025_erigone_rahia_ca3df884:

    # "I couldn’t suppress a grin when I saw Eva struggle to keep herself from rolling her eyes."
    "Je n’ai pas pu m’empêcher de sourire en voyant Eva lutter pour ne pas lever les yeux au ciel."

# game/episode025.rpy:208
translate french ep025_erigone_rahia_6f7c6c07:

    # e "Has the conflict with the Priests not been resolved?"
    e "Le conflit avec les prêtres n’est-il pas encore résolu ?"

# game/episode025.rpy:210
translate french ep025_erigone_rahia_1788fd64:

    # rah "I’m afraid not."
    rah "J’ai bien peur que non."

# game/episode025.rpy:211
translate french ep025_erigone_rahia_798dce2f:

    # rah "After your departure, there were months of heavy fighting where we managed to recapture the Citadel."
    rah "Après ton départ, il y a eu des mois de combats acharnés au cours desquels on a réussi à reprendre la Citadelle."

# game/episode025.rpy:212
translate french ep025_erigone_rahia_077aab6b:

    # rah "It was a close thing and I believe we were only able to assert our dominance because the Priest caste was momentarily distracted by Erylin’s betrayal."
    rah "C’était moins une, et je crois qu’on n’a pu imposer notre domination que parce que la caste des prêtres a été momentanément distraite par la trahison d’Erylin."

# game/episode025.rpy:213
translate french ep025_erigone_rahia_fe98398f:

    # c "Yes, we saw her again."
    c "Oui, on l’a revue."

# game/episode025.rpy:214
translate french ep025_erigone_rahia_631b5bc8:

    # c "She struck a deal with the Confessor."
    c "Elle a conclu un accord avec le Confesseur."

# game/episode025.rpy:215
translate french ep025_erigone_rahia_bf0cb5c1:

    # rah "She did."
    rah "C’est vrai."

# game/episode025.rpy:216
translate french ep025_erigone_rahia_1322eb0c:

    # rah "I believe she was to take the entire Priest caste with her, but many refused."
    rah "Je crois qu’elle devait emmener toute la caste des prêtres avec elle, mais beaucoup ont refusé."

# game/episode025.rpy:218
translate french ep025_erigone_rahia_d887540c:

    # rah "It was her own daughter, Keodele, who led the revolt."
    rah "C’est sa propre fille, Keodele, qui a mené la révolte."

# game/episode025.rpy:220
translate french ep025_erigone_rahia_8eabe267:

    # rah "It was her own acolyte, Keodele, who led the revolt."
    rah "C’est sa propre acolyte, Keodele, qui a mené la révolte."

# game/episode025.rpy:221
translate french ep025_erigone_rahia_c1b77330:

    # c "Typical..."
    c "Typique…"

# game/episode025.rpy:223
translate french ep025_erigone_rahia_23d97181:

    # rah "At first we counted our blessings, but Keodele turned out to be much worse compared to Erylin."
    rah "Au début, on s’est estimé heureux, mais Keodele s’est avérée bien pire qu’Erylin."

# game/episode025.rpy:224
translate french ep025_erigone_rahia_4475a397:

    # c "She did?"
    c "Ah bon ?"

# game/episode025.rpy:225
translate french ep025_erigone_rahia_280e737d:

    # rah "Erylin always put her own interests first."
    rah "Erylin faisait toujours passer ses propres intérêts en premier."

# game/episode025.rpy:226
translate french ep025_erigone_rahia_f052640b:

    # rah "I doubt she was a true believer, but a power player at heart."
    rah "Je doute qu’elle fût une vraie croyante ; au fond, c’était plutôt une ambitieuse."

# game/episode025.rpy:228
translate french ep025_erigone_rahia_764c087c:

    # rah "Keodele is a true zealot and all the more dangerous for it."
    rah "Keodele, elle, est une vraie fanatique, ce qui la rend d’autant plus dangereuse."

# game/episode025.rpy:229
translate french ep025_erigone_rahia_4d3f3918:

    # c "In what way?"
    c "En quoi ?"

# game/episode025.rpy:230
translate french ep025_erigone_rahia_4f463806:

    # rah "The Priest caste has become more organized and more martial."
    rah "La caste des Prêtres est devenue plus organisée et plus belliqueuse."

# game/episode025.rpy:231
translate french ep025_erigone_rahia_7e57f0f2:

    # rah "We’ve defended ourselves against two waves of attacks on the Citadel so far."
    rah "Jusqu’à présent, on a repoussé deux vagues d’attaques contre la Citadelle."

# game/episode025.rpy:232
translate french ep025_erigone_rahia_bb5644f3:

    # rah "The attacks were timed so that we didn’t have time to launch counterattacks on the Aegisthus Shipyards."
    rah "Les attaques ont été planifiées pour qu’on n’ait pas le temps de lancer de contre-attaques sur les chantiers navals d’Aegisthus."

# game/episode025.rpy:234
translate french ep025_erigone_rahia_a9991033:

    # e "That’s their base of operations?"
    e "C’est leur base d’opérations ?"

# game/episode025.rpy:236
translate french ep025_erigone_rahia_83f9a79b:

    # rah "It is, yes."
    rah "Oui, c’est ça."

# game/episode025.rpy:237
translate french ep025_erigone_rahia_9631363f:

    # rah "They moved in almost right after you departed from the shipyard."
    rah "Ils se sont installés là presque juste après ton départ du chantier naval."

# game/episode025.rpy:238
translate french ep025_erigone_rahia_d814d3c3:

    # rah "It’s been a while since the last attack, but intelligence suggests that they’re gearing up for a large strike soon."
    rah "Ça fait un moment depuis la dernière attaque, mais les renseignements indiquent qu’ils se préparent à lancer une offensive de grande envergure d’ici peu."

# game/episode025.rpy:239
translate french ep025_erigone_rahia_280dc0a5:

    # rah "An attack that would break the Citadel’s defences once and for all."
    rah "Une attaque qui briserait les défenses de la Citadelle une bonne fois pour toutes."

# game/episode025.rpy:240
translate french ep025_erigone_rahia_dfb08ade:

    # c "The Priest caste must be feeling confident then?"
    c "La caste des prêtres doit donc se sentir en confiance ?"

# game/episode025.rpy:241
translate french ep025_erigone_rahia_3be709bd:

    # rah "They are."
    rah "Tout à fait."

# game/episode025.rpy:243
translate french ep025_erigone_rahia_dd1e3bae:

    # rah "Keodele’s sermons inspire them, but she has also started up a genetics program."
    rah "Les sermons de Keodele les inspirent, mais elle a aussi lancé un programme de génétique."

# game/episode025.rpy:248
translate french ep025_erigone_rahia_bcbee5cc:

    # rah "The treatments are said to be inspired by our Creator."
    rah "On dit que ces traitements s’inspirent de notre Créateur."

# game/episode025.rpy:249
translate french ep025_erigone_rahia_5f69fdfb:

    # e "You sound doubtful."
    e "Tu as l’air sceptique."

# game/episode025.rpy:251
translate french ep025_erigone_rahia_e241668b:

    # rah "Well, reports are scarce, because the program is very secret."
    rah "Eh bien, les infos sont rares, car ce programme est top secret."

# game/episode025.rpy:252
translate french ep025_erigone_rahia_88d9d15b:

    # rah "But what we have learned is troubling."
    rah "Mais ce qu’on a appris est inquiétant."

# game/episode025.rpy:253
translate french ep025_erigone_rahia_61779ba2:

    # rah "Keodele has apparently sanctioned direct experiments on her fellow Acarhyn in order to boost musculature and stamina."
    rah "Keodele aurait apparemment autorisé des expériences directes sur ses compatriotes Acarhyns afin d’augmenter leur musculature et leur endurance."

# game/episode025.rpy:254
translate french ep025_erigone_rahia_4675368f:

    # c "I take it they don’t perform those experiments on volunteer subjects?"
    c "Je suppose qu’ils ne font pas ces expériences sur des volontaires ?"

# game/episode025.rpy:256
translate french ep025_erigone_rahia_d609384e:

    # rah "Some Priests do, probably."
    rah "Certains prêtres le font, probablement."

# game/episode025.rpy:257
translate french ep025_erigone_rahia_d8cf8a15:

    # rah "The majority are prisoners and the local populace, by my reports."
    rah "D’après mes rapports, la majorité sont des prisonniers et des habitants de la région."

# game/episode025.rpy:258
translate french ep025_erigone_rahia_302e366a:

    # c "So members of the Warrior caste and bystanders?"
    c "Donc des membres de la caste des guerriers et des passants ?"

# game/episode025.rpy:260
translate french ep025_erigone_rahia_776f4ece:

    # rah "Yes, mostly."
    rah "Oui, pour la plupart."

# game/episode025.rpy:261
translate french ep025_erigone_rahia_07aec9f6:

    # rah "We’ve encountered some of the early experiments on the battlefield."
    rah "On a croisé certaines des premières victimes de ces expériences sur le champ de bataille."

# game/episode025.rpy:262
translate french ep025_erigone_rahia_2442e2c8:

    # rah "They’re formidable foes."
    rah "Ce sont des adversaires redoutables."

# game/episode025.rpy:263
translate french ep025_erigone_rahia_1e199295:

    # rah "Keodele has dubbed them Brutes."
    rah "Keodele les a surnommés les \" Brutes \"."

# game/episode025.rpy:264
translate french ep025_erigone_rahia_2df0a0c3:

    # c "Very original."
    c "Très original."

# game/episode025.rpy:267
translate french ep025_erigone_rahia_439d7f9e:

    # rah "You have to forgive her, as she only had her mother and scripture during her upbringing."
    rah "Faut lui pardonner, vu qu’elle n’a eu que sa mère et les Écritures pendant son enfance."

# game/episode025.rpy:269
translate french ep025_erigone_rahia_d01096cf:

    # rah "You have to forgive her, as she only had Erylin and scripture during her acolyte training."
    rah "Faut lui pardonner, vu qu’elle n’a eu qu’Erylin et les Écritures pendant sa formation d’acolyte."

# game/episode025.rpy:270
translate french ep025_erigone_rahia_2793f552:

    # rah "But the Brutes are large, powerful and quick for their size."
    rah "Mais les Brutes sont imposantes, puissantes et rapides pour leur taille."

# game/episode025.rpy:272
translate french ep025_erigone_rahia_732b1cf8:

    # rah "We’ve managed to capture one or two of the units and had a hard time keeping them contained."
    rah "On a réussi à capturer une ou deux de ces créatures et on a eu du mal à les garder enfermées."

# game/episode025.rpy:273
translate french ep025_erigone_rahia_e315e371:

    # rah "Both of them never made it past the fourth day of captivity."
    rah "Aucune des deux n’a tenu plus de quatre jours en captivité."

# game/episode025.rpy:274
translate french ep025_erigone_rahia_7e1239d2:

    # rah "And that wasn’t because they were mistreated, or denied food or care."
    rah "Et ce n’était pas parce qu’elles avaient été maltraitées, ni parce qu’on leur avait refusé de la nourriture ou des soins."

# game/episode025.rpy:275
translate french ep025_erigone_rahia_d798522d:

    # c "Some genetic deficiency?"
    c "Une déficience génétique, peut-être ?"

# game/episode025.rpy:276
translate french ep025_erigone_rahia_a5accdd1:

    # rah "Autopsy confirmed that one caught the common cold and her body couldn’t battle the symptoms."
    rah "L’autopsie a confirmé que l’une d’elles avait attrapé un rhume et que son corps n’avait pas pu lutter contre les symptômes."

# game/episode025.rpy:277
translate french ep025_erigone_rahia_16761da6:

    # rah "The other woman had a small laceration near her toes."
    rah "L’autre femme avait une petite lacération près des orteils."

# game/episode025.rpy:278
translate french ep025_erigone_rahia_baa4623e:

    # rah "She died of blood poisoning within hours after the cut became infected."
    rah "Elle est morte d’un empoisonnement du sang quelques heures après que la coupure se soit infectée."

# game/episode025.rpy:283
translate french ep025_erigone_rahia_32f27d87:

    # e "So the Brutes come with an expiration date as soon as they’ve been created."
    e "Les Brutes auraient donc une date d’expiration dès leur création."

# game/episode025.rpy:285
translate french ep025_erigone_rahia_b91c99f0:

    # rah "It appears so."
    rah "On dirait bien."

# game/episode025.rpy:286
translate french ep025_erigone_rahia_e3acff5a:

    # c "I guess sneaking someone inside Aegisthus Shipyards and sneezing all over the place is out of the question?"
    c "Je suppose qu’il est hors de question de faire entrer quelqu’un en cachette dans les chantiers navals d’Aegisthus et de faire éternuer partout ?"

# game/episode025.rpy:288
translate french ep025_erigone_rahia_93b1c5b5:

    # rah "I’m afraid biological warfare is very much against Acarhyn law."
    rah "J’ai bien peur que la guerre biologique soit strictement interdite par la loi d’Acarhyn."

# game/episode025.rpy:301
translate french ep025_erigone_rahia_d37e9228:

    # rah "The Citadel has staved off the attacks from the Priest caste so far and I’m confident we’ll do so again."
    rah "La Citadelle a repoussé les attaques de la caste des Prêtres jusqu’à présent et je suis convaincu que nous y parviendrons à nouveau."

# game/episode025.rpy:302
translate french ep025_erigone_rahia_bfdda158:

    # rah "You’re safe within the walls of the Citadel, but I urge Your Majesty to evacuate as soon as the tide of battle turns against us."
    rah "Tu es en sécurité entre les murs de la Citadelle, mais je t’exhorte, Votre Majesté, à évacuer dès que le cours de la bataille tournera à notre désavantage."

# game/episode025.rpy:307
translate french ep025_erigone_rahia_2e8a5fe0:

    # e "Of course."
    e "Bien sûr."

# game/episode025.rpy:309
translate french ep025_erigone_rahia_b98b79b0:

    # rah "It would be a privilege if you were to speak to the troops at some point during your stay."
    rah "Ce serait un privilège si tu pouvais t’adresser aux troupes à un moment donné pendant ton séjour."

# game/episode025.rpy:314
translate french ep025_erigone_rahia_8f988b15:

    # e "Yes, I’ll schedule an address for tomorrow."
    e "Oui, je vais programmer un discours pour demain."

# game/episode025.rpy:316
translate french ep025_erigone_rahia_7f606ac4:

    # rah "Do you wish to be present at the strategic briefings in the coming days?"
    rah "Souhaites-tu assister aux réunions stratégiques ces prochains jours ?"

# game/episode025.rpy:321
translate french ep025_erigone_rahia_75f4a0fd:

    # e "Yes, that would be helpful."
    e "Oui, ça serait utile."

# game/episode025.rpy:323
translate french ep025_erigone_rahia_8dda470c:

    # e "My brother wishes to join in as well."
    e "Mon frère souhaite y participer aussi."

# game/episode025.rpy:325
translate french ep025_erigone_rahia_b1f7f198:

    # e "[p_name] wishes to join in as well."
    e "[p_name] souhaite y participer aussi."

# game/episode025.rpy:327
translate french ep025_erigone_rahia_d15c5734:

    # rah "Very good."
    rah "Très bien."

# game/episode025.rpy:332
translate french ep025_erigone_rahia_74f67de1:

    # e "We have a request of our own which I would like to propose at one of those meetings."
    e "On a une demande à formuler, que j’aimerais proposer lors d’une de ces réunions."

# game/episode025.rpy:334
translate french ep025_erigone_rahia_e78c327c:

    # rah "Of course, I’ll amend the agenda."
    rah "Bien sûr, je modifierai l’ordre du jour."

# game/episode025.rpy:339
translate french ep025_erigone_rahia_c7a6de9e:

    # e "I know you’ve been preoccupied with battling the Priest caste and that Erigone is in isolation by design, but we have a request to make."
    e "Je sais que tu as été accaparé par la lutte contre la caste des Prêtres et qu’Erigone est volontairement isolée, mais on a une demande à te faire."

# game/episode025.rpy:340
translate french ep025_erigone_rahia_19169806:

    # e "There’s a war brewing between the Sovereignty and the rest of the known universe and without a strong coalition to oppose them, the outcome looks grim."
    e "Une guerre se prépare entre la Souveraineté et le reste de l’univers connu, et sans une coalition solide pour leur tenir tête, l’issue s’annonce sombre."

# game/episode025.rpy:342
translate french ep025_erigone_rahia_bbbbc63e:

    # rah "I see."
    rah "Je vois."

# game/episode025.rpy:343
translate french ep025_erigone_rahia_ae827db6:

    # rah "Is there a direct threat to Erigone?"
    rah "Y a-t-il une menace directe qui pèse sur Erigone ?"

# game/episode025.rpy:344
translate french ep025_erigone_rahia_f41ba07d:

    # c "Not yet."
    c "Pas encore."

# game/episode025.rpy:345
translate french ep025_erigone_rahia_2b4c8d8d:

    # c "But the location of the planet is known to Sovereignty, as is its significance."
    c "Mais l’emplacement de la planète est connu de la Souveraineté, tout comme son importance."

# game/episode025.rpy:346
translate french ep025_erigone_rahia_0e70340f:

    # rah "Significance?"
    rah "Son importance ?"

# game/episode025.rpy:347
translate french ep025_erigone_rahia_c372e6f6:

    # c "The new leader of the Sovereignty is our father."
    c "Le nouveau chef de la Souveraineté, c’est notre père."

# game/episode025.rpy:348
translate french ep025_erigone_rahia_8426c05d:

    # c "I’m fairly certain he’ll view the conquest of Erigone, ruled by his daughter, as a nice propaganda stunt."
    c "Je suis presque sûr qu’il verra la conquête d’Erigone, dirigée par sa fille, comme un joli coup de pub."

# game/episode025.rpy:350
translate french ep025_erigone_rahia_2c8f8589:

    # rah "We have a lot to discuss then."
    rah "On a donc beaucoup à discuter."

# game/episode025.rpy:351
translate french ep025_erigone_rahia_0026b10c:

    # rah "I will say this though, as long as the civil war on Erigone has not been resolved, I don’t see how we can make a meaningful contribution to a possible war effort."
    rah "Je dirai toutefois ceci : tant que la guerre civile sur Erigone n’aura pas été résolue, je ne vois pas comment on pourrait apporter une contribution significative à un éventuel effort de guerre."

# game/episode025.rpy:352
translate french ep025_erigone_rahia_24366554:

    # c "I understand."
    c "Je comprends."

# game/episode025.rpy:357
translate french ep025_erigone_rahia_a5c2c953:

    # e "All we ask is for our request to be heard."
    e "Tout ce qu’on demande, c’est que notre requête soit entendue."

# game/episode025.rpy:359
translate french ep025_erigone_rahia_dea3d9f7:

    # rah "That goes without saying, anything for our Queen."
    rah "Ça va de soi, on ferait n’importe quoi pour notre reine."

# game/episode025.rpy:360
translate french ep025_erigone_rahia_4be9aefb:

    # rah "I’ll leave you both to settle and will forward the invitation to the next war council."
    rah "Je vous laisse vous mettre d’accord et je transmettrai l’invitation au prochain conseil de guerre."

# game/episode025.rpy:365
translate french ep025_erigone_keodele_2512af87:

    # "We passed mechs, battleships and other military craft on our way to the main building."
    "On a croisé des méchas, des cuirassés et d’autres engins militaires en se rendant au bâtiment principal."

# game/episode025.rpy:366
translate french ep025_erigone_keodele_dcc5a8d8:

    # "All personnel were clearly briefed on our arrival and we were not stopped once."
    "Tout le personnel avait visiblement été informé de notre arrivée et on ne nous a pas arrêtés une seule fois."

# game/episode025.rpy:371
translate french ep025_erigone_keodele_d12a78ea:

    # "A contingent of priests was waiting for us in one of the hangar bays, Keodele in front."
    "Un contingent de prêtres nous attendait dans l’un des hangars, avec Keodele en tête."

# game/episode025.rpy:372
translate french ep025_erigone_keodele_0241d947:

    # "Outwardly, there was nothing visible of the timid and shy acolyte that accompanied the High Priestess everywhere, when Erylin was still in power."
    "En apparence, rien ne rappelait l’acolyte timide et réservée qui accompagnait partout la Grande Prêtresse, à l’époque où Erylin était encore au pouvoir."

# game/episode025.rpy:373
translate french ep025_erigone_keodele_7385027e:

    # "Still clad in red, Keodele wore the vestments of a High Priestess and the other priests seem to defer to her."
    "Toujours vêtue de rouge, Keodele portait les vêtements liturgiques d’une Grande Prêtresse et les autres prêtres semblaient lui témoigner du respect."

# game/episode025.rpy:375
translate french ep025_erigone_keodele_46748f57:

    # keo "Welcome, Virgin Queen."
    keo "Bienvenue, Reine Vierge."

# game/episode025.rpy:376
translate french ep025_erigone_keodele_43757ceb:

    # keo "We are once more honored by Your Presence."
    keo "Nous sommes une fois de plus honorés par ta présence."

# game/episode025.rpy:378
translate french ep025_erigone_keodele_2446e0e4:

    # e "The pleasure is ours, High Priestess."
    e "Tout le plaisir est pour nous, Grande Prêtresse."

# game/episode025.rpy:379
translate french ep025_erigone_keodele_3ad53f81:

    # e "Erigone seems to be at war."
    e "Erigone semble être en guerre."

# game/episode025.rpy:381
translate french ep025_erigone_keodele_f6efd5fd:

    # keo "Yes, the Warrior caste continues to be a major nuisance."
    keo "Oui, la caste des Guerriers continue d’être une véritable plaie."

# game/episode025.rpy:382
translate french ep025_erigone_keodele_f8f83e56:

    # keo "We are making good progress and have them cornered inside the Citadel, but their resistance remains."
    keo "On fait de bons progrès et on les a acculés à l’intérieur de la Citadelle, mais ils continuent de résister."

# game/episode025.rpy:384
translate french ep025_erigone_keodele_3e8671f8:

    # keo "The Warrior caste took advantage of my mother’s betrayal to launch an all out assault."
    keo "La caste des Guerriers a profité de la trahison de ma mère pour lancer un assaut en règle."

# game/episode025.rpy:386
translate french ep025_erigone_keodele_4c746745:

    # keo "The Warrior caste took advantage of High Priest Erylin’s betrayal to launch an all out assault."
    keo "La caste des Guerriers a profité de la trahison de la Grande Prêtresse Erylin pour lancer un assaut en règle."

# game/episode025.rpy:388
translate french ep025_erigone_keodele_7325d03e:

    # keo "We barely managed to survive that first attack, our sphere of influence reduced to the Aegisthus Shipyards and its immediate surroundings."
    keo "On a à peine réussi à survivre à cette première attaque ; notre sphère d’influence s’est réduite aux chantiers navals d’Aegisthus et à leurs environs immédiats."

# game/episode025.rpy:389
translate french ep025_erigone_keodele_480e40c5:

    # keo "Over the many months we have slowly, but surely regained control of large swaths of Erigone."
    keo "Au fil des mois, on a lentement, mais sûrement, repris le contrôle de vastes pans d’Érigone."

# game/episode025.rpy:394
translate french ep025_erigone_keodele_1263c90e:

    # e "We have met Erylin, she seems to have struck a deal with the Confessor."
    e "On a rencontré Erylin ; elle semble avoir conclu un accord avec la Confesseuse."

# game/episode025.rpy:396
translate french ep025_erigone_keodele_ca51fd82:

    # keo "She did, leaving us to deal with the mess she had created."
    keo "C’est vrai, nous laissant nous débrouiller avec le gâchis qu’elle avait créé."

# game/episode025.rpy:397
translate french ep025_erigone_keodele_013688a3:

    # keo "She wanted to take the entirety of my flock with her, but many refused."
    keo "Elle voulait emmener tout mon troupeau avec elle, mais beaucoup ont refusé."

# game/episode025.rpy:398
translate french ep025_erigone_keodele_24349a87:

    # keo "I led the revolt against her insidious attempts at sedition myself, which saved the Priest caste from splintering entirely."
    keo "J’ai moi-même mené la révolte contre ses tentatives insidieuses de sédition, ce qui a empêché la caste des prêtres de se diviser complètement."

# game/episode025.rpy:403
translate french ep025_erigone_keodele_a9ebb7b1:

    # e "You are to be commended for your bravery."
    e "Tu mérites d’être félicitée pour ton courage."

# game/episode025.rpy:405
translate french ep025_erigone_keodele_61511319:

    # keo "Thank you, Your Majesty."
    keo "Merci, Votre Majesté."

# game/episode025.rpy:406
translate french ep025_erigone_keodele_2a0849a3:

    # keo "We have trained and honed our martial skills in order to keep the enemy at bay."
    keo "On s’est entraînées et on a perfectionné nos compétences martiales pour tenir l’ennemi à distance."

# game/episode025.rpy:407
translate french ep025_erigone_keodele_ea91d9d1:

    # keo "I think Your Majesty will be very impressed by the transformation of our order."
    keo "Je pense que Ta Majesté sera très impressionnée par la transformation de notre ordre."

# game/episode025.rpy:412
translate french ep025_erigone_keodele_a8cdd9ea:

    # e "I’m sure we will be."
    e "On en est sûrs."

# game/episode025.rpy:414
translate french ep025_erigone_keodele_395ec5e6:

    # keo "It’s my hope that you will personally attend one of the Holy Sermons."
    keo "J’espère que tu assisteras personnellement à l’un des Sermons sacrés."

# game/episode025.rpy:415
translate french ep025_erigone_keodele_1cc98dda:

    # keo "Several new sisters are to be welcomed to the fold, their enhanced martial capabilities will be a great tool to smite our enemies."
    keo "Plusieurs nouvelles sœurs vont rejoindre nos rangs ; leurs capacités martiales améliorées seront un atout de taille pour terrasser nos ennemis."

# game/episode025.rpy:416
translate french ep025_erigone_keodele_628dd240:

    # keo "The Light of our Creator smiles upon these new Champions and the Priest caste as a whole."
    keo "La Lumière de notre Créateur sourit à ces nouvelles championnes et à la caste des Prêtres dans son ensemble."

# game/episode025.rpy:421
translate french ep025_erigone_keodele_a1449ba2:

    # e "We’d be honored to attend one of your sermons."
    e "On serait honorés d’assister à l’un de tes sermons."

# game/episode025.rpy:423
translate french ep025_erigone_keodele_841d4507:

    # keo "I’m glad to hear it."
    keo "Je suis ravie de l’entendre."

# game/episode025.rpy:424
translate french ep025_erigone_keodele_a5f53ec3:

    # keo "Rooms have been prepared for Your Majesty and her companions."
    keo "Des chambres ont été préparées pour Ta Majesté et ses compagnons."

# game/episode025.rpy:425
translate french ep025_erigone_keodele_ab3cd007:

    # keo "We will see to it that Your Majesty will enjoy her stay to the fullest."
    keo "Nous veillerons à ce que Ta Majesté profite pleinement de son séjour."

# game/episode025.rpy:430
translate french ep025_erigone_keodele_92474673:

    # e "We thank you."
    e "On te remercie."

# game/episode025.rpy:431
translate french ep025_erigone_keodele_f6beabc6:

    # e "We would also like to speak with you on official matters."
    e "Nous aimerions également t’entretenir de questions officielles."

# game/episode025.rpy:432
translate french ep025_erigone_keodele_6f29973e:

    # e "We are aware that battling the Warrior caste preoccupies you all at the moment and that Erigone is in isolation by design, but we have a request to make."
    e "Nous savons que la lutte contre la caste des guerriers vous accapare tous en ce moment et qu’Erigone est volontairement isolée, mais nous avons une requête à te présenter."

# game/episode025.rpy:433
translate french ep025_erigone_keodele_19169806:

    # e "There’s a war brewing between the Sovereignty and the rest of the known universe and without a strong coalition to oppose them, the outcome looks grim."
    e "Une guerre se prépare entre la Souveraineté et le reste de l’univers connu, et sans une coalition solide pour leur tenir tête, l’issue s’annonce sombre."

# game/episode025.rpy:435
translate french ep025_erigone_keodele_0869fac6:

    # keo "That’s worrying indeed."
    keo "C’est en effet inquiétant."

# game/episode025.rpy:436
translate french ep025_erigone_keodele_fe5b6cd6:

    # keo "Is Erigone under direct threat of these enemy forces?"
    keo "Erigone est-elle directement menacée par ces forces ennemies ?"

# game/episode025.rpy:441
translate french ep025_erigone_keodele_530032ee:

    # e "Not yet."
    e "Pas encore."

# game/episode025.rpy:442
translate french ep025_erigone_keodele_bf041693:

    # e "But Erigone’s location and its significance are known to the Sovereignty."
    e "Mais l’emplacement d’Erigone et son importance sont connus de la Souveraineté."

# game/episode025.rpy:444
translate french ep025_erigone_keodele_1287db91:

    # keo "Its significance, Your Majesty?"
    keo "Son importance, Votre Majesté ?"

# game/episode025.rpy:450
translate french ep025_erigone_keodele_e4634a64:

    # e "The new leader of the Sovereignty is our father."
    e "Le nouveau chef de la Souveraineté, c’est notre père."

# game/episode025.rpy:451
translate french ep025_erigone_keodele_34baa4e7:

    # e "It’s almost certain that he’ll view the conquest of Erigone, the seat of his daughter’s power, as an opportunity to create propaganda for the Sovereignty."
    e "Il est presque certain qu’il considérera la conquête d’Erigone, siège du pouvoir de sa fille, comme une occasion de faire de la propagande pour la Souveraineté."

# game/episode025.rpy:453
translate french ep025_erigone_keodele_86eb046c:

    # e "The new leader of the Sovereignty is [p_name]’s father."
    e "Le nouveau chef de la Souveraineté est le père de [p_name]."

# game/episode025.rpy:454
translate french ep025_erigone_keodele_04162c40:

    # e "It’s almost certain that he’ll view the conquest of Erigone, the seat of my power, as an opportunity to create propaganda for the Sovereignty."
    e "Il est presque certain qu’il verra dans la conquête d’Érigone, le siège de mon pouvoir, une occasion de faire de la propagande pour la Souveraineté."

# game/episode025.rpy:456
translate french ep025_erigone_keodele_90038fdc:

    # keo "I see."
    keo "Je vois."

# game/episode025.rpy:457
translate french ep025_erigone_keodele_62f757bf:

    # keo "We should discuss these matters at Your Majesty’s convenience."
    keo "On devrait discuter de ces questions quand ça t’arrangera, Votre Majesté."

# game/episode025.rpy:458
translate french ep025_erigone_keodele_0ce752e1:

    # keo "I would like to point out that as long as Erigone is divided in war, we will not be able to make a meaningful contribution to a possible war effort."
    keo "Je tiens à souligner que tant qu’Érigone sera déchirée par la guerre, on ne pourra pas apporter de contribution significative à un éventuel effort de guerre."

# game/episode025.rpy:463
translate french ep025_erigone_keodele_5d4a0355:

    # e "We understand."
    e "On comprend."

# game/episode025.rpy:464
translate french ep025_erigone_keodele_499cf609:

    # e "Resolving the current crisis is Our greatest priority."
    e "Résoudre la crise actuelle est notre priorité absolue."

# game/episode025.rpy:466
translate french ep025_erigone_keodele_69b42594:

    # keo "Thank you, my Queen."
    keo "Merci, ma reine."

# game/episode025.rpy:467
translate french ep025_erigone_keodele_ff87797d:

    # keo "I’ll leave you all to settle and we will speak soon of the matters at hand."
    keo "Je vous laisse vous installer et on reparlera bientôt des questions à l’ordre du jour."

# game/episode025.rpy:477
translate french ep025_erigone_council_7736bf8f:

    # "The War Council had gathered in the throne room of the Citadel."
    "Le Conseil de guerre s’était réuni dans la salle du trône de la Citadelle."

# game/episode025.rpy:479
translate french ep025_erigone_council_6a18bbf1:

    # "My sister was expected to preside over the meeting and had asked some of us to attend as well."
    "Ma sœur devait présider la réunion et avait demandé à certains d’entre nous d’y assister également."

# game/episode025.rpy:481
translate french ep025_erigone_council_5e81569d:

    # "Eva was expected to preside over the meeting and had asked some of us to attend as well."
    "Eva devait présider la réunion et avait demandé à certains d’entre nous d’y assister également."

# game/episode025.rpy:482
translate french ep025_erigone_council_7ca9fd1d:

    # "The first hours were spent detailing recent troop movements and the general state of the battlefield."
    "Les premières heures ont été consacrées à passer en revue les récents mouvements de troupes et la situation générale sur le champ de bataille."

# game/episode025.rpy:483
translate french ep025_erigone_council_67e1d696:

    # "The general consensus among the officers was that the Priest caste were likely gearing up to execute a final push in order to take the Citadel and environs."
    "Le consensus général parmi les officiers était que la caste des Prêtres se préparait probablement à lancer une offensive finale pour s’emparer de la Citadelle et de ses environs."

# game/episode025.rpy:485
translate french ep025_erigone_council_5c9c0c24:

    # rah "By making certain routes inaccessible and blowing up a few bridges, we are effectively funnelling the army of the Priests along this route."
    rah "En rendant certaines routes inaccessibles et en faisant sauter quelques ponts, on canalise efficacement l’armée des Prêtres sur cet itinéraire."

# game/episode025.rpy:486
translate french ep025_erigone_council_bccdb278:

    # rah "We should be able to ambush them and stage a confrontation here."
    rah "On devrait pouvoir leur tendre une embuscade et provoquer un affrontement ici."

# game/episode025.rpy:487
translate french ep025_erigone_council_d214ba17:

    # rah "The terrain will work in favor for us."
    rah "Le terrain jouera en notre faveur."

# game/episode025.rpy:488
translate french ep025_erigone_council_2e960094:

    # rah "The mountain range will obscure our aerial assault until the last moment."
    rah "La chaîne de montagnes masquera notre assaut aérien jusqu’au dernier moment."

# game/episode025.rpy:489
translate french ep025_erigone_council_b60275a7:

    # rah "After the bombardment, our ground troops will sweep in to deal with the remaining enemy forces."
    rah "Après le bombardement, nos troupes au sol interviendront pour venir à bout des forces ennemies restantes."

# game/episode025.rpy:490
translate french ep025_erigone_council_7a1879c7:

    # "All the gathered officers nodded in assent and looked at Eva to give her final approval."
    "Tous les officiers présents ont acquiescé d’un signe de tête et se sont tournés vers Eva pour qu’elle donne son accord final."

# game/episode025.rpy:495
translate french ep025_erigone_council_1ed32b1d:

    # e "We are pleased with the thorough preparations you have all undertaken."
    e "On est ravis des préparatifs minutieux que vous avez tous mis en place."

# game/episode025.rpy:496
translate french ep025_erigone_council_b5596d49:

    # e "The battle will be a defining moment in Acarhyn history."
    e "Cette bataille marquera un tournant dans l’histoire d’Acarhyn."

# game/episode025.rpy:497
translate french ep025_erigone_council_2e27981a:

    # e "And we are certain the Warrior caste will prevail and that together we will be able to usher our nation into a time of peace and prosperity."
    e "Et on est certains que la caste des Guerriers l’emportera et qu’ensemble, on pourra faire entrer notre nation dans une ère de paix et de prospérité."

# game/episode025.rpy:498
translate french ep025_erigone_council_d47322eb:

    # e "The threat against Erigone doesn’t just come from the inside though."
    e "Mais la menace qui pèse sur Erigone ne vient pas seulement de l’intérieur."

# game/episode025.rpy:499
translate french ep025_erigone_council_0865cfd3:

    # e "As we speak, forces are gathering in order to conquer large swaths of the known universe."
    e "Au moment même où on parle, des forces se rassemblent pour conquérir de vastes pans de l’univers connu."

# game/episode025.rpy:500
translate french ep025_erigone_council_25e4d7ff:

    # e "The Sovereignty has begun a campaign that will reshape the universe into a radically different place, if unopposed."
    e "La Souveraineté a lancé une campagne qui, si personne ne s’y oppose, va transformer l’univers en un endroit radicalement différent."

# game/episode025.rpy:501
translate french ep025_erigone_council_f6a01a72:

    # e "Many worlds have already fallen under the thrall of the Sovereignty and many more will follow, Erigone included."
    e "De nombreux mondes sont déjà tombés sous le joug de la Souveraineté et bien d’autres suivront, y compris Erigone."

# game/episode025.rpy:505
translate french ep025_erigone_council_effc1526:

    # woman "Is there reason to believe the Sovereignty has any special interest in Erigone, Your Majesty?"
    woman "Y a-t-il des raisons de croire que la Souveraineté s’intéresse particulièrement à Erigone, Votre Majesté ?"

# game/episode025.rpy:511
translate french ep025_erigone_council_773a8423:

    # e "Our father has usurped the mantle of leader of the Sovereignty and is directly responsible for these recent acts of aggression."
    e "Notre père a usurpé le rôle de chef de la Souveraineté et est directement responsable de ces récents actes d’agression."

# game/episode025.rpy:512
translate french ep025_erigone_council_42d91e86:

    # e "Our father has hunted us relentlessly and performed unspeakable experiments on Our Person."
    e "Notre père nous a pourchassés sans relâche et a mené des expériences innommables sur notre personne."

# game/episode025.rpy:513
translate french ep025_erigone_council_186c6e59:

    # e "The traitor Erylin is known to be in league with Our father."
    e "On sait que la traîtresse Erylin est de mèche avec notre père."

# game/episode025.rpy:515
translate french ep025_erigone_council_d7065310:

    # e "Agust has usurped the mantle of leader of the Sovereignty and is directly responsible for these recent acts of aggression."
    e "Agust a usurpé le titre de chef de la Souveraineté et est directement responsable de ces récents actes d’agression."

# game/episode025.rpy:516
translate french ep025_erigone_council_c809b4f3:

    # e "This man has hunted us relentlessly and performed unspeakable experiments on Our Person."
    e "Cet homme nous a pourchassés sans relâche et a mené des expériences innommables sur notre personne."

# game/episode025.rpy:517
translate french ep025_erigone_council_161ea975:

    # e "The traitor Erylin is known to be in league with Agust."
    e "On sait que la traîtresse Erylin est de mèche avec Agust."

# game/episode025.rpy:518
translate french ep025_erigone_council_24cf6d9f:

    # e "Subjugating Erigone or perhaps worse, is almost a certainty if we do not act now."
    e "La soumission d’Erigone, voire pire encore, est presque inévitable si on n’agit pas tout de suite."

# game/episode025.rpy:523
translate french ep025_erigone_council_93f9dd93:

    # e "We therefore humbly request you to join the alliance that we have been building, in order to combat the threat of the Sovereignty."
    e "On vous demande donc humblement de rejoindre l'alliance qu'on a mise en place pour lutter contre la menace que représente la Souveraineté."

# game/episode025.rpy:524
translate french ep025_erigone_council_24cd62fe:

    # "As Eva indicated she was done presenting her proposal, the Acarhyn commanders began to converse among themselves."
    "Alors qu’Eva indiquait qu’elle avait fini de présenter sa proposition, les commandants d’Acarhyn se mirent à discuter entre eux."

# game/episode025.rpy:525
translate french ep025_erigone_council_db9f4e6d:

    # "The discussions were heated, but ultimately all commanders seemed to defer to Rahia, who was the first to address Eva again."
    "Les discussions furent animées, mais finalement tous les commandants semblèrent s’en remettre à Rahia, qui fut la première à s’adresser à nouveau à Eva."

# game/episode025.rpy:527
translate french ep025_erigone_council_41b01d87:

    # rah "My Queen."
    rah "Ma Reine."

# game/episode025.rpy:528
translate french ep025_erigone_council_5379db5b:

    # rah "Our intelligence supports Your Majesty’s claims about the Sovereignty and their invasion."
    rah "Nos services de renseignement corroborent les affirmations de Votre Majesté concernant la Souveraineté et son invasion."

# game/episode025.rpy:529
translate french ep025_erigone_council_51135858:

    # rah "With Erigone still divided in civil war, we cannot afford to focus our efforts on two fronts."
    rah "Erigone étant toujours divisée par une guerre civile, on ne peut pas se permettre de concentrer nos efforts sur deux fronts."

# game/episode025.rpy:530
translate french ep025_erigone_council_fbad2743:

    # rah "We advise to resolve the conflict with the Priest caste first, before committing any troops to the alliance."
    rah "On te conseille de régler d’abord le conflit avec la caste des Prêtres, avant d’engager des troupes au sein de l’alliance."

# game/episode025.rpy:531
translate french ep025_erigone_council_1d74edfc:

    # rah "The coming battle we’ve spoken of before will decide the outcome of the civil war."
    rah "La bataille à venir, dont on a déjà parlé, décidera de l’issue de la guerre civile."

# game/episode025.rpy:532
translate french ep025_erigone_council_0c20ed5c:

    # rah "We will strike divisively and end this conflict in one fell swoop, after which all of Erigon’s military might will be available to the alliance."
    rah "On va frapper de manière décisive et mettre fin à ce conflit d’un seul coup, après quoi toute la puissance militaire d’Érigone sera à la disposition de l’alliance."

# game/episode025.rpy:537
translate french ep025_erigone_council_92474673:

    # e "We thank you."
    e "On te remercie."

# game/episode025.rpy:538
translate french ep025_erigone_council_9933c72d:

    # e "The Warrior caste raises valid concerns about Erigone’s internal security."
    e "La caste des Guerriers soulève des préoccupations légitimes concernant la sécurité intérieure d’Érigone."

# game/episode025.rpy:539
translate french ep025_erigone_council_a6943a07:

    # e "We agree that the conflict with the Priest case must be resolved first and grant you full permission to deal with the situation as you see fit."
    e "On est d’accord pour dire que le conflit avec la caste des Prêtres doit être résolu en premier et on t’accorde toute latitude pour gérer la situation comme tu l’entends."

# game/episode025.rpy:541
translate french ep025_erigone_council_80052ee9:

    # rah "Thank you, Your Majesty."
    rah "Merci, Votre Majesté."

# game/episode025.rpy:542
translate french ep025_erigone_council_4740ebdf:

    # rah "I’ve instructed our scouts to alert us the minute there is movement in our direction from Aegisthus Shipyards."
    rah "J’ai donné l’ordre à nos éclaireurs de nous alerter dès qu’il y aura du mouvement en notre direction depuis les chantiers navals d’Aegisthus."

# game/episode025.rpy:543
translate french ep025_erigone_council_728eaf73:

    # rah "Teams are already underway to prepare for the ambush."
    rah "Des équipes sont déjà en route pour préparer l’embuscade."

# game/episode025.rpy:544
translate french ep025_erigone_council_7751eee2:

    # rah "I will instruct others to make preparations for a military campaign outside Erigone’s planetary sphere."
    rah "Je vais demander à d’autres de se préparer pour une campagne militaire en dehors de l’espace planétaire d’Érigone."

# game/episode025.rpy:549
translate french ep025_erigone_council_574484dd:

    # e "This meeting is now adjourned."
    e "La réunion est levée."

# game/episode025.rpy:554
translate french ep025_erigone_council_05453b25:

    # "The commanders all left the throne room, leaving us behind."
    "Les commandants ont tous quitté la salle du trône, nous laissant seuls."

# game/episode025.rpy:555
translate french ep025_erigone_council_64e92085:

    # c "I guess this is the best we could have hoped for."
    c "Je suppose que c’est le mieux qu’on pouvait espérer."

# game/episode025.rpy:556
translate french ep025_erigone_council_5f2b7137:

    # e "Yes, I don’t see how this could have gone any different."
    e "Oui, je ne vois pas comment ça aurait pu se passer autrement."

# game/episode025.rpy:557
translate french ep025_erigone_council_25377112:

    # e "If the Warrior caste were to leave the planet now, Keodele and her priests would have no trouble taking the Citadel and squashing any opposition."
    e "Si la caste des Guerriers venait à quitter la planète maintenant, Keodele et ses prêtres n’auraient aucun mal à s’emparer de la Citadelle et à écraser toute opposition."

# game/episode025.rpy:558
translate french ep025_erigone_council_b74ce565:

    # c "Let’s hope the ambush will go as planned."
    c "Espérons que l’embuscade se passera comme prévu."

# game/episode025.rpy:563
translate french ep025_erigone_council_d65cd2e8:

    # e "Nothing more we can do, I’m afraid."
    e "On ne peut rien faire de plus, j’en ai bien peur."

# game/episode025.rpy:564
translate french ep025_erigone_council_53ecca32:

    # e "Shall we go back to my quarters?"
    e "On retourne dans mes appartements ?"

# game/episode025.rpy:565
translate french ep025_erigone_council_346f428a:

    # e "This throne isn’t the most comfortable, nor are these royal robes."
    e "Ce trône n’est pas des plus confortables, pas plus que ces robes royales."

# game/episode025.rpy:567
translate french ep025_erigone_council_e2853c15:

    # c "I think you look very sexy."
    c "Je te trouve super sexy."

# game/episode025.rpy:568
translate french ep025_erigone_council_e83825a0:

    # c "Hottest Queen ever!"
    c "La reine la plus sexy de tous les temps !"

# game/episode025.rpy:573
translate french ep025_erigone_council_2c479b13:

    # e "[p_name_short], if you utter one more word..."
    e "[p_name_short], si tu dis encore un mot…"

# game/episode025.rpy:574
translate french ep025_erigone_council_20d59369:

    # c "Yes, yes, call off the headsman already!"
    c "Oui, oui, rappelle déjà le bourreau !"

# game/episode025.rpy:575
translate french ep025_erigone_council_c14aca59:

    # "Bickering good-naturedly, we headed back to Eva’s quarters."
    "Tout en chichis, on est retournés dans les appartements d’Eva."

# game/episode025.rpy:577
translate french ep025_erigone_council_7207060f:

    # "We headed back to Eva’s quarters."
    "On est retournés dans les appartements d’Eva."

# game/episode025.rpy:583
translate french ep025_erigone_sermon_b6a9c254:

    # "Keodele’s sermon was to be held inside a large hall of the Shipyards."
    "Le sermon de Keodele devait avoir lieu dans une grande salle des chantiers navals."

# game/episode025.rpy:585
translate french ep025_erigone_sermon_d26f61a5:

    # "Several priests came to remind us about the imminent event, giving the impression that our attendance was far from optional."
    "Plusieurs prêtres sont venus nous rappeler l’événement imminent, nous donnant l’impression que notre présence était loin d’être facultative."

# game/episode025.rpy:586
translate french ep025_erigone_sermon_6bc3af24:

    # "All priests rose as Eva entered the chamber."
    "Tous les prêtres se levèrent quand Eva entra dans la salle."

# game/episode025.rpy:587
translate french ep025_erigone_sermon_5a403dae:

    # "Keodele stood in front of a large altar, looking quite regal in her High Priest attire."
    "Keodele se tenait devant un grand autel, l’air tout à fait majestueux dans sa tenue de grande prêtresse."

# game/episode025.rpy:592
translate french ep025_erigone_sermon_ead6a6e6:

    # keo "Welcome, we are graced by Your Presence, Your Majesty."
    keo "Bienvenue, on est honorés de ta présence, Votre Majesté."

# game/episode025.rpy:593
translate french ep025_erigone_sermon_12968fba:

    # e "We are pleased to attend your sermon, High Priestess."
    e "On est ravis d’assister à ton sermon, grande prêtresse."

# game/episode025.rpy:595
translate french ep025_erigone_sermon_05cf9bb7:

    # "Once we were standing at the front of the crowd, Keodele launched into a lengthy homily on the virtues of the Acarhyn’s alleged creator."
    "Une fois qu’on s’est retrouvés au premier rang, Keodele s’est lancée dans une longue homélie sur les vertus du soi-disant créateur de l’Acarhyn."

# game/episode025.rpy:596
translate french ep025_erigone_sermon_f374e906:

    # "Her lecture put a great emphasis on genetic manipulation and its supposed positive aspects."
    "Son discours mettait fortement l’accent sur la manipulation génétique et ses prétendus aspects positifs."

# game/episode025.rpy:597
translate french ep025_erigone_sermon_b446359f:

    # "I could tell she was paving the way for something and considering the rapt attention of her audience, she was succeeding."
    "Je voyais bien qu’elle préparait le terrain pour quelque chose et, vu l’attention captivée de son public, elle y parvenait."

# game/episode025.rpy:599
translate french ep025_erigone_sermon_ff29d223:

    # keo "With the knowledge granted us by the Creator, we will smite our enemies!"
    keo "Grâce au savoir que nous a accordé le Créateur, on va anéantir nos ennemis !"

# game/episode025.rpy:600
translate french ep025_erigone_sermon_08bc9582:

    # keo "Erigone will become a tranquil, verdant paradise once more."
    keo "Erigone redeviendra un paradis paisible et verdoyant."

# game/episode025.rpy:601
translate french ep025_erigone_sermon_5d319799:

    # keo "Sisters, in a few days we will finally strike a crippling blow to the Warrior caste."
    keo "Mes sœurs, dans quelques jours, on va enfin porter un coup fatal à la caste des Guerriers."

# game/episode025.rpy:602
translate french ep025_erigone_sermon_4948f401:

    # keo "We will go to battle and deal with the threat once and for all."
    keo "On partira au combat et on viendra à bout de cette menace une bonne fois pour toutes."

# game/episode025.rpy:603
translate french ep025_erigone_sermon_f0939e2f:

    # keo "Complete surrender of the Warrior caste is what we will accomplish."
    keo "On obtiendra la capitulation totale de la caste des Guerriers."

# game/episode025.rpy:604
translate french ep025_erigone_sermon_e5490f64:

    # keo "Once we have achieved this, the Priest caste will venture out on behest of our Queen and spread the Holy Word of our Creator to the rest of the universe."
    keo "Une fois cet objectif atteint, la caste des Prêtres partira à la demande de notre Reine pour diffuser la Parole sacrée de notre Créateur dans le reste de l’univers."

# game/episode025.rpy:606
translate french ep025_erigone_sermon_df07b5df:

    # "A deafening cheer erupted from the many priests that were in attendance."
    "Une acclamation assourdissante jaillit de la foule des prêtres présents."

# game/episode025.rpy:607
translate french ep025_erigone_sermon_5c57d90b:

    # "Keodele inclined her head toward Eva."
    "Keodele inclina la tête vers Eva."

# game/episode025.rpy:608
translate french ep025_erigone_sermon_af516b14:

    # "We had secured our commitment to the war against the Sovereignty."
    "On avait obtenu notre engagement dans la guerre contre la Souveraineté."

# game/episode025.rpy:610
translate french ep025_erigone_sermon_40deaa3a:

    # keo "Rejoice, Sisters!"
    keo "Réjouissez-vous, mes sœurs !"

# game/episode025.rpy:611
translate french ep025_erigone_sermon_edbf7904:

    # keo "Another regiment of Brutes has matured, who will help us achieve our victory."
    keo "Un nouveau régiment de Brutes a atteint sa maturité, et il va nous aider à remporter la victoire."

# game/episode025.rpy:613
translate french ep025_erigone_sermon_639e51f2:

    # "Heavy footsteps resounded in the hallway behind us."
    "Des pas lourds résonnèrent dans le couloir derrière nous."

# game/episode025.rpy:614
translate french ep025_erigone_sermon_c23c10ed:

    # "Two priestesses entered the hall, flanking a monstrous figure, who dominated the chamber."
    "Deux prêtresses entrèrent dans la salle, encadrant une silhouette monstrueuse qui dominait la pièce."

# game/episode025.rpy:615
translate french ep025_erigone_sermon_07614f98:

    # "The monstrosity halted before Keodele."
    "La monstruosité s’arrêta devant Keodele."

# game/episode025.rpy:617
translate french ep025_erigone_sermon_3e848fee:

    # keo "Behold, our latest addition to the war effort."
    keo "Contemplez notre dernière recrue pour l’effort de guerre."

# game/episode025.rpy:618
translate french ep025_erigone_sermon_4796677a:

    # keo "This Brute is bigger, better and stronger than the generation before her."
    keo "Cette Brute est plus grande, meilleure et plus forte que la génération qui l’a précédée."

# game/episode025.rpy:620
translate french ep025_erigone_sermon_b79c6c17:

    # "The High Priestess didn’t seem fazed, but concerned murmurs emanated from the audience."
    "La Grande Prêtresse ne semblait pas décontenancée, mais des murmures inquiets s’élevaient de l’assistance."

# game/episode025.rpy:621
translate french ep025_erigone_sermon_a3b0fd6b:

    # keo "Are you ready to fight?"
    keo "T’es prête à te battre ?"

# game/episode025.rpy:622
translate french ep025_erigone_sermon_cf49a1e3:

    # "The Brute grunted in response."
    "La Brute grogna en guise de réponse."

# game/episode025.rpy:623
translate french ep025_erigone_sermon_08f65a16:

    # keo "I say, are you ready to fight?!"
    keo "Je te le demande, t’es prête à te battre ?!"

# game/episode025.rpy:625
translate french ep025_erigone_sermon_784a0cd8:

    # "Prompted by Keodele, the Brute let out an ear-splitting roar, which blended with the cheers that now erupted from the other priestesses."
    "À l’invitations de Keodele, la Brute poussa un rugissement assourdissant, qui se mêla aux acclamations qui éclataient désormais chez les autres prêtresses."

# game/episode025.rpy:626
translate french ep025_erigone_sermon_fe8c4ba5:

    # "When the noise had died down, the Brute was guided back out of the room."
    "Une fois le bruit retombé, la Brute fut reconduite hors de la salle."

# game/episode025.rpy:628
translate french ep025_erigone_sermon_5e1fdcc8:

    # "Keodele spewed more religious platitudes and issued a final battle prayer to close off the ritual."
    "Keodele débita encore quelques platitudes religieuses et prononça une dernière prière de combat pour clore le rituel."

# game/episode025.rpy:629
translate french ep025_erigone_sermon_e9b1bd3b:

    # "As the room emptied, she came toward us."
    "Alors que la salle se vidait, elle vint vers nous."

# game/episode025.rpy:643
translate french ep025_erigone_sermon_c69e1d3e:

    # keo "What did you think, My Queen?"
    keo "Qu’en as-tu pensé, Ma Reine ?"

# game/episode025.rpy:648
translate french ep025_erigone_sermon_fbe3bb3d:

    # e "An impressive display of strength, to be sure."
    e "Une impressionnante démonstration de force, c’est certain."

# game/episode025.rpy:649
translate french ep025_erigone_sermon_79f742f0:

    # e "We take it you are confident about your chances against the Warrior caste."
    e "On en déduit que tu es confiante quant à tes chances face à la caste des Guerriers."

# game/episode025.rpy:651
translate french ep025_erigone_sermon_22a7678b:

    # keo "Very much so, Your Majesty."
    keo "Tout à fait, Votre Majesté."

# game/episode025.rpy:652
translate french ep025_erigone_sermon_d3dc1630:

    # keo "We will crush the Warrior caste and deal with their civil disobedience once and for all."
    keo "On va écraser la caste des Guerriers et régler leur problème de désobéissance civile une bonne fois pour toutes."

# game/episode025.rpy:657
translate french ep025_erigone_sermon_14259d8b:

    # e "Very good."
    e "Très bien."

# game/episode025.rpy:658
translate french ep025_erigone_sermon_def39184:

    # e "We were interested in learning more about the Brutes."
    e "On aimerait en savoir plus sur les Brutes."

# game/episode025.rpy:660
translate french ep025_erigone_sermon_7fff13ee:

    # keo "Of course, Your Majesty."
    keo "Bien sûr, Votre Majesté."

# game/episode025.rpy:661
translate french ep025_erigone_sermon_d8e97708:

    # keo "Allow me to accompany you to the facility where we work on creating the Perfections of the Creator’s Vision."
    keo "Permets-moi de t’accompagner jusqu’aux installations où on travaille à la création des \" Perfectionnements de la Vision du Créateur \"."

# game/episode025.rpy:666
translate french ep025_erigone_sermon_d7aabed6:

    # "Keodele seemed to be utterly sincere uttering that last statement."
    "Keodele semblait tout à fait sincère en prononçant cette dernière phrase."

# game/episode025.rpy:671
translate french ep025_erigone_sermon_7c234bb8:

    # "We followed her through the complex to a gate, guarded by two Priestesses."
    "On l’a suivie à travers le complexe jusqu’à une porte, gardée par deux Prêtresses."

# game/episode025.rpy:672
translate french ep025_erigone_sermon_1372b687:

    # keo "The Queen wishes to inspect our work."
    keo "La Reine souhaite inspecter notre travail."

# game/episode025.rpy:677
translate french ep025_erigone_sermon_a3d93b2a:

    # "The gate gave access to a large laboratory."
    "La porte donnait accès à un grand laboratoire."

# game/episode025.rpy:678
translate french ep025_erigone_sermon_9a56a47e:

    # keo "This is the main operating theatre, where the Potentials are treated."
    keo "C’est le bloc opératoire principal, où les Potentiels sont traités."

# game/episode025.rpy:679
translate french ep025_erigone_sermon_fb16370d:

    # e "Treated how?"
    e "Traités comment ?"

# game/episode025.rpy:680
translate french ep025_erigone_sermon_18ba773b:

    # keo "Over the course of several days, they’re given various substances, allowing for rapid muscle growth and other physical enhancers."
    keo "Pendant plusieurs jours, on leur administre diverses substances qui favorisent une croissance musculaire rapide et d’autres améliorations physiques."

# game/episode025.rpy:681
translate french ep025_erigone_sermon_69e6930a:

    # keo "We start with a regular Acarhyn and develop it into a more perfect being, following the Sacred Tenets of Our Creator in the process."
    keo "On part d’un Acarhyn ordinaire et on le transforme en un être plus parfait, en suivant les principes sacrés de notre Créateur."

# game/episode025.rpy:686
translate french ep025_erigone_sermon_7c8e78e6:

    # e "So you are enhancing their abilities and physical appearance?"
    e "Donc, tu améliores leurs capacités et leur apparence physique ?"

# game/episode025.rpy:688
translate french ep025_erigone_sermon_99b463f0:

    # keo "Certainly, Your Majesty."
    keo "Tout à fait, Votre Majesté."

# game/episode025.rpy:689
translate french ep025_erigone_sermon_fd222c60:

    # keo "The resulting Brute is a stronger and in many ways better Acarhyn."
    keo "La Brute qui en résulte est un Acarhyn plus fort et, à bien des égards, meilleur."

# game/episode025.rpy:690
translate french ep025_erigone_sermon_3cdb1bc4:

    # keo "A formidable opponent on the battlefield and a cunning strategist, despite appearances to the contrary."
    keo "Un adversaire redoutable sur le champ de bataille et un stratège rusé, malgré les apparences."

# game/episode025.rpy:691
translate french ep025_erigone_sermon_41ccef43:

    # e "And all of the Brutes are volunteers?"
    e "Et tous les Brutes sont des volontaires ?"

# game/episode025.rpy:693
translate french ep025_erigone_sermon_16245d0e:

    # keo "Many of them are."
    keo "Beaucoup d’entre eux, oui."

# game/episode025.rpy:694
translate french ep025_erigone_sermon_79e51c8c:

    # keo "The need for an edge against the Warrior caste is so great, however, that we have decided to ask the general populace to sacrifice their own for the greater good."
    keo "Mais le besoin d’un avantage face à la caste des Guerriers est si grand qu’on a décidé de demander à la population de sacrifier les siens pour le bien commun."

# game/episode025.rpy:695
translate french ep025_erigone_sermon_d1adc652:

    # keo "We are also still perfecting the process of creating Brutes."
    keo "On continue aussi à perfectionner le processus de création des Brutes."

# game/episode025.rpy:696
translate french ep025_erigone_sermon_80f20374:

    # keo "The current generation has a significantly longer lifespan than the previous iterations."
    keo "La génération actuelle a une durée de vie nettement plus longue que les précédentes."

# game/episode025.rpy:697
translate french ep025_erigone_sermon_f2fcdd41:

    # keo "Infections are an issue, for example."
    keo "Les infections posent problème, par exemple."

# game/episode025.rpy:698
translate french ep025_erigone_sermon_34c686e6:

    # keo "But I am sure we will weed these kinks out as soon as possible."
    keo "Mais je suis sûr qu’on va régler ces petits soucis dès que possible."

# game/episode025.rpy:699
translate french ep025_erigone_sermon_f08dd06d:

    # c "How long a lifespan are we talking about exactly?"
    c "De quelle durée de vie parle-t-on exactement ?"

# game/episode025.rpy:701
translate french ep025_erigone_sermon_b775fd52:

    # keo "Several months."
    keo "Plusieurs mois."

# game/episode025.rpy:702
translate french ep025_erigone_sermon_951b83ca:

    # c "Months..."
    c "Des mois…"

# game/episode025.rpy:703
translate french ep025_erigone_sermon_8e7282da:

    # keo "Considering the first Brute lasted only two hours, I’d say that’s much progress indeed."
    keo "Vu que le premier Brute n’a tenu que deux heures, je dirais que c’est vraiment un grand progrès."

# game/episode025.rpy:704
translate french ep025_erigone_sermon_6b5fd326:

    # keo "As I’ve said, illness is our main factor of concern now."
    keo "Comme je l’ai dit, la maladie est notre principale source d’inquiétude pour l’instant."

# game/episode025.rpy:705
translate french ep025_erigone_sermon_a752bc73:

    # keo "Once a Brute is infected with even the most common maladies, they will often succumb within the hour."
    keo "Dès qu’un Brute est infecté, même par les maladies les plus courantes, il succombe souvent en moins d’une heure."

# game/episode025.rpy:710
translate french ep025_erigone_sermon_caadb990:

    # e "They die within an hour of a cold?"
    e "Ils meurent en moins d’une heure d’un simple rhume ?"

# game/episode025.rpy:712
translate french ep025_erigone_sermon_6a4644e3:

    # keo "Unfortunately so."
    keo "Malheureusement, oui."

# game/episode025.rpy:713
translate french ep025_erigone_sermon_aa3ee9ee:

    # keo "There have been several promising theories regarding the cause and proposals to fix this."
    keo "Il y a eu plusieurs théories prometteuses sur la cause et des propositions pour y remédier."

# game/episode025.rpy:714
translate french ep025_erigone_sermon_f254ec78:

    # "Eva was clearly horrified by Keodele’s clinical discussions of what amounted to human experimenting."
    "Eva était clairement horrifiée par les discussions cliniques de Keodele sur ce qui s’apparentait à de l’expérimentation humaine."

# game/episode025.rpy:723
translate french ep025_erigone_sermon_6dbba6cc:

    # "Before she could voice her opinion, we were interrupted by a Priest."
    "Avant qu’elle n’ait pu exprimer son opinion, on a été interrompus par un prêtre."

# game/episode025.rpy:726
translate french ep025_erigone_sermon_2e19b3fd:

    # woman "High Priestess, your attendance is required at once."
    woman "Grande Prêtresse, on a besoin de toi tout de suite."

# game/episode025.rpy:727
translate french ep025_erigone_sermon_3c682f28:

    # keo "Of course."
    keo "Bien sûr."

# game/episode025.rpy:729
translate french ep025_erigone_sermon_134e1384:

    # keo "Your Majesty, if you’ll please excuse me."
    keo "Votre Majesté, si tu veux bien m’excuser."

# game/episode025.rpy:730
translate french ep025_erigone_sermon_5587e3d2:

    # keo "I will be at Your Majesty’s disposal as soon as I conclude this business."
    keo "Je serai à la disposition de Votre Majesté dès que j’aurai réglé cette affaire."

# game/episode025.rpy:731
translate french ep025_erigone_sermon_44c9741e:

    # keo "I’ll instruct one of the guards to escort you back to your quarters once you’re ready."
    keo "Je vais demander à un des gardes de t’escorter jusqu’à tes appartements dès que tu seras prête."

# game/episode025.rpy:736
translate french ep025_erigone_sermon_cebc7832:

    # "Keodele left us in the laboratory to deal with whatever crisis she was called away for."
    "Keodele nous a laissés dans le laboratoire pour s’occuper de la crise qui l’avait fait partir en urgence."

# game/episode025.rpy:741
translate french ep025_erigone_sermon_a364c45b:

    # e "I’m going to demand she put a stop to this."
    e "Je vais exiger qu’elle mette fin à tout ça."

# game/episode025.rpy:742
translate french ep025_erigone_sermon_e09729fd:

    # e "They’re forcibly taking civilians and conducting experiments on them."
    e "Ils enlèvent des civils de force et mènent des expériences sur eux."

# game/episode025.rpy:746
translate french ep025_erigone_sermon_89ea8804:

    # c "Yeah, it’s sickening."
    c "Ouais, c’est écœurant."

# game/episode025.rpy:747
translate french ep025_erigone_sermon_eb83abc1:

    # c "No amount of religious window-dressing can ever hide the fact of what they’re doing."
    c "Aucune façade religieuse ne pourra jamais cacher ce qu’ils sont en train de faire."

# game/episode025.rpy:748
translate french ep025_erigone_sermon_b390f688:

    # e "I’m going to formally demand they put a stop to this."
    e "Je vais exiger officiellement qu’ils mettent fin à tout ça."

# game/episode025.rpy:749
translate french ep025_erigone_sermon_ea4adb02:

    # c "I’m not sure Keodele will listen to you, but it’s good to make yourself heard."
    c "Je ne suis pas sûr que Keodele t’écoute, mais c’est bien de te faire entendre."

# game/episode025.rpy:750
translate french ep025_erigone_sermon_05364ff8:

    # e "Agreed."
    e "Je suis d’accord."

# game/episode025.rpy:755
translate french ep025_erigone_sermon_73a1b510:

    # e "Shall we leave this place?"
    e "On part d’ici ?"

# game/episode025.rpy:756
translate french ep025_erigone_sermon_bee33b8a:

    # c "Yes, not much we can do here, I’m afraid."
    c "Oui, j’ai bien peur qu’on ne puisse pas faire grand-chose ici."

# game/episode025.rpy:758
translate french ep025_erigone_sermon_d58538a7:

    # c "The Priests are currently at war."
    c "Les Prêtres sont actuellement en guerre."

# game/episode025.rpy:759
translate french ep025_erigone_sermon_8cfb0dc4:

    # c "I think they need every advantage they can get."
    c "Je pense qu’ils ont besoin de tous les atouts possibles."

# game/episode025.rpy:764
translate french ep025_erigone_sermon_645d328e:

    # e "It’s illegal by any moral or legal code in existence!"
    e "C’est illégal selon n’importe quel code moral ou juridique existant !"

# game/episode025.rpy:765
translate french ep025_erigone_sermon_b390f688_1:

    # e "I’m going to formally demand they put a stop to this."
    e "Je vais exiger officiellement qu’ils mettent fin à tout ça."

# game/episode025.rpy:766
translate french ep025_erigone_sermon_fbb7cdb5:

    # c "I’m not sure Keodele will listen to you."
    c "Je ne suis pas sûr que Keodele t’écoute."

# game/episode025.rpy:767
translate french ep025_erigone_sermon_1d7a4bc4:

    # c "And we need their help after they defeat the Warrior caste."
    c "Et on aura besoin de leur aide une fois qu’ils auront vaincu la caste des Guerriers."

# game/episode025.rpy:772
translate french ep025_erigone_sermon_7cf9b849:

    # e "I don’t care."
    e "Je m’en fiche."

# game/episode025.rpy:773
translate french ep025_erigone_sermon_52773d55:

    # e "You’re right that we need them, so I won't risk our alliance with the Priest caste, but I won’t be complicit in this."
    e "Tu as raison, on a besoin d’eux, donc je ne vais pas mettre en péril notre alliance avec la caste des Prêtres, mais je ne serai pas complice de ça."

# game/episode025.rpy:778
translate french ep025_erigone_sermon_73a1b510_1:

    # e "Shall we leave this place?"
    e "On part d’ici ?"

# game/episode025.rpy:780
translate french ep025_erigone_sermon_056c3112:

    # "Eva and I left the laboratory and headed back to our quarters."
    "Eva et moi avons quitté le laboratoire et sommes retournées dans nos quartiers."

# game/episode025.rpy:791
translate french ep025_erigone_battle_c4494b81:

    # "Asked by Rahia, Eva was to address the troops on the eve of the Battle for Erigone."
    "À la demande de Rahia, Eva devait s’adresser aux troupes à la veille de la bataille d’Érigone."

# game/episode025.rpy:792
translate french ep025_erigone_battle_8f9c092d:

    # "In the courtyard of the Citadel, Eva was standing on a podium."
    "Dans la cour de la Citadelle, Eva se tenait sur un podium."

# game/episode025.rpy:798
translate french ep025_erigone_battle_c1b0af03:

    # "Asked by Keodele, Eva was to address the troops on the eve of the Battle for Erigone."
    "À la demande de Keodele, Eva devait s’adresser aux troupes à la veille de la bataille d’Erigone."

# game/episode025.rpy:799
translate french ep025_erigone_battle_cfd4f455:

    # "On the tarmac in front of the main building of the Shipyards, Eva was standing on a podium."
    "Sur le tarmac devant le bâtiment principal des chantiers navals, Eva se tenait sur un podium."

# game/episode025.rpy:800
translate french ep025_erigone_battle_c70c5a8e:

    # e "My fellow Acarhyn."
    e "Mes chers Acarhyn."

# game/episode025.rpy:801
translate french ep025_erigone_battle_80a6322a:

    # e "Tomorrow will be a defining day for our nation."
    e "Demain sera un jour décisif pour notre nation."

# game/episode025.rpy:807
translate french ep025_erigone_battle_af6e89c2:

    # e "Tomorrow, the Priest caste will be stopped."
    e "Demain, on mettra un terme aux agissements de la caste des Prêtres."

# game/episode025.rpy:813
translate french ep025_erigone_battle_06d247a7:

    # e "Tomorrow, the Warrior caste will be stopped."
    e "Demain, on mettra un terme à la caste des Guerriers."

# game/episode025.rpy:814
translate french ep025_erigone_battle_67a0f211:

    # e "Tomorrow, the corruption of Erigone will come to an end."
    e "Demain, la corruption d’Erigone prendra fin."

# game/episode025.rpy:816
translate french ep025_erigone_battle_2788c826:

    # e "For too long, the Priest caste has tried to assert its dominion, but we will have it no more."
    e "Depuis trop longtemps, la caste des Prêtres tente d’imposer sa domination, mais on n’en veut plus."

# game/episode025.rpy:817
translate french ep025_erigone_battle_e4533c11:

    # e "We say no to forced religious doctrine."
    e "On dit non à la doctrine religieuse imposée de force."

# game/episode025.rpy:819
translate french ep025_erigone_battle_38cb6bf7:

    # e "For too long, the Warrior caste has tried to assert its dominion, but we will have it no more."
    e "Depuis trop longtemps, la caste des Guerriers tente d’imposer sa domination, mais on n’en veut plus."

# game/episode025.rpy:820
translate french ep025_erigone_battle_cb9acf15:

    # e "We say no to violent oppression."
    e "On dit non à l’oppression violente."

# game/episode025.rpy:821
translate french ep025_erigone_battle_8a54e1ed:

    # e "We say no to not being able to express ourselves freely."
    e "On dit non à l’impossibilité de s’exprimer librement."

# game/episode025.rpy:823
translate french ep025_erigone_battle_b40dd230:

    # e "We say no to the scheming, the cronyism and outright bribery that has come to symbolize the Priest caste."
    e "On dit non aux magouilles, au copinage et à la corruption pure et simple qui sont devenus les symboles de la caste des Prêtres."

# game/episode025.rpy:825
translate french ep025_erigone_battle_60cdad02:

    # e "We say no to the scheming, the cronyism and outright bribery that has come to symbolize the Warrior caste."
    e "On dit non aux magouilles, au copinage et à la corruption pure et simple qui sont devenus les symboles de la caste des Guerriers."

# game/episode025.rpy:826
translate french ep025_erigone_battle_c91d2221:

    # e "Erigone belongs to the Acarhyn."
    e "Erigone appartient aux Acarhyn."

# game/episode025.rpy:827
translate french ep025_erigone_battle_d0c6631c:

    # e "Tomorrow we will take back our beautiful planet and ensure a lasting peace!"
    e "Demain, on reprendra notre belle planète et on garantira une paix durable !"

# game/episode025.rpy:828
translate french ep025_erigone_battle_e058b2fc:

    # e "A new dawn for the Acarhyn approaches!"
    e "Une nouvelle aube se profile pour les Acarhyns !"

# game/episode025.rpy:829
translate french ep025_erigone_battle_783ca07a:

    # e "Fight like furies and victory will be ours!"
    e "Battez-vous comme des furies et la victoire sera nôtre !"

# game/episode025.rpy:835
translate french ep025_erigone_battle_a2caec33:

    # "A rapturous roar emanated from the crowd of Acarhyn Warriors."
    "Un rugissement enthousiaste s’éleva de la foule des guerriers Acarhyns."

# game/episode025.rpy:841
translate french ep025_erigone_battle_a2097f59:

    # "A rapturous roar emanated from the crowd of Acarhyn Priests."
    "Un rugissement enthousiaste s’éleva de la foule des prêtres Acarhyns."

# game/episode025.rpy:842
translate french ep025_erigone_battle_d6631c7d:

    # "I could tell Eva was relieved by how her short speech was received."
    "Je voyais bien qu’Eva était soulagée de l’accueil réservé à son petit discours."

# game/episode025.rpy:844
translate french ep025_erigone_battle_973034b2:

    # "The loyalty of the Warriors was by no means a sure thing, but a public appearance by their Virgin Queen certainly helped."
    "La loyauté des guerriers n’était en aucun cas acquise, mais l’apparition publique de leur reine vierge y a certainement contribué."

# game/episode025.rpy:846
translate french ep025_erigone_battle_48f1096a:

    # "The loyalty of the Priests was by no means a sure thing, but a public appearance by their Virgin Queen certainly helped."
    "La loyauté des prêtres n’était pas du tout acquise, mais l’apparition publique de leur reine vierge a certainement aidé."

# game/episode025.rpy:854
translate french ep025_erigone_battle_8f12b348:

    # l "I’m sure this makes me a bad person, but I’m so glad I’m not in Eva’s shoes."
    l "Je suis sûre que ça fait de moi une mauvaise personne, mais je suis tellement contente de ne pas être à la place d'Eva."

# game/episode025.rpy:855
translate french ep025_erigone_battle_aed7d681:

    # c "Because you don’t like to wear elaborate dresses?"
    c "Parce que tu n’aimes pas porter des robes sophistiquées ?"

# game/episode025.rpy:856
translate french ep025_erigone_battle_f2914141:

    # l "That too, but I was referring to giving public speeches to hundreds of bloodthirsty women."
    l "Ça aussi, mais je parlais plutôt de prononcer des discours publics devant des centaines de femmes assoiffées de sang."

# game/episode025.rpy:857
translate french ep025_erigone_battle_67f6475a:

    # c "Eva certainly didn’t choose this, but I think she did very well."
    c "Eva n’a certainement pas choisi ça, mais je trouve qu’elle s’en est très bien sortie."

# game/episode025.rpy:862
translate french ep025_erigone_battle_c6575405:

    # l "She did."
    l "C’est vrai."

# game/episode025.rpy:863
translate french ep025_erigone_battle_de1d6e4b:

    # l "No guarantee the fight tomorrow will be a success though."
    l "Rien ne garantit pour autant que le combat de demain sera un succès."

# game/episode025.rpy:864
translate french ep025_erigone_battle_f9f1f56f:

    # l "Nor are we sure that the Acarhyn will fight for us."
    l "On n’est pas sûrs non plus que les Acarhyn se battront pour nous."

# game/episode025.rpy:865
translate french ep025_erigone_battle_bb78aab7:

    # c "I know."
    c "Je sais."

# game/episode025.rpy:866
translate french ep025_erigone_battle_935aa765:

    # c "But at least we have done everything in our power to make the possible alliance a success."
    c "Mais au moins, on a fait tout ce qui était en notre pouvoir pour que cette alliance potentielle soit un succès."

# game/episode025.rpy:871
translate french ep025_erigone_battle_42055667:

    # l "I guess so."
    l "Je suppose que oui."

# game/episode025.rpy:872
translate french ep025_erigone_battle_c80e9693:

    # l "Though I can’t say I’m looking forward to being on the Bastard while it provides air support."
    l "Même si je ne peux pas dire que j’ai hâte d’être à bord du Bastard pendant qu’il assure le soutien aérien."

# game/episode025.rpy:874
translate french ep025_erigone_battle_529c8141:

    # c "It was an explicit request from Rahia, so it didn’t seem something we could refuse."
    c "C’était une demande expresse de Rahia, donc on ne pouvait pas vraiment refuser."

# game/episode025.rpy:876
translate french ep025_erigone_battle_519dbb62:

    # c "It was an explicit request from Keodele, so it didn’t seem something we could refuse."
    c "C’était une demande expresse de Keodele, donc on ne pouvait pas vraiment refuser."

# game/episode025.rpy:877
translate french ep025_erigone_battle_c424a372:

    # c "I’d understand if you’d rather kept Eva company."
    c "Je comprendrais si tu préférais tenir compagnie à Eva."

# game/episode025.rpy:882
translate french ep025_erigone_battle_e976f0b0:

    # l "No, I’m coming with."
    l "Non, je viens avec vous."

# game/episode025.rpy:883
translate french ep025_erigone_battle_14841dd0:

    # l "Too curious what that new dawn for the Acarhyn is all about..."
    l "J'ai vraiment hâte de savoir ce que cette nouvelle ère pour Les Acarhyns va apporter..."

# game/episode025.rpy:887
translate french ep025_erigone_battle_44ea2915:

    # "We were up early to see the first wave of Warriors head out to the staging grounds, to begin the first stage of the Battle for Erigone."
    "On s’est levés tôt pour voir la première vague de Guerriers se diriger vers la zone de rassemblement, afin d’entamer la première phase de la bataille d’Erigone."

# game/episode025.rpy:890
translate french ep025_erigone_battle_1fe4a0f2:

    # "We were up early to see the first wave of Priests head out to the staging grounds, to begin the first stage of the Battle for Erigone."
    "On s’est levés tôt pour voir la première vague de Prêtres se diriger vers la zone de rassemblement, afin d’entamer la première phase de la bataille d’Erigone."

# game/episode025.rpy:892
translate french ep025_erigone_battle_7ba5bc94:

    # "Acarhyn engineers had loaded the Bastard with several bombs, arguably the first time the ships’ bays were actually loaded with ordnance."
    "Les ingénieurs acarhyns avaient chargé le Bastard de plusieurs bombes ; c’était sans doute la première fois que les soutes du vaisseau étaient réellement remplies de munitions."

# game/episode025.rpy:893
translate french ep025_erigone_battle_9cc6f630:

    # "Thyia and Céline had gone over the Bastard’s guns and cannons to ensure they were still working."
    "Thyia et Céline avaient vérifié les mitrailleuses et les canons du Bastard pour s’assurer qu’ils fonctionnaient toujours."

# game/episode025.rpy:898
translate french ep025_erigone_battle_bc7dc44a:

    # "The first wave of Acarhyn aircraft took off from the landing pad."
    "La première vague d’appareils Acarhyn a décollé de la piste d’atterrissage."

# game/episode025.rpy:899
translate french ep025_erigone_battle_7272ca58:

    # "We were scheduled to accompany the second wave."
    "On devait accompagner la deuxième vague."

# game/episode025.rpy:904
translate french ep025_erigone_battle_5254fa93:

    # "As soon as the signal came over the radio, Céline took us into the air."
    "Dès que le signal est passé à la radio, Céline nous a fait décoller."

# game/episode025.rpy:905
translate french ep025_erigone_battle_14f9de13:

    # "Flying formation, we quickly covered a lot of ground."
    "En vol en formation, on a vite parcouru une bonne distance."

# game/episode025.rpy:907
translate french ep025_erigone_battle_c37d11e8:

    # "Explosions could be seen in the distance and smoke trailed on the horizon."
    "On voyait des explosions au loin et de la fumée s’élevait à l’horizon."

# game/episode025.rpy:908
translate french ep025_erigone_battle_fbb5585c:

    # "Aven let out an audible gasp as we made a pass over the battlefield."
    "Aven a poussé un cri de surprise quand on a survolé le champ de bataille."

# game/episode025.rpy:910
translate french ep025_erigone_battle_a293bdb3:

    # "Several mechs were shooting at each other, Acarhyn swarming around its legs."
    "Plusieurs méchs s’affrontaient, tandis que des Acarhyn fourmillaient autour de leurs jambes."

# game/episode025.rpy:911
translate french ep025_erigone_battle_93501333:

    # "It was impossible to tell whose side was winning, such was the chaos on the ground."
    "Impossible de dire quel camp l’emportait, tant le chaos régnait au sol."

# game/episode025.rpy:916
translate french ep025_erigone_battle_26adcf18:

    # ce "We’re being target-locked by multiple gun batteries."
    ce "On est dans le collimateur de plusieurs batteries de tir."

# game/episode025.rpy:917
translate french ep025_erigone_battle_96e7b7c3:

    # c "Evasive maneuvers!"
    c "Manœuvres d’évitement !"

# game/episode025.rpy:919
translate french ep025_erigone_battle_52137f66:

    # "The Bastard and several other ships in the formation spun away from the center of the battlefield."
    "Le Bastard et plusieurs autres vaisseaux de la formation ont fait demi-tour pour s’éloigner du centre du champ de bataille."

# game/episode025.rpy:920
translate french ep025_erigone_battle_0d7221b0:

    # "The enemy attempted to jam our comms at that moment and a couple of other ships must have failed to receive the command to break off."
    "L’ennemi a tenté de brouiller nos communications à ce moment-là, et quelques autres vaisseaux n’ont sans doute pas reçu l’ordre de se désengager."

# game/episode025.rpy:923
translate french ep025_erigone_battle_e22a18c0:

    # "The gun batteries of the Priest caste, hidden in the trees, belched fire at the remaining ships flying straight on."
    "Les batteries de tir de la caste des Prêtres, cachées dans les arbres, ont craché du feu sur les vaisseaux restants qui continuaient leur route."

# game/episode025.rpy:925
translate french ep025_erigone_battle_2f1b2275:

    # "The gun batteries of the Warrior caste, hidden in the trees, belched fire at the remaining ships flying straight on."
    "Les batteries de la caste des Guerriers, cachées dans les arbres, ont craché du feu sur les vaisseaux restants qui continuaient leur route."

# game/episode025.rpy:926
translate french ep025_erigone_battle_28970140:

    # "Three were hit, one plunged smoking toward the ground and the others exploded in mid-air."
    "Trois ont été touchés : l’un a plongé vers le sol en fumant et les autres ont explosé en plein vol."

# game/episode025.rpy:928
translate french ep025_erigone_battle_e536765e:

    # ce "We’re no longer being targeted."
    ce "On n’est plus dans leur ligne de mire."

# game/episode025.rpy:929
translate french ep025_erigone_battle_6b4b5b37:

    # "Taking advantage of the reloading, our formation sped forward to the tree line."
    "Profitant du temps de rechargement, notre formation a foncé vers la lisière de la forêt."

# game/episode025.rpy:932
translate french ep025_erigone_battle_990ee997:

    # "As expected, a contingent of Priest vehicles was approaching the battlefield, hidden by the cover of the trees."
    "Comme prévu, un contingent de véhicules de la caste des Prêtres s’approchait du champ de bataille, à l’abri des arbres."

# game/episode025.rpy:934
translate french ep025_erigone_battle_06d7efac:

    # "As expected, a contingent of Warrior vehicles was approaching the battlefield, hidden by the cover of the trees."
    "Comme prévu, un contingent de véhicules de la caste des Guerriers s’approchait du champ de bataille, dissimulé par la couverture des arbres."

# game/episode025.rpy:935
translate french ep025_erigone_battle_f87459ac:

    # "We were cleared hot by the Acarhyn command, while the Bastard had commenced its first pass."
    "On a reçu le feu vert du commandement Acarhyn, tandis que le Bastard avait entamé son premier passage."

# game/episode025.rpy:937
translate french ep025_erigone_battle_dd19228c:

    # c "Two away."
    c "Il en reste deux."

# game/episode025.rpy:938
translate french ep025_erigone_battle_7f601f96:

    # av "Two away."
    av "Il en reste deux."

# game/episode025.rpy:939
translate french ep025_erigone_battle_3c1fe5df:

    # "Aven had launched two bombs and followed their trajectory closely."
    "Aven avait lancé deux bombes et suivait de près leur trajectoire."

# game/episode025.rpy:940
translate french ep025_erigone_battle_bcdbc216:

    # av "One and two landed on the mark."
    av "Une et deux ont atteint leur cible."

# game/episode025.rpy:941
translate french ep025_erigone_battle_5c4db647:

    # av "Fifteen vehicles have been destroyed."
    av "Quinze véhicules ont été détruits."

# game/episode025.rpy:942
translate french ep025_erigone_battle_b8601c84:

    # c "Ready for pass two."
    c "Prêts pour le deuxième passage."

# game/episode025.rpy:944
translate french ep025_erigone_battle_75846845:

    # "The carnage of the bomb run was visible on our scopes."
    "Le carnage causé par le bombardement était visible sur nos écrans."

# game/episode025.rpy:945
translate french ep025_erigone_battle_1f4ad429:

    # "Several other ships of our formation had scored direct hits and the convoy of vehicles was in complete disarray."
    "Plusieurs autres vaisseaux de notre formation avaient réussi des tirs directs et le convoi de véhicules était en plein désarroi."

# game/episode025.rpy:946
translate french ep025_erigone_battle_f7ab16f7:

    # "The second run would most likely wipe out the entire supply line."
    "Le deuxième passage allait très probablement anéantir toute la ligne de ravitaillement."

# game/episode025.rpy:947
translate french ep025_erigone_battle_a761a061:

    # "If the other attack groups were successful, the remaining supply lines would be completely cut off, isolating the troops already on the central battlefield."
    "Si les autres groupes d’attaque réussissaient, les lignes de ravitaillement restantes seraient complètement coupées, isolant les troupes déjà présentes sur le champ de bataille central."

# game/episode025.rpy:948
translate french ep025_erigone_battle_4a71db9c:

    # "As the formation began its second fly-over, our scanners lit up with enemy contacts."
    "Alors que la formation entamait son deuxième survol, nos scanners se sont illuminés avec des contacts ennemis."

# game/episode025.rpy:953
translate french ep025_erigone_battle_aa46d434:

    # th "We’ve got company."
    th "On a de la compagnie."

# game/episode025.rpy:956
translate french ep025_erigone_battle_e9414618:

    # "A wing of fighters from the Priest caste was suddenly bearing upon us."
    "Une escadrille de chasseurs de la caste des Prêtres fonçait soudain sur nous."

# game/episode025.rpy:958
translate french ep025_erigone_battle_dc3f9390:

    # "A wing of fighters from the Warrior caste was suddenly bearing upon us."
    "Une escadrille de chasseurs de la caste des Guerriers fonçait soudain sur nous."

# game/episode025.rpy:959
translate french ep025_erigone_battle_4b1a0d5a:

    # c "Take them out."
    c "Élimine-les."

# game/episode025.rpy:961
translate french ep025_erigone_battle_237a4d8d:

    # "The ship’s cannon joined the barrage coming from the other ships in our formation."
    "Le canon du vaisseau se joignit au barrage provenant des autres vaisseaux de notre formation."

# game/episode025.rpy:964
translate french ep025_erigone_battle_89961d4b:

    # "The Priests returned fire."
    "Les Prêtres ripostèrent."

# game/episode025.rpy:966
translate french ep025_erigone_battle_235b48b4:

    # "The Warriors returned fire."
    "Les Guerriers ripostèrent."

# game/episode025.rpy:967
translate french ep025_erigone_battle_d664d87f:

    # "The Bastard’s shields were pelted with energy bolts."
    "Les boucliers du Bastard furent criblés de projectiles d'énergie."

# game/episode025.rpy:969
translate french ep025_erigone_battle_fb966fe5:

    # av "Shields at eighty percent."
    av "Boucliers à 80 pour cent."

# game/episode025.rpy:971
translate french ep025_erigone_battle_55b5361f:

    # "One of the ships in our group must have taken a direct hit, because it hurtled toward the tree tops and exploded on impact."
    "L'un des vaisseaux de notre groupe avait dû essuyer un tir direct, car il fonça vers la cime des arbres et explosa à l'impact."

# game/episode025.rpy:972
translate french ep025_erigone_battle_d8231ba0:

    # "There were fourteen enemy aircraft remaining, as we had turned five of them into slag already."
    "Il restait quatorze vaisseaux ennemis, puisqu'on en avait déjà réduit cinq en cendres."

# game/episode025.rpy:974
translate french ep025_erigone_battle_47833637:

    # "Our group still outnumbered the Priests, but another volley could tip the odds unfavorably."
    "Notre groupe était toujours plus nombreux que les Prêtres, mais une autre salve risquait de faire basculer la balance en leur défaveur."

# game/episode025.rpy:975
translate french ep025_erigone_battle_28a8e266:

    # "The Bastard’s cannon spewed more fire and our guns rattled multiple rounds in the direction of the Priests."
    "Le canon du Bastard cracha encore plus de feu et nos canons tirèrent plusieurs salves en direction des Prêtres."

# game/episode025.rpy:977
translate french ep025_erigone_battle_20518ba6:

    # "Our group still outnumbered the Warriors, but another volley could tip the odds unfavorably."
    "Notre groupe était toujours plus nombreux que les Guerriers, mais une autre salve risquait de faire basculer la balance en leur défaveur."

# game/episode025.rpy:978
translate french ep025_erigone_battle_ddebab35:

    # "The Bastard’s cannon spewed more fire and our guns rattled multiple rounds in the direction of the Warriors."
    "Le canon du Bastard cracha encore plus de feu et nos canons tirèrent plusieurs salves en direction des Guerriers."

# game/episode025.rpy:980
translate french ep025_erigone_battle_9054d0f5:

    # av "Three hits."
    av "Trois impacts."

# game/episode025.rpy:982
translate french ep025_erigone_battle_9682b2fe:

    # "The engine of one ship caught fire and it started losing altitude quickly before exploding among the trees."
    "Le moteur d’un vaisseau a pris feu et il a commencé à perdre de l’altitude rapidement avant d’exploser parmi les arbres."

# game/episode025.rpy:983
translate french ep025_erigone_battle_f91f09f3:

    # "The other two were direct hits, exploding in the air and raining debris all over the convoy below."
    "Les deux autres ont été touchés de plein fouet, explosant en plein vol et faisant pleuvoir des débris sur tout le convoi en contrebas."

# game/episode025.rpy:984
translate french ep025_erigone_battle_f6ff01e3:

    # "Our fellow pilots were similarly lucky, reducing the enemy group to just two ships."
    "Nos camarades pilotes ont eu la même chance, réduisant le groupe ennemi à seulement deux vaisseaux."

# game/episode025.rpy:987
translate french ep025_erigone_battle_ed0322bf:

    # "Sensing the game was up, the remaining two Priests tried to flee, several long range missiles trailing their ships."
    "Sentant que la partie était jouée, les deux Prêtres restants ont tenté de s’enfuir, plusieurs missiles à longue portée à leurs trousses."

# game/episode025.rpy:989
translate french ep025_erigone_battle_b8ff9c50:

    # "Sensing the game was up, the remaining two Warriors tried to flee, several long range missiles trailing their ships."
    "Sentant que la partie était perdue, les deux \" Warriors \" restants ont tenté de s’enfuir, plusieurs missiles à longue portée à leurs trousses."

# game/episode025.rpy:990
translate french ep025_erigone_battle_eee783a6:

    # "They were unable to outrun the missiles and each ship exploded before they were able to return to safety."
    "Ils n’ont pas pu distancer les missiles et chaque vaisseau a explosé avant d’avoir pu se mettre à l’abri."

# game/episode025.rpy:992
translate french ep025_erigone_battle_086f5edd:

    # "With the threat dealt with and the convoy in ruins, we were about to head back to the Citadel, but an urgent comms message interrupted our departure."
    "La menace étant écartée et le convoi en ruines, on s’apprêtait à rentrer à la Citadelle, mais un message urgent a interrompu notre départ."

# game/episode025.rpy:994
translate french ep025_erigone_battle_2611403e:

    # "With the threat dealt with and the convoy in ruins, we were about to head back to the Shipyards, but an urgent comms message interrupted our departure."
    "La menace étant neutralisée et le convoi en ruines, on s’apprêtait à retourner aux Chantiers, mais un message urgent a interrompu notre départ."

# game/episode025.rpy:997
translate french ep025_erigone_battle_56ce6f6b:

    # woman "Urgent message to all active forces."
    woman "Message urgent à toutes les forces en action."

# game/episode025.rpy:999
translate french ep025_erigone_battle_0141ba92:

    # woman "Commander Rahia is isolated and taking heavy fire."
    woman "La commandante Rahia est isolée et subit des tirs nourris."

# game/episode025.rpy:1001
translate french ep025_erigone_battle_99e98a43:

    # woman "High Priestess Keodele is isolated and taking heavy fire."
    woman "La grande prêtresse Keodele est isolée et subit des tirs nourris."

# game/episode025.rpy:1002
translate french ep025_erigone_battle_d2091f62:

    # woman "Extraction required."
    woman "Extraction requise."

# game/episode025.rpy:1003
translate french ep025_erigone_battle_bcaf3f10:

    # woman "All units please respond."
    woman "Toutes les unités, répondez s’il vous plaît."

# game/episode025.rpy:1015
translate french ep025_erigone_battle_9e73aa2e:

    # c "We’re not equipped to handle an extraction, head back to the Citadel as planned."
    c "On n’est pas équipés pour mener une extraction, retournez à la Citadelle comme prévu."

# game/episode025.rpy:1017
translate french ep025_erigone_battle_dc7d66c7:

    # c "We’re not equipped to handle an extraction, head back to the Shipyards as planned."
    c "On n’est pas équipés pour mener une opération d’extraction, on retourne aux Chantiers navals comme prévu."

# game/episode025.rpy:1018
translate french ep025_erigone_battle_6d047732:

    # ce "Of course, heading back now."
    ce "Bien sûr, on y retourne tout de suite."

# game/episode025.rpy:1027
translate french ep025_erigone_rescue_d8906617:

    # c "Open a comms channel, Céline."
    c "Ouvre un canal de communication, Céline."

# game/episode025.rpy:1028
translate french ep025_erigone_rescue_00c71e9f:

    # ce "Comms channel open."
    ce "Canal de communication ouvert."

# game/episode025.rpy:1029
translate french ep025_erigone_rescue_55e8bf0c:

    # c "This is [p_name] of the Iron Bastard, responding to Acarhyn command."
    c "Ici [p_name] de l’Iron Bastard, je réponds au commandement Acarhyn."

# game/episode025.rpy:1031
translate french ep025_erigone_rescue_733a8d28:

    # c "We are near Commander Rahia and will move to evacuate."
    c "On est près de la commandante Rahia et on va se déplacer pour l’évacuer."

# game/episode025.rpy:1033
translate french ep025_erigone_rescue_4b71b563:

    # c "We are near High Priestess Keodele and will move to evacuate."
    c "On est près de la Grande Prêtresse Keodele et on va se mettre en route pour l’évacuer."

# game/episode025.rpy:1034
translate french ep025_erigone_rescue_041adb43:

    # woman "Roger that."
    woman "Bien reçu."

# game/episode025.rpy:1035
translate french ep025_erigone_rescue_8cfe687e:

    # woman "Exact coordinates have been sent."
    woman "Les coordonnées exactes ont été envoyées."

# game/episode025.rpy:1038
translate french ep025_erigone_rescue_ae555bf8:

    # "The Bastard and several other ships broke formation and headed toward the location of Rahia."
    "L’Iron Bastard et plusieurs autres vaisseaux ont rompu la formation et se sont dirigés vers la position de Rahia."

# game/episode025.rpy:1039
translate french ep025_erigone_rescue_182d1f7c:

    # "Close to the extraction site, a couple of burnt out vehicles were visible, probably Rahia’s transport."
    "Près du site d’évacuation, on pouvait voir deux véhicules calcinés, probablement le moyen de transport de Rahia."

# game/episode025.rpy:1041
translate french ep025_erigone_rescue_4d3db699:

    # "The Bastard and several other ships broke formation and headed toward the location of Keodele."
    "Le Bastard et plusieurs autres vaisseaux ont rompu la formation et se sont dirigés vers l’emplacement de Keodele."

# game/episode025.rpy:1042
translate french ep025_erigone_rescue_0de57213:

    # "Close to the extraction site, a couple of burnt out vehicles were visible, probably Keodele’s transport."
    "Près du site d’extraction, on pouvait voir quelques véhicules calcinés, sans doute le moyen de transport de Keodele."

# game/episode025.rpy:1044
translate french ep025_erigone_rescue_0328ca29:

    # "Aven, Thyia, Kit and I were already in the cargo bay, ready to drop out of the Bastard and begin the extraction."
    "Aven, Thyia, Kit et moi étions déjà dans la soute, prêts à sauter du Bastard et à commencer l’extraction."

# game/episode025.rpy:1045
translate french ep025_erigone_rescue_1a68ac83:

    # "The Bastard and the Acarhyn ships would provide cover from the air."
    "Le Bastard et les vaisseaux Acarhyn assureraient la couverture aérienne."

# game/episode025.rpy:1046
translate french ep025_erigone_rescue_3d33410a:

    # ce "Ready for extraction."
    ce "Prêts pour l’extraction."

# game/episode025.rpy:1047
translate french ep025_erigone_rescue_8502e70a:

    # ce "Opening bay doors."
    ce "Ouverture des portes de la soute."

# game/episode025.rpy:1049
translate french ep025_erigone_rescue_ea33654c:

    # "The cargo bay doors slowly opened and strong gusts of wind filled the room."
    "Les portes de la soute s’ouvrirent lentement et de fortes rafales de vent envahirent la pièce."

# game/episode025.rpy:1050
translate french ep025_erigone_rescue_01a396c6:

    # "The Bastard was flying as low as possible in order for us to rappel down among the trees."
    "Le Bastard volait aussi bas que possible pour qu’on puisse descendre en rappel parmi les arbres."

# game/episode025.rpy:1051
translate french ep025_erigone_rescue_65f60860:

    # "A clearing approached and the Bastard remained stationary in the air to allow us to quickly make the descent."
    "Une clairière apparut et le Bastard resta immobile dans les airs pour nous permettre de descendre rapidement."

# game/episode025.rpy:1054
translate french ep025_erigone_rescue_9a1b1e23:

    # "Once we had disengaged our zip lines, we all brandished our weapons and headed to Rahia’s location."
    "Une fois nos tyroliennes détachées, on a tous brandi nos armes et on s’est dirigés vers l’emplacement de Rahia."

# game/episode025.rpy:1056
translate french ep025_erigone_rescue_1faed7dd:

    # "Once we had disengaged our zip lines, we all brandished our weapons and headed to Keodele’s location."
    "Une fois nos tyroliennes détachées, on a tous brandi nos armes et on s’est dirigés vers l’emplacement de Keodele."

# game/episode025.rpy:1057
translate french ep025_erigone_rescue_3c64a8d9:

    # "Explosions could be heard around us and the jungle roared as parts of it were glowing with orange fire."
    "On entendait des explosions tout autour de nous et la jungle rugissait tandis que certaines parties brillaient d’un feu orange."

# game/episode025.rpy:1060
translate french ep025_erigone_rescue_678e6c73:

    # "We cleared this part of the jungle unopposed and were almost upon Rahia."
    "On a traversé cette partie de la jungle sans rencontrer de résistance et on était presque arrivés jusqu'à Rahia."

# game/episode025.rpy:1063
translate french ep025_erigone_rescue_c03d70e9:

    # "We cleared this part of the jungle unopposed and were almost upon Keodele."
    "On a traversé cette partie de la jungle sans rencontrer de résistance et on était presque arrivés à Keodele."

# game/episode025.rpy:1065
translate french ep025_erigone_rescue_277d4833:

    # "After signalling we were friendly, we made our final approach."
    "Après avoir signalé qu’on était des alliés, on a entamé notre approche finale."

# game/episode025.rpy:1066
translate french ep025_erigone_rescue_6b573788:

    # "A contingent of Acarhyn soldiers welcomed us, while continuing to scan the battlefield."
    "Un contingent de soldats Acarhyn nous a accueillis, tout en continuant à scruter le champ de bataille."

# game/episode025.rpy:1068
translate french ep025_erigone_rescue_3be7a1ac:

    # woman "Commander Rahia is over here."
    woman "La commandante Rahia est par ici."

# game/episode025.rpy:1070
translate french ep025_erigone_rescue_8b736915:

    # woman "High Priestess Keodele is over here."
    woman "La grande prêtresse Keodele est par ici."

# game/episode025.rpy:1071
translate french ep025_erigone_rescue_5d888b2c:

    # woman "She has a broken ankle, but is otherwise fit to talk and give orders."
    woman "Elle a la cheville cassée, mais sinon, elle est en état de parler et de donner des ordres."

# game/episode025.rpy:1072
translate french ep025_erigone_rescue_21f74726:

    # c "Good to see you in one piece."
    c "Ça fait du bien de te voir en un seul morceau."

# game/episode025.rpy:1075
translate french ep025_erigone_rescue_df73dcb6:

    # rah "Thanks, that ambush nearly did us in."
    rah "Merci, cette embuscade a failli nous coûter la vie."

# game/episode025.rpy:1078
translate french ep025_erigone_rescue_f070814f:

    # keo "My Brutes fought valiantly until the end, but there were just too many warriors."
    keo "Mes Brutes se sont battus vaillamment jusqu’au bout, mais ils étaient tout simplement trop nombreux."

# game/episode025.rpy:1079
translate french ep025_erigone_rescue_a711fef7:

    # c "Are you able to move?"
    c "Tu peux te déplacer ?"

# game/episode025.rpy:1081
translate french ep025_erigone_rescue_40015a04:

    # rah "Yes, if I can lean on somebody."
    rah "Oui, si je peux m’appuyer sur quelqu’un."

# game/episode025.rpy:1082
translate french ep025_erigone_rescue_64bffc43:

    # rah "I’m slow, so the Priests will have a field day as soon as they have a clear shot at us."
    rah "Je suis lente, donc les prêtres vont s’en donner à cœur joie dès qu’ils auront un angle de tir dégagé sur nous."

# game/episode025.rpy:1083
translate french ep025_erigone_rescue_9cc16b33:

    # c "Any of them hiding nearby?"
    c "Y en a-t-il qui se cachent dans les parages ?"

# game/episode025.rpy:1084
translate french ep025_erigone_rescue_2c02947a:

    # rah "Yes, we’ve been taking intermittent fire from the tree line over there."
    rah "Oui, on subit des tirs sporadiques depuis la lisière de la forêt là-bas."

# game/episode025.rpy:1086
translate french ep025_erigone_rescue_e57178a4:

    # keo "Only when assisted."
    keo "Seulement quand on les aide."

# game/episode025.rpy:1087
translate french ep025_erigone_rescue_47fa7cf0:

    # keo "I won’t be quick though, so we’ll be exposed when we approach your ship."
    keo "Je ne serai pas rapide, donc on sera à découvert quand on s’approchera de ton vaisseau."

# game/episode025.rpy:1088
translate french ep025_erigone_rescue_581b2dbb:

    # c "Any warriors in the vicinity?"
    c "Y a-t-il des guerriers dans les environs ?"

# game/episode025.rpy:1089
translate french ep025_erigone_rescue_893e7a07:

    # keo "Yes, there are several in the trees over there."
    keo "Oui, il y en a plusieurs dans les arbres là-bas."

# game/episode025.rpy:1090
translate french ep025_erigone_rescue_3df35c3d:

    # c "We’ll give them something to keep them busy."
    c "On va leur donner de quoi s’occuper."

# game/episode025.rpy:1092
translate french ep025_erigone_rescue_325d3d6d:

    # rah "Acarhyn, moving out on my mark."
    rah "Acarhyn, on part à mon signal."

# game/episode025.rpy:1093
translate french ep025_erigone_rescue_fe81d847:

    # "The Warriors all voiced their acceptance and we made ready to rendezvous with the Bastard."
    "Les guerriers ont tous acquiescé et on s’est préparés à rejoindre le Bastard."

# game/episode025.rpy:1095
translate french ep025_erigone_rescue_67a1eafd:

    # keo "Sisters, on me."
    keo "Les Sœurs, suivez-moi."

# game/episode025.rpy:1096
translate french ep025_erigone_rescue_f45201cc:

    # "The Priests all voiced their acceptance and we made ready to rendezvous with the Bastard."
    "Les Prêtres ont tous donné leur accord et on s’est préparés à rejoindre le Bastard."

# game/episode025.rpy:1101
translate french ep025_erigone_rescue_16c47c38:

    # "The allied ships were sweeping overhead, peppering the tree line, where the Acarhyn were supposedly holed up, with a barrage of gunfire."
    "Les vaisseaux alliés survolaient la zone, criblant de tirs la lisière de la forêt, là où les Acarhyn étaient censés se cacher."

# game/episode025.rpy:1102
translate french ep025_erigone_rescue_15d69bf7:

    # "At that point, we made a sprint across the clearing, to the spot where the Bastard would pick us up."
    "À ce moment-là, on a traversé la clairière en courant jusqu’à l’endroit où le Bastard devait venir nous chercher."

# game/episode025.rpy:1104
translate french ep025_erigone_rescue_c357858a:

    # "Rahia limped in the middle of the group, supported by two Acarhyn."
    "Rahia boitait au milieu du groupe, soutenue par deux Acarhyn."

# game/episode025.rpy:1106
translate french ep025_erigone_rescue_67583348:

    # "Keodele limped in the middle of the group, supported by two Acarhyn."
    "Keodele boitait au milieu du groupe, soutenu par deux Acarhyn."

# game/episode025.rpy:1107
translate french ep025_erigone_rescue_404981dc:

    # "Scattered bursts of gunfire came from the tree line, missing us by several meters."
    "Des rafales de tirs éparses provenaient de la lisière de la forêt, nous manquant de quelques mètres."

# game/episode025.rpy:1108
translate french ep025_erigone_rescue_7a131576:

    # "We’d nearly reached the pickup point when the trees ahead of us began to shake."
    "On avait presque atteint le point de rendez-vous quand les arbres devant nous se mirent à trembler."

# game/episode025.rpy:1111
translate french ep025_erigone_rescue_c76dadea:

    # "Two Brutes came through the foliage, blocking our way forward."
    "Deux Brutes ont surgi du feuillage, nous barrant la route."

# game/episode025.rpy:1118
translate french ep025_erigone_rescue_13eac10b:

    # ki "Fuck, you didn’t tell me they were that big!"
    ki "Putain, tu m’avais pas dit qu’elles étaient aussi grosses !"

# game/episode025.rpy:1119
translate french ep025_erigone_rescue_37dc6778:

    # woman "Acarhyn on me, we’ll distract them."
    woman "Acarhyn, viens avec moi, on va les distraire."

# game/episode025.rpy:1120
translate french ep025_erigone_rescue_f9caa826:

    # woman "You make sure the Commander gets safely inside the ship."
    woman "Assure-toi que la commandante monte à l’abri dans le vaisseau."

# game/episode025.rpy:1121
translate french ep025_erigone_rescue_a4bfc132:

    # "The Warriors ran toward the Brutes, shooting at them as they came closer."
    "Les guerriers se sont précipités vers les Brutes, tirant sur elles à mesure qu’elles se rapprochaient."

# game/episode025.rpy:1122
translate french ep025_erigone_rescue_fa407c63:

    # "Their fire didn’t even make a dent in the Brute’s armor."
    "Leurs tirs n’ont même pas égratigné l’armure des Brutes."

# game/episode025.rpy:1123
translate french ep025_erigone_rescue_708fab2e:

    # c "Run!"
    c "Courez !"

# game/episode025.rpy:1124
translate french ep025_erigone_rescue_de2bfdd3:

    # "We all broke into a frenzied run, Rahia being bodily dragged along with her escort."
    "On s’est tous lancés dans une course effrénée, Rahia se faisant littéralement traîner par ses escortes."

# game/episode025.rpy:1126
translate french ep025_erigone_rescue_dcfe4c27:

    # "Meanwhile, the Acarhyn had ditched their guns and brandished their swords."
    "Pendant ce temps, les Acarhyn avaient lâché leurs armes à feu et brandissaient leurs épées."

# game/episode025.rpy:1127
translate french ep025_erigone_rescue_3c77c1c4:

    # "It seemed that the metal of the swords, coated in venom, would be able to harm the Brutes."
    "Il semblait que le métal des épées, enduit de venin, puisse blesser les Brutes."

# game/episode025.rpy:1128
translate french ep025_erigone_rescue_1fb68e64:

    # "One of the Brutes swung her own sword and swept it across a group of Acarhyn in a wide arc."
    "L’une des Brutes fit tournoyer son épée et balaya un groupe d’Acarhyn d’un large arc de cercle."

# game/episode025.rpy:1130
translate french ep025_erigone_rescue_17c71733:

    # "Most were able to dodge the swing, but one Acarhyn wasn’t so lucky."
    "La plupart réussirent à esquiver le coup, mais une Acarhyn n’eut pas cette chance."

# game/episode025.rpy:1131
translate french ep025_erigone_rescue_094d1dfe:

    # "Her head was severed and a fountain of blood sprayed from her ragged neck."
    "Sa tête fut tranchée et une fontaine de sang jaillit de son cou déchiqueté."

# game/episode025.rpy:1132
translate french ep025_erigone_rescue_1566b162:

    # "The Brute roared in delight and took a defensive stance, swatting away the Acarhyn attacks."
    "La Brute rugit de joie et adopta une posture défensive, repoussant les attaques des Acarhyns d’un coup de main."

# game/episode025.rpy:1133
translate french ep025_erigone_rescue_cee1cacc:

    # "One of the Warriors was able to sink her sword in one of the Brute’s left calf."
    "L’une des guerrières réussit à enfoncer son épée dans le mollet gauche de la Brute."

# game/episode025.rpy:1135
translate french ep025_erigone_rescue_17327a43:

    # "The Brute roared in pain and focused solely on the Warrior that had wounded her."
    "La Brute rugit de douleur et se concentra uniquement sur la guerrière qui l’avait blessée."

# game/episode025.rpy:1136
translate french ep025_erigone_rescue_0c617617:

    # "One of her massive hands shot out and grabbed the Acarhyn by her arm, wrenching the sword out of her grip."
    "L’une de ses mains gigantesques jaillit et attrapa l’Acarhyn par le bras, lui arrachant l’épée des mains."

# game/episode025.rpy:1137
translate french ep025_erigone_rescue_e70a3143:

    # "The Brute lifted the helpless Acarhyn off her feet and swung her into the air, eventually impaling her on the Brute’s wicked sword."
    "La Brute souleva l’Acarhyn sans défense et la fit tournoyer dans les airs, avant de l’empaler sur son épée acérée."

# game/episode025.rpy:1138
translate french ep025_erigone_rescue_e19b41b0:

    # "The Acarhyn used this distraction to further wound the Brute and were able to lacerate the creature’s skin multiple times."
    "Les Acarhyn profitèrent de cette distraction pour blesser davantage la Brute et réussirent à lacérer la peau de la créature à plusieurs reprises."

# game/episode025.rpy:1139
translate french ep025_erigone_rescue_00e2eeac:

    # "The other Brute was kept busy by several Acarhyn dancing around her, trying to hit the creature in the back."
    "L’autre Brute était occupée par plusieurs Acarhyn qui virevoltaient autour d’elle, essayant de frapper la créature dans le dos."

# game/episode025.rpy:1140
translate french ep025_erigone_rescue_5e89ef85:

    # "Discarding the limp body of the Acarhyn, the Brute resumed her fighting stance."
    "Jettant le corps inerte de l’Acarhyn, la Brute reprit sa posture de combat."

# game/episode025.rpy:1141
translate french ep025_erigone_rescue_272ad362:

    # "Swinging her sword again, the Brute tried to replicate her earlier attack, but wavered."
    "Brandissant à nouveau son épée, la Brute tenta de reproduire son attaque précédente, mais elle hésita."

# game/episode025.rpy:1143
translate french ep025_erigone_rescue_f64aa50d:

    # "For a moment, the Brute held her sword aloft, ready to make a horizontal arc."
    "Pendant un instant, la Brute garda son épée brandie, prête à décrire un arc horizontal."

# game/episode025.rpy:1144
translate french ep025_erigone_rescue_7123e4b7:

    # "Suddenly, snot started streaming out of the bottom of her helmet, soon mixed with a foamy substance that must have been her saliva."
    "Soudain, de la morve se mit à couler du bas de son casque, se mélangeant rapidement à une substance mousseuse qui devait être sa salive."

# game/episode025.rpy:1146
translate french ep025_erigone_rescue_510b8190:

    # "The sword clattered to the ground as the Brute tipped over and fell face forward on the ground."
    "L’épée tomba bruyamment au sol tandis que la Brute basculait et s’effondrait face contre terre."

# game/episode025.rpy:1147
translate french ep025_erigone_rescue_c9f4bd01:

    # "The Acarhyn cheered, but didn’t have long to celebrate, because the other Brute rushed them from the side."
    "Les Acarhyns poussèrent des cris de joie, mais ils n’eurent pas le temps de fêter ça bien longtemps, car l’autre Brute se précipita sur eux par le côté."

# game/episode025.rpy:1149
translate french ep025_erigone_rescue_6536bf0b:

    # "She was able to impale one Acarhyn, as her fist connected with the face of another."
    "Elle réussit à empaler un Acarhyn, tandis que son poing s’abattait sur le visage d’un autre."

# game/episode025.rpy:1150
translate french ep025_erigone_rescue_0a6563ec:

    # "A sickening crunch and the other Acarhyn fell to the ground, her face caved in from where it had connected with the Brute’s mailed fist."
    "Un craquement écœurant retentit et l’autre Acarhyn s’effondra au sol, le visage enfoncé à l’endroit où le poing ganté de la Brute l’avait frappée."

# game/episode025.rpy:1152
translate french ep025_erigone_rescue_2be66752:

    # "We had made progress in the meantime and were nearly at the spot where the Bastard would pick us up."
    "Entre-temps, on avait avancé et on était presque arrivés à l’endroit où le Bastard devait venir nous chercher."

# game/episode025.rpy:1153
translate french ep025_erigone_rescue_9cddd59e:

    # "The engines of our ship could already be heard in the near distance."
    "On entendait déjà les moteurs de notre vaisseau au loin."

# game/episode025.rpy:1154
translate french ep025_erigone_rescue_a343dc27:

    # "The remaining Brute must have heard it too, because she suddenly veered from fighting the Acarhyn and sprinted toward us."
    "La Brute restante avait dû les entendre aussi, car elle a soudainement cessé de se battre contre les Acarhyns et s’est précipitée vers nous."

# game/episode025.rpy:1156
translate french ep025_erigone_rescue_32f16a58:

    # av "Fuck, she’s going to trample us."
    av "Putain, elle va nous piétiner."

# game/episode025.rpy:1157
translate french ep025_erigone_rescue_b5ec2470:

    # rah "Run!{w} Just leave me!"
    rah "Courez ! {w} Laissez-moi tomber !"

# game/episode025.rpy:1159
translate french ep025_erigone_rescue_e2244a09:

    # "I took a grenade from my belt, pulled the pin and lobbed it into the Brute’s path."
    "J’ai sorti une grenade de ma ceinture, j’ai retiré la goupille et je l’ai lancée sur le chemin de la Brute."

# game/episode025.rpy:1160
translate french ep025_erigone_rescue_e1d08a9b:

    # "Because they were trailing far behind her already, I prayed that the Acarhyn pursuing the Brute wouldn’t be caught in the explosion."
    "Comme ils étaient déjà bien loin derrière elle, j’ai prié pour que l’Acarhyn qui poursuivait la Brute ne soit pas pris dans l’explosion."

# game/episode025.rpy:1161
translate french ep025_erigone_rescue_5ea71efd:

    # "The grenade flew with perfect accuracy at the Brute’s feet."
    "La grenade a volé avec une précision parfaite jusqu’aux pieds de la Brute."

# game/episode025.rpy:1163
translate french ep025_erigone_rescue_486b6458:

    # "She had just about passed the explosive when it detonated."
    "Elle venait à peine de dépasser l’engin explosif quand celui-ci a explosé."

# game/episode025.rpy:1164
translate french ep025_erigone_rescue_ae5836ae:

    # "For a moment, the Brute was lit up in orange flames."
    "L’espace d’un instant, la Brute fut enveloppée de flammes orange."

# game/episode025.rpy:1165
translate french ep025_erigone_rescue_ae964380:

    # "Incredibly, it didn’t kill the creature in one fell swoop, she must have crossed the explosive by several meters when it detonated."
    "Incroyablement, ça ne l’a pas tuée d’un seul coup ; elle avait dû déjà dépasser l’engin de plusieurs mètres quand il a explosé."

# game/episode025.rpy:1167
translate french ep025_erigone_rescue_7acb5423:

    # "However, her armor had caught fire and she was furiously swatting away the flames."
    "Par contre, son armure avait pris feu et elle s’acharnait à repousser les flammes."

# game/episode025.rpy:1168
translate french ep025_erigone_rescue_528aadf1:

    # "Behind her, the group of Acarhyn was scattered, most of them sitting dazed in the grass."
    "Derrière elle, le groupe d’Acarhyn était dispersé, la plupart d’entre eux assis dans l’herbe, encore sous le choc."

# game/episode025.rpy:1169
translate french ep025_erigone_rescue_750d4efc:

    # "I was relieved to see that all of them rapidly stood up and resumed their pursuit."
    "J’étais soulagé de voir qu’ils se relevaient tous rapidement et reprenaient leur poursuite."

# game/episode025.rpy:1171
translate french ep025_erigone_rescue_c2a9c4f9:

    # "To keep the Brute occupied, I ordered everyone to fire on her."
    "Pour occuper la Brute, j’ai ordonné à tout le monde de tirer sur elle."

# game/episode025.rpy:1172
translate french ep025_erigone_rescue_8313ac5e:

    # "Predictably, this enraged the creature considerably."
    "Comme on pouvait s’y attendre, ça a considérablement mis la créature en rage."

# game/episode025.rpy:1173
translate french ep025_erigone_rescue_5d90cd73:

    # "Smouldering, she lumbered toward us, now at half her original speed."
    "En fumant encore, elle s’est avancée lourdement vers nous, à moitié de sa vitesse initiale."

# game/episode025.rpy:1174
translate french ep025_erigone_rescue_7a7ac6dd:

    # c "Run for it, our ship is nearby!"
    c "Fuyez, notre vaisseau est tout près !"

# game/episode025.rpy:1176
translate french ep025_erigone_rescue_021f54be:

    # "We broke into a jog, dragging Rahia along with us."
    "On s’est mis à courir, en traînant Rahia avec nous."

# game/episode025.rpy:1177
translate french ep025_erigone_rescue_578ee754:

    # "The fight with the Brutes had already depleted the Acarhyn warriors and a renewed confrontation might prove fatal, even though the Brute was maimed."
    "Le combat contre les Brutes avait déjà épuisé les guerriers Acarhyn et une nouvelle confrontation risquait de leur être fatale, même si la Brute était mutilée."

# game/episode025.rpy:1179
translate french ep025_erigone_rescue_d0825503:

    # "The Bastard came into view, it’s cargo bay door already opening."
    "Le Bastard est apparu, la porte de sa soute s’ouvrait déjà."

# game/episode025.rpy:1180
translate french ep025_erigone_rescue_b4fe89af:

    # "The Brute was hot on our tail, screaming in rage."
    "La Brute était à nos trousses, hurlant de rage."

# game/episode025.rpy:1181
translate french ep025_erigone_rescue_a673b234:

    # "One of the Acarhyn warriors tripped over a rock and fell to the ground."
    "Une des guerrières Acarhyn trébucha sur un rocher et tomba au sol."

# game/episode025.rpy:1183
translate french ep025_erigone_rescue_6e5d6c5c:

    # "There wasn’t any time to rescue her, as the Brute pounced on her and pounded the helpless woman into the ground."
    "On n’eut pas le temps de la secourir, car la Brute bondit sur elle et écrasa la femme sans défense contre le sol."

# game/episode025.rpy:1184
translate french ep025_erigone_rescue_33894058:

    # "We were near the cargo hold when the Bastard’s cannon swung toward the colossal creature."
    "On était près de la soute quand le canon du Bastard s’est tourné vers la créature colossale."

# game/episode025.rpy:1186
translate french ep025_erigone_rescue_203e4bd9:

    # "The Brute was stopped dead in her tracks by several volleys of the cannon."
    "La Brute a été clouée sur place par plusieurs salves du canon."

# game/episode025.rpy:1187
translate french ep025_erigone_rescue_f84eba8f:

    # "The energy bolts burnt holes in her armor until one lucky shot slipped through the visor of her helmet."
    "Les rayons d’énergie ont percé des trous dans son armure jusqu’à ce qu’un tir chanceux passe à travers la visière de son casque."

# game/episode025.rpy:1189
translate french ep025_erigone_rescue_d844d14a:

    # "After a wet pop, the creature staggered backward and crashed to the ground."
    "Après un « pop » humide, la créature a titubé en arrière et s’est écroulée au sol."

# game/episode025.rpy:1191
translate french ep025_erigone_rescue_e9cfdd7e:

    # "We bundled Rahia inside the ship and the Bastard took off toward the Citadel."
    "On a fait monter Rahia à bord du vaisseau et le Bastard a décollé en direction de la Citadelle."

# game/episode025.rpy:1194
translate french ep025_erigone_rescue_490e77c4:

    # "Several mechs came through the foliage, blocking our way forward."
    "Plusieurs mechs ont surgi du feuillage, nous barrant la route."

# game/episode025.rpy:1195
translate french ep025_erigone_rescue_f5ad950f:

    # ki "Fuck, we’ve got company."
    ki "Merde, on a de la compagnie."

# game/episode025.rpy:1196
translate french ep025_erigone_rescue_37dc6778_1:

    # woman "Acarhyn on me, we’ll distract them."
    woman "Acarhyn, viens avec moi, on va les distraire."

# game/episode025.rpy:1197
translate french ep025_erigone_rescue_c654d0ae:

    # woman "You make sure the High Priestess gets safely inside the ship."
    woman "Assure-toi que la Grande Prêtresse monte en sécurité à bord du vaisseau."

# game/episode025.rpy:1199
translate french ep025_erigone_rescue_ced770b5:

    # "The Priests engaged the mechs, shooting at them from a distance."
    "Les prêtres ont engagé le combat contre les mechs, tirant sur eux à distance."

# game/episode025.rpy:1200
translate french ep025_erigone_rescue_a4a65b6e:

    # "One mech nearly buckled under the barrage of fire, but advanced steadily after recovering."
    "Un mech a failli céder sous le barrage de tirs, mais a continué d’avancer sans faiblir après s’être remis."

# game/episode025.rpy:1201
translate french ep025_erigone_rescue_5a9f2fd2:

    # "A spray of bullets from the mechs took out several Priestesses and they were forced to find cover."
    "Une rafale de balles tirée par les méchas a fauché plusieurs prêtresses, qui ont été contraintes de se mettre à l’abri."

# game/episode025.rpy:1203
translate french ep025_erigone_rescue_ff06d273:

    # "As the mechs were still occupied with the Priestesses, we ran further toward the Bastard, Keodele limping along with us."
    "Comme les méchas étaient toujours occupés avec les prêtresses, on a couru plus loin vers le Bastard, Keodele boitant à nos côtés."

# game/episode025.rpy:1204
translate french ep025_erigone_rescue_cb883e70:

    # "Gunfire could be heard behind us, the mechs appeared to have our rearguard pinned down."
    "On entendait des coups de feu derrière nous ; les méchas semblaient avoir cloué notre arrière-garde au sol."

# game/episode025.rpy:1205
translate french ep025_erigone_rescue_7ebf6739:

    # "When the gunfire stopped, we knew that the mechs were after us."
    "Quand les coups de feu ont cessé, on a compris que les méchas étaient à nos trousses."

# game/episode025.rpy:1207
translate french ep025_erigone_rescue_e7658ddd:

    # "A small group of Priestesses reached us and confirmed our suspicions."
    "Un petit groupe de prêtresses nous a rejoints et a confirmé nos soupçons."

# game/episode025.rpy:1208
translate french ep025_erigone_rescue_95348ab2:

    # woman "Heavy losses, we had to retreat."
    woman "On avait subi de lourdes pertes, on devait battre en retraite."

# game/episode025.rpy:1209
translate french ep025_erigone_rescue_7fca5538:

    # woman "We don’t have much time."
    woman "On n’a pas beaucoup de temps."

# game/episode025.rpy:1210
translate french ep025_erigone_rescue_6e780ad3:

    # "The mechs were now very close, breaking through the dense foliage of the jungle almost unimpeded."
    "Les méchas étaient désormais tout près, se frayant un chemin à travers le feuillage dense de la jungle presque sans encombre."

# game/episode025.rpy:1211
translate french ep025_erigone_rescue_d059cdc8:

    # "The Bastard still wasn’t in sight and we wouldn’t be able to survive another confrontation with the mechs on our own."
    "Le Bastard n’était toujours pas en vue et on ne pourrait pas survivre à un autre affrontement avec les méchas tout seuls."

# game/episode025.rpy:1213
translate french ep025_erigone_rescue_10bf3f89:

    # "One of the Acarhyn screamed as gunfire caught her in the back."
    "L’une des Acarhyn a hurlé quand une rafale de tirs l’a touchée dans le dos."

# game/episode025.rpy:1215
translate french ep025_erigone_rescue_967e4bcd:

    # "She fell to the ground and was immediately trampled by one of the mechs."
    "Elle est tombée au sol et a été immédiatement piétinée par l’un des méchas."

# game/episode025.rpy:1216
translate french ep025_erigone_rescue_46ef70bf:

    # c "Take cover!"
    c "Mettez-vous à l’abri !"

# game/episode025.rpy:1218
translate french ep025_erigone_rescue_7f61bf68:

    # "A barrage of gunfire peppered the clearing where we were just moments before."
    "Une rafale de tirs a criblé la clairière où on se trouvait quelques instants auparavant."

# game/episode025.rpy:1219
translate french ep025_erigone_rescue_b6d7767a:

    # "It was only a matter of time before the mechs would be able to reach us with their superior firepower."
    "Ce n’était qu’une question de temps avant que les méchas ne parviennent à nous atteindre grâce à leur puissance de feu supérieure."

# game/episode025.rpy:1221
translate french ep025_erigone_rescue_41980751:

    # "As I was thinking desperately of ways to get us back on the Bastard in one piece, several colossal creatures suddenly crashed through the foliage."
    "Alors que je réfléchissais désespérément à un moyen de nous ramener sains et saufs sur le Bastard, plusieurs créatures colossales ont soudainement surgi à travers le feuillage."

# game/episode025.rpy:1222
translate french ep025_erigone_rescue_97af6bb9:

    # "The Brutes took the mechs completely by surprise."
    "Les Brutes ont pris les méchas complètement par surprise."

# game/episode025.rpy:1224
translate french ep025_erigone_rescue_57094369:

    # "Two of them swung their big swords and severed both arms of one mech in a spray of sparks."
    "Deux d’entre elles ont brandi leurs grandes épées et ont sectionné les deux bras d’un mécha dans un jaillissement d’étincelles."

# game/episode025.rpy:1225
translate french ep025_erigone_rescue_3b53601b:

    # "Defenceless, the mech was destroyed in a matter of seconds."
    "Sans défense, le mécha a été détruit en quelques secondes."

# game/episode025.rpy:1227
translate french ep025_erigone_rescue_eafcc12d:

    # "The piloting Acarhyn warrior was pulled screaming from the wreckage and one of the Brutes pulled her head clean off her body without breaking a sweat."
    "La guerrière Acarhyn aux commandes fut arrachée en hurlant de l’épave et l’une des Brutes lui arracha la tête d’un seul coup, sans même transpirer."

# game/episode025.rpy:1228
translate french ep025_erigone_rescue_2b4d2934:

    # "The remaining mechs now fired upon the Brutes."
    "Les mechs restants ouvrirent alors le feu sur les Brutes."

# game/episode025.rpy:1229
translate french ep025_erigone_rescue_29164d34:

    # "Their armor took a lot of the heat, but I could see the Brutes straining under the firepower of the mechs."
    "Leur armure encaissait une grande partie des tirs, mais je voyais bien que les Brutes peinaient sous la puissance de feu des mechs."

# game/episode025.rpy:1230
translate french ep025_erigone_rescue_9ca47ddf:

    # "The mechs distracted, this had to be our moment."
    "Les mechs étaient distraits, c’était le moment ou jamais."

# game/episode025.rpy:1232
translate french ep025_erigone_rescue_7a7ac6dd_1:

    # c "Run for it, our ship is nearby!"
    c "Fuyez, notre vaisseau est tout près !"

# game/episode025.rpy:1233
translate french ep025_erigone_rescue_4d6adfa6:

    # "We broke into a jog, dragging Keodele along with us."
    "On s’est mis à courir, en traînant Keodele avec nous."

# game/episode025.rpy:1234
translate french ep025_erigone_rescue_d0825503_1:

    # "The Bastard came into view, it’s cargo bay door already opening."
    "Le Bastard est apparu, la porte de sa soute s’ouvrait déjà."

# game/episode025.rpy:1235
translate french ep025_erigone_rescue_11fb27fa:

    # "The mechs had obviously dealt with the Brutes definitively and were once again in pursuit."
    "Les méchas avaient visiblement réglé leur compte aux Brutes une bonne fois pour toutes et se lançaient à nouveau à notre poursuite."

# game/episode025.rpy:1237
translate french ep025_erigone_rescue_628a6970:

    # "We were near the cargo hold when the Bastard’s cannon swung toward the line of mechs."
    "On était près de la soute quand le canon du Bastard a pivoté vers la ligne des méchas."

# game/episode025.rpy:1238
translate french ep025_erigone_rescue_617a7b7b:

    # "The mechs lit up in flames after receiving several volleys of the cannon."
    "Les méchas se sont embrasés après avoir essuyé plusieurs salves du canon."

# game/episode025.rpy:1240
translate french ep025_erigone_rescue_74ee19cb:

    # "Two of the mechs were reduced to smoking ruins, the other two were burning and permanently out of commission."
    "Deux d’entre eux ont été réduits à des ruines fumantes, les deux autres brûlaient et étaient définitivement hors d’état de marche."

# game/episode025.rpy:1242
translate french ep025_erigone_rescue_feccb5b6:

    # "We bundled Keodele inside the ship and the Bastard took off toward the Shipyards."
    "On a fait monter Keodele à bord du vaisseau et l’Iron Bastard a décollé en direction des Chantiers navals."

# game/episode025.rpy:1251
translate french ep025_erigone_aftermath_d5232ce7:

    # "As soon as we arrived at the Citadel, we handed over Rahia so she could receive the required medical care."
    "Dès qu’on est arrivés à la Citadelle, on a confié Rahia aux soigneurs pour qu’elle reçoive les soins médicaux nécessaires."

# game/episode025.rpy:1254
translate french ep025_erigone_aftermath_232bb737:

    # "As soon as we arrived at the Shipyards, we handed over Keodele so she could receive the required medical care."
    "Dès qu’on est arrivés aux Chantiers navals, on a confié Keodele aux soigneurs pour qu’elle reçoive les soins médicaux nécessaires."

# game/episode025.rpy:1255
translate french ep025_erigone_aftermath_1d43f512:

    # "We stayed near the Iron Bastard, waiting for any news from the battlefield."
    "On est restés près de l’Iron Bastard, en attendant des nouvelles du champ de bataille."

# game/episode025.rpy:1258
translate french ep025_erigone_aftermath_452a9c40:

    # "After we arrived at the Citadel, we stayed near the Iron Bastard, waiting for any news from the battlefield."
    "Après notre arrivée à la Citadelle, on est resté près de l’Iron Bastard, en attendant des nouvelles du champ de bataille."

# game/episode025.rpy:1260
translate french ep025_erigone_aftermath_dbbbd0ed:

    # "After we arrived at the Shipyards, we stayed near the Iron Bastard, waiting for any news from the battlefield."
    "Après notre arrivée aux Chantiers navals, on est resté près de l’Iron Bastard, en attendant des nouvelles du champ de bataille."

# game/episode025.rpy:1261
translate french ep025_erigone_aftermath_fb6fc5b7:

    # "Despite the heavy fighting, our ship had come out with barely a scratch."
    "Malgré les combats acharnés, notre vaisseau s’en était sorti avec à peine une égratignure."

# game/episode025.rpy:1266
translate french ep025_erigone_aftermath_730fb30d:

    # "The same couldn’t be said for the troops and ordnance returning from the jungle."
    "On ne pouvait pas en dire autant des troupes et du matériel qui revenaient de la jungle."

# game/episode025.rpy:1268
translate french ep025_erigone_aftermath_872367e1:

    # "The Warrior caste had clearly encountered heavy opposition."
    "La caste des Guerriers avait clairement rencontré une forte résistance."

# game/episode025.rpy:1270
translate french ep025_erigone_aftermath_e4e2a2fb:

    # "The Priest caste had clearly encountered heavy opposition."
    "La caste des Prêtres avait clairement rencontré une forte résistance."

# game/episode025.rpy:1271
translate french ep025_erigone_aftermath_4954a9ff:

    # "The outcome of the battle was still very much unknown."
    "L’issue de la bataille restait encore très incertaine."

# game/episode025.rpy:1282
translate french ep025_erigone_aftermath_426fc3a8:

    # "Eva joined us soon after our arrival and we brought her up to speed with the latest developments."
    "Eva nous a rejoints peu après notre arrivée et on l’a mise au courant des derniers développements."

# game/episode025.rpy:1291
translate french ep025_erigone_aftermath_ab83de61:

    # "Several hours passed until a group of Acarhyn returned."
    "Plusieurs heures se sont écoulées avant qu’un groupe d’Acarhyn ne revienne."

# game/episode025.rpy:1292
translate french ep025_erigone_aftermath_b3a8c9b2:

    # "They looked rather grim and forlorn."
    "Ils avaient l’air plutôt sombre et abattu."

# game/episode025.rpy:1297
translate french ep025_erigone_aftermath_e458c067:

    # woman "Greetings, Your Majesty."
    woman "Salutations, Votre Majesté."

# game/episode025.rpy:1298
translate french ep025_erigone_aftermath_a5c5b985:

    # woman "The war is over."
    woman "La guerre est finie."

# game/episode025.rpy:1300
translate french ep025_erigone_aftermath_1cafa0bb:

    # woman "We’re fighting the last vestiges of Priest resistance, but they’re fighting a losing battle."
    woman "On combat les derniers vestiges de la résistance des Prêtres, mais ils mènent un combat perdu d’avance."

# game/episode025.rpy:1301
translate french ep025_erigone_aftermath_2ec3d010:

    # woman "Tomorrow will be a day of mourning for the loss of our Commander."
    woman "Demain sera un jour de deuil pour la perte de notre commandante."

# game/episode025.rpy:1302
translate french ep025_erigone_aftermath_70b842ca:

    # woman "Commander Rahia perished on the battlefield."
    woman "La commandante Rahia a péri sur le champ de bataille."

# game/episode025.rpy:1304
translate french ep025_erigone_aftermath_78ed9151:

    # woman "We’re fighting the last vestiges of Warrior resistance, but they’re fighting a losing battle."
    woman "On combat les derniers vestiges de la résistance des guerriers, mais ils mènent un combat perdu d’avance."

# game/episode025.rpy:1305
translate french ep025_erigone_aftermath_68b3791a:

    # woman "Tomorrow will be a day of mourning for the loss of our High Priestess."
    woman "Demain sera un jour de deuil pour la perte de notre grande prêtresse."

# game/episode025.rpy:1306
translate french ep025_erigone_aftermath_76c83223:

    # woman "High Priestess Keodele perished on the battlefield."
    woman "La grande prêtresse Keodele a péri sur le champ de bataille."

# game/episode025.rpy:1307
translate french ep025_erigone_aftermath_f3b2e923:

    # woman "Her rescue came too late."
    woman "On est arrivés trop tard pour la sauver."

# game/episode025.rpy:1312
translate french ep025_erigone_aftermath_225763cf:

    # e "Her bravery and mettle were unparalleled."
    e "Son courage et sa force d’âme étaient sans pareil."

# game/episode025.rpy:1313
translate french ep025_erigone_aftermath_6c409f3e:

    # e "She will receive a funeral with full honors."
    e "Elle aura droit à des funérailles avec tous les honneurs."

# game/episode025.rpy:1318
translate french ep025_erigone_aftermath_6a23da66:

    # woman "Of course, Your Majesty."
    woman "Bien sûr, Votre Majesté."

# game/episode025.rpy:1319
translate french ep025_erigone_aftermath_38789e09:

    # "The Acarhyn left us to talk amongst ourselves."
    "Les Acarhyn nous ont laissés entre nous pour discuter."

# game/episode025.rpy:1324
translate french ep025_erigone_aftermath_177b4765:

    # av "This is a blow for us."
    av "C’est un coup dur pour nous."

# game/episode025.rpy:1326
translate french ep025_erigone_aftermath_54fd3ecc:

    # av "Rahia was an ally."
    av "Rahia était une alliée."

# game/episode025.rpy:1328
translate french ep025_erigone_aftermath_b2107857:

    # av "Keodele was an ally, albeit a reluctant one."
    av "Keodele était une alliée, même si elle l’était à contrecœur."

# game/episode025.rpy:1329
translate french ep025_erigone_aftermath_26e2c7f1:

    # c "Yes, she was."
    c "Oui, c’est vrai."

# game/episode025.rpy:1334
translate french ep025_erigone_aftermath_71475c83:

    # l "Should we have participated in the attempt to rescue her?"
    l "On aurait dû participer à la tentative pour la sauver ?"

# game/episode025.rpy:1335
translate french ep025_erigone_aftermath_56be2fbf:

    # c "That would have been a suicide run."
    c "Ça aurait été une mission suicide."

# game/episode025.rpy:1336
translate french ep025_erigone_aftermath_a5a7719c:

    # c "You all saw the chaos on the battlefield."
    c "Vous avez tous vu le chaos qui régnait sur le champ de bataille."

# game/episode025.rpy:1337
translate french ep025_erigone_aftermath_34bd489d:

    # c "The Bastard was in no shape to touch down amidst all that."
    c "Le Bastard n’était pas en état d’atterrir au milieu de tout ça."

# game/episode025.rpy:1342
translate french ep025_erigone_aftermath_a84bedf1:

    # na "The only thing we can do now is hope for the best."
    na "La seule chose qu’on puisse faire maintenant, c’est espérer que tout ira pour le mieux."

# game/episode025.rpy:1347
translate french ep025_erigone_aftermath_23e2cfd6:

    # "The Acarhyn were right to surmise that the fighting would stop soon."
    "Les Acarhyn avaient raison de penser que les combats cesseraient bientôt."

# game/episode025.rpy:1348
translate french ep025_erigone_aftermath_a7546641:

    # "No more gunfire could be heard when darkness fell."
    "On n’entendait plus aucun coup de feu à la tombée de la nuit."

# game/episode025.rpy:1351
translate french ep025_erigone_aftermath_3ef3376f:

    # "Captured priests were led into the Citadel."
    "Les prêtres capturés ont été conduits à la Citadelle."

# game/episode025.rpy:1354
translate french ep025_erigone_aftermath_b5757ba3:

    # "Captured warriors were led into the Shipyards."
    "Les guerriers capturés ont été conduits aux Chantiers navals."

# game/episode025.rpy:1355
translate french ep025_erigone_aftermath_7fc04698:

    # "Though everyone appeared to be glad the conflict was over, the atmosphere was very muted."
    "Même si tout le monde semblait content que le conflit soit terminé, l’ambiance était très morose."

# game/episode025.rpy:1361
translate french ep025_erigone_aftermath_4dfd6db1:

    # "This continued the next day, when Rahia’s funeral was held."
    "Ça a continué le lendemain, lors des funérailles de Rahia."

# game/episode025.rpy:1362
translate french ep025_erigone_aftermath_cda37602:

    # "Eva was required to oversee the proceedings and lit Rahia’s funeral pyre."
    "Eva a dû superviser la cérémonie et allumer le bûcher funéraire de Rahia."

# game/episode025.rpy:1365
translate french ep025_erigone_aftermath_81d9d0eb:

    # "This continued the next day, when Keodele’s funeral was held."
    "Ça a continué le lendemain, lors des funérailles de Keodele."

# game/episode025.rpy:1366
translate french ep025_erigone_aftermath_9e292821:

    # "Eva was required to oversee the proceedings and lit Keodele’s funeral pyre."
    "Eva a dû superviser la cérémonie et allumer le bûcher funéraire de Keodele."

# game/episode025.rpy:1368
translate french ep025_erigone_aftermath_8bceff4c:

    # "Several days after the funeral, a group of Acarhyn requested an audience with their queen."
    "Quelques jours après les funérailles, un groupe d’Acarhyn a demandé une audience avec leur reine."

# game/episode025.rpy:1369
translate french ep025_erigone_aftermath_0a09474a:

    # "As we were preparing to leave Erigone, we agreed to meet them near the Bastard."
    "Alors qu’on s’apprêtait à quitter Erigone, on a accepté de les rencontrer près du Bastard."

# game/episode025.rpy:1380
translate french ep025_erigone_aftermath_5a753fcb:

    # woman "My Queen, we have come to pledge our support to the mission Your Majesty has asked us to join."
    woman "Ma reine, on est venus t’assurer de notre soutien pour la mission à laquelle Ta Majesté nous a demandé de participer."

# game/episode025.rpy:1381
translate french ep025_erigone_aftermath_6b74cd68:

    # woman "The Acarhyn will defeat the Sovereignty once and for all!"
    woman "Les Acarhyn vaincront la Souveraineté une bonne fois pour toutes !"

# game/episode025.rpy:1392
translate french ep025_erigone_aftermath_92474673:

    # e "We thank you."
    e "On te remercie."

# game/episode025.rpy:1393
translate french ep025_erigone_aftermath_5e09efe2:

    # e "Your pledge of allegiance is honorable and just, befitting of a true Acarhyn."
    e "Ton serment d’allégeance est honorable et juste, digne d’un vrai Acarhyn."

# game/episode025.rpy:1404
translate french ep025_erigone_aftermath_f3ede4bf:

    # woman "Thank you, Your Majesty."
    woman "Merci, Votre Majesté."

# game/episode025.rpy:1405
translate french ep025_erigone_aftermath_e033414a:

    # woman "Our only regret is that not all of us will be able to join the fight."
    woman "Notre seul regret, c’est que nous ne puissions pas tous rejoindre le combat."

# game/episode025.rpy:1406
translate french ep025_erigone_aftermath_9bced104:

    # woman "Erigone needs to be rebuilt and our caste is in need of new leadership."
    woman "Erigone doit être reconstruite et notre caste a besoin d’une nouvelle direction."

# game/episode025.rpy:1408
translate french ep025_erigone_aftermath_511f7d1d:

    # woman "Choosing a new Commander will be difficult."
    woman "Choisir un nouveau commandant ne sera pas facile."

# game/episode025.rpy:1410
translate french ep025_erigone_aftermath_c4d34907:

    # woman "Choosing a new High Priestess will be difficult."
    woman "Choisir une nouvelle grande prêtresse ne sera pas facile."

# game/episode025.rpy:1421
translate french ep025_erigone_aftermath_6c8945ca:

    # e "We recognize your hardship, which makes your pledge all the more worthy."
    e "On comprend tes difficultés, ce qui rend ton engagement d’autant plus louable."

# game/episode025.rpy:1422
translate french ep025_erigone_aftermath_1bd12c65:

    # c "My crew will coordinate with you on how to join the forces that have already gathered in opposition against the Sovereignty."
    c "Mon équipage se coordonnera avec toi pour savoir comment rejoindre les forces déjà rassemblées contre la Souveraineté."

# game/episode025.rpy:1424
translate french ep025_erigone_aftermath_fc2df6fb:

    # "This surely wasn’t the most ideal outcome, but we had no choice but to accept it."
    "Ce n’était certainement pas l’issue la plus idéale, mais on n’avait pas d’autre choix que de l’accepter."

# game/episode025.rpy:1425
translate french ep025_erigone_aftermath_a67c6b43:

    # "Céline and Thyia provided the Acarhyn with the necessary information to join up with the fleet we had already amassed."
    "Céline et Thyia ont fourni aux Acarhyns les informations nécessaires pour rejoindre la flotte qu’on avait déjà rassemblée."

# game/episode025.rpy:1426
translate french ep025_erigone_aftermath_2bf1e69a:

    # "We would be joining up with the fleet too, to see if the Rhenkoy and Tubloshi had made progress in recruiting new forces into the fold."
    "On allait aussi rejoindre la flotte, pour voir si les Rhenkoy et les Tubloshi avaient fait des progrès dans le recrutement de nouvelles forces."

# game/episode025.rpy:1430
translate french ep025_erigone_aftermath_c90687f9:

    # "Several hours passed until a group of Acarhyn returned, Rahia among them."
    "Plusieurs heures se sont écoulées avant qu’un groupe d’Acarhyn ne revienne, avec Rahia parmi eux."

# game/episode025.rpy:1436
translate french ep025_erigone_aftermath_b27dbce7:

    # "Several hours passed until a group of Acarhyn returned, Keodele among them."
    "Plusieurs heures se sont écoulées avant qu’un groupe d’Acarhyn ne revienne, avec Keodele parmi eux."

# game/episode025.rpy:1437
translate french ep025_erigone_aftermath_85f6a0c6:

    # "She still had trouble walking, but looked a little less worse for wear."
    "Elle avait encore du mal à marcher, mais semblait un peu moins mal en point."

# game/episode025.rpy:1440
translate french ep025_erigone_aftermath_abed9d08:

    # rah "Your Majesty, I’m pleased to announce that the war is over."
    rah "Votre Majesté, j’ai le plaisir de t’annoncer que la guerre est finie."

# game/episode025.rpy:1441
translate french ep025_erigone_aftermath_5b278a9b:

    # rah "We’re dealing with some small Priest caste remnants, but they don’t pose a lasting threat."
    rah "On a encore affaire à quelques vestiges de la caste des prêtres, mais ils ne représentent pas une menace durable."

# game/episode025.rpy:1442
translate french ep025_erigone_aftermath_1f9240dd:

    # rah "Keodele has been captured and is currently imprisoned in the Citadel dungeons."
    rah "Keodele a été capturée et est actuellement emprisonnée dans les cachots de la Citadelle."

# game/episode025.rpy:1443
translate french ep025_erigone_aftermath_6aca2d14:

    # rah "Her trial will be tomorrow and Your Majesty is kindly asked to attend."
    rah "Son procès aura lieu demain et on te demande, Votre Majesté, d’y assister."

# game/episode025.rpy:1448
translate french ep025_erigone_aftermath_f6e589f8:

    # e "Thank you, commander."
    e "Merci, commandante."

# game/episode025.rpy:1449
translate french ep025_erigone_aftermath_9aa253fc:

    # e "You have fought valiantly and helped us secure the victory the Acarhyn people so desperately needed."
    e "Tu t’es battu vaillamment et tu nous as aidés à remporter la victoire dont le peuple acarhyn avait tant besoin."

# game/episode025.rpy:1450
translate french ep025_erigone_aftermath_28ecae96:

    # e "We will of course attend the trial of the traitor Keodele tomorrow."
    e "On assistera bien sûr demain au procès de la traîtresse Keodele."

# game/episode025.rpy:1452
translate french ep025_erigone_aftermath_53921eb5:

    # "The Acarhyn left us and we all headed back to our quarters for some much-needed sleep."
    "Les Acarhyns nous ont quittés et on est tous retournés dans nos quartiers pour un sommeil bien mérité."

# game/episode025.rpy:1454
translate french ep025_erigone_aftermath_43577c94:

    # "Some intermittent gunfire could be heard during the night, but eventually this all stopped."
    "On a entendu quelques coups de feu sporadiques pendant la nuit, mais tout ça a fini par s’arrêter."

# game/episode025.rpy:1455
translate french ep025_erigone_aftermath_32fd5cb3:

    # "Rahia was right in presuming that any remaining resistance would soon be broken."
    "Rahia avait vu juste en supposant que toute résistance restante serait bientôt anéantie."

# game/episode025.rpy:1457
translate french ep025_erigone_aftermath_7754fc85:

    # "A steady stream of captured priests were led into the Citadel during the early morning."
    "Un flot continu de prêtres capturés a été conduit dans la Citadelle tôt ce matin."

# game/episode025.rpy:1462
translate french ep025_erigone_aftermath_3e105349:

    # "The trial of Keodele took place around midday in the courtyard of the Citadel."
    "Le procès de Keodele a eu lieu vers midi dans la cour de la Citadelle."

# game/episode025.rpy:1463
translate french ep025_erigone_aftermath_c5a90a19:

    # "Eva had already been fetched and was standing on the dais in the courtyard, joined by Rahia."
    "Eva avait déjà été amenée et se tenait sur l'estrade de la cour, aux côtés de Rahia."

# game/episode025.rpy:1464
translate french ep025_erigone_aftermath_527f6c57:

    # "A group of Acarhyn stood on the side of the platform and served as a jury."
    "Un groupe d'Acarhyn se tenait sur le côté de l'estrade et faisait office de jury."

# game/episode025.rpy:1469
translate french ep025_erigone_aftermath_39dbfc87:

    # "The former High Priestess was standing barefeet on the rough wooden boards and looked rather less stately than before."
    "L’ancienne Grande Prêtresse se tenait pieds nus sur les planches de bois rugueuses et semblait bien moins imposante qu’auparavant."

# game/episode025.rpy:1470
translate french ep025_erigone_aftermath_753b7eaf:

    # "Her gaze was defiant though."
    "Son regard était pourtant provocateur."

# game/episode025.rpy:1471
translate french ep025_erigone_aftermath_4194cd32:

    # "Nothing of the timid acolyte I encountered before remained."
    "Il ne restait plus rien de la timide acolyte que j’avais rencontrée auparavant."

# game/episode025.rpy:1472
translate french ep025_erigone_aftermath_6bcc20d8:

    # "I could see why she’d been able to rally the Priest caste around her and inspire them to rebel against the Warriors."
    "Je comprenais pourquoi elle avait réussi à rallier la caste des prêtres autour d’elle et à les inciter à se rebeller contre les guerriers."

# game/episode025.rpy:1473
translate french ep025_erigone_aftermath_bfdfc8c7:

    # "All of that bravado was now moot and Keodele seemed to have deduced what her final fate would be."
    "Toute cette bravade n’avait plus d’importance désormais et Keodele semblait avoir deviné quel serait son sort final."

# game/episode025.rpy:1475
translate french ep025_erigone_aftermath_e116f1b4:

    # rah "Acarhyn!"
    rah "Acarhyn !"

# game/episode025.rpy:1476
translate french ep025_erigone_aftermath_6b679e9f:

    # rah "The war is over."
    rah "La guerre est finie."

# game/episode025.rpy:1477
translate french ep025_erigone_aftermath_96621cda:

    # rah "Erigone will be rebuilt and returned to its former glory."
    rah "Erigone sera reconstruite et retrouvera sa gloire d’antan."

# game/episode025.rpy:1479
translate french ep025_erigone_aftermath_38c13164:

    # rah "The Priest caste will be curtailed and regulated."
    rah "La caste des prêtres sera restreinte et réglementée."

# game/episode025.rpy:1480
translate french ep025_erigone_aftermath_4e72e06a:

    # rah "Priests will no longer be allowed to bear arms."
    rah "Les prêtres ne seront plus autorisés à porter les armes."

# game/episode025.rpy:1481
translate french ep025_erigone_aftermath_52207feb:

    # rah "Any gatherings of ten or more people are forbidden, unless officially sanctioned by the Erigone government."
    rah "Tout rassemblement de dix personnes ou plus est interdit, sauf s’il est officiellement autorisé par le gouvernement d’Erigone."

# game/episode025.rpy:1482
translate french ep025_erigone_aftermath_2d4896df:

    # rah "Any Priestesses who wish to give up their calling are free to do so, without fear of repercussions."
    rah "Toute prêtresse qui souhaite renoncer à sa vocation est libre de le faire, sans craindre de représailles."

# game/episode025.rpy:1483
translate french ep025_erigone_aftermath_95304af6:

    # rah "Any Priestesses who wish to join the Warrior caste and contribute to the rebuilding of Erigone are welcome to do so."
    rah "Toutes prêtresses qui souhaitent rejoindre la caste des guerriers et contribuer à la reconstruction d’Erigone sont les bienvenues."

# game/episode025.rpy:1485
translate french ep025_erigone_aftermath_0bb01d77:

    # rah "This conflict has served as a line drawn under any hostilities among the castes."
    rah "Ce conflit a permis de tirer un trait sur toutes les hostilités entre les castes."

# game/episode025.rpy:1486
translate french ep025_erigone_aftermath_df56b3d0:

    # rah "However, the instigators of the rebellion must be brought to justice."
    rah "Cependant, les instigateurs de la rébellion doivent être traduits en justice."

# game/episode025.rpy:1488
translate french ep025_erigone_aftermath_ba1e5c2a:

    # rah "Keodele, former High Priestess of the Priest caste, is the first to be tried."
    rah "Keodele, ancienne Grande Prêtresse de la caste des Prêtres, est la première à être jugée."

# game/episode025.rpy:1489
translate french ep025_erigone_aftermath_2ad5104a:

    # rah "Many of her lieutenants will be brought to justice in the coming days."
    rah "Beaucoup de ses lieutenants seront traduits en justice dans les jours à venir."

# game/episode025.rpy:1491
translate french ep025_erigone_aftermath_85bc64a2:

    # rah "Justice will be done."
    rah "Justice sera faite."

# game/episode025.rpy:1492
translate french ep025_erigone_aftermath_94c27711:

    # rah "This court is now in session."
    rah "La séance est ouverte."

# game/episode025.rpy:1494
translate french ep025_erigone_aftermath_724d4226:

    # rah "Keodele, you stand accused of high treason in your attempt to eradicate the Warrior caste."
    rah "Keodele, tu es accusée de haute trahison pour avoir tenté d’éradiquer la caste des Guerriers."

# game/episode025.rpy:1495
translate french ep025_erigone_aftermath_da479a11:

    # rah "Furthermore, you are accused of giving the order to perform experiments on unwilling Acarhyn."
    rah "De plus, tu es accusée d’avoir donné l’ordre de mener des expériences sur des Acarhyns contre leur gré."

# game/episode025.rpy:1496
translate french ep025_erigone_aftermath_9f3d8bb8:

    # rah "The so-called Brutes, created on your instigation, were used as troops in the conflict."
    rah "Les soi-disant « Brutes », créées à ton instigation, ont été utilisées comme troupes pendant le conflit."

# game/episode025.rpy:1497
translate french ep025_erigone_aftermath_a5890d40:

    # rah "Many of them perished on the battlefield or because of their extremely short lifespans."
    rah "Beaucoup d’entre eux ont péri sur le champ de bataille ou en raison de leur espérance de vie extrêmement courte."

# game/episode025.rpy:1498
translate french ep025_erigone_aftermath_1da25d6d:

    # rah "How do you plead?"
    rah "Comment te défends-tu ?"

# game/episode025.rpy:1500
translate french ep025_erigone_aftermath_5c0f6cf4:

    # keo "Not guilty."
    keo "Non coupable."

# game/episode025.rpy:1502
translate french ep025_erigone_aftermath_74bf7f87:

    # rah "Do you deny conspiring against the Warrior caste?"
    rah "Nies-tu avoir conspiré contre la caste des Guerriers ?"

# game/episode025.rpy:1503
translate french ep025_erigone_aftermath_0785f90e:

    # rah "Do you deny giving the order to experiment on your fellow Acarhyn?"
    rah "Nies-tu avoir donné l’ordre de mener des expériences sur tes compatriotes Acarhyns ?"

# game/episode025.rpy:1505
translate french ep025_erigone_aftermath_f99b03b9:

    # keo "I do not."
    keo "Non."

# game/episode025.rpy:1506
translate french ep025_erigone_aftermath_24a8c1db:

    # keo "I did what was necessary."
    keo "J’ai fait ce qui était nécessaire."

# game/episode025.rpy:1507
translate french ep025_erigone_aftermath_83b646be:

    # keo "And I’d do it again."
    keo "Et je le referais."

# game/episode025.rpy:1512
translate french ep025_erigone_aftermath_9b2eca6a:

    # "This statement elicited gasps from the audience."
    "Cette déclaration a provoqué des cris de stupéfaction dans l’assistance."

# game/episode025.rpy:1513
translate french ep025_erigone_aftermath_9fc2f544:

    # "The trial went on for quite some time, though everyone already knew the outcome."
    "Le procès s’est prolongé un bon moment, même si tout le monde connaissait déjà l’issue."

# game/episode025.rpy:1514
translate french ep025_erigone_aftermath_4c9db5fd:

    # "Ample amounts of evidence were presented and never refuted by Keodele."
    "De nombreuses preuves ont été présentées et n’ont jamais été réfutées par Keodele."

# game/episode025.rpy:1515
translate french ep025_erigone_aftermath_5e6dcf69:

    # "Keodele might not have pleaded guilty, but never denied any of her actions."
    "Keodele n’a peut-être pas plaidé coupable, mais elle n’a jamais nié aucune de ses actions."

# game/episode025.rpy:1516
translate french ep025_erigone_aftermath_8998a2b6:

    # "The guilty verdict from the jury came as no surprise to anyone, including Keodele."
    "Le verdict de culpabilité rendu par le jury n’a surpris personne, pas même Keodele."

# game/episode025.rpy:1517
translate french ep025_erigone_aftermath_a5f00871:

    # "It fell to Eva to read out the sentence."
    "C’est à Eva qu’il revint de lire la sentence."

# game/episode025.rpy:1522
translate french ep025_erigone_aftermath_7565a4a7:

    # e "Keodele, this court deems you guilty of war crimes, crimes against the Acarhyn people and high treason."
    e "Keodele, ce tribunal te déclare coupable de crimes de guerre, de crimes contre le peuple Acarhyn et de haute trahison."

# game/episode025.rpy:1523
translate french ep025_erigone_aftermath_8889a604:

    # e "The Acarhyn know only one sentence for these crimes."
    e "Les Acarhyn ne connaissent qu’une seule peine pour ces crimes."

# game/episode025.rpy:1524
translate french ep025_erigone_aftermath_a96abd78:

    # e "You are to be executed, effective immediately."
    e "Tu seras exécutée, avec effet immédiat."

# game/episode025.rpy:1526
translate french ep025_erigone_aftermath_34409500:

    # keo "Everything I did, was for the benefit of Acarhynkind."
    keo "Tout ce que j’ai fait, c’était pour le bien du peuple Acarhyn."

# game/episode025.rpy:1527
translate french ep025_erigone_aftermath_d5d1d8e6:

    # keo "I have no remorse."
    keo "Je n’ai aucun remords."

# game/episode025.rpy:1528
translate french ep025_erigone_aftermath_1142065e:

    # keo "You may kill me, but my dream of a better Erigone will live on in the hearts of my true believers."
    keo "Vous pouvez me tuer, mais mon rêve d’une meilleure Erigone continuera de vivre dans le cœur de mes fidèles."

# game/episode025.rpy:1533
translate french ep025_erigone_aftermath_465f16fd:

    # "A chopping block had been fetched and Rahia had drawn her sword."
    "On avait apporté un billot et Rahia avait dégainé son épée."

# game/episode025.rpy:1534
translate french ep025_erigone_aftermath_7f6e75fa:

    # "Keodele was made to let her head rest on the block."
    "On obligea Keodele à poser sa tête sur le billot."

# game/episode025.rpy:1536
translate french ep025_erigone_aftermath_4bd7a52b:

    # "With one stroke, Rahia severed Keodele’s head from her body."
    "D’un seul coup, Rahia trancha la tête de Keodele."

# game/episode025.rpy:1537
translate french ep025_erigone_aftermath_26df63cc:

    # "There were no cheers or any reaction from the audience."
    "Il n’y eut ni acclamations ni aucune réaction de la part du public."

# game/episode025.rpy:1539
translate french ep025_erigone_aftermath_9edfe287:

    # "We all left the courtyard in silence."
    "On quitta tous la cour en silence."

# game/episode025.rpy:1540
translate french ep025_erigone_aftermath_7de803e7:

    # "The trials continued during the coming days and many executions followed."
    "Les procès se poursuivirent les jours suivants et de nombreuses exécutions eurent lieu."

# game/episode025.rpy:1541
translate french ep025_erigone_aftermath_b31ff031:

    # "We didn’t attend those, as we were too busy preparing the Bastard to leave Erigone."
    "On n’y assista pas, car on était trop occupés à préparer le Bastard pour quitter Erigone."

# game/episode025.rpy:1546
translate french ep025_erigone_aftermath_e349d7b1:

    # "Rahia visited us a few days before we were scheduled to leave."
    "Rahia vint nous rendre visite quelques jours avant notre départ prévu."

# game/episode025.rpy:1547
translate french ep025_erigone_aftermath_56ecd585:

    # rah "My Queen, the Acarhyn Council has reached a verdict on joining the mission Your Majesty has proposed."
    rah "Ma reine, le Conseil d’Acarhyn a rendu son verdict concernant la participation à la mission que Ta Majesté a proposée."

# game/episode025.rpy:1548
translate french ep025_erigone_aftermath_64390812:

    # rah "I have come to formally pledge our support to the alliance against the Sovereignty."
    rah "Je suis venue t’assurer officiellement de notre soutien à l’alliance contre la Souveraineté."

# game/episode025.rpy:1553
translate french ep025_erigone_aftermath_92474673_1:

    # e "We thank you."
    e "On te remercie."

# game/episode025.rpy:1554
translate french ep025_erigone_aftermath_5e09efe2_1:

    # e "Your pledge of allegiance is honorable and just, befitting of a true Acarhyn."
    e "Ton serment d’allégeance est honorable et juste, digne d’un vrai Acarhyn."

# game/episode025.rpy:1556
translate french ep025_erigone_aftermath_80052ee9:

    # rah "Thank you, Your Majesty."
    rah "Merci, Votre Majesté."

# game/episode025.rpy:1557
translate french ep025_erigone_aftermath_70152226:

    # rah "The Priest caste has been decimated and no further rebellions are expected."
    rah "La caste des prêtres a été décimée et aucune autre rébellion n’est à craindre."

# game/episode025.rpy:1558
translate french ep025_erigone_aftermath_bf043df9:

    # rah "A contingent of Acarhyn will remain on Erigone, overseeing the repairs and restoring order to our lands."
    rah "Un contingent d’Acarhyn restera sur Erigone pour superviser les réparations et rétablir l’ordre sur nos terres."

# game/episode025.rpy:1559
translate french ep025_erigone_aftermath_ca0a86f0:

    # rah "I will personally lead the Acarhyn who’ll be joining the alliance against the Sovereignty."
    rah "Je dirigerai personnellement les Acarhyn qui rejoindront l’alliance contre la Souveraineté."

# game/episode025.rpy:1564
translate french ep025_erigone_aftermath_e9cc8ef1:

    # e "We thank you again for your cooperation."
    e "On te remercie encore pour ta coopération."

# game/episode025.rpy:1565
translate french ep025_erigone_aftermath_1bd12c65_1:

    # c "My crew will coordinate with you on how to join the forces that have already gathered in opposition against the Sovereignty."
    c "Mon équipage se coordonnera avec toi pour savoir comment rejoindre les forces déjà rassemblées contre la Souveraineté."

# game/episode025.rpy:1567
translate french ep025_erigone_aftermath_a67c6b43_1:

    # "Céline and Thyia provided the Acarhyn with the necessary information to join up with the fleet we had already amassed."
    "Céline et Thyia ont fourni aux Acarhyns les informations nécessaires pour rejoindre la flotte qu’on avait déjà rassemblée."

# game/episode025.rpy:1568
translate french ep025_erigone_aftermath_2bb8ca6b:

    # "Rahia and her Acarhyn would depart at the same time we would be joining up with the fleet."
    "Rahia et ses Acarhyn partiraient au moment même où on rejoindrait la flotte."

# game/episode025.rpy:1569
translate french ep025_erigone_aftermath_4fa22838:

    # "The addition of all those Acarhyn Warriors was a definitive win for us and we were curious to see if the Rhenkoy and Tubloshi had made progress in recruiting new forces into the fold."
    "L’arrivée de tous ces guerriers Acarhyn a été une victoire décisive pour nous, et on était curieux de voir si les Rhenkoy et les Tubloshi avaient fait des progrès dans le recrutement de nouvelles forces au sein de leur camp."

# game/episode025.rpy:1572
translate french ep025_erigone_aftermath_56e24973:

    # keo "Your Majesty, we have vanquished our foes."
    keo "Ta Majesté, on a vaincu nos ennemis."

# game/episode025.rpy:1573
translate french ep025_erigone_aftermath_717d53d7:

    # keo "The conflict is over."
    keo "Le conflit est terminé."

# game/episode025.rpy:1574
translate french ep025_erigone_aftermath_a96057b8:

    # keo "Some of the Warrior caste still oppose us, but they are not a lasting threat and will be dealt with soon enough."
    keo "Certains membres de la caste des guerriers s’opposent encore à nous, mais ils ne constituent pas une menace durable et on s’en occupera bien assez tôt."

# game/episode025.rpy:1575
translate french ep025_erigone_aftermath_35e71953:

    # keo "Commander Rahia has been taken prisoner and is being held in the Shipyards until her execution tomorrow."
    keo "La commandante Rahia a été faite prisonnière et est détenue dans les chantiers navals jusqu’à son exécution demain."

# game/episode025.rpy:1576
translate french ep025_erigone_aftermath_94f150eb:

    # keo "Your Majesty is expected to oversee the proceedings."
    keo "On attend de toi, Votre Majesté, que tu présides la cérémonie."

# game/episode025.rpy:1581
translate french ep025_erigone_aftermath_ceb9a47a:

    # e "Of course we will attend, High Priestess."
    e "Bien sûr qu’on sera là, Grande Prêtresse."

# game/episode025.rpy:1582
translate french ep025_erigone_aftermath_9aa253fc_1:

    # e "You have fought valiantly and helped us secure the victory the Acarhyn people so desperately needed."
    e "Tu t’es battu vaillamment et tu nous as aidés à remporter la victoire dont le peuple acarhyn avait tant besoin."

# game/episode025.rpy:1583
translate french ep025_erigone_aftermath_a27087d5:

    # e "We will of course attend the trial of the traitor Rahia tomorrow."
    e "On assistera bien sûr demain au procès de la traîtresse Rahia."

# game/episode025.rpy:1585
translate french ep025_erigone_aftermath_53921eb5_1:

    # "The Acarhyn left us and we all headed back to our quarters for some much-needed sleep."
    "Les Acarhyns nous ont quittés et on est tous retournés dans nos quartiers pour un sommeil bien mérité."

# game/episode025.rpy:1587
translate french ep025_erigone_aftermath_43577c94_1:

    # "Some intermittent gunfire could be heard during the night, but eventually this all stopped."
    "On a entendu quelques coups de feu sporadiques pendant la nuit, mais tout ça a fini par s’arrêter."

# game/episode025.rpy:1588
translate french ep025_erigone_aftermath_4c1ecc18:

    # "Keodele was right in presuming that any remaining resistance would soon be broken."
    "Keodele avait raison de penser que toute résistance restante serait bientôt brisée."

# game/episode025.rpy:1590
translate french ep025_erigone_aftermath_77183b2c:

    # "A steady stream of captured priests were led into the Shipyards during the early morning."
    "Un flot continu de prêtres capturés a été conduit aux chantiers navals tôt ce matin."

# game/episode025.rpy:1595
translate french ep025_erigone_aftermath_7fc435aa:

    # "The trial of Rahia took place around midday."
    "Le procès de Rahia a eu lieu vers midi."

# game/episode025.rpy:1596
translate french ep025_erigone_aftermath_db39e09a:

    # "Eva had already been fetched and was standing in front of the main building, joined by Keodele."
    "Eva avait déjà été conduite sur place et se tenait devant le bâtiment principal, rejointe par Keodele."

# game/episode025.rpy:1601
translate french ep025_erigone_aftermath_64250a1b:

    # "The former Commander of the Warrior Caste was kneeling on the asphalt next to a chopping block and looked rather less powerful than before."
    "L’ancienne commandante de la caste des guerrières était agenouillée sur l’asphalte à côté d’un billot et semblait bien moins imposante qu’auparavant."

# game/episode025.rpy:1602
translate french ep025_erigone_aftermath_f31ed611:

    # "It was clear she had been treated badly, but her gaze was defiant though."
    "Il était évident qu’elle avait été maltraitée, mais son regard restait provocateur."

# game/episode025.rpy:1603
translate french ep025_erigone_aftermath_9de0c0d6:

    # "Rahia seemed to have deduced what her final fate would be and was resigned to it."
    "Rahia semblait avoir deviné quel serait son destin final et s’y était résignée."

# game/episode025.rpy:1605
translate french ep025_erigone_aftermath_81364d92:

    # keo "Sisters!"
    keo "Mes sœurs !"

# game/episode025.rpy:1606
translate french ep025_erigone_aftermath_b90e00b7:

    # keo "We have prevailed!"
    keo "On a triomphé !"

# game/episode025.rpy:1607
translate french ep025_erigone_aftermath_fcce5175:

    # keo "Our Creator has blessed us with this victory over the insidious Warrior caste."
    keo "Notre Créateur nous a accordé cette victoire sur la perfide caste des guerriers."

# game/episode025.rpy:1608
translate french ep025_erigone_aftermath_1101fc12:

    # keo "Together, we will rebuild Erigone and return it to its rightful glory."
    keo "Ensemble, on va reconstruire Erigone et lui redonner toute sa gloire."

# game/episode025.rpy:1610
translate french ep025_erigone_aftermath_c30906d1:

    # keo "The Warrior caste is hereby forbidden and any remaining member will be hunted and killed."
    keo "La caste des Guerriers est désormais interdite et tout membre restant sera traqué et tué."

# game/episode025.rpy:1611
translate french ep025_erigone_aftermath_79e2653b:

    # keo "The Priest caste is the ultimate authority on Erigone, as it should have been from the very start."
    keo "La caste des Prêtres est l’autorité suprême sur Erigone, comme cela aurait dû l’être depuis le tout début."

# game/episode025.rpy:1613
translate french ep025_erigone_aftermath_d50b2907:

    # keo "We will bring peace and prosperity to these lands."
    keo "On apportera la paix et la prospérité à ces terres."

# game/episode025.rpy:1614
translate french ep025_erigone_aftermath_02cd598b:

    # keo "A golden future awaits us, but first we must deal with the past."
    keo "Un avenir radieux nous attend, mais on doit d’abord régler le passé."

# game/episode025.rpy:1616
translate french ep025_erigone_aftermath_cc39db72:

    # keo "The traitorous firebrands of the unjust rebellion will be brought to justice."
    keo "Les agitateurs traîtres de cette rébellion injuste seront traduits en justice."

# game/episode025.rpy:1617
translate french ep025_erigone_aftermath_eee080b7:

    # keo "Rahia, former Commander of the Warrior caste, is the first to learn of her fate."
    keo "Rahia, ancienne commandante de la caste des guerriers, est la première à apprendre son sort."

# game/episode025.rpy:1618
translate french ep025_erigone_aftermath_4a6d2c62:

    # keo "Many of her lieutenants will be brought to justice in the coming days."
    keo "Beaucoup de ses lieutenants seront traduits en justice dans les jours à venir."

# game/episode025.rpy:1620
translate french ep025_erigone_aftermath_ea1e18eb:

    # keo "Justice will be done."
    keo "Justice sera faite."

# game/episode025.rpy:1621
translate french ep025_erigone_aftermath_ce045cd0:

    # keo "Rahia, you stand accused of high treason in your attempt to eradicate the Warrior caste and subvert the power that rightfully belongs to the Priest caste."
    keo "Rahia, tu es accusée de haute trahison pour avoir tenté d’éradiquer la caste des guerriers et de renverser le pouvoir qui revient de droit à la caste des prêtres."

# game/episode025.rpy:1622
translate french ep025_erigone_aftermath_8fdc5659:

    # keo "The sentence for these crimes is death."
    keo "La peine pour ces crimes est la mort."

# game/episode025.rpy:1624
translate french ep025_erigone_aftermath_80adb918:

    # rah "I defended Erigone from the threat that is the Priest caste."
    rah "J’ai défendu Erigone contre la menace que représente la caste des prêtres."

# game/episode025.rpy:1625
translate french ep025_erigone_aftermath_edc7e8a0:

    # rah "The teachings of Keodele and her ilk will be your ruin."
    rah "Les enseignements de Keodele et de ses semblables causeront ta perte."

# game/episode025.rpy:1626
translate french ep025_erigone_aftermath_c6380bfd:

    # rah "Mark my words, I-"
    rah "Crois-moi, je…"

# game/episode025.rpy:1628
translate french ep025_erigone_aftermath_073ba1c1:

    # "The rest of Rahia’s speech was cut off as one of the guards beat her to the ground."
    "Le reste du discours de Rahia fut interrompu lorsqu’un des gardes la jeta à terre d’un coup."

# game/episode025.rpy:1633
translate french ep025_erigone_aftermath_78735fd9:

    # "A Priestess approached, carrying a large blade."
    "Une prêtresse s’approcha, brandissant une grande lame."

# game/episode025.rpy:1634
translate french ep025_erigone_aftermath_51c38b42:

    # "Rahia was forced to rest her head on the block."
    "Rahia fut contrainte de poser sa tête sur le billot."

# game/episode025.rpy:1636
translate french ep025_erigone_aftermath_e464e8d0:

    # "With one stroke, the executioner severed Rahia’s head from her body."
    "D’un seul coup, le bourreau sépara la tête de Rahia de son corps."

# game/episode025.rpy:1637
translate french ep025_erigone_aftermath_75c0dd0d:

    # "The amassed Priest caste cheered as the former Commander bled out on the block."
    "La caste des prêtres, rassemblée là, applaudit tandis que l’ancienne commandante se vidait de son sang sur le billot."

# game/episode025.rpy:1639
translate french ep025_erigone_aftermath_4aa68de4:

    # "We left the scene in silence, while Keodele resumed her speech and the Acarhyn cheered on."
    "On a quitté les lieux en silence, tandis que Keodele reprenait son discours et que les Acarhyn l’acclamaient."

# game/episode025.rpy:1640
translate french ep025_erigone_aftermath_4d6659d9:

    # "The executions continued during the coming days, sometimes consisting of entire groups of warriors."
    "Les exécutions se sont poursuivies les jours suivants, touchant parfois des groupes entiers de guerriers."

# game/episode025.rpy:1641
translate french ep025_erigone_aftermath_3d65610e:

    # "We didn’t attend, as we were too busy preparing the Bastard to leave Erigone."
    "On n’y a pas assisté, car on était trop occupés à préparer le Bastard pour quitter Erigone."

# game/episode025.rpy:1643
translate french ep025_erigone_aftermath_d02770f3:

    # "Keodele visited us a few days before we were scheduled to leave."
    "Keodele nous a rendu visite quelques jours avant notre départ prévu."

# game/episode025.rpy:1644
translate french ep025_erigone_aftermath_d9101374:

    # keo "My Queen, the Priest caste has reached a verdict on joining the mission Your Majesty has proposed."
    keo "Ma reine, la caste des prêtres a rendu son verdict concernant la participation à la mission que Votre Majesté a proposée."

# game/episode025.rpy:1645
translate french ep025_erigone_aftermath_28574089:

    # keo "We formally pledge our support to the alliance against the Sovereignty."
    keo "On s’engage officiellement à soutenir l’alliance contre la Souveraineté."

# game/episode025.rpy:1650
translate french ep025_erigone_aftermath_92474673_2:

    # e "We thank you."
    e "On te remercie."

# game/episode025.rpy:1651
translate french ep025_erigone_aftermath_5e09efe2_2:

    # e "Your pledge of allegiance is honorable and just, befitting of a true Acarhyn."
    e "Ton serment d’allégeance est honorable et juste, digne d’un vrai Acarhyn."

# game/episode025.rpy:1653
translate french ep025_erigone_aftermath_61511319:

    # keo "Thank you, Your Majesty."
    keo "Merci, Votre Majesté."

# game/episode025.rpy:1654
translate french ep025_erigone_aftermath_e329a757:

    # keo "The Warrior caste has been all but eradicated and no further uprisings are expected."
    keo "La caste des guerriers a été pratiquement éradiquée et aucun autre soulèvement n’est à craindre."

# game/episode025.rpy:1655
translate french ep025_erigone_aftermath_b7a777ab:

    # keo "We have full control of Erigone and will continue to repair and restore Erigone in the image of our Creator."
    keo "On contrôle entièrement Erigone et on continuera à réparer et à restaurer Erigone à l’image de notre Créateur."

# game/episode025.rpy:1656
translate french ep025_erigone_aftermath_2db7500e:

    # keo "A contingent of Priests and several ships have been selected to join the alliance against the Sovereignty."
    keo "Un contingent de prêtres et plusieurs vaisseaux ont été sélectionnés pour rejoindre l’alliance contre la Souveraineté."

# game/episode025.rpy:1657
translate french ep025_erigone_aftermath_c28b1552:

    # keo "I will personally lead them."
    keo "Je les mènerai personnellement."

# game/episode025.rpy:1662
translate french ep025_erigone_aftermath_e9cc8ef1_1:

    # e "We thank you again for your cooperation."
    e "On te remercie encore pour ta coopération."

# game/episode025.rpy:1663
translate french ep025_erigone_aftermath_1bd12c65_2:

    # c "My crew will coordinate with you on how to join the forces that have already gathered in opposition against the Sovereignty."
    c "Mon équipage se coordonnera avec toi pour savoir comment rejoindre les forces déjà rassemblées contre la Souveraineté."

# game/episode025.rpy:1665
translate french ep025_erigone_aftermath_a67c6b43_2:

    # "Céline and Thyia provided the Acarhyn with the necessary information to join up with the fleet we had already amassed."
    "Céline et Thyia ont fourni aux Acarhyns les informations nécessaires pour rejoindre la flotte qu’on avait déjà rassemblée."

# game/episode025.rpy:1666
translate french ep025_erigone_aftermath_ab042ed8:

    # "Keodele and her Acarhyn would depart at the same time we would be joining up with the fleet."
    "Keodele et ses Acarhyn partiraient au moment même où on rejoindrait la flotte."

# game/episode025.rpy:1667
translate french ep025_erigone_aftermath_35567863:

    # "The addition of all those Acarhyn Priestesses was a definitive win for us and we were curious to see if the Rhenkoy and Tubloshi had made progress in recruiting new forces into the fold."
    "L’arrivée de toutes ces prêtresses Acarhyn était une victoire décisive pour nous, et on était curieux de voir si les Rhenkoy et les Tubloshi avaient fait des progrès dans le recrutement de nouvelles forces au sein de leur camp."

# game/episode025.rpy:1673
translate french ep025_erigone_aftermath_1600c88f:

    # "Eva was busy for the last days we remained on Erigone."
    "Eva était très occupée ces derniers jours où on est restés sur Erigone."

# game/episode025.rpy:1674
translate french ep025_erigone_aftermath_179fa86e:

    # "She had to chair several meetings regarding the rebuilding of Erigone."
    "Elle a dû présider plusieurs réunions concernant la reconstruction d’Erigone."

# game/episode025.rpy:1677
translate french ep025_erigone_aftermath_2b0326fd:

    # "Those meetings were exhausting, as she had to deal with several warring factions among the Warrior caste."
    "Ces réunions étaient épuisantes, car elle devait gérer plusieurs factions rivales au sein de la caste des guerriers."

# game/episode025.rpy:1679
translate french ep025_erigone_aftermath_31f816f1:

    # "Those meetings were exhausting, as she had to deal with several warring factions among the Priest caste."
    "Ces réunions étaient épuisantes, car elle devait gérer plusieurs factions rivales au sein de la caste des prêtres."

# game/episode025.rpy:1680
translate french ep025_erigone_aftermath_08c2640f:

    # "The caste had no clear leader and the power vacuum created a slew of problems."
    "La caste n’avait pas de chef clair et ce vide de pouvoir a engendré une multitude de problèmes."

# game/episode025.rpy:1681
translate french ep025_erigone_aftermath_de355ead:

    # "Tensions continued to run high and the risk of another conflict was just a matter of time."
    "Les tensions restaient vives et le risque d’un nouveau conflit n’était qu’une question de temps."

# game/episode025.rpy:1682
translate french ep025_erigone_aftermath_7e6f4ee0:

    # "If we were to ever return to Erigone, it would remain to be seen what would be left of the planet and its people."
    "Si jamais on devait revenir sur Erigone, il restait à voir ce qu’il resterait de la planète et de ses habitants."

# game/episode025.rpy:1683
translate french ep025_erigone_aftermath_15460400:

    # "However, we had more pressing matters to attend to and Eva did what she could."
    "Mais on avait des affaires plus urgentes à régler et Eva faisait ce qu’elle pouvait."

# game/episode025.rpy:1686
translate french ep025_erigone_aftermath_38eb8054:

    # "Those meetings were exhausting, but as the Warrior caste truly listened to her input, she deemed it all worthwhile."
    "Ces réunions étaient épuisantes, mais comme la caste des Guerriers écoutait vraiment ses propositions, elle estimait que ça en valait la peine."

# game/episode025.rpy:1687
translate french ep025_erigone_aftermath_1aeebf65:

    # "She managed to persuade the Warriors to let civilian representatives attend the meetings and have a say in how Erigone should be governed."
    "Elle a réussi à convaincre les Guerriers de laisser des représentants civils assister aux réunions et d'avoir leur mot à dire sur la façon dont Erigone devait être gouvernée."

# game/episode025.rpy:1689
translate french ep025_erigone_aftermath_b3093c49:

    # "The meetings were exhausting and Eva was mostly there as a figurehead."
    "Les réunions étaient épuisantes et Eva n’était là, pour l’essentiel, qu’à titre symbolique."

# game/episode025.rpy:1690
translate french ep025_erigone_aftermath_804e520e:

    # "Keodele exerted a lot of influence and singlehandedly decided on most of the major issues."
    "Keodele exerçait une grande influence et décidait à elle seule de la plupart des questions importantes."

# game/episode025.rpy:1691
translate french ep025_erigone_aftermath_16431723:

    # "Several of her loyalists were already in place to lead Erigone in her absence."
    "Plusieurs de ses fidèles étaient déjà en place pour diriger Erigone en son absence."

# game/episode025.rpy:1692
translate french ep025_erigone_aftermath_1d3280fe:

    # "There was no doubt that the High Priestess would still have a firm grip on the planet, even if she would be off-planet to join the fleet."
    "Il ne faisait aucun doute que la Grande Prêtresse garderait une emprise ferme sur la planète, même si elle devait s’en éloigner pour rejoindre la flotte."

# game/episode025.rpy:1700
translate french ep025_erigone_aftermath_310a5d0f:

    # "When Eva returned to the Bastard, we were ready to leave."
    "Quand Eva est revenue sur le Bastard, on était prêts à partir."

# game/episode025.rpy:1701
translate french ep025_erigone_aftermath_508ff706:

    # "Several Acarhyn ships were already in orbit and ready to leave for the coordinates they’d received from Céline."
    "Plusieurs vaisseaux acarhyns étaient déjà en orbite et prêts à partir vers les coordonnées qu’ils avaient reçues de Céline."

# game/episode025.rpy:1704
translate french ep025_erigone_aftermath_be79ce2d:

    # woman "The Warrior caste is ready for take-off."
    woman "La caste des guerriers est prête à décoller."

# game/episode025.rpy:1706
translate french ep025_erigone_aftermath_cc22bc7b:

    # woman "The Priest caste is ready for take-off."
    woman "La caste des Prêtres est prête au décollage."

# game/episode025.rpy:1707
translate french ep025_erigone_aftermath_6ea77f30:

    # woman "We’ll join you at the rendezvous point."
    woman "On te rejoindra au point de rendez-vous."

# game/episode025.rpy:1710
translate french ep025_erigone_aftermath_6cde3923:

    # rah "The Warrior caste is ready for take-off."
    rah "La caste des guerriers est prête à décoller."

# game/episode025.rpy:1711
translate french ep025_erigone_aftermath_017bc996:

    # rah "We’ll join you at the rendezvous point."
    rah "On te rejoindra au point de rendez-vous."

# game/episode025.rpy:1713
translate french ep025_erigone_aftermath_b0e877a2:

    # keo "The Priest caste is ready for launch."
    keo "La caste des Prêtres est prête au lancement."

# game/episode025.rpy:1714
translate french ep025_erigone_aftermath_b96f792d:

    # keo "We’ll join you at the rendezvous point."
    keo "On te rejoindra au point de rendez-vous."

# game/episode025.rpy:1715
translate french ep025_erigone_aftermath_11e73def:

    # c "Acknowledged."
    c "Bien reçu."

# game/episode025.rpy:1716
translate french ep025_erigone_aftermath_168792e7:

    # c "See you soon."
    c "À bientôt."

# game/episode025.rpy:1717
translate french ep025_erigone_aftermath_9e137c85:

    # c "Bastard out."
    c "Bastard, terminé."

# game/episode025.rpy:1720
translate french ep025_erigone_aftermath_fa3a696b:

    # "The Bastard rose from the jungle canopy and quickly left the planet’s surface behind."
    "Le Bastard s’éleva au-dessus de la canopée de la jungle et quitta rapidement la surface de la planète."

# game/episode025.rpy:1723
translate french ep025_erigone_aftermath_85b5c226:

    # "The Bastard rose from the Shipyards and quickly left the planet’s surface behind."
    "Le Bastard s’éleva au-dessus des chantiers navals et quitta rapidement la surface de la planète."

# game/episode025.rpy:1725
translate french ep025_erigone_aftermath_d515a42a:

    # "Once we were out of Erigone’s orbital sphere, we punched in the coordinates to join our Rhenkoy and Tubloshi allies."
    "Une fois sortis de la sphère orbitale d’Erigone, on a entré les coordonnées pour rejoindre nos alliés Rhenkoy et Tubloshi."

# game/episode025.rpy:1726
translate french ep025_erigone_aftermath_b8e93eb4:

    # "Several messages suddenly arrived, held up by the communications blockade in effect on Erigone."
    "Plusieurs messages sont soudainement arrivés, retenus par le blocus des communications en vigueur sur Erigone."

# game/episode025.rpy:1728
translate french ep025_erigone_aftermath_a4e99845:

    # "One message caught my attention and I brought the video up on my screen."
    "Un message a attiré mon attention et j’ai affiché la vidéo sur mon écran."

# game/episode025.rpy:1729
translate french ep025_erigone_aftermath_e80e1d48:

    # "It was one of the Confessor’s Handmaidens."
    "C’était l’une des Servantes du Confesseur."

# game/episode025.rpy:1732
translate french ep025_erigone_aftermath_d0edc910:

    # woman "We formally request a meeting with the crew of the Iron Bastard."
    woman "On demande officiellement une rencontre avec l’équipage de l’Iron Bastard."

# game/episode025.rpy:1733
translate french ep025_erigone_aftermath_9d23fec5:

    # woman "Please respond and meet us at these coordinates."
    woman "Réponds-nous et rejoins-nous à ces coordonnées."

# game/episode025.rpy:1734
translate french ep025_erigone_aftermath_03fdd0d3:

    # "The last time we encountered the Handmaidens was on Petrarch, before the Confessor’s demise."
    "La dernière fois qu’on a croisé les Servantes, c’était sur Pétrarque, avant la mort du Confesseur."

# game/episode025.rpy:1736
translate french ep025_erigone_aftermath_3eb9971c:

    # av "Why would they reach out to us?"
    av "Pourquoi nous contacteraient-elles ?"

# game/episode025.rpy:1737
translate french ep025_erigone_aftermath_8caa2926:

    # av "We killed their master..."
    av "On a tué leur maître…"

# game/episode025.rpy:1738
translate french ep025_erigone_aftermath_2c20cd2b:

    # c "I haven’t got a clue."
    c "J’en ai aucune idée."

# game/episode025.rpy:1739
translate french ep025_erigone_aftermath_468fc1e8:

    # av "It could be a trap."
    av "Ça pourrait être un piège."

# game/episode025.rpy:1740
translate french ep025_erigone_aftermath_41155672:

    # c "Yes, it could be."
    c "Oui, c’est possible."

# game/episode025.rpy:1741
translate french ep025_erigone_aftermath_d9b641da:

    # c "Only one way to find out."
    c "Y a qu’un seul moyen de le savoir."

# game/episode025.rpy:1742
translate french ep025_erigone_aftermath_f045f336:

    # c "Céline, change of plans, we’re making a detour."
    c "Céline, changement de programme, on fait un détour."

# game/episode025.rpy:1744
translate french ep025_erigone_aftermath_00e5bbfc:

    # "Céline punched in the new coordinates, pointing the Bastard to the Handmaiden’s location."
    "Céline a entré les nouvelles coordonnées, mettant le Bastard sur la piste des Handmaidens."

# game/episode025.rpy:1760
translate french ep025_erigone_e_b166ee2e:

    # "Eva was resting in her quarters when I came to visit her."
    "Eva se reposait dans ses quartiers quand je suis venu lui rendre visite."

# game/episode025.rpy:1761
translate french ep025_erigone_e_984a0153:

    # c "Hey there."
    c "Salut."

# game/episode025.rpy:1762
translate french ep025_erigone_e_50edab85:

    # c "Everything all right with you?"
    c "Tout va bien ?"

# game/episode025.rpy:1764
translate french ep025_erigone_e_d9249210:

    # e "Just a little tired."
    e "Je suis juste un peu fatiguée."

# game/episode025.rpy:1765
translate french ep025_erigone_e_ec9e7952:

    # e "Carrying all this extra weight around sure is exhausting."
    e "Porter tout ce poids en plus, c’est vraiment épuisant."

# game/episode025.rpy:1766
translate french ep025_erigone_e_0b529335:

    # c "Take all the rest you need."
    c "Repose-toi autant que tu en as besoin."

# game/episode025.rpy:1768
translate french ep025_erigone_e_3593a416:

    # e "Yes, I’m fine."
    e "Oui, ça va."

# game/episode025.rpy:1770
translate french ep025_erigone_e_2c992148:

    # c "Mind if I join you?"
    c "Ça te dérange si je te rejoins ?"

# game/episode025.rpy:1771
translate french ep025_erigone_e_a0808f6b:

    # e "Of course not!"
    e "Bien sûr que non !"

# game/episode025.rpy:1783
translate french ep025_erigone_e_0e40381b:

    # e "Do you think the Warriors’ plan will succeed?"
    e "Tu penses que le plan des Guerriers va marcher ?"

# game/episode025.rpy:1784
translate french ep025_erigone_e_352251fe:

    # c "It looked strong on paper."
    c "Ça avait l’air solide sur le papier."

# game/episode025.rpy:1785
translate french ep025_erigone_e_3e360437:

    # c "I just hope there won’t be a lot of surprises once they execute the ambush."
    c "J’espère juste qu’il n’y aura pas trop de surprises quand ils lanceront l’embuscade."

# game/episode025.rpy:1790
translate french ep025_erigone_e_b1363a05:

    # e "There are always surprises."
    e "Il y a toujours des surprises."

# game/episode025.rpy:1791
translate french ep025_erigone_e_0db77c9b:

    # e "Will we be required to join the operation?"
    e "On va devoir participer à l’opération ?"

# game/episode025.rpy:1792
translate french ep025_erigone_e_95ee4203:

    # c "Yes, we are."
    c "Oui, c’est prévu."

# game/episode025.rpy:1793
translate french ep025_erigone_e_7a5c7787:

    # c "The rest of the crew has been talking to the Warriors."
    c "Le reste de l’équipage a discuté avec les Guerriers."

# game/episode025.rpy:1794
translate french ep025_erigone_e_d0bebbd7:

    # c "The Priest caste is light on fighter planes, so the Warriors are hoping to overwhelm the sky."
    c "La caste des Prêtres manque d’avions de combat, alors les Guerriers espèrent dominer les airs."

# game/episode025.rpy:1795
translate french ep025_erigone_e_b872a09c:

    # c "The Bastard is going to assist from the air during the assault."
    c "Le Bâtard va apporter son aide depuis les airs pendant l’assaut."

# game/episode025.rpy:1800
translate french ep025_erigone_e_67632972:

    # e "Can’t say I’m looking forward to that part of the operation."
    e "Je ne peux pas dire que j’ai hâte de passer à cette partie de l’opération."

# game/episode025.rpy:1801
translate french ep025_erigone_e_e3f85eeb:

    # c "I believe you are required to stay behind."
    c "Je crois que tu dois rester sur place."

# game/episode025.rpy:1802
translate french ep025_erigone_e_60965691:

    # e "Yes, I figured."
    e "Oui, je m’en doutais."

# game/episode025.rpy:1803
translate french ep025_erigone_e_fe6aef30:

    # e "No place for a Queen on the battlefield..."
    e "Pas de place pour une reine sur le champ de bataille…"

# game/episode025.rpy:1805
translate french ep025_erigone_e_cb7b2233:

    # c "Did you have a talk with Keodele?"
    c "Tu as discuté avec Keodele ?"

# game/episode025.rpy:1810
translate french ep025_erigone_e_765cc51b:

    # e "Yes, a very disappointing one."
    e "Oui, une discussion très décevante."

# game/episode025.rpy:1811
translate french ep025_erigone_e_4e0e2d4b:

    # e "They’re going ahead with creating more Brutes, despite any reservations I have."
    e "Ils vont de l’avant avec la création de nouvelles Brutes, malgré toutes mes réserves."

# game/episode025.rpy:1812
translate french ep025_erigone_e_dd940e0d:

    # c "So, essentially, she doesn’t respect the Queen’s authority?"
    c "Donc, en gros, elle ne respecte pas l’autorité de la Reine ?"

# game/episode025.rpy:1813
translate french ep025_erigone_e_753f0a50:

    # e "Yes, that’s what it comes down to."
    e "Oui, c’est bien ça."

# game/episode025.rpy:1814
translate french ep025_erigone_e_cb6170d6:

    # e "She told me much more politely and couched in a lot of niceties."
    e "Elle me l’a dit de manière bien plus polie, en utilisant plein de formules de politesse."

# game/episode025.rpy:1815
translate french ep025_erigone_e_c1634fec:

    # c "Keodele must have had a lot of practice."
    c "Keodele a dû s’entraîner pas mal."

# game/episode025.rpy:1816
translate french ep025_erigone_e_8591f216:

    # e "Yes, she must have."
    e "Oui, c’est sûr."

# game/episode025.rpy:1817
translate french ep025_erigone_e_afe7c65e:

    # e "Be careful with her, though."
    e "Fais gaffe à elle, par contre."

# game/episode025.rpy:1822
translate french ep025_erigone_e_9e645497:

    # e "I’m sure they’ll join our alliance as soon as they’re able, but I don’t think they’re a reliable partner in the long run."
    e "Je suis sûr qu’ils rejoindront notre alliance dès qu’ils le pourront, mais je ne pense pas qu’ils soient des partenaires fiables à long terme."

# game/episode025.rpy:1824
translate french ep025_erigone_e_3fa85fc6:

    # c "Erylin showed a penchant for backstabbing, so I’m sure her daughter learned from the very best."
    c "Erylin avait un penchant pour les coups de poignard dans le dos, donc je suis sûr que sa fille a appris ça de la meilleure des sources."

# game/episode025.rpy:1826
translate french ep025_erigone_e_a50c29d0:

    # c "Erylin showed a penchant for backstabbing, so I’m sure her acolyte learned from the very best."
    c "Erylin avait un penchant pour les coups bas, donc je suis sûr que son acolyte a appris de la meilleure des maîtresses."

# game/episode025.rpy:1827
translate french ep025_erigone_e_6361c8c3:

    # e "Yeah..."
    e "Ouais…"

# game/episode025.rpy:1828
translate french ep025_erigone_e_a5d9a0c6:

    # e "Still, watch out for her, she’s as driven as any zealot."
    e "Mais fais quand même gaffe à elle, elle est aussi déterminée que n’importe quel fanatique."

# game/episode025.rpy:1829
translate french ep025_erigone_e_b7f4b180:

    # c "Noted."
    c "C’est noté."

# game/episode025.rpy:1830
translate french ep025_erigone_e_18bfb04c:

    # e "Are we joining the coming battle?"
    e "On participe à la bataille qui s’annonce ?"

# game/episode025.rpy:1831
translate french ep025_erigone_e_08d4abeb:

    # c "Yes, we will."
    c "Oui, on y va."

# game/episode025.rpy:1832
translate french ep025_erigone_e_47a63336:

    # c "The rest of the crew has been talking to the Priestesses."
    c "Le reste de l’équipe a discuté avec les prêtresses."

# game/episode025.rpy:1833
translate french ep025_erigone_e_1388f1a2:

    # c "They’re light on fighter planes, so the Bastard is going to assist from the air during the assault."
    c "Elles manquent d’avions de chasse, donc le Bastard va apporter son soutien aérien pendant l’assaut."

# game/episode025.rpy:1838
translate french ep025_erigone_e_67632972_1:

    # e "Can’t say I’m looking forward to that part of the operation."
    e "Je ne peux pas dire que j’ai hâte de passer à cette partie de l’opération."

# game/episode025.rpy:1839
translate french ep025_erigone_e_e3f85eeb_1:

    # c "I believe you are required to stay behind."
    c "Je crois que tu dois rester sur place."

# game/episode025.rpy:1840
translate french ep025_erigone_e_60965691_1:

    # e "Yes, I figured."
    e "Oui, je m’en doutais."

# game/episode025.rpy:1845
translate french ep025_erigone_e_fe6aef30_1:

    # e "No place for a Queen on the battlefield..."
    e "Pas de place pour une reine sur le champ de bataille…"

# game/episode025.rpy:1857
translate french ep025_erigone_e_aca8de24:

    # e "I wish we could just be together."
    e "J’aimerais qu’on puisse juste être ensemble."

# game/episode025.rpy:1858
translate french ep025_erigone_e_1244497d:

    # e "Be done with all that we are involved at the moment."
    e "En finir avec tout ce dans quoi on est embarqués en ce moment."

# game/episode025.rpy:1860
translate french ep025_erigone_e_0cd670e0:

    # e "Just you, me and the baby living our lives."
    e "Juste toi, moi et le bébé, à vivre notre vie."

# game/episode025.rpy:1861
translate french ep025_erigone_e_f263d194:

    # c "I feel the same."
    c "Je ressens la même chose."

# game/episode025.rpy:1862
translate french ep025_erigone_e_d1db6a03:

    # c "And I promise you we will, after we’ve dealt with Dad and the Sovereignty."
    c "Et je te promets qu’on le fera, une fois qu’on se sera occupés de papa et de la Souveraineté."

# game/episode025.rpy:1873
translate french ep025_erigone_e_9002f38f:

    # e "Don’t make promises you can’t keep."
    e "Ne fais pas de promesses que tu ne pourras pas tenir."

# game/episode025.rpy:1874
translate french ep025_erigone_e_62cc254b:

    # e "I’m sure there’ll always be another crisis."
    e "Je suis sûre qu’il y aura toujours une autre crise."

# game/episode025.rpy:1875
translate french ep025_erigone_e_7a5902d0:

    # c "I’m sure there will be, but I’m done after this."
    c "Je suis sûr que oui, mais après ça, j’en ai fini."

# game/episode025.rpy:1876
translate french ep025_erigone_e_8ae1b8cc:

    # c "It’s a promise I absolutely intend to keep."
    c "C’est une promesse que j’ai bien l’intention de tenir."

# game/episode025.rpy:1887
translate french ep025_erigone_e_5473a803:

    # e "I’m hoping we both can."
    e "J’espère qu’on pourra tous les deux le faire."

# game/episode025.rpy:1899
translate french ep025_erigone_e_25e56f13:

    # "I kissed my sister and we lay in each other’s arms for a long while."
    "J’ai embrassé ma sœur et on est restés enlacés pendant un long moment."

# game/episode025.rpy:1901
translate french ep025_erigone_e_62b9a7fa:

    # "I kissed my girlfriend and we lay in each other’s arms for a long while."
    "J’ai embrassé ma copine et on est restés enlacés pendant un long moment."

# game/episode025.rpy:1902
translate french ep025_erigone_e_c7a622ee:

    # "When dinner was announced, we had to leave, but not before promising Eva I’d meet her later."
    "Quand on a annoncé le dîner, on a dû partir, mais pas sans avoir promis à Eva que je la retrouverais plus tard."

# game/episode025.rpy:1904
translate french ep025_erigone_e_13158e12:

    # c "I’ll leave you to rest for a while."
    c "Je te laisse te reposer un peu."

# game/episode025.rpy:1912
translate french ep025_quarters_ziv_b562a367:

    # "Even though we were assigned quarters in the Citadel, Ziv had asked me to come by her quarters on the Iron Bastard."
    "Même si on nous avait attribué des quartiers dans la Citadelle, Ziv m’avait demandé de passer la voir dans ses quartiers à bord de l’Iron Bastard."

# game/episode025.rpy:1915
translate french ep025_quarters_ziv_29fc7396:

    # "Even though we were assigned quarters in the Shipyards, Ziv had asked me to come by her quarters on the Iron Bastard."
    "Même si on nous avait attribué des quartiers dans les Chantiers navals, Ziv m’avait demandé de passer la voir dans ses quartiers à bord de l’Iron Bastard."

# game/episode025.rpy:1917
translate french ep025_quarters_ziv_195f53d0:

    # "Her door was open and I found Ziv standing on her bed with her eyes closed, completely naked."
    "Sa porte était ouverte et j’ai trouvé Ziv debout sur son lit, les yeux fermés, complètement nue."

# game/episode025.rpy:1918
translate french ep025_quarters_ziv_96877540:

    # c "Ah...{w} Hi."
    c "Ah… {w} Salut."

# game/episode025.rpy:1920
translate french ep025_quarters_ziv_4571fee3:

    # zi "Oh, [p_name]."
    zi "Oh, [p_name]."

# game/episode025.rpy:1921
translate french ep025_quarters_ziv_a678e94f:

    # zi "I was centering myself."
    zi "J’étais en train de me recentrer."

# game/episode025.rpy:1922
translate french ep025_quarters_ziv_f7f0dc51:

    # c "Should I come back later?"
    c "Je devrais revenir plus tard ?"

# game/episode025.rpy:1924
translate french ep025_quarters_ziv_197d4735:

    # zi "No, no, please stay."
    zi "Non, non, reste s’il te plaît."

# game/episode025.rpy:1925
translate french ep025_quarters_ziv_0dbd9e7e:

    # "There was a nervous quality to her voice, easily detectable because she normally appeared so composed."
    "Il y avait une pointe de nervosité dans sa voix, facilement perceptible car elle semblait d’habitude si sereine."

# game/episode025.rpy:1926
translate french ep025_quarters_ziv_e4403132:

    # c "You’re looking very beautiful today."
    c "Tu es vraiment très belle aujourd’hui."

# game/episode025.rpy:1927
translate french ep025_quarters_ziv_d2e75395:

    # zi "Thanks."
    zi "Merci."

# game/episode025.rpy:1928
translate french ep025_quarters_ziv_d21c4563:

    # zi "Being naked helps the centering process."
    zi "Être nue facilite le processus de recentrage."

# game/episode025.rpy:1929
translate french ep025_quarters_ziv_e5191510:

    # c "I’m not complaining at all."
    c "Je ne m’en plains pas du tout."

# game/episode025.rpy:1930
translate french ep025_quarters_ziv_a2270094:

    # c "What exactly does this centering mean?"
    c "C’est quoi exactement, ce « se recentrer » ?"

# game/episode025.rpy:1931
translate french ep025_quarters_ziv_b8db1dcf:

    # zi "It’s a process where a Rhenkoy becomes more attuned to their senses."
    zi "C’est un processus qui permet à un Rhenkoy d’être plus à l’écoute de ses sens."

# game/episode025.rpy:1932
translate french ep025_quarters_ziv_20e8e87e:

    # zi "It helps to achieve a level of calm during emotional distress."
    zi "Ça aide à retrouver un certain calme quand on est en proie à une détresse émotionnelle."

# game/episode025.rpy:1933
translate french ep025_quarters_ziv_1fbc096b:

    # c "Is something the matter with you?"
    c "Quelque chose ne va pas ?"

# game/episode025.rpy:1936
translate french ep025_quarters_ziv_439c7017:

    # zi "That’s what I wanted to talk to you about."
    zi "C’est justement de ça que je voulais te parler."

# game/episode025.rpy:1937
translate french ep025_quarters_ziv_bafa6c2f:

    # zi "It’s a delicate matter, that’s why I requested us to meet on the Iron Bastard."
    zi "C’est un sujet délicat, c’est pour ça que j’ai demandé qu’on se retrouve sur l’Iron Bastard."

# game/episode025.rpy:1938
translate french ep025_quarters_ziv_89257688:

    # zi "I don’t want anyone to walk in on us."
    zi "Je ne veux pas que quelqu’un nous surprenne."

# game/episode025.rpy:1940
translate french ep025_quarters_ziv_838e751f:

    # c "Little chance of that, everybody is back in the Citadel."
    c "Y a pas de risque, tout le monde est de retour à la Citadelle."

# game/episode025.rpy:1942
translate french ep025_quarters_ziv_80f2a6dd:

    # c "Little chance of that, everybody is back in the Shipyards."
    c "Y a pas de risque, tout le monde est de retour aux Chantiers navals."

# game/episode025.rpy:1944
translate french ep025_quarters_ziv_87dcfd4a:

    # zi "Good."
    zi "Bien."

# game/episode025.rpy:1945
translate french ep025_quarters_ziv_36f470fe:

    # zi "We have spoken about this before and you were positive at that time, as was I."
    zi "On en a déjà parlé et tu étais optimiste à l’époque, tout comme moi."

# game/episode025.rpy:1947
translate french ep025_quarters_ziv_aa698e85:

    # zi "Despite that, finding out was a shock."
    zi "Malgré ça, l’apprendre a été un choc."

# game/episode025.rpy:1948
translate french ep025_quarters_ziv_083576d9:

    # c "Ziv, are you talking about-"
    c "Ziv, tu parles de…"

# game/episode025.rpy:1949
translate french ep025_quarters_ziv_cb170553:

    # zi "I’m pregnant, [p_name_short]."
    zi "Je suis enceinte, [p_name_short]."

# game/episode025.rpy:1953
translate french ep025_quarters_ziv_fcdc6c3e:

    # c "But that’s fantastic news!"
    c "Mais c’est une nouvelle fantastique !"

# game/episode025.rpy:1954
translate french ep025_quarters_ziv_9abb28a2:

    # c "Have you been lying here for hours, dreading to tell me the news?"
    c "Tu es restée allongée là depuis des heures, à redouter de m’annoncer la nouvelle ?"

# game/episode025.rpy:1955
translate french ep025_quarters_ziv_50a5b587:

    # zi "I was centering myself..."
    zi "Je me recentrerais…"

# game/episode025.rpy:1956
translate french ep025_quarters_ziv_52cb9d94:

    # c "You were worrying and mulling."
    c "Tu t’inquiétais et tu ruminais."

# game/episode025.rpy:1958
translate french ep025_quarters_ziv_bcc58a38:

    # zi "Yes, I was."
    zi "Oui, c’est vrai."

# game/episode025.rpy:1959
translate french ep025_quarters_ziv_36cf5ac3:

    # zi "Normally the centering process calms me, but I kept trying out different ways to tell you the news in my head."
    zi "D’habitude, le processus de recentrage m’apaise, mais je n’arrêtais pas d’essayer différentes façons de t’annoncer la nouvelle dans ma tête."

# game/episode025.rpy:1960
translate french ep025_quarters_ziv_c37ffe96:

    # zi "Being naked supposedly clears you of any distractions, but I just longed for your touch on my bare skin."
    zi "Être nue est censé te libérer de toute distraction, mais j’avais juste envie que tu me touches la peau nue."

# game/episode025.rpy:1961
translate french ep025_quarters_ziv_75c33f47:

    # c "That’s a natural reaction, Ziv."
    c "C’est une réaction naturelle, Ziv."

# game/episode025.rpy:1962
translate french ep025_quarters_ziv_55a4bb09:

    # c "We agreed to do things differently, by defying the Rhenkoy way of living."
    c "On avait décidé de faire les choses différemment, en allant à contre-courant du mode de vie Rhenkoy."

# game/episode025.rpy:1963
translate french ep025_quarters_ziv_5e021832:

    # c "No need to meditate yourself into a state of forced calmness."
    c "Pas besoin de te forcer à entrer dans un état de calme artificiel par la méditation."

# game/episode025.rpy:1964
translate french ep025_quarters_ziv_f83cac98:

    # c "This is momentous news!"
    c "C’est une nouvelle capitale !"

# game/episode025.rpy:1965
translate french ep025_quarters_ziv_18c6385c:

    # c "We’re going to be parents!"
    c "On va être parents !"

# game/episode025.rpy:1967
translate french ep025_quarters_ziv_91024fca:

    # zi "Yes, we are!"
    zi "Oui, c’est vrai !"

# game/episode025.rpy:1968
translate french ep025_quarters_ziv_4412534c:

    # zi "I’m so happy, [p_name_short]."
    zi "Je suis tellement heureuse, [p_name_short]."

# game/episode025.rpy:1969
translate french ep025_quarters_ziv_3171097f:

    # zi "And I’m so glad we talked about it earlier."
    zi "Et je suis tellement contente qu’on en ait parlé tout à l’heure."

# game/episode025.rpy:1970
translate french ep025_quarters_ziv_5686b4c6:

    # zi "I never would have dared to bring the subject up."
    zi "Je n’aurais jamais osé aborder le sujet."

# game/episode025.rpy:1971
translate french ep025_quarters_ziv_19a9801c:

    # c "Talking about things is often the best way to have a sustainable relationship."
    c "Parler des choses, c’est souvent le meilleur moyen d’avoir une relation durable."

# game/episode025.rpy:1972
translate french ep025_quarters_ziv_0a75342f:

    # c "So I don’t want us to hold back, especially in light of your pregnancy."
    c "Je ne veux donc pas qu’on se retienne, surtout vu ta grossesse."

# game/episode025.rpy:1973
translate french ep025_quarters_ziv_15411d8f:

    # c "I’m sure it’s going to be a confusing and challenging time and I want us to talk freely about what bothers us, or if you have any doubts."
    c "Je suis sûr que ça va être une période déroutante et difficile, et je veux qu’on parle librement de ce qui nous dérange, ou si tu as des doutes."

# game/episode025.rpy:1974
translate french ep025_quarters_ziv_672a3dd3:

    # zi "Yes, that sounds like a good idea."
    zi "Oui, ça me semble être une bonne idée."

# game/episode025.rpy:1976
translate french ep025_quarters_ziv_a50a0c4e:

    # "I kissed her and lowered myself to her belly to kiss her skin there."
    "Je l’ai embrassée et je me suis penché vers son ventre pour embrasser sa peau à cet endroit."

# game/episode025.rpy:1977
translate french ep025_quarters_ziv_31033689:

    # "Though of course she wasn’t showing already, the thought of her belly filled with my child made me feel ecstatic."
    "Même si, bien sûr, ça ne se voyait pas encore, l’idée que son ventre abrite mon enfant me rendait fou de joie."

# game/episode025.rpy:1978
translate french ep025_quarters_ziv_9c90dae7:

    # c "We’re going to celebrate and tell the others."
    c "On va fêter ça et l’annoncer aux autres."

# game/episode025.rpy:1979
translate french ep025_quarters_ziv_ee96e948:

    # c "Unless you want it otherwise?"
    c "À moins que tu ne préfères qu’on fasse autrement ?"

# game/episode025.rpy:1981
translate french ep025_quarters_ziv_f92ad710:

    # zi "No, the others have a right to know, of course."
    zi "Non, les autres ont le droit de savoir, bien sûr."

# game/episode025.rpy:1984
translate french ep025_quarters_ziv_908c42d7:

    # zi "And how would you like to celebrate?"
    zi "Et comment tu voudrais fêter ça ?"

# game/episode025.rpy:1985
translate french ep025_quarters_ziv_4ac1571e:

    # c "I can think of some things..."
    c "J’ai quelques idées…"

# game/episode025.rpy:1987
translate french ep025_quarters_ziv_d0b03113:

    # "I stroked her bare skin and Ziv shivered in response."
    "J’ai caressé sa peau nue et Ziv a frissonné de plaisir."

# game/episode025.rpy:1988
translate french ep025_quarters_ziv_218a2370:

    # zi "Mmmmm, that feels so good."
    zi "Mmmmm, c’est tellement bon."

# game/episode025.rpy:1991
translate french ep025_quarters_ziv_cb1416eb:

    # zi "But I just want to be with you for a while."
    zi "Mais j’ai juste envie d’être avec toi pendant un moment."

# game/episode025.rpy:1992
translate french ep025_quarters_ziv_1354881a:

    # zi "Have you all to myself."
    zi "T’avoir rien que pour moi."

# game/episode025.rpy:1994
translate french ep025_quarters_ziv_b8c1c9f4:

    # "Ziv and I lay on her bed and enjoyed each other’s company."
    "Ziv et moi, on s’est allongés sur son lit et on a profité de la présence l’un de l’autre."

# game/episode025.rpy:1996
translate french ep025_quarters_ziv_961167d8:

    # "When my tablet began to fill up with messages from the rest of the crew inquiring about my whereabouts, it was time to head back to the Citadel."
    "Quand ma tablette a commencé à se remplir de messages du reste de l’équipage me demandant où j’étais, il était temps de retourner à la Citadelle."

# game/episode025.rpy:1998
translate french ep025_quarters_ziv_55dccd3d:

    # "When my tablet began to fill up with messages from the rest of the crew inquiring about my whereabouts, it was time to head back to the Shipyards."
    "Quand ma tablette a commencé à se remplir de messages du reste de l’équipage me demandant où j’étais, il était temps de retourner aux Chantiers navals."

# game/episode025.rpy:2000
translate french ep025_quarters_ziv_b8ab748c:

    # "We exchanged one last kiss and I left Ziv’s quarters."
    "On s’est échangé un dernier baiser et j’ai quitté les quartiers de Ziv."

# game/episode025.rpy:2003
translate french ep025_quarters_ziv_2fb4cde6:

    # zi "Not really."
    zi "Pas vraiment."

# game/episode025.rpy:2004
translate french ep025_quarters_ziv_516a5acd:

    # zi "I just have these urges all the time."
    zi "C’est juste que j’ai ces envies tout le temps."

# game/episode025.rpy:2005
translate french ep025_quarters_ziv_ee27f910:

    # zi "And it’s hard to not give in."
    zi "Et c’est dur de ne pas y céder."

# game/episode025.rpy:2006
translate french ep025_quarters_ziv_8cad6544:

    # zi "I mean, a major part of being a Rhenkoy is exercising restraint."
    zi "Je veux dire, une grande partie de ce que c’est d’être un Rhenkoy, c’est de faire preuve de retenue."

# game/episode025.rpy:2007
translate french ep025_quarters_ziv_b3390bd1:

    # c "You’re referring to sex, I presume."
    c "Tu fais allusion au sexe, je suppose."

# game/episode025.rpy:2009
translate french ep025_quarters_ziv_041789d4:

    # zi "Yes..."
    zi "Oui…"

# game/episode025.rpy:2010
translate french ep025_quarters_ziv_8e6cb2ae:

    # c "I thought we’d agreed to do things differently, by defying the Rhenkoy way of living."
    c "Je croyais qu’on avait décidé de faire les choses différemment, en défiant le mode de vie des Rhenkoy."

# game/episode025.rpy:2011
translate french ep025_quarters_ziv_5aa43822:

    # c "So I think you shouldn’t be ashamed of having these urges."
    c "Je pense donc que tu ne devrais pas avoir honte d’avoir ces envies."

# game/episode025.rpy:2012
translate french ep025_quarters_ziv_257ba183:

    # c "They’re a natural impulse and if they give you pleasure, you shouldn’t deny them."
    c "C’est une pulsion naturelle et si ça te procure du plaisir, tu ne devrais pas les refouler."

# game/episode025.rpy:2014
translate french ep025_quarters_ziv_90c0d157:

    # zi "That’s something I’ve come to realize during the past hour of centering."
    zi "C’est quelque chose que j’ai fini par comprendre pendant cette dernière heure de méditation."

# game/episode025.rpy:2015
translate french ep025_quarters_ziv_6960c3cf:

    # zi "I was lying there, completely naked and trying to banish all impure thoughts from my mind."
