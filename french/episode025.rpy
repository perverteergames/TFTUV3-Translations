    c "C’est très fastidieux ?"

# game/episode025.rpy:2081
translate french ep025_erigone_grove_e097b611:

    # e "No, not that."
    e "Non, pas ça."

# game/episode025.rpy:2082
translate french ep025_erigone_grove_10016cc8:

    # e "I can actually contribute from time to time."
    e "En fait, j’arrive à apporter ma contribution de temps en temps."

# game/episode025.rpy:2083
translate french ep025_erigone_grove_96e3df36:

    # e "It’s just the duration and amount that wear me out."
    e "C’est juste la durée et le nombre de réunions qui m’épuisent."

# game/episode025.rpy:2085
translate french ep025_erigone_grove_3a1da560:

    # e "So, I’ve instructed my guards not to let anyone but the crew through."
    e "Du coup, j’ai donné l’ordre à mes gardes de ne laisser passer personne d’autre que l’équipage."

# game/episode025.rpy:2087
translate french ep025_erigone_grove_282ac659:

    # e "I’ve instructed my guards not to let anyone but the crew through."
    e "J’ai donné l’ordre à mes gardes de ne laisser passer personne d’autre que l’équipage."

# game/episode025.rpy:2088
