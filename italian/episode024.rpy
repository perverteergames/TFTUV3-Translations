
# game/episode024.rpy:42
translate italian episode024_88c87761:

    # centered "{=chapter_heading}EPISODE 24{/=chapter_heading}"
    centered "{=chapter_heading}EPISODIO 24{/=chapter_heading}"

# game/episode024.rpy:47
translate italian episode024_4c6cc17f:

    # ag "Good afternoon, Velnia."
    ag "Buon pomeriggio, Velnia."

# game/episode024.rpy:48
translate italian episode024_f785cd82:

    # ag "Are these quarters luxurious enough for you?"
    ag "Questi alloggi sono abbastanza lussuosi per te?"

# game/episode024.rpy:50
translate italian episode024_1c0234c6:

    # vel "Fuck you, Agust."
    vel "Fottiti, August."

# game/episode024.rpy:51
translate italian episode024_ae2c8342:

    # ag "I think the proper style of address would be “Your Highness”."
    ag "Penso che lo stile corretto per rivolgersi a qualcuno sarebbe 'Vostra Altezza'."

# game/episode024.rpy:52
translate italian episode024_013936f4:

    # vel "You already have me in a cell, chained to a wall, and now you’ve come to gloat?"
    vel "Mi hai già in cella, incatenato al muro, e ora sei venuto a gongolare?"

# game/episode024.rpy:53
translate italian episode024_079df4ea:

    # ag "Not at all."
    ag "Affatto."

# game/episode024.rpy:54
translate italian episode024_3fec40c6:

    # ag "You see, Velnia, you are the only member of the Council still alive, apart from me of course."
    ag "Vedi, Velnia, tu sei l'unico membro del Consiglio ancora vivo, a parte me ovviamente."

# game/episode024.rpy:55
translate italian episode024_9d6890c9:

    # ag "As you know, the others met their demise in that very tragic accident."
    ag "Come sapete, gli altri sono morti in quel tragico incidente."

# game/episode024.rpy:57
translate italian episode024_ba6ec454:

    # vel "You fucking murdered them, Agust."
    vel "Li hai assassinati, cazzo, Agust."

# game/episode024.rpy:59
translate italian episode024_cb14ced1:

    # ag "That’s not the official story, I can assure you."
    ag "Questa non è la storia ufficiale, te lo posso assicurare."

# game/episode024.rpy:60
translate italian episode024_7ff5a9d8:

    # ag "That unfortunate explosion made sure that a proper forensic investigation wasn’t possible."
    ag "Quella sfortunata esplosione ha fatto sì che un’indagine forense adeguata non fosse possibile."

# game/episode024.rpy:61
translate italian episode024_02f7cbc7:

    # ag "I’m sure the investigators would be perplexed by the eviscerated hearts inside those bodies."
    ag "Sono sicuro che gli investigatori rimarrebbero perplessi davanti ai cuori eviscerati all'interno di quei corpi."

# game/episode024.rpy:62
translate italian episode024_41cc9250:

    # ag "Who knew that the members of the Council all had such weak hearts that just spontaneously burst inside their chests on that unfateful evening?"
    ag "Chi sapeva che i membri del Consiglio avevano tutti dei cuori così deboli che scoppiarono spontaneamente nei loro petti in quella sera infatidica?"

# game/episode024.rpy:63
translate italian episode024_40b1dbe6:

    # ag "Aren’t you glad we were apparently made of much stronger stuff and managed to survive?"
    ag "Non sei contento che apparentemente fossimo fatti di una sostanza molto più forte e che siamo riusciti a sopravvivere?"

# game/episode024.rpy:65
translate italian episode024_3ab0b0b0:

    # vel "You disgust me."
    vel "Mi fai schifo."

# game/episode024.rpy:67
translate italian episode024_68a8fd1f:

    # ag "I’m sure you feel that way."
    ag "Sono sicuro che ti senti così."

# game/episode024.rpy:68
translate italian episode024_d1f02865:

    # ag "The people of the Sovereignty love me, though."
    ag "Il popolo della Sovranità, però, mi ama."

# game/episode024.rpy:69
translate italian episode024_7ec801e2:

    # ag "They crave a leader in these dark times."
    ag "Desiderano un leader in questi tempi bui."

# game/episode024.rpy:70
translate italian episode024_33db95b9:

    # ag "A leader who will guide them on the path to achieve the supremacy the Sovereignty so rightly deserves."
    ag "Un leader che li guiderà nel cammino verso il raggiungimento della supremazia che la Sovranità merita giustamente."

# game/episode024.rpy:71
translate italian episode024_ef579122:

    # ag "The era of human domination has finally begun, and I will be its shepherd."
    ag "L’era del dominio umano è finalmente iniziata e io ne sarò il pastore."

# game/episode024.rpy:73
translate italian episode024_0c121629:

    # vel "Spare me the sanctimonious bullshit and just kill me."
    vel "Risparmiami le stronzate ipocrite e uccidimi."

# game/episode024.rpy:75
translate italian episode024_963f63ed:

    # ag "I’m afraid I can’t do that."
    ag "Temo di non poterlo fare."

# game/episode024.rpy:76
translate italian episode024_e17b1d2a:

    # ag "Yet..."
    ag "Eppure..."

# game/episode024.rpy:77
translate italian episode024_f2bc97b6:

    # ag "You see, there’s some information I need from you."
    ag "Vedi, ci sono alcune informazioni che mi servono da te."

# game/episode024.rpy:78
translate italian episode024_bc4e544e:

    # ag "Documents you’ve kept."
    ag "Documenti che hai conservato."

# game/episode024.rpy:79
translate italian episode024_7d23adc6:

    # ag "Surveillance footage and logs about me, which could put a dent in the trust the good people of the Sovereignty have in me, should they fall into the wrong hands."
    ag "Filmati e registri di sorveglianza su di me, che potrebbero intaccare la fiducia che le brave persone della Sovranità hanno in me, se dovessero cadere nelle mani sbagliate."

# game/episode024.rpy:81
translate italian episode024_c749e135:

    # vel "I don’t know what you’re talking about."
    vel "Non so di cosa stai parlando."

# game/episode024.rpy:82
translate italian episode024_7ec08692:

    # ag "Sure you do."
    ag "Certo che lo fai."

# game/episode024.rpy:83
translate italian episode024_5aeb54ca:

    # ag "But maybe I can refresh your memory."
    ag "Ma forse posso rinfrescarti la memoria."

# game/episode024.rpy:85
translate italian episode024_2b870632:

    # "*SNAP*"
    "*A SCATTO*"

# game/episode024.rpy:86
translate italian episode024_c1066646:

    # vel "Aaaah! Aaah! You motherfucker!"
    vel "Aaaah! Aaah! Figlio di puttana!"

# game/episode024.rpy:87
translate italian episode024_d5926495:

    # ag "I’ve just shattered your left kneecap, so I would be careful not to put any weight on that leg if they ever take you down from this wall."
    ag "Ti ho appena fracassato la rotula sinistra, quindi starei attento a non caricare il peso su quella gamba se mai ti tirassero giù da questo muro."

# game/episode024.rpy:89
translate italian episode024_e452b1b2:

    # vel "Do you think torturing me is going to make me spill any secrets?"
    vel "Pensi che torturarmi mi farà svelare qualche segreto?"

# game/episode024.rpy:91
translate italian episode024_c21f539c:

    # ag "Yes, as a matter of fact."
    ag "Sì, in effetti."

# game/episode024.rpy:92
translate italian episode024_1137f862:

    # ag "First, I will break every bone in your body, and when I’m done, I’ll reknit your entire skeleton and start all over again."
    ag "Per prima cosa romperò ogni osso del tuo corpo e, quando avrò finito, ricomincerò il tuo intero scheletro e ricomincerò tutto da capo."

# game/episode024.rpy:93
translate italian episode024_db476e3d:

    # ag "I’m going to keep you alive until you beg me to share every secret you know."
    ag "Ti terrò in vita finché non mi pregherai di condividere ogni segreto che conosci."

# game/episode024.rpy:94
translate italian episode024_fd97081c:

    # ag "The people of the Sovereignty deserve strong leadership, a leader with a spotless history, untainted by any missteps."
    ag "Il popolo della Sovranità merita una leadership forte, un leader con una storia immacolata, incontaminata da qualsiasi passo falso."

# game/episode024.rpy:95
translate italian episode024_4d3a8584:

    # ag "So you will tell me where you keep your records, or suffer the consequences."
    ag "Quindi mi dirai dove tieni i tuoi documenti, o ne pagherai le conseguenze."

# game/episode024.rpy:97
translate italian episode024_987a9bfd:

    # vel "Do your worst."
    vel "Fai del tuo peggio."

# game/episode024.rpy:99
translate italian episode024_35ea8b90:

    # ag "Oh, I certainly will."
    ag "Oh, lo farò sicuramente."

# game/episode024.rpy:100
translate italian episode024_eaf3249c:

    # vel "Aaaaah!"
    vel "Aaaaah!"

# game/episode024.rpy:102
translate italian episode024_0eb9bcdd:

    # vel "AAAAAAAAH!"
    vel "AAAAAAAAH!"

# game/episode024.rpy:110
translate italian episode024_a744ce6e:

    # "Hannah ushered us into a waiting room and left us after bringing some refreshments."
    "Hannah ci ha fatto entrare in una sala d'attesa e ci ha lasciato dopo aver portato dei rinfreschi."

# game/episode024.rpy:111
translate italian episode024_bb604716:

    # "The wait began."
    "L'attesa è iniziata."

# game/episode024.rpy:113
translate italian episode024_9a3c5bdf:

    # av "How do you rate our chances with the Tubloshi?"
    av "Come valuti le nostre possibilità con i Tubloshi?"

# game/episode024.rpy:115
translate italian episode024_805e2657:

    # c "I think we stand a good chance of gaining their support."
    c "Penso che abbiamo buone possibilità di ottenere il loro sostegno."

# game/episode024.rpy:117
translate italian episode024_f0f69dd4:

    # zi "Agreed."
    zi "Concordato."

# game/episode024.rpy:118
translate italian episode024_0f04ed34:

    # zi "They seem to have not forgotten what we did for them previously, so that works in our favor."
    zi "Sembra che non abbiano dimenticato ciò che abbiamo fatto per loro in precedenza, quindi questo gioca a nostro favore."

# game/episode024.rpy:120
translate italian episode024_3f42f57a:

    # c "I’m not sure, it could go either way."
    c "Non ne sono sicuro, potrebbe andare in entrambi i modi."

# game/episode024.rpy:122
translate italian episode024_3106effe:

    # zi "Yes, they were very held back in their response."
    zi "Sì, sono stati molto trattenuti nella loro risposta."

# game/episode024.rpy:124
translate italian episode024_af7bf4a7:

    # c "Yes, that was my impression as well."
    c "Sì, è stata anche la mia impressione."

# game/episode024.rpy:125
translate italian episode024_a177a947:

    # c "At any rate, now all we can do is wait."
    c "In ogni caso, ora non ci resta che aspettare."

# game/episode024.rpy:148
translate italian episode024_8e711d98:

    # "Just when I was about to go to sleep, my tablet received a message."
    "Proprio quando stavo per andare a dormire, il mio tablet ha ricevuto un messaggio."

# game/episode024.rpy:149
translate italian episode024_e8b0fa7d:

    # "It was Thyia, telling me to stay awake for just a little while longer, because she was on her way to me."
    "Era Thyia, che mi diceva di restare sveglio ancora per un po', perché stava venendo da me."

# game/episode024.rpy:150
translate italian episode024_6291004c:

    # "She told me she couldn’t wait to show herself wearing next to nothing."
    "Mi ha detto che non vedeva l'ora di mostrarsi indossando quasi nulla."

# game/episode024.rpy:152
translate italian episode024_a895df41:

    # "I was pretty certain of what she had in mind, and I wanted to surprise her in turn, so I messaged Jade and Vess to come as well."
    "Ero abbastanza sicuro di quello che aveva in mente e volevo fare una sorpresa a mia volta, quindi ho mandato un messaggio anche a Jade e Vess di venire anche loro."

# game/episode024.rpy:153
translate italian episode024_57053c59:

    # "They were both under orders to come dressed in as little clothing as possible."
    "Entrambi avevano l'ordine di presentarsi vestiti con il minor numero di vestiti possibile."

# game/episode024.rpy:156
translate italian episode024_b3b8ecee:

    # "I was pretty certain of what she had in mind and I wanted to surprise her in turn, so I messaged Jade to come as well."
    "Ero abbastanza sicuro di quello che aveva in mente e volevo sorprenderla a mia volta, quindi ho mandato un messaggio a Jade di venire anche lei."

# game/episode024.rpy:158
translate italian episode024_52ef16c1:

    # "I was pretty certain of what she had in mind, and I wanted to surprise her in turn, so I messaged Vess to come as well."
    "Ero abbastanza sicuro di quello che aveva in mente e volevo fare una sorpresa a mia volta, quindi ho mandato un messaggio anche a Vess di venire."

# game/episode024.rpy:159
translate italian episode024_81ec65d3:

    # "She was under orders to come dressed in as little clothing as possible."
    "Aveva l'ordine di venire vestita con il minor numero di vestiti possibile."

# game/episode024.rpy:162
