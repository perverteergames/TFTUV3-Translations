# game/episode024.rpy:165
translate italian episode024_52ef16c1_1:

    # "I was pretty certain of what she had in mind, and I wanted to surprise her in turn, so I messaged Vess to come as well."
    "Ero abbastanza sicuro di quello che aveva in mente e volevo fare una sorpresa a mia volta, quindi ho mandato un messaggio anche a Vess di venire."

# game/episode024.rpy:166
translate italian episode024_81ec65d3_1:

    # "She was under orders to come dressed in as little clothing as possible."
    "Aveva l'ordine di venire vestita con il minor numero di vestiti possibile."

# game/episode024.rpy:168
translate italian episode024_8e711d98_2:

    # "Just when I was about to go to sleep, my tablet received a message."
    "Proprio quando stavo per andare a dormire, il mio tablet ha ricevuto un messaggio."

# game/episode024.rpy:169
translate italian episode024_d3f3babc:

    # "It was Vess, telling me to stay awake for just a little while longer, because she was on her way to me."
    "Era Vess che mi diceva di restare sveglio ancora per un po', perché stava venendo da me."

# game/episode024.rpy:170
translate italian episode024_6291004c_2:

    # "She told me she couldn’t wait to show herself wearing next to nothing."
    "Mi ha detto che non vedeva l'ora di mostrarsi indossando quasi nulla."

# game/episode024.rpy:171
translate italian episode024_bd61b411:

    # "I was pretty certain of what she had in mind, and I wanted to surprise her in turn, so I messaged Jade to come as well."
    "Ero abbastanza sicuro di quello che aveva in mente e volevo sorprenderla a mia volta, quindi ho mandato un messaggio a Jade di venire anche lei."

# game/episode024.rpy:172
translate italian episode024_81ec65d3_2:

    # "She was under orders to come dressed in as little clothing as possible."
    "Aveva l'ordine di venire vestita con il minor numero di vestiti possibile."

# game/episode024.rpy:174
translate italian episode024_d541cd8c:

    # "Before going to sleep, I decided to have some fun."
    "Prima di andare a dormire ho deciso di divertirmi un po'."

# game/episode024.rpy:175
translate italian episode024_4ea65031:

    # "I messaged both Vess and Jade, ordering them to come to the apartment wearing as little clothing as possible."
    "Ho mandato un messaggio sia a Vess che a Jade, ordinando loro di venire all'appartamento indossando il minor numero di vestiti possibile."

# game/episode024.rpy:209
translate italian ep024_tubloshi_2bc2599c:

    # "Our delegation was led to the same hall we were in when we visited the Tubloshi earlier."
    "La nostra delegazione è stata condotta nella stessa sala in cui ci trovavamo quando abbiamo visitato il Tubloshi in precedenza."

# game/episode024.rpy:214
translate italian ep024_tubloshi_62375ff4:

    # "The captain of the ship, Kyl Zaghav, sat himself down and motioned for us to sit as well."
    "Il capitano della nave, Kyl Zaghav, si sedette e fece segno anche a noi di sederci."

# game/episode024.rpy:215
translate italian ep024_tubloshi_37b60198:

    # "As soon as we faced him, the captain began to speak, with Hannah translating."
    "Non appena lo abbiamo affrontato, il capitano ha iniziato a parlare, con Hannah che traduceva."

# game/episode024.rpy:218
translate italian ep024_tubloshi_94625ce8:

    # ha "[p_name] of the Humans, you honor us with your presence."
    ha "[p_name] degli Umani, ci onori con la tua presenza."

# game/episode024.rpy:219
translate italian ep024_tubloshi_5bc7bd2c:

    # ha "We are of course delighted if your visit is a mere social call, but we would treasure it even more if there was a higher purpose behind it."
    ha "Naturalmente saremo lieti se la vostra visita fosse una semplice visita sociale, ma ne faremmo tesoro ancora di più se dietro ci fosse uno scopo più alto."

# game/episode024.rpy:220
translate italian ep024_tubloshi_41a6c793:

    # c "There certainly is."
    c "Certamente c'è."

# game/episode024.rpy:222
translate italian ep024_tubloshi_928f5818:

    # ha "[p_name] of the Humans, why have you come?"
    ha "[p_name] degli Umani, perché sei venuto?"

# game/episode024.rpy:223
translate italian ep024_tubloshi_5951d2b8:

    # ha "We are surprised you would contact us again and suspect a higher purpose behind ‚your call."
    ha "Siamo sorpresi che tu ci contatti di nuovo e sospetti che dietro la tua chiamata ci sia uno scopo più alto."

# game/episode024.rpy:224
translate italian ep024_tubloshi_35cb38d9:

    # c "There certainly is a higher purpose."
    c "Sicuramente c’è uno scopo più alto."

# game/episode024.rpy:226
translate italian ep024_tubloshi_b5cec404:

    # c "As you might know, I originally hail from the Sovereignty."
    c "Come forse saprai, originariamente provengo dai Sovereignty."

# game/episode024.rpy:227
translate italian ep024_tubloshi_60b89451:

    # c "I recognize the Sovereignty for what it is, a corrupt dictatorship, that’s quickly sliding into even darker moral territory."
    c "Riconosco la Sovranità per quello che è, una dittatura corrotta, che sta rapidamente scivolando in un territorio morale ancora più oscuro."

# game/episode024.rpy:228
translate italian ep024_tubloshi_c23eef8b:

    # c "My father has recently become Regent of the Sovereignty, a position of power that soon will very likely be absolute."
    c "Mio padre è da poco diventato Reggente della Sovranità, una posizione di potere che molto probabilmente presto sarà assoluto."

# game/episode024.rpy:229
translate italian ep024_tubloshi_fa6f50ea:

    # c "I have reason to believe that the Sovereignty is planning on aggressively expanding its borders, subjugating any species that it encounters."
    c "Ho motivo di credere che la Sovranità stia progettando di espandere in modo aggressivo i suoi confini, sottomettendo qualsiasi specie incontri."

# game/episode024.rpy:230
translate italian ep024_tubloshi_b7efa349:

    # c "My father is not a reasonable man, and with the full power of the Sovereignty and any allies behind him, I think he will be capable of anything."
    c "Mio padre non è un uomo ragionevole e, con tutto il potere della Sovranità e tutti gli alleati al suo fianco, penso che sarà capace di qualsiasi cosa."

# game/episode024.rpy:231
translate italian ep024_tubloshi_b8b827f8:

    # c "The Sovereignty under his leadership will stop at nothing to usurp any civilized system currently in existence."
    c "La Sovranità sotto la sua guida non si fermerà davanti a nulla pur di usurpare qualsiasi sistema civilizzato attualmente esistente."

# game/episode024.rpy:232
translate italian ep024_tubloshi_8a9e68d8:

    # c "I’m certain there will be resistance, but unless there is a coordinated alliance, I’m afraid it is doomed to fail."
    c "Sono certo che ci sarà resistenza, ma a meno che non ci sia un’alleanza coordinata, temo che sia destinata a fallire."

# game/episode024.rpy:233
translate italian ep024_tubloshi_3a4d01e4:

    # c "I aim to lead that alliance and put a stop to my father and the Sovereignty once and for all."
    c "Il mio obiettivo è guidare quell'alleanza e porre fine a mio padre e alla Sovranità una volta per tutte."

# game/episode024.rpy:235
translate italian ep024_tubloshi_963e22b3:

    # ha "A noble cause indeed."
    ha "Una causa nobile davvero."

# game/episode024.rpy:236
translate italian ep024_tubloshi_41bc59b9:

    # ha "The news you bring is troublesome, but our own intelligence corroborates your claims."
    ha "Le notizie che porti sono preoccupanti, ma la nostra stessa intelligenza conferma le tue affermazioni."

# game/episode024.rpy:237
translate italian ep024_tubloshi_b94b9b3f:

    # ha "We have received reports of violent border skirmishes and incursions into territory unclaimed by the Sovereignty."
    ha "Abbiamo ricevuto segnalazioni di violente scaramucce al confine e incursioni in territori non rivendicati dalla Sovranità."

# game/episode024.rpy:238
translate italian ep024_tubloshi_bd809c7b:

    # ha "Already, the Sovereignty has found allies in its conquest."
    ha "La Sovranità ha già trovato degli alleati nella sua conquista."

# game/episode024.rpy:239
translate italian ep024_tubloshi_8e1f8d95:

    # ha "We know of several weaker systems that have rallied behind the Sovereignty’s cause."
    ha "Conosciamo diversi sistemi più deboli che si sono mobilitati a sostegno della causa della sovranità."

# game/episode024.rpy:240
translate italian ep024_tubloshi_a89172f7:

    # ha "What they hope to gain is unclear, as the Sovereignty will either enslave or slaughter them in the end, as is their wont."
    ha "Ciò che sperano di ottenere non è chiaro, poiché la Sovranità alla fine li schiavizzerà o li massacrerà, come è loro abitudine."

# game/episode024.rpy:241
translate italian ep024_tubloshi_d512b57a:

    # ha "You speak of your father with such vehemence."
    ha "Parli di tuo padre con tanta veemenza."

# game/episode024.rpy:242
translate italian ep024_tubloshi_81b47b30:

    # ha "Tell me, is there a personal reason for your willingness to take on an empire as big as the Sovereignty?"
    ha "Dimmi, c'è una ragione personale per cui sei disposto ad affrontare un impero grande quanto la Sovranità?"

# game/episode024.rpy:244
translate italian ep024_tubloshi_29b2589a:

    # c "Yes, there is."
    c "Sì, c'è."

# game/episode024.rpy:245
translate italian ep024_tubloshi_8574ccc4:

    # c "My father has hurt me and my family on several occasions."
    c "Mio padre ha ferito me e la mia famiglia in diverse occasioni."

# game/episode024.rpy:246
translate italian ep024_tubloshi_be590183:

    # c "He’s responsible for illegal medical experiments and has tried to kill my sister and me for his own gain."
    c "È responsabile di esperimenti medici illegali e ha cercato di uccidere me e mia sorella per il suo tornaconto."

# game/episode024.rpy:247
translate italian ep024_tubloshi_fcf1fa80:

    # c "For that alone, I want him dead."
    c "Solo per questo lo voglio morto."

# game/episode024.rpy:248
translate italian ep024_tubloshi_4896971e:

    # c "Him becoming Regent has only strengthened my resolve to put an end to him and the travesty that is the Sovereignty."
    c "Il fatto che sia diventato reggente non ha fatto altro che rafforzare la mia determinazione a porre fine a lui e alla parodia della Sovranità."

# game/episode024.rpy:250
translate italian ep024_tubloshi_15b2c0ac:

    # ha "Am I correct in understanding that you’re asking us to join the alliance against the Sovereignty?"
    ha "Ho ragione nel capire che ci stai chiedendo di unirci all'alleanza contro la Sovranità?"

# game/episode024.rpy:252
translate italian ep024_tubloshi_25ad6410:

    # c "Yes, you are."
    c "Sì, sei tu."

# game/episode024.rpy:254
translate italian ep024_tubloshi_336ef893:

    # c "A race of mighty warriors like the Tubloshi will surely be an incentive for others to join forces."
    c "Una razza di potenti guerrieri come i Tubloshi sarà sicuramente un incentivo per gli altri a unire le forze."

# game/episode024.rpy:255
translate italian ep024_tubloshi_b2ff27f1:

    # c "The efficiency and success of the Tubloshi military campaigns are legendary."
    c "L'efficienza e il successo delle campagne militari di Tubloshi sono leggendari."

# game/episode024.rpy:256
translate italian ep024_tubloshi_1939e747:

    # c "Your heroism is unparalleled and an inspiration for us all."
    c "Il tuo eroismo non ha eguali ed è fonte di ispirazione per tutti noi."

# game/episode024.rpy:257
translate italian ep024_tubloshi_670dc06d:

    # c "I’m asking you humbly to become our first partners in this endeavor."
    c "Vi chiedo umilmente di diventare i nostri primi partner in questa impresa."

# game/episode024.rpy:262
translate italian ep024_tubloshi_336ef893_1:

    # c "A race of mighty warriors like the Tubloshi will surely be an incentive for others to join forces."
    c "Una razza di potenti guerrieri come i Tubloshi sarà sicuramente un incentivo per gli altri a unire le forze."

# game/episode024.rpy:263
translate italian ep024_tubloshi_b2ff27f1_1:

    # c "The efficiency and success of the Tubloshi military campaigns are legendary."
    c "L'efficienza e il successo delle campagne militari di Tubloshi sono leggendari."

# game/episode024.rpy:264
translate italian ep024_tubloshi_1939e747_1:

    # c "Your heroism is unparalleled and an inspiration for us all."
    c "Il tuo eroismo non ha eguali ed è fonte di ispirazione per tutti noi."

# game/episode024.rpy:265
translate italian ep024_tubloshi_670dc06d_1:

    # c "I’m asking you humbly to become our first partners in this endeavor."
    c "Vi chiedo umilmente di diventare i nostri primi partner in questa impresa."

# game/episode024.rpy:268
translate italian ep024_tubloshi_3c029f7e:

    # c "We need as many allies in this fight as possible."
    c "Abbiamo bisogno di quanti più alleati possibile in questa lotta."

# game/episode024.rpy:269
translate italian ep024_tubloshi_77e9a3a2:

    # c "The Sovereignty is a strong opponent, but not undefeatable."
    c "La Sovranità è un avversario forte, ma non imbattibile."

# game/episode024.rpy:270
translate italian ep024_tubloshi_8641b6c9:

    # c "Your military might is well-known throughout the galaxy, and that’s why I’m asking you to become our first partners in this endeavor."
    c "La vostra potenza militare è ben nota in tutta la galassia, ed è per questo che vi chiedo di diventare i nostri primi partner in questa impresa."

# game/episode024.rpy:272
translate italian ep024_tubloshi_36d34802:

    # c "Together we will be able to put a stop to the Sovereignty and make the galaxy a better place for us all."
    c "Insieme saremo in grado di porre fine alla Sovranità e rendere la galassia un posto migliore per tutti noi."

# game/episode024.rpy:275
translate italian ep024_tubloshi_23840c62:

    # ha "Thank you for your kind words, [p_name] of the Humans."
    ha "Grazie per le tue gentili parole, [p_name] degli Umani."

# game/episode024.rpy:276
translate italian ep024_tubloshi_bea80d6a:

    # ha "We will now deliberate and let you know our verdict as soon as possible."
    ha "Ora deliberemo e vi faremo sapere il nostro verdetto il prima possibile."

# game/episode024.rpy:277
translate italian ep024_tubloshi_9be85a46:

    # c "Thank you, Honorable Captain Kyl Zaghav."
    c "Grazie, onorevole capitano Kyl Zaghav."

# game/episode024.rpy:280
translate italian ep024_tubloshi_ce434b12:

    # ha "We will take your request advisement and let you know our verdict as soon as possible, [p_name] of the Humans."
    ha "Prenderemo in considerazione la tua richiesta e ti faremo sapere il nostro verdetto il prima possibile, [p_name] degli Umani."

# game/episode024.rpy:281
translate italian ep024_tubloshi_4c0ec1ad:

    # c "Thank you, Captain Kyl Zaghav."
    c "Grazie, capitano Kyl Zaghav."

# game/episode024.rpy:282
translate italian ep024_tubloshi_3c6cfad8:

    # "We took our leave of the Tubloshi and left the dining hall with Hannah."
    "Ci congedammo dal Tubloshi e lasciammo la sala da pranzo con Hannah."

# game/episode024.rpy:289
translate italian ep024_tubloshi_agreement_8b16d172:

    # "The Tubloshi leadership called us in after only a couple of hours."
    "La dirigenza di Tubloshi ci chiamò dopo solo un paio d'ore."

# game/episode024.rpy:295
translate italian ep024_tubloshi_agreement_dfa7c0fb:

    # "Hannah and I barely had time to get dressed and hurried to the conference room."
    "Hannah e io abbiamo avuto appena il tempo di vestirci e di correre nella sala conferenze."

# game/episode024.rpy:297
translate italian ep024_tubloshi_agreement_f6fa5cdd:

    # "We made our way to the conference room."
    "Ci siamo diretti verso la sala conferenze."

# game/episode024.rpy:299
translate italian ep024_tubloshi_agreement_b33724d0:

    # "The Tubloshi leadership took their time deliberating and called us in after several hours."
    "La leadership di Tubloshi si è presa il tempo necessario per riflettere e ci ha chiamato dopo diverse ore."

# game/episode024.rpy:301
translate italian ep024_tubloshi_agreement_c76033c5:

    # "The announcement came as a surprise, as Hannah and I had forgotten our surroundings as we spent the time naked in her bed."
    "L'annuncio è arrivato come una sorpresa, poiché Hannah e io avevamo dimenticato ciò che ci circondava mentre passavamo il tempo nudi nel suo letto."

# game/episode024.rpy:306
translate italian ep024_tubloshi_agreement_d8f4abf1:

    # "We got dressed and hurried to the conference room."
    "Ci vestimmo e corremmo nella sala conferenze."

# game/episode024.rpy:308
translate italian ep024_tubloshi_agreement_f6fa5cdd_1:

    # "We made our way to the conference room."
    "Ci siamo diretti verso la sala conferenze."

# game/episode024.rpy:310
translate italian ep024_tubloshi_agreement_ccb05b2f:

    # "Kyl Zaghav was already waiting for us."
    "Kyl Zaghav ci stava già aspettando."

# game/episode024.rpy:312
translate italian ep024_tubloshi_agreement_f64cb4a0:

    # "Hannah took up position next to the captain and waited for him to speak."
    "Hannah prese posizione accanto al capitano e attese che parlasse."

# game/episode024.rpy:313
translate italian ep024_tubloshi_agreement_e86ad599:

    # "The captain looked at me longer than I felt comfortable."
    "Il capitano mi guardò più a lungo di quanto mi sentissi a mio agio."

# game/episode024.rpy:314
translate italian ep024_tubloshi_agreement_d49d61c5:

    # "At last, he spoke."
    "Alla fine parlò."

# game/episode024.rpy:317
translate italian ep024_tubloshi_agreement_a1fee370:

    # ha "The Tubloshi have heard your call for help, and we are honored to stand shoulder to shoulder in the coming fight."
    ha "I Tubloshi hanno ascoltato la tua richiesta di aiuto e siamo onorati di schierarci fianco a fianco nella battaglia imminente."

# game/episode024.rpy:318
translate italian ep024_tubloshi_agreement_9ad5195b:

    # ha "The Sovereignty will feel the full might of the Tubloshi army as we will crush them into oblivion."
    ha "La Sovranità sentirà tutta la potenza dell'esercito Tubloshi mentre li schiacceremo nell'oblio."

# game/episode024.rpy:319
translate italian ep024_tubloshi_agreement_4c0ec1ad:

    # c "Thank you, Captain Kyl Zaghav."
    c "Grazie, capitano Kyl Zaghav."

# game/episode024.rpy:320
translate italian ep024_tubloshi_agreement_0f38e582:

    # c "I am honored by your zeal and determination."
    c "Sono onorato del tuo zelo e della tua determinazione."

# game/episode024.rpy:321
translate italian ep024_tubloshi_agreement_29998096:

    # c "The conflict we face will be long and bloody, but we will be victorious, I have no doubt of that."
    c "Il conflitto che dovremo affrontare sarà lungo e sanguinoso, ma ne usciremo vittoriosi, su questo non ho dubbi."

# game/episode024.rpy:323
translate italian ep024_tubloshi_agreement_995607da:

    # ha "The Tubloshi fleet will coordinate with your ship so that we will be ready for our next destination."
    ha "La flotta Tubloshi si coordinerà con la vostra nave in modo da essere pronti per la nostra prossima destinazione."

# game/episode024.rpy:324
translate italian ep024_tubloshi_agreement_f661b20f:

    # ha "But now, a toast is in order!"
    ha "Ma ora è d'obbligo un brindisi!"

# game/episode024.rpy:326
translate italian ep024_tubloshi_agreement_a052ae6d:

    # "A bottle and several glasses were brought to the table."
    "Furono portati in tavola una bottiglia e diversi bicchieri."

# game/episode024.rpy:327
translate italian ep024_tubloshi_agreement_835a37cc:

    # "Kyl Zaghav poured generous amounts of the Tubloshi liquor and downed one of the glasses in one go."
    "Kyl Zaghav versò abbondanti quantità di liquore Tubloshi e buttò giù uno dei bicchieri in un colpo solo."

# game/episode024.rpy:328
translate italian ep024_tubloshi_agreement_5f609fb0:

    # "The others and I did the same."
    "Io e gli altri abbiamo fatto lo stesso."

# game/episode024.rpy:329
translate italian ep024_tubloshi_agreement_c6860939:

    # "The strong liquor burned as much as I remembered, but I kept a straight face."
    "Il liquore forte bruciava per quanto ricordassi, ma mantenni la faccia seria."

# game/episode024.rpy:330
translate italian ep024_tubloshi_agreement_ba410b4a:

    # "Kyl Zaghav nodded in appreciation and poured again."
    "Kyl Zaghav annuì in segno di apprezzamento e versò di nuovo."

# game/episode024.rpy:332
translate italian ep024_tubloshi_agreement_c85a809a:

    # "This went on for several hours, until most of the Tubloshi were lying drunk under the table."
    "Ciò andò avanti per diverse ore, finché la maggior parte dei Tubloshi giaceva ubriaca sotto il tavolo."

# game/episode024.rpy:333
translate italian ep024_tubloshi_agreement_66a764af:

    # "Me and my crew had wisely moderated the alcohol intake and listened dutifully to several renditions of what must be Tubloshi drinking songs."
    "Io e il mio equipaggio avevamo saggiamente moderato il consumo di alcol e ascoltato diligentemente diverse interpretazioni di quelle che dovevano essere le canzoni dei Tubloshi sul bere."

# game/episode024.rpy:334
translate italian ep024_tubloshi_agreement_6706b6c6:

    # "When Kyl Zaghav staggered to stand, we knew the meeting was officially over."
    "Quando Kyl Zaghav si è alzato barcollando, abbiamo capito che l'incontro era ufficialmente finito."

# game/episode024.rpy:335
translate italian ep024_tubloshi_agreement_fb106e05:

    # "After saying goodbye to the drunken Tubloshi revellers, we made our way back to our ship."
    "Dopo aver salutato i festaioli ubriachi di Tubloshi, siamo tornati alla nostra nave."

# game/episode024.rpy:337
translate italian ep024_tubloshi_agreement_08fb43ca:

    # ha "The Tubloshi have reached a verdict."
    ha "I Tubloshi hanno raggiunto un verdetto."

# game/episode024.rpy:338
translate italian ep024_tubloshi_agreement_c1fdaf03:

    # ha "The facts you have presented us align with our own findings."
    ha "I fatti che ci hai presentato sono in linea con le nostre scoperte."

# game/episode024.rpy:339
translate italian ep024_tubloshi_agreement_1176801e:

    # ha "The need for action cannot be denied."
    ha "La necessità di agire non può essere negata."

# game/episode024.rpy:340
translate italian ep024_tubloshi_agreement_56ae2699:

    # ha "It is for this reason that we agree to join the alliance that has been offered."
    ha "È per questo motivo che accettiamo di aderire all'alleanza che ci è stata offerta."

# game/episode024.rpy:341
translate italian ep024_tubloshi_agreement_4c0ec1ad_1:

    # c "Thank you, Captain Kyl Zaghav."
    c "Grazie, capitano Kyl Zaghav."

# game/episode024.rpy:343
translate italian ep024_tubloshi_agreement_995607da_1:

    # ha "The Tubloshi fleet will coordinate with your ship so that we will be ready for our next destination."
    ha "La flotta Tubloshi si coordinerà con la vostra nave in modo da essere pronti per la nostra prossima destinazione."

# game/episode024.rpy:344
translate italian ep024_tubloshi_agreement_c018148c:

    # "The Tubloshi all stood, which was our cue to leave the ship."
    "I Tubloshi si alzarono tutti, il che fu il nostro segnale per lasciare la nave."

# game/episode024.rpy:348
translate italian ep024_tubloshi_agreement_08f4514c:

    # "Hannah walked us to the airlock and waited for everyone to get back onto the Bastard."
    "Hannah ci accompagnò alla camera di equilibrio e aspettò che tutti tornassero a bordo del Bastard."

# game/episode024.rpy:353
translate italian ep024_tubloshi_agreement_aca77ffa:

    # ha "The Captain will be in touch as soon as the Tubloshi are ready to leave."
    ha "Il Capitano si metterà in contatto non appena i Tubloshi saranno pronti a partire."

# game/episode024.rpy:354
translate italian ep024_tubloshi_agreement_f23b6f2b:

    # c "We will forward the coordinates to our next destination shortly."
    c "A breve inoltreremo le coordinate per la nostra prossima destinazione."

# game/episode024.rpy:355
translate italian ep024_tubloshi_agreement_833870c1:

    # ha "I had a very good time."
    ha "Mi sono divertito moltissimo."

# game/episode024.rpy:356
translate italian ep024_tubloshi_agreement_e0224be1:

    # c "Me too."
    c "Anche io."

# game/episode024.rpy:358
translate italian ep024_tubloshi_agreement_48b26928:

    # c "I’m so happy we found each other again."
    c "Sono così felice che ci siamo ritrovati."

# game/episode024.rpy:359
translate italian ep024_tubloshi_agreement_ff135c59:

    # c "Especially considering the news you’ve brought with you."
    c "Soprattutto considerando le notizie che hai portato con te."

# game/episode024.rpy:360
translate italian ep024_tubloshi_agreement_3da8c80e:

    # c "We should get together soon."
    c "Dovremmo vederci presto."

# game/episode024.rpy:365
translate italian ep024_tubloshi_agreement_89a43bee:

    # ha "I’m just a comms message away."
    ha "Sono solo a un messaggio di comunicazione da me."

# game/episode024.rpy:366
translate italian ep024_tubloshi_agreement_74c283bf:

    # c "I know and that makes me very happy."
    c "Lo so e questo mi rende molto felice."

# game/episode024.rpy:367
translate italian ep024_tubloshi_agreement_19c089fd:

    # c "I’ll call you soon."
    c "Ti chiamerò presto."

# game/episode024.rpy:369
translate italian ep024_tubloshi_agreement_3c6ae073:

    # c "I’m glad we ran into each other again."
    c "Sono felice che ci siamo incontrati di nuovo."

# game/episode024.rpy:374
translate italian ep024_tubloshi_agreement_e21d3ab3:

    # ha "I’m just a comms message away, if you want to do it again."
    ha "Mi manca solo un messaggio di comunicazione, se vuoi farlo di nuovo."

# game/episode024.rpy:375
translate italian ep024_tubloshi_agreement_1c2b5cd5:

    # c "That sounds very tempting."
    c "Sembra molto allettante."

# game/episode024.rpy:376
translate italian ep024_tubloshi_agreement_4a67ad8a:

    # c "I’ll call you."
    c "Ti chiamo."

# game/episode024.rpy:381
translate italian ep024_tubloshi_agreement_bc795649:

    # "Hannah and I kissed before I stepped into the airlock passageway."
    "Hannah e io ci siamo baciati prima di entrare nel passaggio della camera di equilibrio."

# game/episode024.rpy:382
translate italian ep024_tubloshi_agreement_0473460c:

    # "The doors closed behind me and I was back on the Iron Bastard."
    "Le porte si chiusero dietro di me ed ero di nuovo sull'Iron Bastard."

# game/episode024.rpy:384
translate italian ep024_tubloshi_agreement_7680d5a4:

    # "Ziv and Aven were waiting for me on the bridge."
    "Ziv e Aven mi stavano aspettando sul ponte."

# game/episode024.rpy:386
translate italian ep024_tubloshi_agreement_908917a7:

    # "Hannah walked us to the airlock."
    "Hannah ci ha accompagnato alla camera di equilibrio."

# game/episode024.rpy:388
translate italian ep024_tubloshi_agreement_aca77ffa_1:

    # ha "The Captain will be in touch as soon as the Tubloshi are ready to leave."
    ha "Il Capitano si metterà in contatto non appena i Tubloshi saranno pronti a partire."

# game/episode024.rpy:389
translate italian ep024_tubloshi_agreement_ebdd5257:

    # ha "We will keep a comms channel open for any inquiries or directions you might have."
    ha "Manterremo un canale di comunicazione aperto per qualsiasi domanda o indicazione che potresti avere."

# game/episode024.rpy:390
translate italian ep024_tubloshi_agreement_0ee7adfb:

    # c "Thank you, we will forward the coordinates to our next destination shortly."
    c "Grazie, inoltreremo a breve le coordinate per la nostra prossima destinazione."

# game/episode024.rpy:391
translate italian ep024_tubloshi_agreement_56f74509:

    # "The airlock closed behind us, and we were back on the Iron Bastard."
    "La camera di equilibrio si chiuse alle nostre spalle e ci ritrovammo sull'Iron Bastard."

# game/episode024.rpy:393
translate italian ep024_tubloshi_agreement_abc8f63a:

    # "We headed back to the bridge."
    "Ritornammo al ponte."

# game/episode024.rpy:396
translate italian ep024_tubloshi_agreement_ddd442b5:

    # av "That went well, I think?"
    av "E' andata bene, secondo me?"

# game/episode024.rpy:397
translate italian ep024_tubloshi_agreement_f55b01bc:

    # c "It did, yes."
    c "Lo ha fatto, sì."

# game/episode024.rpy:400
translate italian ep024_tubloshi_agreement_a89ad5d7:

    # zi "Yes, the Tubloshi make strong allies."
    zi "Sì, i Tubloshi sono ottimi alleati."

# game/episode024.rpy:401
translate italian ep024_tubloshi_agreement_eeaf092e:

    # zi "Considering the amount of respect they’ve shown us so far, they will remain staunch allies."
    zi "Considerando il rispetto che ci hanno dimostrato finora, rimarranno fedeli alleati."

# game/episode024.rpy:402
translate italian ep024_tubloshi_agreement_72731689:

    # c "Yes, I think they were pretty stoked to be included."
    c "Sì, penso che fossero piuttosto entusiasti di essere inclusi."

# game/episode024.rpy:403
translate italian ep024_tubloshi_agreement_322d0c27:

    # c "Especially considering the amount of bottles of that foul liquor they drank immediately afterward."
    c "Soprattutto considerando la quantità di bottiglie di quel disgustoso liquore che bevvero subito dopo."

# game/episode024.rpy:405
translate italian ep024_tubloshi_agreement_772ff1bf:

    # av "They sure drank a lot..."
    av "Sicuramente hanno bevuto molto..."

# game/episode024.rpy:407
translate italian ep024_tubloshi_agreement_49ac8fbb:

    # zi "A token of respect."
    zi "Un segno di rispetto."

# game/episode024.rpy:408
translate italian ep024_tubloshi_agreement_c8d36195:

    # zi "I think this first alliance is solid, let’s hope the next alliance is on an equal solid footing."
    zi "Penso che questa prima alleanza sia solida, speriamo che la prossima alleanza sia su basi altrettanto solide."

# game/episode024.rpy:410
translate italian ep024_tubloshi_agreement_bd3c9a7a:

    # zi "The pact with the Tubloshi strengthens us tremendously."
    zi "Il patto con i Tubloshi ci rafforza moltissimo."

# game/episode024.rpy:411
translate italian ep024_tubloshi_agreement_d4b6f3ea:

    # zi "I do hope they’ll remain allies in the near future."
    zi "Spero che rimarranno alleati nel prossimo futuro."

# game/episode024.rpy:412
translate italian ep024_tubloshi_agreement_72bd9c50:

    # c "Do you doubt that?"
    c "Ne dubiti?"

# game/episode024.rpy:413
translate italian ep024_tubloshi_agreement_df217485:

    # zi "The current alliance suits us both."
    zi "L’attuale alleanza va bene a entrambi."

# game/episode024.rpy:414
translate italian ep024_tubloshi_agreement_36cc027d:

    # zi "Considering the lack of displayed zeal so characteristic of the Tubloshi, I’d say they’ll remain interested in cooperating."
    zi "Considerando la mancanza di zelo così caratteristica dei Tubloshi, direi che rimarranno interessati a collaborare."

# game/episode024.rpy:415
translate italian ep024_tubloshi_agreement_6c8a3221:

    # c "And if they’re no longer interested, they’ll turn on us?"
    c "E se non saranno più interessati, si rivolteranno contro di noi?"

# game/episode024.rpy:417
translate italian ep024_tubloshi_agreement_4ca2292e:

    # zi "They might, if they perceive us as weak."
    zi "Potrebbero, se ci percepissero come deboli."

# game/episode024.rpy:418
translate italian ep024_tubloshi_agreement_6ac80f52:

    # zi "But they might just as easily abandon us at some point."
    zi "Ma ad un certo punto potrebbero abbandonarci altrettanto facilmente."

# game/episode024.rpy:420
translate italian ep024_tubloshi_agreement_0308a2b6:

    # av "We’ll keep a close eye on them."
    av "Li terremo d'occhio."

# game/episode024.rpy:422
translate italian ep024_tubloshi_agreement_068f5b51:

    # zi "That is wise."
    zi "Questo è saggio."

# game/episode024.rpy:423
translate italian ep024_tubloshi_agreement_0ad5bb3b:

    # zi "Let’s hope the next alliance is on a more solid footing."
    zi "Speriamo che la prossima alleanza abbia basi più solide."

# game/episode024.rpy:425
translate italian ep024_tubloshi_agreement_d1bd198f:

    # ce "What’s our next move?"
    ce "Qual è la nostra prossima mossa?"

# game/episode024.rpy:426
translate italian ep024_tubloshi_agreement_a6995c33:

    # c "We’re going back to Uailea."
    c "Ritorneremo a Uailea."

# game/episode024.rpy:427
translate italian ep024_tubloshi_agreement_554e5622:

    # c "Military might will persuade many, but we need diplomats to make deals with the parties that aren’t impressed by just martial prowess."
    c "La potenza militare persuaderà molti, ma abbiamo bisogno che i diplomatici raggiungano accordi con le parti che non sono impressionate solo dall’abilità marziale."

# game/episode024.rpy:429
translate italian ep024_tubloshi_agreement_e13a6d28:

    # av "You’re thinking of enlisting the Rhenkoy?"
    av "Stai pensando di arruolare i Rhenkoy?"

# game/episode024.rpy:430
translate italian ep024_tubloshi_agreement_36391c9b:

    # c "Yes, I am."
    c "Sì, io sono."

# game/episode024.rpy:432
translate italian ep024_tubloshi_agreement_fb269c8b:

    # zi "That’s going to be a challenge, considering how we left my home planet."
    zi "Sarà una sfida, considerando come abbiamo lasciato il mio pianeta natale."

# game/episode024.rpy:434
translate italian ep024_tubloshi_agreement_0d5dc9cf:

    # c "I’m sure Nkoy Rhedia will listen to us."
    c "Sono sicuro che Nkoy Rhedia ci ascolterà."

# game/episode024.rpy:435
translate italian ep024_tubloshi_agreement_0390e998:

    # zi "I’m certain she will."
    zi "Sono certo che lo farà."

# game/episode024.rpy:436
translate italian ep024_tubloshi_agreement_7922fc2a:

    # zi "But dealing with rooting out the corruption and the lingering influence of Nkoy Arlya is likely to dominate her agenda."
    zi "Ma è probabile che occuparsi di sradicare la corruzione e la persistente influenza di Nkoy Arlya domini la sua agenda."

# game/episode024.rpy:437
translate italian ep024_tubloshi_agreement_04c9ada2:

    # c "We have to try to drum up support regardless."
    c "Dobbiamo cercare di ottenere sostegno a prescindere."

# game/episode024.rpy:439
translate italian ep024_tubloshi_agreement_daad7307:

    # c "I’m sure Nkoy Arlya will listen to reason."
    c "Sono sicuro che Nkoy Arlya ascolterà la ragione."

# game/episode024.rpy:440
translate italian ep024_tubloshi_agreement_fcdef2f2:

    # zi "I hope she does."
    zi "Spero che lo faccia."

# game/episode024.rpy:442
translate italian ep024_tubloshi_agreement_a989ae1c:

    # "After informing the Tubloshi of our new heading, Céline set course to Uailea."
    "Dopo aver informato i Tubloshi della nostra nuova rotta, Céline fece rotta verso Uailea."

# game/episode024.rpy:449
translate italian ep024_hannah_f7973127:

    # "While the Tubloshi went to deliberate among themselves, I took the opportunity to find Hannah."
    "Mentre i Tubloshi andavano a discutere tra loro, ho colto l'occasione per trovare Hannah."

# game/episode024.rpy:454
translate italian ep024_hannah_649b5e7a:

    # "The translator wasn’t hard to find, as she came walking toward me in the hallway."
    "La traduttrice non è stata difficile da trovare, mentre veniva verso di me nel corridoio."

# game/episode024.rpy:455
translate italian ep024_hannah_93f03eea:

    # c "Hannah, am I glad to see you."
    c "Hannah, sono felice di vederti."

# game/episode024.rpy:460
translate italian ep024_hannah_6297a344:

    # ha "You too, [p_name]."
    ha "Anche tu, [p_name]."

# game/episode024.rpy:461
translate italian ep024_hannah_9a5e2ecb:

    # ha "I was dying for the greeting ceremony to be over."
    ha "Morivo dalla voglia che la cerimonia di saluto finisse."

# game/episode024.rpy:462
translate italian ep024_hannah_241c7773:

    # ha "Could we have a word in private?"
    ha "Potremmo scambiare due parole in privato?"

# game/episode024.rpy:463
translate italian ep024_hannah_4e8c7062:

    # c "Of course."
    c "Ovviamente."

# game/episode024.rpy:465
translate italian ep024_hannah_4a6a4976:

    # "I followed Hannah through the bowels of the Tubloshi warship until we reached her private quarters."
    "Ho seguito Hannah attraverso le viscere della nave da guerra Tubloshi finché non abbiamo raggiunto i suoi alloggi privati."

# game/episode024.rpy:466
translate italian ep024_hannah_1a74d9bb:

    # c "Still holed up in here, I see."
    c "Sono ancora rintanato qui, vedo."

# game/episode024.rpy:469
translate italian ep024_hannah_45aa049d:

    # "As I closed the door, Hannah turned around and faced me."
    "Mentre chiudevo la porta, Hannah si voltò e mi guardò."

# game/episode024.rpy:470
translate italian ep024_hannah_2f552008:

    # c "So...{w} You’re pregnant."
    c "Quindi...{w} Sei incinta."

# game/episode024.rpy:472
translate italian ep024_hannah_b73ca50f:

    # ha "I am."
    ha "Sono."

# game/episode024.rpy:473
translate italian ep024_hannah_6ecef24a:

    # ha "Before you ask anything else, it’s yours."
    ha "Prima di chiedere qualsiasi altra cosa, è tuo."

# game/episode024.rpy:474
translate italian ep024_hannah_bd2dbd8b:

    # c "It’s mine?!"
    c "È mio?!"

# game/episode024.rpy:475
translate italian ep024_hannah_b4d20e22:

    # c "But how?"
    c "Ma come?"

# game/episode024.rpy:477
translate italian ep024_hannah_6522642f:

    # ha "Well, cumming inside me during our first encounter might have contributed to the fact."
    ha "Beh, venirmi dentro durante il nostro primo incontro potrebbe aver contribuito a questo."

# game/episode024.rpy:478
translate italian ep024_hannah_f7cafb46:

    # c "But it’s been over nine months since I last saw you."
    c "Ma sono passati più di nove mesi dall’ultima volta che ti ho visto."

# game/episode024.rpy:479
translate italian ep024_hannah_c6417b60:

    # c "Looking at how you’ve grown, you can’t be much further than your second trimester."
    c "Guardando come sei cresciuto, non puoi essere molto oltre il tuo secondo trimestre."

# game/episode024.rpy:481
translate italian ep024_hannah_5e5aa4be:

    # ha "You’re right."
    ha "Hai ragione."

# game/episode024.rpy:482
translate italian ep024_hannah_b760257f:

    # ha "I’m in my twenty-fourth week, actually."
    ha "Sono alla ventiquattresima settimana, a dire il vero."

# game/episode024.rpy:483
translate italian ep024_hannah_f0015089:

    # ha "But the baby is yours."
    ha "Ma il bambino è tuo."

# game/episode024.rpy:484
translate italian ep024_hannah_7029aaf9:

    # ha "Allow me to explain."
    ha "Permettimi di spiegare."

# game/episode024.rpy:486
translate italian ep024_hannah_9cfe9237:

    # c "Before you do that, I just want to say that I’m over the moon to hear this news."
    c "Prima di farlo, voglio solo dirti che sono al settimo cielo nel sentire questa notizia."

# game/episode024.rpy:488
translate italian ep024_hannah_db8b2056:

    # "By the way her posture changed, I could tell that a load had been lifted from Hannah’s shoulders."
    "Dal modo in cui la sua postura cambiava, potevo dire che un peso era stato tolto dalle spalle di Hannah."

# game/episode024.rpy:490
translate italian ep024_hannah_01fb9ee3:

    # "I took her into my arms and kissed her."
    "L'ho presa tra le mie braccia e l'ho baciata."

# game/episode024.rpy:492
translate italian ep024_hannah_68bdda20:

    # ha "I found out I was pregnant a few weeks after you left."
    ha "Ho scoperto di essere incinta poche settimane dopo la tua partenza."

# game/episode024.rpy:493
translate italian ep024_hannah_106d4499:

    # ha "Kyl Zaghav allowed me to contact you, which is a rare privilege."
    ha "Kyl Zaghav mi ha permesso di contattarti, il che è un privilegio raro."

# game/episode024.rpy:494
translate italian ep024_hannah_52c7b361:

    # ha "I tried for months to reach you, but my messages never arrived."
    ha "Ho provato per mesi a contattarti, ma i miei messaggi non sono mai arrivati."

# game/episode024.rpy:495
translate italian ep024_hannah_a090bea3:

    # c "I think I know why, we were held hostage in a secret facility for months after we left you."
    c "Penso di sapere perché, siamo stati tenuti in ostaggio in una struttura segreta per mesi dopo averti lasciato."

# game/episode024.rpy:497
translate italian ep024_hannah_b3cc9a09:

    # ha "That must be it."
    ha "Deve essere così."

# game/episode024.rpy:498
translate italian ep024_hannah_c4b028ff:

    # ha "I kept sending messages until the Tubloshi put me on ice."
    ha "Ho continuato a mandare messaggi finché i Tubloshi non mi hanno messo sotto ghiaccio."

# game/episode024.rpy:499
translate italian ep024_hannah_7f6b1596:

    # c "Put you on ice?"
    c "Ti metti sotto ghiaccio?"

# game/episode024.rpy:501
translate italian ep024_hannah_8b8a2425:

    # ha "We’ve just returned from a long campaign deep inside Gapilr territory."
    ha "Siamo appena tornati da una lunga campagna nel territorio di Gapilr."

# game/episode024.rpy:502
translate italian ep024_hannah_c34e4ec8:

    # ha "As you might know, the Gapilr are infamous for their xenophobia."
    ha "Come forse saprai, i Gapilr sono famosi per la loro xenofobia."

# game/episode024.rpy:503
translate italian ep024_hannah_772bc253:

    # ha "Any non-Gapilr species is shot on sight, and the chances of seeing you again while in Gapilr territory were very slim."
    ha "Qualsiasi specie non Gapilr viene colpita a vista e le possibilità di rivederti mentre ti trovi nel territorio Gapilr sono molto scarse."

# game/episode024.rpy:504
translate italian ep024_hannah_65decd24:

    # ha "So for my own and our little one’s safety, I agreed for my body to be frozen."
    ha "Quindi, per la mia sicurezza e quella del nostro piccolo, ho accettato che il mio corpo fosse congelato."

# game/episode024.rpy:517
translate italian ep024_hannah_f8df78b0:

    # ha "It’s in my contract with the Tubloshi, as a mandatory security action, actually."
    ha "È nel mio contratto con i Tubloshi, come azione di sicurezza obbligatoria, a dire il vero."

# game/episode024.rpy:518
translate italian ep024_hannah_da7c2369:

    # ha "I’ve spent the past months in stasis, while the Tubloshi carried out their search-and-rescue mission."
    ha "Ho trascorso gli ultimi mesi in stasi, mentre i Tubloshi portavano avanti la loro missione di ricerca e salvataggio."

# game/episode024.rpy:519
translate italian ep024_hannah_e2480862:

    # c "So freezing you actually put the pregnancy on pause?"
    c "Quindi congelandoti hai effettivamente messo in pausa la gravidanza?"

# game/episode024.rpy:521
translate italian ep024_hannah_86fb188b:

    # ha "Yes, everything."
    ha "Sì, tutto."

# game/episode024.rpy:522
translate italian ep024_hannah_ce50a678:

    # ha "It’s perfectly safe, the Tubloshi do it all the time."
    ha "È perfettamente sicuro, i Tubloshi lo fanno sempre."

# game/episode024.rpy:523
translate italian ep024_hannah_256e0c02:

    # ha "It’s supposedly more efficient."
    ha "Presumibilmente è più efficiente."

# game/episode024.rpy:524
translate italian ep024_hannah_4ed3d0ba:

    # c "I guess it is."
    c "Immagino di sì."

# game/episode024.rpy:527
translate italian ep024_hannah_e3ec83b9:

    # ha "Why are you looking so serious?"
    ha "Perché sembri così serio?"

# game/episode024.rpy:528
translate italian ep024_hannah_7ba34e10:

    # ha "Aren’t you happy?"
    ha "Non sei felice?"

# game/episode024.rpy:529
translate italian ep024_hannah_38e1f176:

    # c "It’s a lot to take in."
    c "C'è molto da accettare."

# game/episode024.rpy:530
translate italian ep024_hannah_f91d67bb:

    # c "I’m not the same person as I was before."
    c "Non sono più la stessa persona di prima."

# game/episode024.rpy:531
translate italian ep024_hannah_d0bd0c85:

    # c "Things have changed."
    c "Le cose sono cambiate."

# game/episode024.rpy:533
translate italian ep024_hannah_6057836d:

    # ha "What are you telling me?"
    ha "Cosa mi stai dicendo?"

# game/episode024.rpy:534
translate italian ep024_hannah_8d6d9de1:

    # ha "Don’t you want the baby, is that it?"
    ha "Non vuoi il bambino, vero?"

# game/episode024.rpy:535
translate italian ep024_hannah_d471daf7:

    # ha "You don’t want to be a father?"
    ha "Non vuoi essere padre?"

# game/episode024.rpy:536
translate italian ep024_hannah_e375f746:

    # c "I will take my responsibility."
    c "Mi prenderò la mia responsabilità."

# game/episode024.rpy:537
translate italian ep024_hannah_be28edc7:

    # c "And I will make sure you get all the support you need."
    c "E mi assicurerò che tu riceva tutto il supporto di cui hai bisogno."

# game/episode024.rpy:538
translate italian ep024_hannah_50eb73a8:

    # c "But I can’t be in your life."
    c "Ma non posso essere nella tua vita."

# game/episode024.rpy:540
translate italian ep024_hannah_5ba92749:

    # ha "You had no qualms knocking me up, but you can’t be a fucking father?!"
    ha "Non hai avuto scrupoli a mettermi incinta, ma non puoi essere un fottuto padre?!"

# game/episode024.rpy:541
translate italian ep024_hannah_4267ee1c:

    # c "As I said, I’m not the same person I was before."
    c "Come ho detto, non sono più la stessa persona di prima."

# game/episode024.rpy:542
translate italian ep024_hannah_8ee46234:

    # c "I’ve made a promise to my girlfriend."
    c "Ho fatto una promessa alla mia ragazza."

# game/episode024.rpy:543
translate italian ep024_hannah_b989631b:

    # c "I can’t break that promise."
    c "Non posso infrangere quella promessa."

# game/episode024.rpy:545
translate italian ep024_hannah_b49bc1dd:

    # ha "How fucking noble of you."
    ha "Che maledettamente nobile da parte tua."

# game/episode024.rpy:546
translate italian ep024_hannah_fdeada21:

    # ha "You coward!"
    ha "Vigliacco!"

# game/episode024.rpy:547
translate italian ep024_hannah_39cf70fe:

    # ha "Get the fuck out of here!"
    ha "Vattene da qui, cazzo!"

# game/episode024.rpy:548
translate italian ep024_hannah_60a81581:

    # c "As I said, I will make sure you will be provided for."
    c "Come ho detto, mi assicurerò che ti venga fornito tutto."

# game/episode024.rpy:549
translate italian ep024_hannah_e287939e:

    # ha "I don’t care!"
    ha "Non mi interessa!"

# game/episode024.rpy:550
translate italian ep024_hannah_164e34a5:

    # ha "Get out!"
    ha "Uscire!"

# game/episode024.rpy:552
translate italian ep024_hannah_1e0dd8ad:

    # "I could hear Hannah crying as the door slid closed."
    "Potevo sentire Hannah piangere mentre la porta si chiudeva."

# game/episode024.rpy:555
translate italian ep024_hannah_0aa27963:

    # c "You look so beautiful though."
    c "Sei così bella però."

# game/episode024.rpy:557
translate italian ep024_hannah_037dc296:

    # ha "Thank you."
    ha "Grazie."

# game/episode024.rpy:558
translate italian ep024_hannah_5828f39e:

    # ha "I’m so happy to have found you again."
    ha "Sono così felice di averti ritrovato."

# game/episode024.rpy:560
translate italian ep024_hannah_28f4f7f9:

    # ha "I am, nothing much has changed to be honest."
    ha "Lo sono, non è cambiato molto a dire il vero."

# game/episode024.rpy:561
translate italian ep024_hannah_27f8ed19:

    # c "Well, I wish I could say the same."
    c "Ebbene, vorrei poter dire lo stesso."

# game/episode024.rpy:562
translate italian ep024_hannah_4211b7aa:

    # c "Quite a lot has happened since we last saw each other."
    c "Sono successe molte cose dall'ultima volta che ci siamo visti."

# game/episode024.rpy:564
translate italian ep024_hannah_d6c04b21:

    # "Hannah stepped in closer as I talked, until our bodies were nearly touching."
    "Hannah si avvicinò mentre parlavo, finché i nostri corpi quasi si toccarono."

# game/episode024.rpy:565
translate italian ep024_hannah_8c8080b9:

    # ha "I want to hear all about it."
    ha "Voglio sapere tutto."

# game/episode024.rpy:566
translate italian ep024_hannah_3f8cf74f:

    # ha "But there’s something I’d like to do first."
    ha "Ma c’è qualcosa che vorrei fare prima."

# game/episode024.rpy:567
translate italian ep024_hannah_59fe9738:

    # "She pawed at my shirt, but I had to take her hand and stop her."
    "Mi ha tastato la maglietta, ma ho dovuto prenderle la mano e fermarla."

# game/episode024.rpy:568
translate italian ep024_hannah_ea2b69e7:

    # c "I’m sorry, Hannah, but I can’t do this."
    c "Mi dispiace, Hannah, ma non posso farlo."

# game/episode024.rpy:570
translate italian ep024_hannah_16ea41d1:

    # ha "Why?"
    ha "Perché?"

# game/episode024.rpy:571
translate italian ep024_hannah_90ca8a0a:

    # c "As I said, a lot has happened."
    c "Come ho detto, sono successe molte cose."

# game/episode024.rpy:572
translate italian ep024_hannah_37cd9dfe:

    # c "I’ve made a promise to someone I love."
    c "Ho fatto una promessa a qualcuno che amo."

# game/episode024.rpy:573
translate italian ep024_hannah_8e166d61:

    # c "I don’t want to break that promise."
    c "Non voglio infrangere quella promessa."

# game/episode024.rpy:575
translate italian ep024_hannah_a027db01:

    # ha "How noble..."
    ha "Che nobile..."

# game/episode024.rpy:576
translate italian ep024_hannah_2389393d:

    # ha "Why did you come back to my room then?"
    ha "Perché sei tornato nella mia stanza allora?"

# game/episode024.rpy:577
translate italian ep024_hannah_d010545c:

    # c "I just wanted to talk, two friends catching up."
    c "Volevo solo parlare, due amici si stanno vedendo."

# game/episode024.rpy:579
translate italian ep024_hannah_ed880052:

    # ha "And I wanted to fuck."
    ha "E volevo scopare."

# game/episode024.rpy:580
translate italian ep024_hannah_cac1ede2:

    # ha "Guess we both won’t be getting our way."
    ha "Immagino che entrambi non otterremo ciò che vogliamo."

# game/episode024.rpy:581
translate italian ep024_hannah_ab0c4a93:

    # c "Hannah-"
    c "Hannah-"

# game/episode024.rpy:583
translate italian ep024_hannah_26c75057:

    # ha "Just go, [p_name]."
    ha "Vai e basta, [p_name]."

# game/episode024.rpy:585
translate italian ep024_hannah_be3fe603:

    # ha "I’d like to be alone."
    ha "Vorrei stare da solo."

# game/episode024.rpy:587
translate italian ep024_hannah_c2883965:

    # "I left Hannah and went back to Ziv and Aven to wait on the Tubloshi verdict."
    "Ho lasciato Hannah e sono tornato da Ziv e Aven per aspettare il verdetto di Tubloshi."

# game/episode024.rpy:591
translate italian ep024_hannah_e73494e2:

    # "As soon as we crossed the threshold, I spun Hannah around and kissed her."
    "Non appena abbiamo varcato la soglia, ho girato Hannah e l'ho baciata."

# game/episode024.rpy:592
translate italian ep024_hannah_d7aa6482:

    # c "I wanted to do that the moment I saw you."
    c "Volevo farlo nel momento in cui ti ho visto."

# game/episode024.rpy:594
translate italian ep024_hannah_c5a32e91:

    # ha "It’s been so long."
    ha "È passato così tanto tempo."

# game/episode024.rpy:596
translate italian ep024_hannah_27851ff7:

    # ha "How have you been?"
    ha "Come sei stato?"

# game/episode024.rpy:597
translate italian ep024_hannah_ae9e479d:

    # c "So much has happened since I last saw you."
    c "Sono successe così tante cose dall'ultima volta che ti ho visto."

# game/episode024.rpy:598
translate italian ep024_hannah_95708ff1:

    # c "I want to tell you all about it."
    c "Voglio raccontarti tutto."

# game/episode024.rpy:599
translate italian ep024_hannah_1fe2e969:

    # ha "I’d like to know everything about it."
    ha "Mi piacerebbe sapere tutto a riguardo."

# game/episode024.rpy:600
translate italian ep024_hannah_6a2d884e:

    # ha "And we’re not in a hurry, because the Tubloshi have just returned from a long campaign deep inside Gapilr territory."
    ha "E non abbiamo fretta, perché i Tubloshi sono appena tornati da una lunga campagna nel territorio di Gapilr."

# game/episode024.rpy:601
translate italian ep024_hannah_8fad738a:

    # ha "They need to do some necessary repairs and recuperate."
    ha "Hanno bisogno di fare alcune riparazioni necessarie e recuperare."

# game/episode024.rpy:603
translate italian ep024_hannah_ca39f3e6:

    # ha "We were there for so long, I thought I’d never see another human being again."
    ha "Siamo stati lì per così tanto tempo che pensavo che non avrei mai più rivisto un altro essere umano."

# game/episode024.rpy:605
translate italian ep024_hannah_1dbe00a5:

    # ha "And then your message came through."
    ha "E poi è arrivato il tuo messaggio."

# game/episode024.rpy:606
translate italian ep024_hannah_fdf07b2c:

    # ha "I’m so glad I found you again."
    ha "Sono così felice di averti ritrovato."

# game/episode024.rpy:607
translate italian ep024_hannah_e0224be1:

    # c "Me too."
    c "Anche io."

# game/episode024.rpy:608
translate italian ep024_hannah_4d12095d:

    # c "I want us to talk much more, but there’s also something else I’d like to do."
    c "Voglio che parliamo molto di più, ma c’è anche qualcos’altro che mi piacerebbe fare."

# game/episode024.rpy:609
translate italian ep024_hannah_9b2f95fe:

    # ha "Oh..."
    ha "Oh..."

# game/episode024.rpy:613
translate italian ep024_hannah_7f4b7dea:

    # c "I don’t want to leave you and the baby with the Tubloshi again."
    c "Non voglio lasciare di nuovo te e il bambino con i Tubloshi."

# game/episode024.rpy:616
translate italian ep024_hannah_4f46ca17:

    # c "I don’t want to leave you with the Tubloshi again."
    c "Non voglio lasciarti di nuovo con i Tubloshi."

# game/episode024.rpy:618
translate italian ep024_hannah_f240407e:

    # ha "You might not have to."
    ha "Potrebbe non essere necessario."

# game/episode024.rpy:619
translate italian ep024_hannah_54f26d64:

    # ha "The Sovereignty has been a thorn in the side for many people, the Tubloshi included."
    ha "La Sovranità è stata una spina nel fianco per molti, Tubloshi compresi."

# game/episode024.rpy:620
translate italian ep024_hannah_541f423e:

    # ha "And Kyl Zaghav hasn’t forgotten what you did, returning Kyl Tavort’s body."
    ha "E Kyl Zaghav non ha dimenticato quello che hai fatto, restituendo il corpo di Kyl Tavort."

# game/episode024.rpy:621
translate italian ep024_hannah_bb1fe40e:

    # ha "So I think your proposal will go over well with the rest of the warriors."
    ha "Quindi penso che la tua proposta piacerà al resto dei guerrieri."

# game/episode024.rpy:626
translate italian ep024_hannah_435ba5c2:

    # ha "I’m not sure what your plans are, but I guess we’ll be forming a fleet of some sort?"
    ha "Non sono sicuro di quali siano i tuoi piani, ma immagino che formeremo una flotta di qualche tipo?"

# game/episode024.rpy:627
translate italian ep024_hannah_0aeb7fea:

    # c "Yes, I think so, once the rest of the Tubloshi warships join us."
    c "Sì, penso di sì, una volta che il resto delle navi da guerra Tubloshi si unirà a noi."

# game/episode024.rpy:628
translate italian ep024_hannah_63b62949:

    # ha "In that case, it’s just a matter of taking a shuttle to the other ship when we want to meet."
    ha "In tal caso, è solo questione di prendere una navetta per l’altra nave quando vogliamo incontrarci."

# game/episode024.rpy:629
translate italian ep024_hannah_e0d4e590:

    # ha "I mean, we’ll have to coordinate a lot of things."
    ha "Voglio dire, dovremo coordinare molte cose."

# game/episode024.rpy:630
translate italian ep024_hannah_acf0af71:

    # c "Yes, coordination is key with these things."
    c "Sì, il coordinamento è fondamentale in queste cose."

# game/episode024.rpy:631
translate italian ep024_hannah_3ae20e73:

    # ha "We’ll coordinate the hell out of each other!"
    ha "Ci coordineremo a vicenda!"

# game/episode024.rpy:632
translate italian ep024_hannah_7727957c:

    # c "I can’t wait."
    c "Non vedo l'ora."

# game/episode024.rpy:635
translate italian ep024_hannah_dad47d1a:

    # "I kissed her again and rested my hand on the pregnant swell of her belly."
    "La baciai di nuovo e appoggiai la mano sul rigonfiamento gravido del suo ventre."

# game/episode024.rpy:638
translate italian ep024_hannah_d2c55b63:

    # "I kissed her again and rested my hand on the soft skin of her belly."
    "La baciai di nuovo e appoggiai la mano sulla morbida pelle del suo ventre."

# game/episode024.rpy:651
translate italian ep024_uailea_87716c3d:

    # "Our arrival on Uailea went about the same way as it did months ago."
    "Il nostro arrivo a Uailea si è svolto più o meno nello stesso modo di mesi fa."

# game/episode024.rpy:652
translate italian ep024_uailea_0125436f:

    # "The Tubloshi fleet hadn’t followed us to the Rhenkoy homeworld, as the presence of a foreign armada might be misinterpreted as a prelude to violence."
    "La flotta Tubloshi non ci aveva seguito sul pianeta natale dei Rhenkoy, poiché la presenza di un'armata straniera avrebbe potuto essere interpretata erroneamente come un preludio alla violenza."

# game/episode024.rpy:654
translate italian ep024_uailea_09fe12c1:

    # "After we were assigned a place in the docks, the same apartment we stayed in last time was offered to us."
    "Dopo che ci è stato assegnato un posto nel porto, ci è stato offerto lo stesso appartamento in cui abbiamo alloggiato l'ultima volta."

# game/episode024.rpy:656
translate italian ep024_uailea_13b298c2:

    # "Ziv reached out to the Council of Nkoy to kickstart the Rhenkoy bureaucracy and then the waiting began."
    "Ziv si è rivolto al Consiglio di Nkoy per rilanciare la burocrazia di Rhenkoy e poi è iniziata l'attesa."

# game/episode024.rpy:659
translate italian ep024_uailea_90feca06:

    # "The Rhenkoy capital looked quite different when we went out for a stroll."
    "La capitale Rhenkoy sembrava molto diversa quando uscivamo per una passeggiata."

# game/episode024.rpy:660
translate italian ep024_uailea_506af255:

    # "Several construction crews were busy working on buildings and fixing up public spaces."
    "Diverse squadre di costruzione erano impegnate a lavorare sugli edifici e a sistemare gli spazi pubblici."

# game/episode024.rpy:661
translate italian ep024_uailea_4d2fc95b:

    # c "Looks like the capital is one big construction pit."
    c "Sembra che la capitale sia un grande cantiere edile."

# game/episode024.rpy:663
translate italian ep024_uailea_5316d325:

    # zi "Yes, the Council finally approved a lot of overdue maintenance."
    zi "Sì, il Consiglio ha finalmente approvato molti dei lavori di manutenzione scaduti."

# game/episode024.rpy:664
translate italian ep024_uailea_b31c45bb:

    # zi "People have been complaining for years, but the Nkoy finally voted in favor after being deadlocked for so long."
    zi "La gente si lamenta da anni, ma alla fine l'Nkoy ha votato a favore dopo essere rimasto bloccato per così tanto tempo."

# game/episode024.rpy:665
translate italian ep024_uailea_e2ea2432:

    # c "Nkoy Rhedia broke that deadlock?"
    c "Nkoy Rhedia ha risolto il problema?"

# game/episode024.rpy:666
translate italian ep024_uailea_7cdc14bd:

    # zi "I think so, yes."
    zi "Penso di sì, sì."

# game/episode024.rpy:667
translate italian ep024_uailea_f5c46100:

    # c "I hope they’re not too busy to handle our request for help, in that case."
    c "Spero che non siano troppo occupati per gestire la nostra richiesta di aiuto, in questo caso."

# game/episode024.rpy:668
translate italian ep024_uailea_bd7a4bb1:

    # zi "I’m sure they’re not too busy for something like that."
    zi "Sono sicuro che non sono troppo occupati per una cosa del genere."

# game/episode024.rpy:671
translate italian ep024_uailea_b4d13737:

    # "The Rhenkoy capital didn’t look much different when we went out for a stroll, but the atmosphere had decidedly changed."
    "La capitale Rhenkoy non sembrava molto diversa quando uscivamo per una passeggiata, ma l’atmosfera era decisamente cambiata."

# game/episode024.rpy:672
translate italian ep024_uailea_31aa43a2:

    # "There was a large police presence throughout the city and several buildings were under permanent guard."
    "C'era una grande presenza di polizia in tutta la città e diversi edifici erano sotto sorveglianza permanente."

# game/episode024.rpy:674
translate italian ep024_uailea_a847c7d5:

    # "Most Rhenkoy hurried through the streets, as if they wanted to reach their destination with as little exposure to the outside as possible."
    "La maggior parte dei Rhenkoy si affrettava per le strade, come se volessero raggiungere la loro destinazione con la minor esposizione possibile all'esterno."

# game/episode024.rpy:675
translate italian ep024_uailea_18d629d3:

    # c "Is it me, or does everybody seem rather tense?"
    c "Sono io, o sembrano tutti piuttosto tesi?"

# game/episode024.rpy:677
translate italian ep024_uailea_95ef5465:

    # zi "Yes, I’ve noticed it too."
    zi "Sì, l'ho notato anch'io."

# game/episode024.rpy:678
translate italian ep024_uailea_3951d108:

    # zi "Apparently, the Council is afraid of terrorist attacks on government buildings."
    zi "A quanto pare, il Consiglio teme attacchi terroristici contro edifici governativi."

# game/episode024.rpy:680
translate italian ep024_uailea_c2d5fa07:

    # zi "Nkoy Arlya is under heavy guard as well."
    zi "Anche Nkoy Arlya è sotto stretta sorveglianza."

# game/episode024.rpy:681
translate italian ep024_uailea_1ca0f881:

    # c "Have there been incidents?"
    c "Ci sono stati incidenti?"

# game/episode024.rpy:682
translate italian ep024_uailea_adbd7b61:

    # c "I thought locking up Nkoy Rhedia would have nipped any resistance in the bud."
    c "Pensavo che rinchiudere Nkoy Rhedia avrebbe stroncato ogni resistenza sul nascere."

# game/episode024.rpy:684
translate italian ep024_uailea_4e3288cf:

    # zi "Yes, there are no credible challengers to the Council’s power at the moment, and there haven’t been any incidents."
    zi "Sì, al momento non ci sono sfidanti credibili al potere del Consiglio e non si sono verificati incidenti."

# game/episode024.rpy:685
translate italian ep024_uailea_4f557c2f:

    # c "So, either the police are doing a very good job preventing any attacks, or the Council is using the supposed threat as a pretext to tighten their grip."
    c "Quindi, o la polizia sta facendo un ottimo lavoro nel prevenire eventuali attacchi, oppure il Consiglio sta usando la presunta minaccia come pretesto per rafforzare la presa."

# game/episode024.rpy:687
translate italian ep024_uailea_1fd9c02d:

    # zi "Textbook fear-mongering, I’d say."
    zi "Allarmismo da manuale, direi."

# game/episode024.rpy:688
translate italian ep024_uailea_9f85b645:

    # c "Yeah."
    c "Sì."

# game/episode024.rpy:689
translate italian ep024_uailea_1fe28837:

    # c "It also doesn’t help our chances of getting help from the Council."
    c "Inoltre, non migliora le nostre possibilità di ottenere aiuto dal Consiglio."

# game/episode024.rpy:690
translate italian ep024_uailea_58f5b829:

    # zi "I worry about that too."
    zi "Mi preoccupo anche di questo."

# game/episode024.rpy:692
translate italian ep024_uailea_70f464a7:

    # zi "I’ll file our request at the Council, and I hope we’ll have an answer in a few days."
    zi "Presenterò la nostra richiesta al Consiglio e spero che avremo una risposta entro pochi giorni."

# game/episode024.rpy:693
translate italian ep024_uailea_517b2470:

    # "Considering the amount of time the Council kept us waiting when we were on Uailea previously, we prepared ourselves for another long wait."
    "Considerando il tempo che il Consiglio ci ha fatto aspettare quando eravamo precedentemente su Uailea, ci siamo preparati per un'altra lunga attesa."

# game/episode024.rpy:694
translate italian ep024_uailea_a6c2add9:

    # "I decided on using the apartment as my base of operations and slept there for several nights as the Council supposedly deliberated about our request."
    "Ho deciso di utilizzare l'appartamento come base operativa e ho dormito lì per diverse notti mentre il Consiglio presumibilmente deliberava sulla nostra richiesta."

# game/episode024.rpy:701
translate italian ep024_uailea_rhedia_eaafebec:

    # "Nkoy Rhedia surprised me with a visit before the Council even responded formally to our request."
    "Nkoy Rhedia mi ha sorpreso con una visita prima ancora che il Consiglio rispondesse formalmente alla nostra richiesta."

# game/episode024.rpy:702
translate italian ep024_uailea_rhedia_41f44719:

    # rh "Good day, [p_name]."
    rh "Buongiorno, [p_name]."

# game/episode024.rpy:703
translate italian ep024_uailea_rhedia_2a50a53f:

    # rh "I hope your stay with us is to your liking so far?"
    rh "Spero che il tuo soggiorno con noi sia stato di tuo gradimento finora?"

# game/episode024.rpy:704
translate italian ep024_uailea_rhedia_fee8c54c:

    # c "It is, thank you."
    c "Lo è, grazie."

# game/episode024.rpy:706
translate italian ep024_uailea_rhedia_7967e074:

    # rh "I didn’t expect you back so soon."
    rh "Non mi aspettavo che tornassi così presto."

# game/episode024.rpy:707
translate italian ep024_uailea_rhedia_b3d8af51:

    # c "We weren’t planning on returning here again, but circumstances have changed."
    c "Non avevamo intenzione di tornare di nuovo qui, ma le circostanze sono cambiate."

# game/episode024.rpy:708
translate italian ep024_uailea_rhedia_2e411744:

    # rh "Yes, your petition mentioned as much."
    rh "Sì, la tua petizione lo menzionava."

# game/episode024.rpy:709
translate italian ep024_uailea_rhedia_f6dabdde:

    # rh "We will talk more of this during the Council session."
    rh "Ne parleremo più approfonditamente durante la sessione del Consiglio."

# game/episode024.rpy:710
translate italian ep024_uailea_rhedia_af89e6ef:

    # rh "A session is planned very soon, and I’m sorry for the long wait, but we are very busy shaping the future of Uailea."
    rh "Una sessione è prevista molto presto e mi dispiace per la lunga attesa, ma siamo molto impegnati a dare forma al futuro di Uailea."

# game/episode024.rpy:711
translate italian ep024_uailea_rhedia_55cee9e4:

    # c "So I have noticed."
    c "Quindi ho notato."

# game/episode024.rpy:712
translate italian ep024_uailea_rhedia_45b54f81:

    # c "I take it the construction works in the capital are a planet-wide effort?"
    c "Immagino che i lavori di costruzione nella capitale siano uno sforzo planetario?"

# game/episode024.rpy:714
translate italian ep024_uailea_rhedia_b3ed784c:

    # rh "Very much so, and those public works are only the most visible part of what we’re trying to achieve."
    rh "Moltissimo, e quelle opere pubbliche sono solo la parte più visibile di ciò che stiamo cercando di realizzare."

# game/episode024.rpy:715
translate italian ep024_uailea_rhedia_6bf8307e:

    # rh "Arlya and her faction’s influence has had a devastating effect on the Rhenkoy, and we are only now beginning to fix some of it."
    rh "L’influenza di Arlya e della sua fazione ha avuto un effetto devastante sui Rhenkoy e solo ora stiamo iniziando a risolverne alcuni."

# game/episode024.rpy:716
translate italian ep024_uailea_rhedia_2a305044:

    # c "I’m glad to hear it."
    c "Sono felice di sentirlo."

# game/episode024.rpy:717
translate italian ep024_uailea_rhedia_f721d406:

    # rh "And I am glad you allowed me the opportunity to do so."
    rh "E sono felice che tu mi abbia dato l'opportunità di farlo."

# game/episode024.rpy:718
translate italian ep024_uailea_rhedia_86047b2e:

    # rh "Helping the alliance you seek to create very much aligns with the Council’s vision for the Rhenkoy."
    rh "Aiutare l’alleanza che cerchi di creare è in linea con la visione del Consiglio per i Rhenkoy."

# game/episode024.rpy:720
translate italian ep024_uailea_rhedia_bf7d0256:

    # rh "We have been getting requests for aid from other worlds that are already threatened by the Sovereignty."
    rh "Stiamo ricevendo richieste di aiuto da altri mondi che sono già minacciati dalla Sovranità."

# game/episode024.rpy:721
translate italian ep024_uailea_rhedia_af5282bb:

    # rh "Allying ourselves with you would enable us to provide the help those worlds desperately seek."
    rh "Allearci con te ci consentirebbe di fornire l’aiuto che quei mondi cercano disperatamente."

# game/episode024.rpy:722
translate italian ep024_uailea_rhedia_6a309441:

    # c "I very much hope the other members of the Council can be persuaded."
    c "Spero vivamente che gli altri membri del Consiglio possano essere persuasi."

# game/episode024.rpy:723
translate italian ep024_uailea_rhedia_007e6f49:

    # rh "So do I."
    rh "Anch'io."

# game/episode024.rpy:724
translate italian ep024_uailea_rhedia_e48fb42e:

    # c "Does Arlya still have some sway over the public opinion?"
    c "Arlya ha ancora una certa influenza sull’opinione pubblica?"

# game/episode024.rpy:726
translate italian ep024_uailea_rhedia_8bb7ac46:

    # rh "Some, but not as much as before."
    rh "Alcuni, ma non così tanti come prima."

# game/episode024.rpy:728
translate italian ep024_uailea_rhedia_7bda230e:

    # rh "She has been tried and sentenced during your absence and is currently being held in a prison facility."
    rh "È stata processata e condannata durante la tua assenza ed è attualmente detenuta in una struttura carceraria."

# game/episode024.rpy:730
translate italian ep024_uailea_rhedia_15f26050:

    # rh "She’s not allowed to communicate with the outside world, but her followers sometimes succeed in smuggling her writings out of the prison."
    rh "Non le è permesso comunicare con il mondo esterno, ma i suoi seguaci a volte riescono a far uscire di nascosto i suoi scritti dalla prigione."

# game/episode024.rpy:731
translate italian ep024_uailea_rhedia_eb0a06c9:

    # rh "On the other hand, more and more information about the corruption of the Council of Nkoy and Arlya’s role in it is coming to light."
    rh "D’altro canto, vengono alla luce sempre più informazioni sulla corruzione del Consiglio di Nkoy e sul ruolo di Arlya al suo interno."

# game/episode024.rpy:733
translate italian ep024_uailea_rhedia_bed52dc3:

    # rh "So her follower numbers are slowly, but surely dwindling."
    rh "Quindi il numero dei suoi follower sta lentamente, ma sicuramente diminuendo."

# game/episode024.rpy:734
translate italian ep024_uailea_rhedia_b9aa15aa:

    # c "I’m happy to hear that."
    c "Sono felice di saperlo."

# game/episode024.rpy:735
translate italian ep024_uailea_rhedia_79702fd2:

    # rh "I have another meeting planned, so I have to leave you now."
    rh "Ho un altro incontro in programma, quindi devo lasciarti adesso."

# game/episode024.rpy:737
translate italian ep024_uailea_rhedia_037e2ea4:

    # rh "I just wanted you to know that the Council will process your petition very soon."
    rh "Volevo solo dirti che il Consiglio esaminerà la tua petizione molto presto."

# game/episode024.rpy:738
translate italian ep024_uailea_rhedia_c0f363fd:

    # c "Thank you very much, and I hope to see you soon."
    c "Grazie mille e spero di vedervi presto."

# game/episode024.rpy:739
translate italian ep024_uailea_rhedia_88fb1e09:

    # "Rhedia left the apartment and I began to feel more hopeful than before we set foot on Uailea."
    "Rhedia lasciò l'appartamento e cominciai a sentirmi più fiducioso di prima di mettere piede a Uailea."

# game/episode024.rpy:746
translate italian ep024_uailea_arlya_017e8cd7:

    # "Nkoy Arlya surprised me with a visit before the Council even responded formally to our request."
    "Nkoy Arlya mi ha sorpreso con una visita prima ancora che il Consiglio rispondesse formalmente alla nostra richiesta."

# game/episode024.rpy:747
translate italian ep024_uailea_arlya_2c7f61ee:

    # c "Nkoy Arlya, what a pleasant surprise."
    c "Nkoy Arlya, che piacevole sorpresa."

# game/episode024.rpy:749
translate italian ep024_uailea_arlya_381fcd7d:

    # arl "Good day, [p_name]."
    arl "Buongiorno, [p_name]."

# game/episode024.rpy:750
translate italian ep024_uailea_arlya_4de43917:

    # arl "I didn’t expect to see you again."
    arl "Non mi aspettavo di rivederti."

# game/episode024.rpy:751
translate italian ep024_uailea_arlya_b3d8af51:

    # c "We weren’t planning on returning here again, but circumstances have changed."
    c "Non avevamo intenzione di tornare di nuovo qui, ma le circostanze sono cambiate."

# game/episode024.rpy:752
translate italian ep024_uailea_arlya_685023d8:

    # arl "So I’ve read in your petition."
    arl "Così ho letto nella tua petizione."

# game/episode024.rpy:753
translate italian ep024_uailea_arlya_6e42ee1b:

    # c "Has the Council decided yet?"
    c "Il Consiglio ha già deciso?"

# game/episode024.rpy:755
translate italian ep024_uailea_arlya_d4d75c7c:

    # arl "Not yet, I haven’t come in an official capacity."
    arl "Non ancora, non sono venuto in veste ufficiale."

# game/episode024.rpy:756
translate italian ep024_uailea_arlya_89aefe22:

    # c "I see."
    c "Vedo."

# game/episode024.rpy:758
translate italian ep024_uailea_arlya_534ebdf4:

    # arl "I’ll come right to the point."
    arl "Verrò dritto al punto."

# game/episode024.rpy:759
translate italian ep024_uailea_arlya_6ffac024:

    # arl "As you know, I have a lot of sway with the Council."
    arl "Come sapete, ho molta influenza sul Consiglio."

# game/episode024.rpy:760
translate italian ep024_uailea_arlya_70379705:

    # arl "There is no question that my vote will decide whether the Council views your petition favorably or denies it."
    arl "Non c'è dubbio che il mio voto deciderà se il Consiglio considererà favorevolmente la vostra petizione o se la respingerà."

# game/episode024.rpy:761
translate italian ep024_uailea_arlya_6e0e3cff:

    # c "An appeal to your sense of moral obligation is probably not enough?"
    c "Un appello al tuo senso di obbligo morale probabilmente non è sufficiente?"

# game/episode024.rpy:763
translate italian ep024_uailea_arlya_fa424a59:

    # arl "I have a very keen moral sense, but this is also a business transaction."
    arl "Ho un senso morale molto acuto, ma questa è anche una transazione d'affari."

# game/episode024.rpy:764
translate italian ep024_uailea_arlya_20280865:

    # arl "You require the diplomatic prowess of the Rhenkoy to garner allies and support."
    arl "Hai bisogno dell'abilità diplomatica dei Rhenkoy per ottenere alleati e sostegno."

# game/episode024.rpy:765
translate italian ep024_uailea_arlya_88e062c9:

    # arl "Without our diplomatic efforts, your initiative will surely fail."
    arl "Senza i nostri sforzi diplomatici, la vostra iniziativa sicuramente fallirà."

# game/episode024.rpy:766
translate italian ep024_uailea_arlya_fd27da06:

    # c "I wouldn’t go that far."
    c "Non andrei così lontano."

# game/episode024.rpy:767
translate italian ep024_uailea_arlya_36e6b775:

    # c "We’d struggle for sure, I’ll admit that much."
    c "Faremmo sicuramente fatica, lo ammetto."

# game/episode024.rpy:768
translate italian ep024_uailea_arlya_06751024:

    # c "But you mentioned a business transaction, so I assume there’s something you want in return for influencing the Council?"
    c "Ma hai menzionato una transazione d'affari, quindi presumo che tu voglia qualcosa in cambio dell'influenza del Consiglio?"

# game/episode024.rpy:770
translate italian ep024_uailea_arlya_b8110d8d:

    # arl "Yes, I want a seat at the table during the entire process and afterward."
    arl "Sì, voglio un posto al tavolo durante l'intero processo e anche dopo."

# game/episode024.rpy:771
translate italian ep024_uailea_arlya_9f158aac:

    # arl "I assume you want to build some power structure to replace the Sovereignty, and I want a high position within that structure."
    arl "Presumo che tu voglia costruire una struttura di potere per sostituire la Sovranità, e io voglio una posizione elevata all'interno di quella struttura."

# game/episode024.rpy:772
translate italian ep024_uailea_arlya_9550fc22:

    # arl "Furthermore, I want a sizeable cut from the spoils of war."
    arl "Inoltre, voglio una quota considerevole del bottino di guerra."

# game/episode024.rpy:776
translate italian ep024_uailea_arlya_2e7d94f6:

    # c "I’m sure we can come to an arrangement."
    c "Sono sicuro che possiamo raggiungere un accordo."

# game/episode024.rpy:778
translate italian ep024_uailea_arlya_7ff9d097:

    # arl "I’m happy to hear that."
    arl "Sono felice di saperlo."

# game/episode024.rpy:780
translate italian ep024_uailea_arlya_f4ffab66:

    # arl "I want this in writing, of course, so I’ll draw up the necessary paperwork."
    arl "Lo voglio per iscritto, ovviamente, quindi preparerò la documentazione necessaria."

# game/episode024.rpy:781
translate italian ep024_uailea_arlya_011ea9f8:

    # arl "Our agreement will be witnessed and filed with the League of Dipoturn to ensure it’s legally binding and that the Council will be none the wiser."
    arl "Il nostro accordo sarà testimoniato e archiviato presso la Lega di Dipoturn per garantire che sia giuridicamente vincolante e che il Consiglio non ne venga a conoscenza."

# game/episode024.rpy:782
translate italian ep024_uailea_arlya_950daf31:

    # c "You have it all planned out."
    c "Hai pianificato tutto."

# game/episode024.rpy:784
translate italian ep024_uailea_arlya_8b0c8f38:

    # arl "I didn’t come this far without any planning."
    arl "Non sono arrivato fin qui senza alcuna pianificazione."

# game/episode024.rpy:785
translate italian ep024_uailea_arlya_91b5b150:

    # arl "A pleasure doing business, and I’m sure the Council will be sympathetic to your request."
    arl "È un piacere fare affari e sono sicuro che il Consiglio sarà comprensivo della tua richiesta."

# game/episode024.rpy:788
translate italian ep024_uailea_arlya_12724fac:

    # c "It’s all about power for you, isn’t it?"
    c "Per te è tutta una questione di potere, non è vero?"

# game/episode024.rpy:789
translate italian ep024_uailea_arlya_66b0fab7:

    # c "I’ll take my chances with the Council."
    c "Correrò il rischio con il Consiglio."

# game/episode024.rpy:791
translate italian ep024_uailea_arlya_3e8ff3ca:

    # arl "They’ll refuse."
    arl "Si rifiuteranno."

# game/episode024.rpy:792
translate italian ep024_uailea_arlya_4b50af49:

    # c "Maybe, but when the Sovereignty overruns your planet, you’ll die in the knowledge that you could have done something to prevent it."
    c "Forse, ma quando la Sovranità invaderà il tuo pianeta, morirai sapendo che avresti potuto fare qualcosa per impedirlo."

# game/episode024.rpy:794
translate italian ep024_uailea_arlya_e97724d8:

    # arl "You have a lot to learn if you want to play the political game."
    arl "Hai molto da imparare se vuoi partecipare al gioco politico."

# game/episode024.rpy:795
translate italian ep024_uailea_arlya_9e2fa476:

    # c "I have no interest in playing games."
    c "Non ho interesse a giocare."

# game/episode024.rpy:796
translate italian ep024_uailea_arlya_876e637c:

    # arl "That’s very clear."
    arl "Questo è molto chiaro."

# game/episode024.rpy:797
translate italian ep024_uailea_arlya_381fcd7d_1:

    # arl "Good day, [p_name]."
    arl "Buongiorno, [p_name]."

# game/episode024.rpy:798
translate italian ep024_uailea_arlya_b98da319:

    # arl "You’ll learn of the Council’s decision and the consequences of your mistake very soon."
    arl "Imparerai molto presto la decisione del Consiglio e le conseguenze del tuo errore."

# game/episode024.rpy:805
translate italian ep024_uailea_arlya_bribe_7585636e:

    # "A few days after Arlya’s visit, an android presented itself at the door of the apartment."
    "Pochi giorni dopo la visita di Arlya, un androide si è presentato alla porta dell’appartamento."

# game/episode024.rpy:807
translate italian ep024_uailea_arlya_bribe_aee68192:

    # man "[p_name] Valenmann de Lonval?"
    man "[p_name] Valenmann de Lonval?"

# game/episode024.rpy:808
translate italian ep024_uailea_arlya_bribe_24c7ada5:

    # c "Yes?"
    c "SÌ?"

# game/episode024.rpy:809
translate italian ep024_uailea_arlya_bribe_a3111de9:

    # man "May I please come in?"
    man "Posso entrare, per favore?"

# game/episode024.rpy:810
translate italian ep024_uailea_arlya_bribe_a3171955:

    # man "We have matters to discuss."
    man "Abbiamo delle questioni da discutere."

# game/episode024.rpy:811
translate italian ep024_uailea_arlya_bribe_7b7a5678:

    # c "Yes, of course."
    c "Sì, naturalmente."

# game/episode024.rpy:813
translate italian ep024_uailea_arlya_bribe_0307612a:

    # man "Nkoy Arlya has prepared some documents for you to sign."
    man "Nkoy Arlya ha preparato alcuni documenti da firmare."

# game/episode024.rpy:814
translate italian ep024_uailea_arlya_bribe_eb3452d0:

    # man "I will witness the signing and a copy of the document, and the recording will be stored in the Vault of Dipoturn."
    man "Farò da testimone alla firma e ad una copia del documento, e la registrazione sarà conservata nel Caveau di Dipoturn."

# game/episode024.rpy:815
translate italian ep024_uailea_arlya_bribe_90897e30:

    # man "By signing these documents, you agree to be bound by the terms listed inside."
    man "Firmando questi documenti, accetti di essere vincolato dai termini elencati al loro interno."

# game/episode024.rpy:816
translate italian ep024_uailea_arlya_bribe_24f2842b:

    # man "Failure to honor the terms of the agreement will result in disciplinary action courtesy of the League of Dipoturn and any associates."
    man "Il mancato rispetto dei termini dell'accordo comporterà un provvedimento disciplinare da parte della Lega di Dipoturn e degli eventuali associati."

# game/episode024.rpy:831
translate italian ep024_uailea_arlya_bribe_d0b4789f:

    # c "Alright, just tell me where."
    c "Va bene, dimmi solo dove."

# game/episode024.rpy:832
translate italian ep024_uailea_arlya_bribe_3e65e1a8:

    # man "Please press your finger on the tab."
    man "Per favore premi il dito sulla linguetta."

# game/episode024.rpy:833
translate italian ep024_uailea_arlya_bribe_6f263c98:

    # man "Thank you."
    man "Grazie."

# game/episode024.rpy:834
translate italian ep024_uailea_arlya_bribe_450d23ff:

    # c "That’s it?"
    c "Questo è tutto?"

# game/episode024.rpy:835
translate italian ep024_uailea_arlya_bribe_75c6be5b:

    # man "Yes, a video recording of this exchange has been made, and the document has been sent to the Vault of Dipoturn via a secure connection."
    man "Sì, è stata effettuata una registrazione video di questo scambio e il documento è stato inviato al Vault di Dipoturn tramite una connessione protetta."

# game/episode024.rpy:836
translate italian ep024_uailea_arlya_bribe_a20285ac:

    # man "Thank you for your cooperation."
    man "Grazie per la collaborazione."

# game/episode024.rpy:837
translate italian ep024_uailea_arlya_bribe_359e3689:

    # man "Have a nice day."
    man "Buona giornata."

# game/episode024.rpy:839
translate italian ep024_uailea_arlya_bribe_a754028c:

    # "The android left me, and I was alone again."
    "L'androide mi lasciò e rimasi di nuovo solo."

# game/episode024.rpy:840
translate italian ep024_uailea_arlya_bribe_53f02089:

    # "Signing those documents didn’t feel right, but it was necessary."
    "Firmare quei documenti non mi sembrava giusto, ma era necessario."

# game/episode024.rpy:843
translate italian ep024_uailea_arlya_bribe_2cb8356a:

    # c "I’ve changed my mind, I’m not signing."
    c "Ho cambiato idea, non firmo."

# game/episode024.rpy:844
translate italian ep024_uailea_arlya_bribe_6241c132:

    # man "That’s a shame, sir."
    man "È un peccato, signore."

# game/episode024.rpy:845
translate italian ep024_uailea_arlya_bribe_87cf6fd9:

    # man "Are you absolutely certain?"
    man "Ne sei assolutamente certo?"

# game/episode024.rpy:846
translate italian ep024_uailea_arlya_bribe_36391c9b:

    # c "Yes, I am."
    c "Sì, io sono."

# game/episode024.rpy:847
translate italian ep024_uailea_arlya_bribe_9a89c0ea:

    # man "Very good."
    man "Molto bene."

# game/episode024.rpy:848
translate italian ep024_uailea_arlya_bribe_13342d72:

    # man "As you have not signed any of the documents, there is no binding legal contract and the League of Dipoturn will not enforce any punitive actions."
    man "Non avendo firmato nessuno dei documenti, non esiste alcun contratto legale vincolante e la Lega di Dipoturn non applicherà alcuna azione sanzionatoria."

# game/episode024.rpy:849
translate italian ep024_uailea_arlya_bribe_464e9811:

    # man "The other signatory will be informed of your decision and the relevant documents will be destroyed."
    man "L'altro firmatario verrà informato della tua decisione e i relativi documenti verranno distrutti."

# game/episode024.rpy:850
translate italian ep024_uailea_arlya_bribe_359e3689_1:

    # man "Have a nice day."
    man "Buona giornata."

# game/episode024.rpy:852
translate italian ep024_uailea_arlya_bribe_dfd24b29:

    # "The android left me and I was alone again, a sinking feeling permeating, despite having done the right thing."
    "L'androide mi lasciò e rimasi di nuovo solo, permeato da una sensazione di smarrimento, nonostante avessi fatto la cosa giusta."

# game/episode024.rpy:860
translate italian ep024_uailea_council_8da9ace5:

    # "A couple of days after Rhedia’s visit, the Council invited us to join them."
    "Un paio di giorni dopo la visita di Rhedia, il Consiglio ci ha invitato ad unirci a loro."

# game/episode024.rpy:861
translate italian ep024_uailea_council_a0573492:

    # "Ziv, Nadya and I were led to the Council chambers."
    "Ziv, Nadya e io fummo condotti nelle camere del Consiglio."

# game/episode024.rpy:862
translate italian ep024_uailea_council_0ad24223:

    # "The Nkoy’s were already there, Rhedia presiding as the head of the Council."
    "Gli Nkoy erano già lì, Rhedia presiedeva come capo del Consiglio."

# game/episode024.rpy:864
translate italian ep024_uailea_council_af192209:

    # rh "Welcome, [p_name], Ziv and Nadya."
    rh "Benvenuti, [p_name], Ziv e Nadya."

# game/episode024.rpy:865
translate italian ep024_uailea_council_73d0143d:

    # rh "The Council is now in session and will now respond to your petition."
    rh "Il Consiglio è ora in sessione e ora risponderà alla tua petizione."

# game/episode024.rpy:866
translate italian ep024_uailea_council_330e1759:

    # rh "On the matter of providing diplomatic services to a Coalition against the aggression of the Sovereignty, the Council has reached a verdict."
    rh "Sulla questione della fornitura di servizi diplomatici ad una coalizione contro l'aggressione alla Sovranità, il Consiglio ha emesso un verdetto."

# game/episode024.rpy:868
translate italian ep024_uailea_council_944f9e24:

    # rh "The Rhenkoy will provide diplomatic assistance as outlined in your petition."
    rh "La Rhenkoy fornirà assistenza diplomatica come indicato nella tua petizione."

# game/episode024.rpy:869
translate italian ep024_uailea_council_302086bf:

    # rh "We will work closely together with you as we begin our outreach to other potential allies."
    rh "Lavoreremo a stretto contatto con voi mentre iniziamo a raggiungere altri potenziali alleati."

# game/episode024.rpy:870
translate italian ep024_uailea_council_b3585248:

    # rh "Your petition also mentioned the Tubloshi and their military strength."
    rh "La tua petizione menziona anche i Tubloshi e la loro forza militare."

# game/episode024.rpy:872
translate italian ep024_uailea_council_25a9e27e:

    # rh "Their battle prowess may provide a powerful incentive for others to join the fight, but we will of course explore other avenues as well."
    rh "La loro abilità in battaglia può fornire un potente incentivo affinché altri si uniscano alla lotta, ma ovviamente esploreremo anche altre strade."

# game/episode024.rpy:873
translate italian ep024_uailea_council_2d133a37:

    # rh "With your permission, we will appoint a liaison, who will act as our eyes and ears."
    rh "Con il tuo permesso, nomineremo un collegamento, che fungerà da nostri occhi e orecchie."

# game/episode024.rpy:874
translate italian ep024_uailea_council_51f3ac73:

    # rh "They will forward any request you have to us and will keep you up to date with our own progress."
    rh "Ci inoltreranno qualsiasi richiesta tu abbia e ti terranno aggiornato sui nostri progressi."

# game/episode024.rpy:875
translate italian ep024_uailea_council_2833e7f2:

    # rh "A contingent of mediators is on its way from Soniriey and will join the pool of diplomats already present here in the capital."
    rh "Un contingente di mediatori è in arrivo da Soniriey e si aggiungerà al pool di diplomatici già presenti qui nella capitale."

# game/episode024.rpy:876
translate italian ep024_uailea_council_13a85f7b:

    # rh "As soon as the last group has arrived they will be ready to depart."
    rh "Appena sarà arrivato l'ultimo gruppo saranno pronti a partire."

# game/episode024.rpy:877
translate italian ep024_uailea_council_60ee7fbb:

    # rh "A diplomatic greatship, containing several diplomatic shuttles, is being prepared for travel and will join your fleet."
    rh "Una grande nave diplomatica, contenente diverse navette diplomatiche, è in fase di preparazione per il viaggio e si unirà alla tua flotta."

# game/episode024.rpy:878
translate italian ep024_uailea_council_19eec105:

    # c "Thank you very much."
    c "Grazie mille."

# game/episode024.rpy:879
translate italian ep024_uailea_council_783e2571:

    # c "We look forward to working together."
    c "Non vediamo l'ora di lavorare insieme."

# game/episode024.rpy:880
translate italian ep024_uailea_council_f8108235:

    # c "Together we will build the largest and most powerful alliance ever known."
    c "Insieme costruiremo l’alleanza più grande e potente mai conosciuta."

# game/episode024.rpy:882
translate italian ep024_uailea_council_55cc7e5f:

    # rh "The Rhenkoy are honored to be part of this effort."
    rh "I Rhenkoy sono onorati di far parte di questo sforzo."

# game/episode024.rpy:883
translate italian ep024_uailea_council_ecbb56aa:

    # rh "This Council session is now adjourned."
    rh "La sessione del Consiglio è ora aggiornata."

# game/episode024.rpy:885
translate italian ep024_uailea_council_588712c7:

    # "The Nkoy got up and left, leaving the three of us to process this news."
    "L'Nkoy si alzò e se ne andò, lasciando noi tre a elaborare la notizia."

# game/episode024.rpy:887
translate italian ep024_uailea_council_fb444bdc:

    # na "Well, it seems like we did it."
    na "Beh, sembra che ce l'abbiamo fatta."

# game/episode024.rpy:888
translate italian ep024_uailea_council_68b6cf4f:

    # c "Yes, it seems we did."
    c "Sì, sembra che l'abbiamo fatto."

# game/episode024.rpy:889
translate italian ep024_uailea_council_f7d69d1b:

    # c "Allying ourselves with an outcast seems to have paid off in the end."
    c "Allearci con un emarginato sembra aver dato i suoi frutti alla fine."

# game/episode024.rpy:891
translate italian ep024_uailea_council_ebfcb5c0:

    # zi "Yes, it may have been a gamble, but I’m glad it worked to our advantage."
    zi "Sì, potrebbe essere stata una scommessa, ma sono felice che abbia funzionato a nostro vantaggio."

# game/episode024.rpy:893
translate italian ep024_uailea_council_3155f938:

    # na "Agreed, let’s go tell the others."
    na "D'accordo, andiamo a dirlo agli altri."

# game/episode024.rpy:895
translate italian ep024_uailea_council_5723e9cd:

    # "Leaving the Council chambers, we went to the Bastard to bring everyone up to speed."
    "Lasciando le stanze del Consiglio, siamo andati dal Bastardo per aggiornare tutti."

# game/episode024.rpy:900
translate italian ep024_uailea_council_f44dd42f:

    # "One day after the visit of the representative of the League of Dipoturn, the Council invited us to join them."
    "Un giorno dopo la visita del rappresentante della Lega di Dipoturn, il Consiglio ci ha invitato ad unirci a loro."

# game/episode024.rpy:902
translate italian ep024_uailea_council_7766e056:

    # "A couple of days after Arlya’s visit, the Council invited us to join them."
    "Un paio di giorni dopo la visita di Arlya, il Consiglio ci ha invitato ad unirci a loro."

# game/episode024.rpy:903
translate italian ep024_uailea_council_a0573492_1:

    # "Ziv, Nadya and I were led to the Council chambers."
    "Ziv, Nadya e io fummo condotti nelle camere del Consiglio."

# game/episode024.rpy:906
translate italian ep024_uailea_council_1fad64a5:

    # "The Nkoy’s were already there, Arlya presiding as the head of the Council and smiling pleasantly."
    "Gli Nkoy erano già lì, Arlya presiedeva come capo del Consiglio e sorrideva amabilmente."

# game/episode024.rpy:908
translate italian ep024_uailea_council_685ccc33:

    # "The Nkoy’s were already there, Arlya presiding as the head of the Council and smirking ominously."
    "Gli Nkoy erano già lì, Arlya presiedeva come capo del Consiglio e sorrideva minacciosamente."

# game/episode024.rpy:909
translate italian ep024_uailea_council_579c71e6:

    # arl "Welcome all."
    arl "Benvenuti a tutti."

# game/episode024.rpy:910
translate italian ep024_uailea_council_e7652b19:

    # arl "The Council of Nkoy is now in session."
    arl "Il Consiglio di Nkoy è ora in sessione."

# game/episode024.rpy:911
translate italian ep024_uailea_council_366fd428:

    # arl "We are formally responding to a petition for diplomatic aid."
    arl "Stiamo rispondendo formalmente a una richiesta di aiuto diplomatico."

# game/episode024.rpy:914
translate italian ep024_uailea_council_dc834bcc:

    # arl "The Council has decided to deny your request."
    arl "Il Consiglio ha deciso di respingere la vostra richiesta."

# game/episode024.rpy:915
translate italian ep024_uailea_council_d22de38e:

    # arl "It is not in the best interest of the Rhenkoy to become part of this conflict, and we will therefore remain neutral in this conflict."
    arl "Non è nell’interesse dei Rhenkoy entrare a far parte di questo conflitto, e quindi rimarremo neutrali in questo conflitto."

# game/episode024.rpy:916
translate italian ep024_uailea_council_209fe013:

    # arl "The Rhenkoy will not render their diplomatic services to you."
    arl "I Rhenkoy non ti forniranno i loro servizi diplomatici."

# game/episode024.rpy:917
translate italian ep024_uailea_council_9179fbdf:

    # c "You’re making a mistake."
    c "Stai commettendo un errore."

# game/episode024.rpy:919
translate italian ep024_uailea_council_be8ca7fe:

    # na "The Sovereignty will trample you without mercy, neutrality be damned."
    na "La Sovranità vi calpesterà senza pietà, al diavolo la neutralità."

# game/episode024.rpy:921
translate italian ep024_uailea_council_22ddc95b:

    # zi "You disgust me, Arlya."
    zi "Mi fai schifo, Arlya."

# game/episode024.rpy:922
translate italian ep024_uailea_council_3f65bf79:

    # zi "You’re corrupting the Rhenkoy from the inside out."
    zi "Stai corrompendo i Rhenkoy dall'interno."

# game/episode024.rpy:923
translate italian ep024_uailea_council_a38778a6:

    # zi "And the other Nkoy are letting you get away with it."
    zi "E gli altri Nkoy ti stanno lasciando farla franca."

# game/episode024.rpy:925
translate italian ep024_uailea_council_6c8fe3ac:

    # arl "Spending this much time with non-Rhenkoy has made you stray from the path."
    arl "Trascorrere così tanto tempo con i non-Rhenkoy ti ha fatto deviare dal sentiero."

# game/episode024.rpy:926
translate italian ep024_uailea_council_e97e627a:

    # arl "Nkoy Redrigyu has rightly warned us of the dilution of our species by consorting with the other races."
    arl "Nkoy Redrigyu ci ha giustamente messo in guardia contro la diluizione della nostra specie attraverso la collaborazione con le altre razze."

# game/episode024.rpy:928
translate italian ep024_uailea_council_fcc5255f:

    # zi "You’re seriously quoting a dissident fundamentalist as gospel now?"
    zi "Adesso stai seriamente citando un fondamentalista dissidente come vangelo?"

# game/episode024.rpy:929
translate italian ep024_uailea_council_4a5e48f6:

    # zi "And you all just let her?"
    zi "E voi tutti glielo avete permesso?"

# game/episode024.rpy:933
translate italian ep024_uailea_council_17f657c9:

    # woman "Your tone and demeanour are unacceptable here in these hallowed Council halls."
    woman "Il tuo tono e il tuo comportamento sono inaccettabili qui, in queste sacre sale del Consiglio."

# game/episode024.rpy:935
translate italian ep024_uailea_council_56a1837f:

    # arl "You are the one who has lost their way, Ziv."
    arl "Sei tu quello che ha perso la strada, Ziv."

# game/episode024.rpy:936
translate italian ep024_uailea_council_f4b564c9:

    # arl "This session is over."
    arl "Questa sessione è finita."

# game/episode024.rpy:938
translate italian ep024_uailea_council_38adc7ce:

    # "The Nkoy got up and left, leaving the three of us fuming."
    "L'Nkoy si alzò e se ne andò, lasciandoci tutti e tre furiosi."

# game/episode024.rpy:940
translate italian ep024_uailea_council_c75788ef:

    # zi "They’re so shortsighted!"
    zi "Sono così miopi!"

# game/episode024.rpy:942
translate italian ep024_uailea_council_6d073341:

    # na "That Arlya seems to have a firm grip on the Council."
    na "Quella Arlya sembra avere una presa salda sul Consiglio."

# game/episode024.rpy:943
translate italian ep024_uailea_council_83110c5b:

    # c "She mentioned as much when she visited me earlier."
    c "Me ne ha parlato quando è venuta a trovarmi prima."

# game/episode024.rpy:945
translate italian ep024_uailea_council_4a9d1064:

    # na "What did she want?"
    na "Cosa voleva?"

# game/episode024.rpy:946
translate italian ep024_uailea_council_cfca75b7:

    # c "A bribe."
    c "Una tangente."

# game/episode024.rpy:947
translate italian ep024_uailea_council_1b8b2634:

    # c "I said no."
    c "Ho detto di no."

# game/episode024.rpy:949
translate italian ep024_uailea_council_0c10fe4d:

    # na "And rightly so, alliances shouldn’t be built on the promise of personal gain."
    na "E giustamente, le alleanze non dovrebbero essere costruite sulla promessa di un guadagno personale."

# game/episode024.rpy:951
translate italian ep024_uailea_council_f0f69dd4:

    # zi "Agreed."
    zi "Concordato."

# game/episode024.rpy:952
translate italian ep024_uailea_council_1f0c1c31:

    # c "It does leave us without an ally though."
    c "Tuttavia ci lascia senza un alleato."

# game/episode024.rpy:954
translate italian ep024_uailea_council_f3a94386:

    # na "The diplomatic skills of the Rhenkoy aren’t easily replicated, but there must be other options we can explore."
    na "Le capacità diplomatiche dei Rhenkoy non sono facilmente replicabili, ma ci devono essere altre opzioni che possiamo esplorare."

# game/episode024.rpy:956
translate italian ep024_uailea_council_d6f079c4:

    # zi "I will ask around if there are any Rhenkoy who wish to join us."
    zi "Chiederò in giro se c'è qualche Rhenkoy che desidera unirsi a noi."

# game/episode024.rpy:957
translate italian ep024_uailea_council_2cf8360d:

    # c "Will they break from the Rhenkoy hierarchy that easily?"
    c "Si romperanno così facilmente dalla gerarchia Rhenkoy?"

# game/episode024.rpy:959
translate italian ep024_uailea_council_2f0bed82:

    # zi "It’s a big ask, but Nkoy Rhedia’s trial and subsequent imprisonment have sown a lot of discontent."
    zi "È una domanda importante, ma il processo di Nkoy Rhedia e la successiva incarcerazione hanno seminato molto malcontento."

# game/episode024.rpy:960
translate italian ep024_uailea_council_58b03bdb:

    # zi "I’ll keep you posted."
    zi "Ti terrò aggiornato."

# game/episode024.rpy:961
translate italian ep024_uailea_council_fd885045:

    # c "Thanks, if you need anything, just let me know."
    c "Grazie, se hai bisogno di qualcosa, fammi sapere."

# game/episode024.rpy:963
translate italian ep024_uailea_council_32e618b3:

    # "Leaving the Council chambers, we each went our separate ways."
    "Lasciando le camere del Consiglio, ognuno di noi andò per la propria strada."

# game/episode024.rpy:966
translate italian ep024_uailea_council_372892a9:

    # arl "The Council has decided to honor your request."
    arl "Il Consiglio ha deciso di onorare la tua richiesta."

# game/episode024.rpy:967
translate italian ep024_uailea_council_7a8fc0da:

    # arl "The diplomatic services of the Rhenkoy are at your disposal."
    arl "I servizi diplomatici della Rhenkoy sono a vostra disposizione."

# game/episode024.rpy:969
translate italian ep024_uailea_council_e17b136a:

    # arl "We will coordinate with you to begin our outreach to other potential allies."
    arl "Ci coordineremo con voi per iniziare il nostro contatto con altri potenziali alleati."

# game/episode024.rpy:970
translate italian ep024_uailea_council_aa557927:

    # arl "Your petition mentioned the Tubloshi."
    arl "La tua petizione menzionava i Tubloshi."

# game/episode024.rpy:971
translate italian ep024_uailea_council_fb98be03:

    # arl "Their military might is a powerful incentive for others to join, but we will explore other avenues as well."
    arl "La loro potenza militare è un potente incentivo affinché altri aderiscano, ma esploreremo anche altre strade."

# game/episode024.rpy:972
translate italian ep024_uailea_council_c7a05c06:

    # arl "A liaison will be appointed and will act as our eyes and ears."
    arl "Verrà nominato un collegamento che fungerà da nostri occhi e orecchie."

# game/episode024.rpy:973
translate italian ep024_uailea_council_52e472f0:

    # arl "They will forward any request you have to us and will keep you up to date with our own progress."
    arl "Ci inoltreranno qualsiasi richiesta tu abbia e ti terranno aggiornato sui nostri progressi."

# game/episode024.rpy:974
translate italian ep024_uailea_council_19eec105_1:

    # c "Thank you very much."
    c "Grazie mille."

# game/episode024.rpy:975
translate italian ep024_uailea_council_783e2571_1:

    # c "We look forward to working together."
    c "Non vediamo l'ora di lavorare insieme."

# game/episode024.rpy:976
translate italian ep024_uailea_council_f8108235_1:

    # c "Together we will build the largest and most powerful alliance ever known."
    c "Insieme costruiremo l’alleanza più grande e potente mai conosciuta."

# game/episode024.rpy:978
translate italian ep024_uailea_council_de2441a4:

    # arl "The Rhenkoy are honored to be part of this effort."
    arl "I Rhenkoy sono onorati di far parte di questo sforzo."

# game/episode024.rpy:979
translate italian ep024_uailea_council_3f0b8629:

    # arl "This Council session is now adjourned."
    arl "La sessione del Consiglio è ora aggiornata."

# game/episode024.rpy:981
translate italian ep024_uailea_council_588712c7_1:

    # "The Nkoy got up and left, leaving the three of us to process this news."
    "L'Nkoy si alzò e se ne andò, lasciando noi tre a elaborare la notizia."

# game/episode024.rpy:983
translate italian ep024_uailea_council_fb444bdc_1:

    # na "Well, it seems like we did it."
    na "Beh, sembra che ce l'abbiamo fatta."

# game/episode024.rpy:984
translate italian ep024_uailea_council_e89de6b6:

    # c "Yes, but I hope the benefits will outweigh the costs."
    c "Sì, ma spero che i benefici superino i costi."

# game/episode024.rpy:986
translate italian ep024_uailea_council_f5978c11:

    # zi "That’s always the question, sadly."
    zi "Questa è sempre la domanda, purtroppo."

# game/episode024.rpy:987
translate italian ep024_uailea_council_eb13a208:

    # c "At any rate, I’d say this is a win for us."
    c "In ogni caso, direi che questa è una vittoria per noi."

# game/episode024.rpy:988
translate italian ep024_uailea_council_3155f938_1:

    # na "Agreed, let’s go tell the others."
    na "D'accordo, andiamo a dirlo agli altri."

# game/episode024.rpy:990
translate italian ep024_uailea_council_5723e9cd_1:

    # "Leaving the Council chambers, we went to the Bastard to bring everyone up to speed."
    "Lasciando le stanze del Consiglio, siamo andati dal Bastardo per aggiornare tutti."

# game/episode024.rpy:997
translate italian ep024_uailea_rhedia_crisis_917914f5:

    # "After the Council was adjourned, we waited several days for the greatship to be ready and the group of mediators to arrive."
    "Dopo la sospensione del Consiglio, abbiamo aspettato diversi giorni affinché la grande nave fosse pronta e arrivasse il gruppo dei mediatori."

# game/episode024.rpy:999
translate italian ep024_uailea_rhedia_crisis_712b2c52:

    # "Instead of a message about our collective departure from Uailea, a clearly agitated Rhedia arrived at the apartment instead."
    "Invece di un messaggio sulla nostra partenza collettiva da Uailea, è arrivata all'appartamento una Rhedia chiaramente agitata."

# game/episode024.rpy:1001
translate italian ep024_uailea_rhedia_crisis_e7d17025:

    # rh "I am sorry for the unannounced interruption."
    rh "Mi scuso per l'interruzione senza preavviso."

# game/episode024.rpy:1002
translate italian ep024_uailea_rhedia_crisis_bd805a76:

    # c "No problem."
    c "Nessun problema."

# game/episode024.rpy:1003
translate italian ep024_uailea_rhedia_crisis_e4436339:

    # c "Is something the matter?"
    c "C'è qualcosa che non va?"

# game/episode024.rpy:1005
translate italian ep024_uailea_rhedia_crisis_85015bb3:

    # rh "Yes, it’s the group of mediators that were to arrive here today."
    rh "Sì, è il gruppo di mediatori che doveva arrivare qui oggi."

# game/episode024.rpy:1006
translate italian ep024_uailea_rhedia_crisis_546d3c56:

    # rh "They have failed to check in for several days now."
    rh "Sono diversi giorni che non riescono a effettuare il check-in."

# game/episode024.rpy:1007
translate italian ep024_uailea_rhedia_crisis_a569e9f5:

    # rh "We have sent out some scouts to determine why the group was delayed, but they weren’t able to find them."
    rh "Abbiamo inviato alcuni esploratori per determinare il motivo del ritardo del gruppo, ma non sono riusciti a trovarli."

# game/episode024.rpy:1008
translate italian ep024_uailea_rhedia_crisis_2aad09ed:

    # c "The whole group vanished?"
    c "L'intero gruppo è scomparso?"

# game/episode024.rpy:1009
translate italian ep024_uailea_rhedia_crisis_7b86c60b:

    # c "Someone made them disappear?"
    c "Qualcuno li ha fatti sparire?"

# game/episode024.rpy:1011
translate italian ep024_uailea_rhedia_crisis_9c75e6f1:

    # rh "Yes, we have received ransom demands from an organization based in Sharard this morning."
    rh "Sì, stamattina abbiamo ricevuto richieste di riscatto da un'organizzazione con sede a Sharard."

# game/episode024.rpy:1012
translate italian ep024_uailea_rhedia_crisis_8b7bddcc:

    # rh "The group travelled from Soniriey and had to pass Sharard in order to arrive here."
    rh "Il gruppo è partito da Soniriey e ha dovuto passare Sharard per arrivare qui."

# game/episode024.rpy:1013
translate italian ep024_uailea_rhedia_crisis_32061787:

    # rh "Sharard has always been a base of power for Nkoy Arlya, and many of her followers still live there."
    rh "Sharard è sempre stata una base di potere per Nkoy Arlya e molti dei suoi seguaci vivono ancora lì."

# game/episode024.rpy:1026
translate italian ep024_uailea_rhedia_crisis_f9fccc7f:

    # rh "They must have gotten word of the mediators passing Sharard and made their move."
    rh "Devono aver saputo che i mediatori avevano superato Sharard e hanno fatto la loro mossa."

# game/episode024.rpy:1027
translate italian ep024_uailea_rhedia_crisis_05e8809d:

    # c "And now they try to ransom the mediators in return for the release of Arlya?"
    c "E ora cercano di riscattare i mediatori in cambio del rilascio di Arlya?"

# game/episode024.rpy:1029
translate italian ep024_uailea_rhedia_crisis_09470c32:

    # rh "Yes, the release of Arlya and abstaining from any further prosecution were their only demands."
    rh "Sì, le loro uniche richieste erano il rilascio di Arlya e l'astensione da qualsiasi ulteriore procedimento giudiziario."

# game/episode024.rpy:1030
translate italian ep024_uailea_rhedia_crisis_45bfc866:

    # c "Will they harm the mediators?"
    c "Danneggeranno i mediatori?"

# game/episode024.rpy:1031
translate italian ep024_uailea_rhedia_crisis_730660fd:

    # rh "I doubt it."
    rh "Ne dubito."

# game/episode024.rpy:1032
translate italian ep024_uailea_rhedia_crisis_fa62fe38:

    # rh "Treating their hostages fairly is still in their best interest."
    rh "Trattare equamente i loro ostaggi è ancora nel loro interesse."

# game/episode024.rpy:1033
translate italian ep024_uailea_rhedia_crisis_a90ac1ec:

    # rh "But we can’t give in to their demands."
    rh "Ma non possiamo cedere alle loro richieste."

# game/episode024.rpy:1034
translate italian ep024_uailea_rhedia_crisis_b2fc99e0:

    # rh "Releasing Nkoy Arlya would undermine everything we’ve tried to build so far."
    rh "Rilasciare Nkoy Arlya minerebbe tutto ciò che abbiamo cercato di costruire finora."

# game/episode024.rpy:1035
translate italian ep024_uailea_rhedia_crisis_62045626:

    # rh "Any improvement of our society will be tarred by letting the person who’s responsible for the decay of it loose."
    rh "Qualsiasi miglioramento della nostra società sarà vanificato lasciando libera la persona responsabile del suo decadimento."

# game/episode024.rpy:1036
translate italian ep024_uailea_rhedia_crisis_24366554:

    # c "I understand."
    c "Capisco."

# game/episode024.rpy:1037
translate italian ep024_uailea_rhedia_crisis_1d63e2f0:

    # c "So are you going to attempt to spring them free by force?"
    c "Quindi tenterai di liberarli con la forza?"

# game/episode024.rpy:1039
translate italian ep024_uailea_rhedia_crisis_b1a5642a:

    # rh "Any open hostile actions against that group would very likely trigger open revolts, maybe even a civil war."
    rh "Qualsiasi aperta azione ostile contro quel gruppo molto probabilmente scatenerebbe rivolte aperte, forse anche una guerra civile."

# game/episode024.rpy:1040
translate italian ep024_uailea_rhedia_crisis_8d9d9154:

    # rh "Sending a covert team is too risky as well, and we lack the manpower."
    rh "Anche mandare una squadra sotto copertura è troppo rischioso, e non abbiamo abbastanza personale."

# game/episode024.rpy:1042
translate italian ep024_uailea_rhedia_crisis_4baf90ff:

    # rh "If the operation fails and the identities of the covert team were to become public knowledge, it would have the same effect as a direct strike."
    rh "Se l’operazione fallisse e l’identità della squadra segreta diventasse di dominio pubblico, l’effetto sarebbe identico a quello di un attacco diretto."

# game/episode024.rpy:1043
translate italian ep024_uailea_rhedia_crisis_24366554_1:

    # c "I understand."
    c "Capisco."

# game/episode024.rpy:1044
translate italian ep024_uailea_rhedia_crisis_02abc943:

    # c "So there’s nothing that can be done for these people?"
    c "Quindi non c’è niente che si possa fare per queste persone?"

# game/episode024.rpy:1046
translate italian ep024_uailea_rhedia_crisis_9061e167:

    # rh "We were hoping you would be willing to try."
    rh "Speravamo che fossi disposto a provare."

# game/episode024.rpy:1047
translate italian ep024_uailea_rhedia_crisis_f63c4fba:

    # rh "The followers of Nkoy Arlya are not as organized, nor have they had the military training you have."
    rh "I seguaci di Nkoy Arlya non sono così organizzati, né hanno ricevuto l'addestramento militare che avete voi."

# game/episode024.rpy:1049
translate italian ep024_uailea_rhedia_crisis_ce0d7edf:

    # rh "Our analysts have reviewed the situation at the compound where the hostages are likely held and deem the operation perfect for a small strike team."
    rh "I nostri analisti hanno esaminato la situazione nel complesso dove probabilmente sono tenuti gli ostaggi e ritengono che l'operazione sia perfetta per una piccola squadra d'assalto."

# game/episode024.rpy:1050
translate italian ep024_uailea_rhedia_crisis_3105e8d0:

    # rh "The fact that you are not formally tied to the Council of Nkoy will make it easier for us to deny any involvement."
    rh "Il fatto che non siate formalmente legati al Consiglio di Nkoy ci renderà più facile negare qualsiasi coinvolgimento."

# game/episode024.rpy:1051
translate italian ep024_uailea_rhedia_crisis_538fe4f3:

    # rh "We will of course informally assist you in any way we can."
    rh "Naturalmente vi aiuteremo in modo informale in ogni modo possibile."

# game/episode024.rpy:1052
translate italian ep024_uailea_rhedia_crisis_6a141c12:

    # c "The fact that we just made a deal and are then caught out trying to assault the compound of your rival, won’t be a problem?"
    c "Il fatto che abbiamo appena stretto un accordo e poi veniamo sorpresi mentre tentavamo di assaltare il complesso del tuo rivale, non sarà un problema?"

# game/episode024.rpy:1054
translate italian ep024_uailea_rhedia_crisis_3da9da50:

    # rh "I’m not saying it won’t be a problem, but it will be a problem we can manage."
    rh "Non sto dicendo che non sarà un problema, ma sarà un problema che possiamo gestire."

# game/episode024.rpy:1055
translate italian ep024_uailea_rhedia_crisis_28d15c8b:

    # rh "Whereas an officially sanctioned strike would lead to a crisis almost certainly."
    rh "Mentre uno sciopero ufficialmente sancito porterebbe quasi sicuramente ad una crisi."

# game/episode024.rpy:1059
translate italian ep024_uailea_rhedia_crisis_bd72d7dd:

    # c "The current pool of Rhenkoy diplomats is on the small side."
    c "L’attuale numero di diplomatici Rhenkoy è piuttosto piccolo."

# game/episode024.rpy:1060
translate italian ep024_uailea_rhedia_crisis_223e1269:

    # c "We really need those extra mediators."
    c "Abbiamo davvero bisogno di questi mediatori extra."

# game/episode024.rpy:1062
translate italian ep024_uailea_rhedia_crisis_a98e0a73:

    # rh "I agree."
    rh "Sono d'accordo."

# game/episode024.rpy:1063
translate italian ep024_uailea_rhedia_crisis_35e11b12:

    # c "Your team will be able to provide us with maps and intel?"
    c "La tua squadra sarà in grado di fornirci mappe e informazioni?"

# game/episode024.rpy:1064
translate italian ep024_uailea_rhedia_crisis_ef712afd:

    # rh "Yes, they’re also available to help you plan the operation, if you want."
    rh "Sì, sono disponibili anche per aiutarti a pianificare l'operazione, se lo desideri."

# game/episode024.rpy:1065
translate italian ep024_uailea_rhedia_crisis_d6f474f5:

    # c "When can we start?"
    c "Quando possiamo iniziare?"

# game/episode024.rpy:1066
translate italian ep024_uailea_rhedia_crisis_0834d18c:

    # rh "As soon as possible."
    rh "Appena possibile."

# game/episode024.rpy:1067
translate italian ep024_uailea_rhedia_crisis_3369e91a:

    # rh "Our Commander of Special Ops has already been informed and is waiting for you to contact her."
    rh "Il nostro comandante delle operazioni speciali è già stato informato e aspetta che tu lo contatti."

# game/episode024.rpy:1068
translate italian ep024_uailea_rhedia_crisis_0dab1d9f:

    # c "Good, we’ll meet her and draw up a plan."
    c "Bene, la incontreremo e elaboreremo un piano."

# game/episode024.rpy:1070
translate italian ep024_uailea_rhedia_crisis_c392d773:

    # rh "Very good."
    rh "Molto bene."

# game/episode024.rpy:1071
translate italian ep024_uailea_rhedia_crisis_c8fbfaa1:

    # rh "If you need anything else, you can ask the Commander."
    rh "Se hai bisogno di altro, puoi chiedere al Comandante."

# game/episode024.rpy:1072
translate italian ep024_uailea_rhedia_crisis_db80334d:

    # rh "I’ll make sure it will be provided to you."
    rh "Mi assicurerò che ti venga fornito."

# game/episode024.rpy:1074
translate italian ep024_uailea_rhedia_crisis_d74468c1:

    # rh "We’ll continue preparing the greatship and wait for your arrival."
    rh "Continueremo a preparare la grande nave e aspetteremo il tuo arrivo."

# game/episode024.rpy:1076
translate italian ep024_uailea_rhedia_crisis_c4f59232:

    # "Rhedia gave me the contact details of the Special Ops commander and left the apartment."
    "Rhedia mi diede i dettagli di contatto del comandante delle operazioni speciali e lasciò l'appartamento."

# game/episode024.rpy:1079
translate italian ep024_uailea_rhedia_crisis_46b3a0e6:

    # c "I’m sorry, but I don’t think we can afford to become involved in this."
    c "Mi dispiace, ma non credo che possiamo permetterci di essere coinvolti in questa cosa."

# game/episode024.rpy:1080
translate italian ep024_uailea_rhedia_crisis_5c697419:

    # c "The group of extra mediators would be of help, but we’ll have to make do without them."
    c "Il gruppo dei mediatori aggiuntivi aiuterebbe, ma dovremo farne a meno."

# game/episode024.rpy:1081
translate italian ep024_uailea_rhedia_crisis_124ce655:

    # c "We’re on a timeline, and the risk is simply too great."
    c "Siamo in linea con i tempi e il rischio è semplicemente troppo grande."

# game/episode024.rpy:1083
translate italian ep024_uailea_rhedia_crisis_bbe35c94:

    # rh "It saddens me to hear this, but I respect your decision."
    rh "Mi rattrista sentire questo, ma rispetto la tua decisione."

# game/episode024.rpy:1084
translate italian ep024_uailea_rhedia_crisis_4b0b46c6:

    # rh "The current amount of diplomats we’ve been able to provide is small, though."
    rh "Tuttavia, l’attuale numero di diplomatici che siamo in grado di fornire è ridotto."

# game/episode024.rpy:1085
translate italian ep024_uailea_rhedia_crisis_6ede102c:

    # rh "The inclusion group of mediators currently being held in Sharard would really make a difference."
    rh "Il gruppo di mediatori attualmente tenuto a Sharard farebbe davvero la differenza."

# game/episode024.rpy:1086
translate italian ep024_uailea_rhedia_crisis_ac374624:

    # c "I’m aware, but the risks are still too great."
    c "Lo so, ma i rischi sono ancora troppo grandi."

# game/episode024.rpy:1088
translate italian ep024_uailea_rhedia_crisis_ff525fcc:

    # rh "Understood, we’ll proceed with preparations of the greatship and start negotiations with the faction in Sharard instead."
    rh "Capito, procederemo con i preparativi della grande nave e avvieremo invece i negoziati con la fazione di Sharard."

# game/episode024.rpy:1089
translate italian ep024_uailea_rhedia_crisis_e897fbb0:

    # c "Thank you."
    c "Grazie."

# game/episode024.rpy:1090
translate italian ep024_uailea_rhedia_crisis_a03bae1a:

    # c "I sincerely hope you’ll get your people back."
    c "Spero sinceramente che riporterai indietro la tua gente."

# game/episode024.rpy:1092
translate italian ep024_uailea_rhedia_crisis_ee526f95:

    # "Rhedia left the apartment, unable to hide her disappointment."
    "Rhedia lasciò l'appartamento, incapace di nascondere la sua delusione."

# game/episode024.rpy:1093
translate italian ep024_uailea_rhedia_crisis_43c0c075:

    # "I asked Céline and the rest of the crew to prepare the Bastard for take-off."
    "Ho chiesto a Céline e al resto dell'equipaggio di preparare il Bastard per il decollo."

# game/episode024.rpy:1100
translate italian ep024_uailea_ziv_97571168:

    # "I didn’t see much of Ziv during my stay at the apartment."
    "Non ho visto molto Ziv durante il mio soggiorno nell'appartamento."

# game/episode024.rpy:1101
translate italian ep024_uailea_ziv_622497b9:

    # "She was out to drum up diplomatic support and visited several settlements on Uailea."
    "Era intenzionata a raccogliere sostegno diplomatico e ha visitato diversi insediamenti su Uailea."

# game/episode024.rpy:1103
translate italian ep024_uailea_ziv_bb748e2c:

    # "Ziv returned after two weeks of travelling and came immediately to the apartment."
    "Ziv ritornò dopo due settimane di viaggio e venne immediatamente all'appartamento."

# game/episode024.rpy:1104
translate italian ep024_uailea_ziv_38232650:

    # c "Hey, how have you been?"
    c "Ehi, come stai?"

# game/episode024.rpy:1105
translate italian ep024_uailea_ziv_72cc9a88:

    # zi "Good, considering, very tired though."
    zi "Bene, considerando che sono molto stanco, però."

# game/episode024.rpy:1106
translate italian ep024_uailea_ziv_0da57f1a:

    # c "I can imagine."
    c "Posso immaginare."

# game/episode024.rpy:1107
translate italian ep024_uailea_ziv_54027a63:

    # c "Any luck?"
    c "Un po' di fortuna?"

# game/episode024.rpy:1109
translate italian ep024_uailea_ziv_31d4e678:

    # zi "Not much."
    zi "Non tanto."

# game/episode024.rpy:1110
translate italian ep024_uailea_ziv_cb401b73:

    # zi "Nobody wants to talk, so I had a hard time figuring out how to contact people who aren’t in league with the new Council."
    zi "Nessuno vuole parlare, quindi ho avuto difficoltà a capire come contattare le persone che non sono in combutta con il nuovo Consiglio."

# game/episode024.rpy:1111
translate italian ep024_uailea_ziv_14108021:

    # zi "I finally managed to establish communications with a splinter group following the teachings of Irnaxya, one of the mentors of Nkoy Rhedia."
    zi "Alla fine sono riuscito a stabilire una comunicazione con un gruppo scissionista seguendo gli insegnamenti di Irnaxya, uno dei mentori di Nkoy Rhedia."

# game/episode024.rpy:1112
translate italian ep024_uailea_ziv_30e7b2db:

    # c "Did they agree to come with us?"
    c "Hanno accettato di venire con noi?"

# game/episode024.rpy:1114
translate italian ep024_uailea_ziv_b584cbd2:

    # zi "No, but they were able to tell me where Nkoy Rhedia and her dissidents are being held."
    zi "No, ma sono riusciti a dirmi dove sono tenuti Nkoy Rhedia e i suoi dissidenti."

# game/episode024.rpy:1115
translate italian ep024_uailea_ziv_4eef07fb:

    # zi "Arlya imprisoned them after we left Uailea."
    zi "Arlya li ha imprigionati dopo che abbiamo lasciato Uailea."

# game/episode024.rpy:1116
translate italian ep024_uailea_ziv_ca7e1816:

    # zi "Rhedia and her dissidents got a show trial and were then sent to a holding facility near Sharard."
    zi "Rhedia e i suoi dissidenti subirono un processo farsa e furono poi mandati in una struttura di detenzione vicino a Sharard."

# game/episode024.rpy:1118
translate italian ep024_uailea_ziv_59893090:

    # zi "Holding facility seems like an overstatement, though."
    zi "La struttura di detenzione, però, sembra un'esagerazione."

# game/episode024.rpy:1119
translate italian ep024_uailea_ziv_179b6aff:

    # zi "It’s a residential building in the middle of the city, not an official prison."
    zi "È un edificio residenziale nel centro della città, non una prigione ufficiale."

# game/episode024.rpy:1120
translate italian ep024_uailea_ziv_ca33e566:

    # zi "A prison would mean that Rhedia would have visitation rights and other privileges."
    zi "Una prigione significherebbe che Rhedia avrebbe diritti di visita e altri privilegi."

# game/episode024.rpy:1121
translate italian ep024_uailea_ziv_e26f13d2:

    # c "And the Council agreed to move Rhedia there, without any official oversight?"
    c "E il Consiglio ha accettato di trasferire Rhedia lì, senza alcuna supervisione ufficiale?"

# game/episode024.rpy:1123
translate italian ep024_uailea_ziv_e73ba1e5:

    # zi "It seems that Arlya’s grip on the Council is very strong, I don’t see how she made them agree to this arrangement otherwise."
    zi "Sembra che la presa di Arlya sul Consiglio sia molto forte, non vedo come avrebbe fatto altrimenti a convincerli a accettare questo accordo."

# game/episode024.rpy:1124
translate italian ep024_uailea_ziv_20c92885:

    # zi "Sharard has always been a place where Arlya’s support was the strongest, so it makes sense they were sent there."
    zi "Sharard è sempre stato un luogo in cui il sostegno di Arlya era più forte, quindi è logico che siano stati mandati lì."

# game/episode024.rpy:1137
translate italian ep024_uailea_ziv_a573409c:

    # zi "A convenient place where Rhedia and her ideas will quickly be forgotten."
    zi "Un posto conveniente dove Rhedia e le sue idee verranno presto dimenticate."

# game/episode024.rpy:1138
translate italian ep024_uailea_ziv_dc96cf73:

    # c "Sounds like Arlya has it all figured out."
    c "Sembra che Arlya abbia capito tutto."

# game/episode024.rpy:1139
translate italian ep024_uailea_ziv_db81f7d5:

    # c "But how does knowing where Rhedia is captured help us?"
    c "Ma come ci aiuta sapere dove è stata catturata Rhedia?"

# game/episode024.rpy:1141
translate italian ep024_uailea_ziv_f0992543:

    # zi "We need Rhedia’s support."
    zi "Abbiamo bisogno del sostegno di Rhedia."

# game/episode024.rpy:1142
translate italian ep024_uailea_ziv_d2797db3:

    # zi "So we need to free her."
    zi "Quindi dobbiamo liberarla."

# game/episode024.rpy:1143
translate italian ep024_uailea_ziv_5105aa0d:

    # zi "In exchange, I’m sure they’ll help us."
    zi "In cambio, sono sicuro che ci aiuteranno."

# game/episode024.rpy:1145
translate italian ep024_uailea_ziv_1f8ce782:

    # zi "They can’t stay here on Uailea after being freed at any rate."
    zi "In ogni caso non potranno restare qui a Uailea dopo essere stati liberati."

# game/episode024.rpy:1146
translate italian ep024_uailea_ziv_4e3d0069:

    # zi "She and her dissidents can talk to the other factions who aren’t sympathetic to Arlya."
    zi "Lei e i suoi dissidenti possono parlare con le altre fazioni che non sono in sintonia con Arlya."

# game/episode024.rpy:1147
translate italian ep024_uailea_ziv_449d05e5:

    # c "What’s to stop Arlya from sending armed forces to recapture Rhedia?"
    c "Cosa impedisce ad Arlya di inviare forze armate per riconquistare Rhedia?"

# game/episode024.rpy:1149
translate italian ep024_uailea_ziv_61caee0b:

    # zi "I’m sure she’ll try, but Rhedia has experience hiding from her enemies."
    zi "Sono sicuro che ci proverà, ma Rhedia ha esperienza nel nascondersi dai suoi nemici."

# game/episode024.rpy:1150
translate italian ep024_uailea_ziv_6719eae0:

    # zi "As soon as we have enough support, we’ll pull out of Uailea, taking the Rhenkoy that are willing to help with us."
    zi "Non appena avremo abbastanza supporto, lasceremo Uailea, portando con noi i Rhenkoy disposti ad aiutarci."

# game/episode024.rpy:1151
translate italian ep024_uailea_ziv_5555fbd9:

    # c "But we’ll be in danger of suffering Arlya’s retaliation, while Rhedia goes on her recruitment drive among the Rhenkoy."
    c "Ma correremo il pericolo di subire la ritorsione di Arlya, mentre Rhedia prosegue la sua campagna di reclutamento tra i Rhenkoy."

# game/episode024.rpy:1153
translate italian ep024_uailea_ziv_b1e4352f:

    # zi "I’m not suggesting that we confront Arlya’s forces head on."
    zi "Non sto suggerendo di affrontare le forze di Arlya a testa alta."

# game/episode024.rpy:1154
translate italian ep024_uailea_ziv_efce9dd6:

    # zi "The facility where Rhedia is being held is a clandestine holding facility."
    zi "La struttura in cui è detenuta Rhedia è una struttura di detenzione clandestina."

# game/episode024.rpy:1155
translate italian ep024_uailea_ziv_82700ba2:

    # zi "A place Arlya wants to keep under wraps, because it isn’t exactly legal."
    zi "Un posto che Arlya vuole tenere nascosto, perché non è esattamente legale."

# game/episode024.rpy:1159
translate italian ep024_uailea_ziv_4789d6ab:

    # c "If that facility were to become public knowledge it would be a publicity nightmare?"
    c "Se quella struttura diventasse di pubblico dominio sarebbe un incubo pubblicitario?"

# game/episode024.rpy:1161
translate italian ep024_uailea_ziv_f79996b0:

    # zi "Exactly."
    zi "Esattamente."

# game/episode024.rpy:1162
translate italian ep024_uailea_ziv_a643c9d7:

    # zi "Something she can’t afford as she’s still asserting her grip on the Council."
    zi "Qualcosa che non può permettersi poiché sta ancora affermando la sua presa sul Consiglio."

# game/episode024.rpy:1163
translate italian ep024_uailea_ziv_4a7a060d:

    # c "I think we need to call a meeting and plan an operation in that case."
    c "Penso che dovremmo convocare una riunione e pianificare un'operazione in quel caso."

# game/episode024.rpy:1164
translate italian ep024_uailea_ziv_1b94d889:

    # zi "Good idea."
    zi "Buona idea."

# game/episode024.rpy:1166
translate italian ep024_uailea_ziv_3dff2856:

    # zi "I have some schematics and maps of the place and its surroundings."
    zi "Ho alcuni schemi e mappe del luogo e dei suoi dintorni."

# game/episode024.rpy:1167
translate italian ep024_uailea_ziv_10c46b0e:

    # zi "I’ll bring those to the Bastard and we can go from there."
    zi "Li porterò al Bastardo e potremo partire da lì."

# game/episode024.rpy:1168
translate italian ep024_uailea_ziv_ead546a8:

    # c "Excellent."
    c "Eccellente."

# game/episode024.rpy:1169
translate italian ep024_uailea_ziv_0f9c777c:

    # c "See you at the ship."
    c "Ci vediamo alla nave."

# game/episode024.rpy:1172
translate italian ep024_uailea_ziv_09cfa210:

    # c "We can’t risk it, Arlya is too powerful already."
    c "Non possiamo rischiare, Arlya è già troppo potente."

# game/episode024.rpy:1173
translate italian ep024_uailea_ziv_f680060f:

    # c "If we get caught, we’ll probably rot in a cell somewhere, while my father takes over the universe unchecked."
    c "Se veniamo scoperti, probabilmente marciremo in una cella da qualche parte, mentre mio padre prenderà il controllo dell’universo senza controllo."

# game/episode024.rpy:1174
translate italian ep024_uailea_ziv_d1d45f3d:

    # c "We’ll have to do without the support of the Rhenkoy, I’m afraid."
    c "Dovremo fare a meno del sostegno dei Rhenkoy, temo."

# game/episode024.rpy:1176
translate italian ep024_uailea_ziv_0b6717fd:

    # zi "I think that’s a mistake, but it’s your call."
    zi "Penso che sia un errore, ma la scelta è tua."

# game/episode024.rpy:1177
translate italian ep024_uailea_ziv_855a325e:

    # c "My decision is final."
    c "La mia decisione è definitiva."

# game/episode024.rpy:1178
translate italian ep024_uailea_ziv_6a9113b4:

    # c "The cost will be too great if the mission fails, or we get caught somehow."
    c "Il costo sarebbe troppo alto se la missione fallisse o se venissimo scoperti in qualche modo."

# game/episode024.rpy:1179
translate italian ep024_uailea_ziv_f5e22990:

    # c "Let’s return to the ship."
    c "Torniamo alla nave."

# game/episode024.rpy:1181
translate italian ep024_uailea_ziv_9cb71e70:

    # "Ziv clearly didn’t agree with my decision, but went with me to the docks nonetheless."
    "Ziv chiaramente non era d’accordo con la mia decisione, ma venne comunque con me al molo."

# game/episode024.rpy:1187
translate italian ep024_sharard_2a6d8a94:

    # "The Commander of Special Ops met with Ziv, Kit, Aven and me to go over our insertion plan."
    "Il comandante delle operazioni speciali si è incontrato con Ziv, Kit, Aven e me per esaminare il nostro piano di inserimento."

# game/episode024.rpy:1188
translate italian ep024_sharard_cf114f36:

    # "More details about where the hostages were being held had emerged from the scout reports."
    "Maggiori dettagli sul luogo in cui erano tenuti gli ostaggi erano emersi dai rapporti degli scout."

# game/episode024.rpy:1189
translate italian ep024_sharard_6cbad8eb:

    # "While the building where the followers of Arlya were holed up was a residential one, a frontal assault was doomed to fail."
    "Sebbene l'edificio in cui si erano rintanati i seguaci di Arlya fosse residenziale, un assalto frontale era destinato a fallire."

# game/episode024.rpy:1190
translate italian ep024_sharard_b524b067:

    # "A large sewer network spread out under Sharard, and a tunnel ran directly under the compound, accessible via a maintenance hatch in the building’s lower level."
    "Una grande rete fognaria si estendeva sotto Sharard e un tunnel correva direttamente sotto il complesso, accessibile tramite uno sportello di manutenzione al piano inferiore dell’edificio."

# game/episode024.rpy:1191
translate italian ep024_sharard_32564bf5:

    # "Going through the sewers seemed like the best option."
    "Passare attraverso le fogne sembrava la soluzione migliore."

# game/episode024.rpy:1192
translate italian ep024_sharard_5b92ef9b:

    # "The Commander asked us to keep casualties to a minimum and provided us with other information that might be helpful."
    "Il Comandante ci ha chiesto di ridurre al minimo le vittime e ci ha fornito altre informazioni che potrebbero essere utili."

# game/episode024.rpy:1193
translate italian ep024_sharard_4e829ffa:

    # "After several hours of discussion, we all felt ready to travel to Sharard."
    "Dopo diverse ore di discussione, ci sentivamo tutti pronti per partire per Sharard."

# game/episode024.rpy:1195
translate italian ep024_sharard_a0a0d85e:

    # "Ziv, Aven, Lilly, Kit, Jade and I flew an unmarked shuttle provided by Special Ops to Sharard."
    "Ziv, Aven, Lilly, Kit, Jade e io abbiamo volato su Sharard con una navetta non contrassegnata fornita dalle Operazioni Speciali."

# game/episode024.rpy:1198
translate italian ep024_sharard_39f61cf5:

    # "Ziv’s maps were the basis for the insertion plan I compiled together with her, Kit, and Aven."
    "Le mappe di Ziv sono state la base per il piano di inserimento che ho compilato insieme a lei, Kit e Aven."

# game/episode024.rpy:1199
translate italian ep024_sharard_2780397a:

    # "The building where the followers of Arlya were holed up was a residential one, a frontal assault was doomed to fail."
    "L'edificio dove si erano asserragliati i seguaci di Arlya era un edificio residenziale, un assalto frontale era destinato a fallire."

# game/episode024.rpy:1200
translate italian ep024_sharard_3484b61a:

    # "According to Ziv’s schematics, a large sewer network spread out under Sharard and a tunnel ran directly under the compound, accessible via a maintenance hatch in the building’s lower level."
    "Secondo gli schemi di Ziv, una grande rete fognaria si estendeva sotto Sharard e un tunnel correva direttamente sotto il complesso, accessibile tramite uno sportello di manutenzione al piano inferiore dell’edificio."

# game/episode024.rpy:1201
translate italian ep024_sharard_32564bf5_1:

    # "Going through the sewers seemed like the best option."
    "Passare attraverso le fogne sembrava la soluzione migliore."

# game/episode024.rpy:1202
translate italian ep024_sharard_899da16f:

    # "We felt that keeping casualties to a minimum would provide the best chances of rescuing Rhedia alive."
    "Abbiamo ritenuto che mantenere le vittime al minimo avrebbe fornito le migliori possibilità di salvare Rhedia viva."

# game/episode024.rpy:1203
translate italian ep024_sharard_4e829ffa_1:

    # "After several hours of discussion, we all felt ready to travel to Sharard."
    "Dopo diverse ore di discussione, ci sentivamo tutti pronti per partire per Sharard."

# game/episode024.rpy:1205
translate italian ep024_sharard_12825ad9:

    # "Ziv, Aven, Lilly, Kit, Jade and I flew a hired shuttle to Sharard."
    "Ziv, Aven, Lilly, Kit, Jade e io abbiamo preso una navetta noleggiata per Sharard."

# game/episode024.rpy:1210
translate italian ep024_sharard_04761cfd:

    # "We arrived in Sharard after an hour and parked the shuttle near the sewer entrance."
    "Arrivammo a Sharard dopo un'ora e parcheggiammo la navetta vicino all'ingresso delle fogne."

# game/episode024.rpy:1211
translate italian ep024_sharard_0a9c8c5b:

    # "The area surrounding the sewers wasn’t under guard, so Jade could crack the door security in peace and quiet."
    "L'area circostante le fogne non era sorvegliata, quindi Jade poteva forzare la sicurezza della porta in pace e tranquillità."

# game/episode024.rpy:1213
translate italian ep024_sharard_3da2ca41:

    # "She had the doors open in minutes, and we ventured in, arms at the ready and wearing helmets to stave off the odor."
    "Ha aperto le porte in pochi minuti e ci siamo avventurati dentro, con le braccia pronte e indossando i caschi per allontanare l'odore."

# game/episode024.rpy:1215
translate italian ep024_sharard_c4a4a5d9:

    # "Jade checked her tablet after a couple of minutes."
    "Jade controllò il tablet dopo un paio di minuti."

# game/episode024.rpy:1217
translate italian ep024_sharard_72539ec9:

    # j "We’re nearly under the compound, the access hatch should be above us a few clicks from here."
    j "Siamo quasi sotto il recinto, il portello di accesso dovrebbe essere sopra di noi a pochi clic da qui."

# game/episode024.rpy:1218
translate italian ep024_sharard_09d3b381:

    # l "Is that hatch locked?"
    l "Quel portello è chiuso a chiave?"

# game/episode024.rpy:1219
translate italian ep024_sharard_27eb6a4a:

    # c "We’re not sure, we didn’t receive any intel on the current situation in the building."
    c "Non ne siamo sicuri, non abbiamo ricevuto alcuna informazione sulla situazione attuale nell'edificio."

# game/episode024.rpy:1220
translate italian ep024_sharard_a1554b1b:

    # c "But we have to assume it’s under guard at the very least."
    c "Ma dobbiamo presumere che almeno sia sotto sorveglianza."

# game/episode024.rpy:1221
translate italian ep024_sharard_c3bcc2ee:

    # c "If we can’t open the hatch from here, we might need to blow it open."
    c "Se non riusciamo ad aprire il portello da qui, potremmo doverlo aprire."

# game/episode024.rpy:1222
translate italian ep024_sharard_00b8a174:

    # c "That would blow our advantage of remaining undetected until we’re inside, so I hope it won’t come to that."
    c "Ciò vanificherebbe il nostro vantaggio di non essere scoperti finché non saremo all’interno, quindi spero che non si arrivi a questo."

# game/episode024.rpy:1223
translate italian ep024_sharard_654612a7:

    # ki "No use in debating while all the Rhenkoy excrement floats by, let’s check out that hatch."
    ki "È inutile discutere mentre tutti gli escrementi di Rhenkoy fluttuano, diamo un'occhiata a quel portello."

# game/episode024.rpy:1225
translate italian ep024_sharard_fef61140:

    # "We nearly passed by the hatch, an unremarkable grate in the ceiling of the sewer."
    "Quasi passammo davanti al portello, una grata insignificante nel soffitto della fogna."

# game/episode024.rpy:1226
translate italian ep024_sharard_ba33c32d:

    # c "Seems like we found our entrance."
    c "Sembra che abbiamo trovato il nostro ingresso."

# game/episode024.rpy:1227
translate italian ep024_sharard_c6a779da:

    # c "Okay, ready your weapons."
    c "Ok, prepara le armi."

# game/episode024.rpy:1228
translate italian ep024_sharard_dfbe8b92:

    # c "Kit, try to open the hatch slowly, see if it opens at all."
    c "Kit, prova ad aprire lentamente il portello, vedi se si apre del tutto."

# game/episode024.rpy:1230
translate italian ep024_sharard_ea2f980b:

    # "Kit pushed against the grate, and we heard it move with the barest metal groan."
    "Kit spinse contro la grata e la sentimmo muoversi con un leggerissimo gemito metallico."

# game/episode024.rpy:1231
translate italian ep024_sharard_84f2f8a0:

    # ki "It’s unlocked."
    ki "È sbloccato."

# game/episode024.rpy:1232
translate italian ep024_sharard_a558425b:

    # "He dared to open the grate even further, allowing him to look through a crack between the ceiling and the grate."
    "Ha osato aprire ancora di più la grata, permettendogli di guardare attraverso una fessura tra il soffitto e la grata."

# game/episode024.rpy:1233
translate italian ep024_sharard_e14de14f:

    # ki "Seems like a storeroom of some kind."
    ki "Sembra una specie di magazzino."

# game/episode024.rpy:1234
translate italian ep024_sharard_d3a73ce6:

    # ki "It’s empty."
    ki "È vuoto."

# game/episode024.rpy:1236
translate italian ep024_sharard_ff167699:

    # "Kit pushed open the grate fully and climbed up."
    "Kit spinse completamente la grata e salì."

# game/episode024.rpy:1237
translate italian ep024_sharard_65d69a72:

    # ki "All clear."
    ki "Tutto chiaro."

# game/episode024.rpy:1239
translate italian ep024_sharard_066bba35:

    # "We followed Kit and went up into the room above, closing the hatch behind us."
    "Seguimmo Kit e salimmo nella stanza di sopra, chiudendo il portello dietro di noi."

# game/episode024.rpy:1240
translate italian ep024_sharard_f22a1c75:

    # av "I don’t think this room has been used in a while."
    av "Non credo che questa stanza sia stata utilizzata da un po'."

# game/episode024.rpy:1241
translate italian ep024_sharard_330f0575:

    # c "That’s good."
    c "Va bene."

# game/episode024.rpy:1242
translate italian ep024_sharard_74ef3e01:

    # c "We’re in the south-east section of the building."
    c "Siamo nella sezione sud-est dell'edificio."

# game/episode024.rpy:1243
translate italian ep024_sharard_bb9ed310:

    # c "Jade, can you find out anything from here?"
    c "Jade, puoi scoprire qualcosa da qui?"

# game/episode024.rpy:1244
translate italian ep024_sharard_8efa13bc:

    # j "I’d need access to the internal network for that, and I don’t see any sockets here."
    j "Per questo avrei bisogno dell'accesso alla rete interna e non vedo alcuna presa qui."

# game/episode024.rpy:1245
translate italian ep024_sharard_d41a4cef:

    # c "We’ll have to go outside then and look for access."
    c "Dovremo uscire allora e cercare l'accesso."

# game/episode024.rpy:1247
translate italian ep024_sharard_fdc442b2:

    # "Slightly opening the door revealed an empty corridor, lined with several other doors."
    "Aprendo leggermente la porta rivelò un corridoio vuoto, fiancheggiato da diverse altre porte."

# game/episode024.rpy:1248
translate italian ep024_sharard_be21380f:

    # c "Looks deserted."
    c "Sembra deserto."

# game/episode024.rpy:1249
translate italian ep024_sharard_c7c84133:

    # c "Let’s try if we have any luck here and move further upward if necessary."
    c "Se abbiamo fortuna, proviamo a muoverci più in alto se necessario."

# game/episode024.rpy:1250
translate italian ep024_sharard_dbeb0a89:

    # "This wing of the building seemed to be used for storage."
    "Sembrava che quest'ala dell'edificio fosse utilizzata come magazzino."

# game/episode024.rpy:1252
translate italian ep024_sharard_ddcb5c55:

    # "One room contained only rubble, the ceiling appeared to have caved in."
    "Una stanza conteneva solo macerie, il soffitto sembrava essere crollato."

# game/episode024.rpy:1254
translate italian ep024_sharard_63228d0c:

    # ki "Seems like they desperately need to do some maintenance."
    ki "Sembra che abbiano un disperato bisogno di fare un po' di manutenzione."

# game/episode024.rpy:1255
translate italian ep024_sharard_ecd3e136:

    # ki "It’s almost as if several floors above have collapsed."
    ki "È quasi come se diversi piani superiori fossero crollati."

# game/episode024.rpy:1256
translate italian ep024_sharard_d485ef38:

    # l "They’re probably too busy roleplaying jailers."
    l "Probabilmente sono troppo impegnati a interpretare i carcerieri."

# game/episode024.rpy:1258
translate italian ep024_sharard_8ff72273:

    # "We got lucky on the fourth try, entering a room with a computer console connected to power."
    "Abbiamo avuto fortuna al quarto tentativo, entrando in una stanza con la console di un computer collegata alla corrente."

# game/episode024.rpy:1260
translate italian ep024_sharard_a8fc1f0f:

    # c "Do your magic, Jade."
    c "Fai la tua magia, Jade."

# game/episode024.rpy:1261
translate italian ep024_sharard_ca021bae:

    # j "I will."
    j "Lo farò."

# game/episode024.rpy:1263
translate italian ep024_sharard_9e547e95:

    # "Jade got behind the computer and worked on breaking into the network, while the others and I stood on the lookout for any unwelcome visitors."
    "Jade si mise dietro il computer e lavorò per entrare nella rete, mentre io e gli altri stavamo alla ricerca di eventuali visitatori indesiderati."

# game/episode024.rpy:1265
translate italian ep024_sharard_2e0aa68f:

    # "After a few minutes, Jade looked up at me."
    "Dopo qualche minuto, Jade mi guardò."

# game/episode024.rpy:1266
translate italian ep024_sharard_6632b050:

    # j "I’m in."
    j "Ci sto."

# game/episode024.rpy:1268
translate italian ep024_sharard_f641a715:

    # j "The hostages are being held on the top floor."
    j "Gli ostaggi sono tenuti all'ultimo piano."

# game/episode024.rpy:1270
translate italian ep024_sharard_c1c25de5:

    # j "Rhedia is being held on the top floor."
    j "Rhedia è trattenuta all'ultimo piano."

# game/episode024.rpy:1272
translate italian ep024_sharard_099d5d03:

    # j "Most of the guards seem to be patrolling outside the compound."
    j "La maggior parte delle guardie sembra pattugliare l'esterno del complesso."

# game/episode024.rpy:1273
translate italian ep024_sharard_cfc1957a:

    # j "Inside, there’s a permanent guard of about five people, regularly patrolling the entire top floor."
    j "All'interno c'è una guardia permanente di circa cinque persone, che pattuglia regolarmente l'intero piano superiore."

# game/episode024.rpy:1274
translate italian ep024_sharard_5e69efd3:

    # j "Two people on guard near the entrance."
    j "Due persone di guardia vicino all'ingresso."

# game/episode024.rpy:1276
translate italian ep024_sharard_6e838121:

    # c "So there are two levels of Rhenkoy separating us from them?"
    c "Quindi ci sono due livelli di Rhenkoy che ci separano da loro?"

# game/episode024.rpy:1278
translate italian ep024_sharard_8228ae96:

    # c "So there are two levels of Rhenkoy separating us from Rhedia?"
    c "Quindi ci sono due livelli di Rhenkoy che ci separano da Rhedia?"

# game/episode024.rpy:1279
translate italian ep024_sharard_6fae616a:

    # j "Yes, the other two floors are used as a living area for Arlya’s followers."
    j "Sì, gli altri due piani vengono utilizzati come zona giorno per i seguaci di Arlya."

# game/episode024.rpy:1280
translate italian ep024_sharard_b4446cf8:

    # j "It’s quite busy, judging by the number of logged-in terminals."
    j "È piuttosto affollato, a giudicare dal numero di terminali registrati."

# game/episode024.rpy:1281
translate italian ep024_sharard_bfa54833:

    # c "Can we avoid those floors?"
    c "Possiamo evitare quei piani?"

# game/episode024.rpy:1283
translate italian ep024_sharard_e7bc106e:

    # j "Yes, I think so."
    j "Sì, penso di sì."

# game/episode024.rpy:1284
translate italian ep024_sharard_c62fd425:

    # j "The area where we are now was used as a living space before."
    j "L'area dove ci troviamo ora prima era utilizzata come spazio abitativo."

# game/episode024.rpy:1285
translate italian ep024_sharard_616d45d0:

    # j "There are reports to the building manager about a flood."
    j "Ci sono segnalazioni all'amministratore dell'edificio riguardo un'alluvione."

# game/episode024.rpy:1287
translate italian ep024_sharard_037ae537:

    # j "There was a leak on the top floor, causing the floor to crash through the storeys below."
    j "Si è verificata una perdita all'ultimo piano, causando il crollo del pavimento nei piani sottostanti."

# game/episode024.rpy:1288
translate italian ep024_sharard_25e52a9d:

    # j "It’s that room we were in earlier."
    j "È quella stanza in cui eravamo prima."

# game/episode024.rpy:1289
translate italian ep024_sharard_5d446227:

    # c "Must have been some flood..."
    c "Dev'esserci stata un'alluvione..."

# game/episode024.rpy:1291
translate italian ep024_sharard_d0203f03:

    # j "It was."
    j "Lo era."

# game/episode024.rpy:1292
translate italian ep024_sharard_736d0fbb:

    # j "Building manager is quite livid about it."
    j "Il direttore dell'edificio è piuttosto furioso al riguardo."

# game/episode024.rpy:1293
translate italian ep024_sharard_3e418387:

    # j "Something about skimping on materials, plumbing and bribed building inspectors when this compound was built."
    j "Qualcosa riguardo al risparmio su materiali, impianti idraulici e ispettori edili corrotti quando questo complesso è stato costruito."

# game/episode024.rpy:1294
translate italian ep024_sharard_2a14c38c:

    # c "So could we climb to the top through that caved-in section?"
    c "Quindi potremmo salire in cima attraverso quella sezione franata?"

# game/episode024.rpy:1296
translate italian ep024_sharard_0b12f493:

    # c "Maybe get the hostages out via that route?"
    c "Forse far uscire gli ostaggi attraverso quella strada?"

# game/episode024.rpy:1298
translate italian ep024_sharard_ce818258:

    # c "Maybe get Rhedia out via that route?"
    c "Forse far uscire Rhedia attraverso quella strada?"

# game/episode024.rpy:1300
translate italian ep024_sharard_dc63fb7b:

    # j "We have brought climbing gear, so yes, I think so."
    j "Abbiamo portato l'attrezzatura per l'arrampicata, quindi sì, penso di sì."

# game/episode024.rpy:1302
translate italian ep024_sharard_6e572f00:

    # "Exiting the room, we made our way back to the caved-in section of the building."
    "Uscendo dalla stanza, tornammo alla sezione crollata dell'edificio."

# game/episode024.rpy:1303
translate italian ep024_sharard_60fcbcfd:

    # c "Let’s strap ourselves in."
    c "Allacciamoci le cinture."

# game/episode024.rpy:1304
translate italian ep024_sharard_99b8aad7:

    # c "We’re going all the way up to the top floor, which is patrolled regularly."
    c "Saliamo fino all’ultimo piano, che è pattugliato regolarmente."

# game/episode024.rpy:1306
translate italian ep024_sharard_179694dc:

    # c "Any resistance needs to be taken out quietly, so we can get the hostages out one by one via this route."
    c "Qualsiasi resistenza deve essere eliminata senza fare rumore, così potremo liberare gli ostaggi uno per uno attraverso questa strada."

# game/episode024.rpy:1308
translate italian ep024_sharard_62d12e0c:

    # c "Any resistance needs to be taken out quietly, so we can get Rhedia out via this route."
    c "Qualsiasi resistenza deve essere eliminata in silenzio, in modo da poter far uscire Rhedia attraverso questa strada."

# game/episode024.rpy:1310
translate italian ep024_sharard_adb89ae0:

    # "Using grappling guns, we shot lines into the ceiling above us."
    "Usando i rampini, abbiamo sparato delle linee nel soffitto sopra di noi."

# game/episode024.rpy:1311
translate italian ep024_sharard_cb1f186b:

    # "Securing the lines to our harnesses, the crew initiated the ascent, and we were yanked several feet in the air, passing by two floors."
    "Dopo aver assicurato le funi alle nostre imbracature, l'equipaggio ha iniziato la salita e siamo stati sollevati per diversi metri in aria, passando per due piani."

# game/episode024.rpy:1312
translate italian ep024_sharard_f9f2b0f6:

    # "Luckily for us, the cave-ins on the floors separating us from the top weren’t guarded, so nobody noticed six people flying past."
    "Fortunatamente per noi, i crolli sui piani che ci separavano dalla cima non erano sorvegliati, quindi nessuno ha notato sei persone che volavano via."

# game/episode024.rpy:1314
translate italian ep024_sharard_31700129:

    # "At the top, we all jumped onto the part of the floor that was still intact and decoupled the lines from our harnesses."
    "In cima siamo saltati tutti sulla parte del pavimento ancora intatta e abbiamo staccato le corde dalle nostre imbracature."

# game/episode024.rpy:1315
translate italian ep024_sharard_7e63cf9e:

    # "According to our maps, double doors lead into a corridor."
    "Secondo le nostre mappe, le doppie porte conducono in un corridoio."

# game/episode024.rpy:1317
translate italian ep024_sharard_27b9a6b3:

    # c "There are supposed to be seven guards beyond this point."
    c "Dovrebbero esserci sette guardie oltre questo punto."

# game/episode024.rpy:1318
translate italian ep024_sharard_79bedfcf:

    # c "Five on patrol, two on guard at the door."
    c "Cinque di pattuglia, due di guardia alla porta."

# game/episode024.rpy:1320
translate italian ep024_sharard_2e3bbc5c:

    # c "Use the tranquilizer guns we were issued and hide the bodies here."
    c "Usa le pistole tranquillanti che ci hanno dato e nascondi i corpi qui."

# game/episode024.rpy:1321
translate italian ep024_sharard_a85c3e7f:

    # j "I’ll take care of the door separating us from the hostages."
    j "Mi occuperò io della porta che ci separa dagli ostaggi."

# game/episode024.rpy:1322
translate italian ep024_sharard_5027aff4:

    # j "Three of you are going to guide them all here and start getting them to the bottom floor."
    j "Tre di voi li guideranno tutti qui e inizieranno a portarli al piano inferiore."

# game/episode024.rpy:1324
translate italian ep024_sharard_c057480f:

    # c "Use the tranquilizer guns Ziv got us and hide the bodies here."
    c "Usa le pistole tranquillanti che Ziv ci ha procurato e nascondi i corpi qui."

# game/episode024.rpy:1325
translate italian ep024_sharard_01f2248f:

    # j "I’ll take care of the door separating us from Rhedia."
    j "Mi occuperò io della porta che ci separa da Rhedia."

# game/episode024.rpy:1326
translate italian ep024_sharard_a9f3b83b:

    # j "Three of you are going to guide Rhedia here and start getting them to the bottom floor."
    j "Tre di voi guideranno Rhedia qui e inizieranno a portarli al piano inferiore."

# game/episode024.rpy:1327
translate italian ep024_sharard_fc651851:

    # ki "Aven, Lilly and I will make sure we handle any unexpected guests arriving."
    ki "Aven, Lilly e io ci assicureremo di gestire eventuali ospiti inattesi in arrivo."

# game/episode024.rpy:1329
translate italian ep024_sharard_6716bd2f:

    # "I opened the door slightly and peeked through the crack."
    "Ho aperto leggermente la porta e ho sbirciato attraverso la fessura."

# game/episode024.rpy:1330
translate italian ep024_sharard_0f3bde81:

    # c "Two guards, standing with their backs to us, just before the corner."
    c "Due guardie, che ci danno le spalle, proprio prima dell'angolo."

# game/episode024.rpy:1331
translate italian ep024_sharard_9e20b1a0:

    # c "We’re going to take them out."
    c "Li elimineremo."

# game/episode024.rpy:1333
translate italian ep024_sharard_c20c9ad2:

    # "Jade and I slipped out and trained our guns at the backs of the guards."
    "Jade e io siamo scesi e abbiamo puntato le nostre armi alle spalle delle guardie."

# game/episode024.rpy:1334
translate italian ep024_sharard_d9c91f90:

    # "As Jade kneeled down to get better aim, the floor creaked."
    "Mentre Jade si inginocchiava per prendere meglio la mira, il pavimento scricchiolò."

# game/episode024.rpy:1336
translate italian ep024_sharard_40296cf9:

    # "One of the guards was just about to turn around to see where the noise came from, when two beams punctured their bodies."
    "Una delle guardie stava proprio per voltarsi per vedere da dove provenisse il rumore, quando due travi trapassarono i loro corpi."

# game/episode024.rpy:1339
translate italian ep024_sharard_66c38d20:

    # woman "What the-"
    woman "Cosa-"

# game/episode024.rpy:1341
translate italian ep024_sharard_b26d6e01:

    # "The fast-acting sedative took them out in under a second, their bodies thudding to the floor."
    "Il sedativo ad azione rapida li fece fuori in meno di un secondo, facendo cadere i loro corpi sul pavimento."

# game/episode024.rpy:1342
translate italian ep024_sharard_55d47531:

    # "We sprinted toward them and dragged their bodies behind the double doors."
    "Siamo corsi verso di loro e abbiamo trascinato i loro corpi dietro le doppie porte."

# game/episode024.rpy:1344
translate italian ep024_sharard_c60c4f51:

    # c "Two down, five to go."
    c "Due in meno, ne mancano cinque."

# game/episode024.rpy:1345
translate italian ep024_sharard_f515acfc:

    # c "No alarm so far."
    c "Nessun allarme per ora."

# game/episode024.rpy:1346
translate italian ep024_sharard_7a922f31:

    # ki "Good, let’s head out."
    ki "Bene, andiamo fuori."

# game/episode024.rpy:1348
translate italian ep024_sharard_98d3a316:

    # "Stopping at the corner of the corridor, I snuck a look around it."
    "Fermandomi all'angolo del corridoio, ho dato un'occhiata intorno."

# game/episode024.rpy:1349
translate italian ep024_sharard_35e776ff:

    # c "One guard coming toward us."
    c "Una guardia viene verso di noi."

# game/episode024.rpy:1350
translate italian ep024_sharard_5290ab47:

    # c "Four having a conversation near the door."
    c "Quattro conversano vicino alla porta."

# game/episode024.rpy:1351
translate italian ep024_sharard_84f01f87:

    # c "We’ll take out the single guard first, then throw a gas grenade at the rest."
    c "Prima elimineremo l'unica guardia, poi lanceremo una granata a gas contro le altre."

# game/episode024.rpy:1353
translate italian ep024_sharard_b90a64c5:

    # "Before the singular guard could voice any suspicion about the absence of her two colleagues, we were upon her."
    "Prima che la singolare guardia potesse esprimere qualsiasi sospetto sull'assenza dei suoi due colleghi, le eravamo addosso."

# game/episode024.rpy:1354
translate italian ep024_sharard_ecd4f7f7:

    # "She sank to her knees with a beam in her neck and soon joined her fellow guards near the cave-in."
    "Cadde in ginocchio con una trave nel collo e presto raggiunse le sue compagne guardie vicino al crollo."

# game/episode024.rpy:1355
translate italian ep024_sharard_c8303814:

    # "That left the four guards standing in front of the door of the room we needed to get into."
    "Ciò lasciò le quattro guardie davanti alla porta della stanza in cui dovevamo entrare."

# game/episode024.rpy:1357
translate italian ep024_sharard_4893b2a3:

    # "Aven lobbed a gas grenade at the guard’s feet."
    "Aven lanciò una granata a gas ai piedi della guardia."

# game/episode024.rpy:1359
translate italian ep024_sharard_f75b8701:

    # "One was able to voice her surprise, before the grenade exploded in a puff of sedative."
    "Qualcuno ha potuto esprimere la propria sorpresa, prima che la granata esplodesse in uno sbuffo di sedativo."

# game/episode024.rpy:1361
translate italian ep024_sharard_c4a1bd0c:

    # "Still wearing our helmets, we rushed to the place where they had fallen and dragged them out of sight as soon as possible."
    "Indossando ancora i nostri elmetti, ci siamo precipitati sul luogo dove erano caduti e li abbiamo trascinati fuori dalla vista il prima possibile."

# game/episode024.rpy:1363
translate italian ep024_sharard_4263af42:

    # "Once they were stowed out of sight, we waited to see if anyone who might have heard something would show up"
    "Una volta che furono nascosti alla vista, aspettammo per vedere se qualcuno che avrebbe potuto sentire qualcosa si sarebbe presentato"

# game/episode024.rpy:1364
translate italian ep024_sharard_88434dec:

    # "Nobody came."
    "Non è venuto nessuno."

# game/episode024.rpy:1365
translate italian ep024_sharard_f61e77c9:

    # c "I think we’re safe."
    c "Penso che siamo al sicuro."

# game/episode024.rpy:1366
translate italian ep024_sharard_076300b2:

    # c "Jade, let’s get working on that door."
    c "Jade, lavoriamo su quella porta."

# game/episode024.rpy:1368
translate italian ep024_sharard_e83721ad:

    # "Taking up our positions, Jade kneeled down before the door and pulled out her tablet to start working on the lock."
    "Prendendo posizione, Jade si inginocchiò davanti alla porta e tirò fuori il tablet per iniziare a lavorare sulla serratura."

# game/episode024.rpy:1369
translate italian ep024_sharard_c9eab3d4:

    # "After an agonizing two minutes, I heard her exhale in relief."
    "Dopo due minuti angosciosi, la sentii espirare di sollievo."

# game/episode024.rpy:1370
translate italian ep024_sharard_17f62836:

    # j "It’s done."
    j "È fatto."

# game/episode024.rpy:1373
translate italian ep024_sharard_d40f854c:

    # "The hostages looked up at us in surprise, as we walked into the room."
    "Gli ostaggi ci guardarono sorpresi mentre entravamo nella stanza."

# game/episode024.rpy:1375
translate italian ep024_sharard_2312c41e:

    # woman "Are you our new jailers?"
    woman "Siete i nostri nuovi carcerieri?"

# game/episode024.rpy:1376
translate italian ep024_sharard_13ff2ecf:

    # c "No, we’ve come to rescue you all."
    c "No, siamo venuti per salvarvi tutti."

# game/episode024.rpy:1377
translate italian ep024_sharard_3ba4af50:

    # c "We need to hurry."
    c "Dobbiamo sbrigarci."

# game/episode024.rpy:1378
translate italian ep024_sharard_a711fef7:

    # c "Are you able to move?"
    c "Are you able to move?"

# game/episode024.rpy:1379
translate italian ep024_sharard_5571a3d5:

    # woman "Yes, they didn’t hurt us."
    woman "Sì, non ci hanno fatto del male."

# game/episode024.rpy:1380
translate italian ep024_sharard_136b0e35:

    # c "Good, let’s go then, follow me."
    c "Bene, allora andiamo, seguimi."

# game/episode024.rpy:1381
translate italian ep024_sharard_0330d50d:

    # c "Speed and stealth are of the essence."
    c "La velocità e la furtività sono essenziali."

# game/episode024.rpy:1384
translate italian ep024_sharard_7cefe421:

    # "With the hostages following us, we made our way back to the caved-in room, my sisters and Kit giving us cover."
    "Con gli ostaggi che ci seguivano, tornammo alla stanza crollata, con le mie sorelle e Kit che ci proteggevano."

# game/episode024.rpy:1386
translate italian ep024_sharard_879677fa:

    # "With the hostages following us, we made our way back to the caved-in room, Lilly, Aven and Kit giving us cover."
    "Con gli ostaggi al seguito, siamo tornati alla stanza crollata, Lilly, Aven e Kit ci hanno fornito copertura."

# game/episode024.rpy:1388
translate italian ep024_sharard_6ea71a70:

    # "Attaching the lines to our harnesses again, we were ready for our descent."
    "Attaccando nuovamente le linee alle nostre imbracature, eravamo pronti per la discesa."

# game/episode024.rpy:1389
translate italian ep024_sharard_0c192d8d:

    # c "You’re going with us, one by one."
    c "Verrai con noi, uno per uno."

# game/episode024.rpy:1390
translate italian ep024_sharard_ef912c5a:

    # c "Hold on tight to me."
    c "Tienimi stretto."

# game/episode024.rpy:1391
translate italian ep024_sharard_6234824b:

    # "The first hostage gripped me tightly as we made our way down quickly to the bottom floor."
    "Il primo ostaggio mi afferrò saldamente mentre scendevamo rapidamente al piano inferiore."

# game/episode024.rpy:1392
translate italian ep024_sharard_d8d0d73e:

    # "We made the trip several times, until every last Rhenkoy diplomat was on the bottom floor."
    "Abbiamo fatto il viaggio più volte, finché fino all'ultimo diplomatico Rhenkoy era al piano inferiore."

# game/episode024.rpy:1393
translate italian ep024_sharard_46e45080:

    # "Kit, Lilly and Aven, relieved of their upstairs guard duty, made the final descent."
    "Kit, Lilly e Aven, sollevati dal servizio di guardia al piano di sopra, effettuarono la discesa finale."

# game/episode024.rpy:1395
translate italian ep024_sharard_326746af:

    # "Disengaging the harnesses, we hurried to the sewer hatch."
    "Sganciando le imbracature, ci affrettammo verso il portello della fogna."

# game/episode024.rpy:1397
translate italian ep024_sharard_98e0c443:

    # "We handed out gas masks for the Rhenkoy to wear, so they could make the journey through the sewer safely."
    "Abbiamo distribuito maschere antigas da indossare ai Rhenkoy, in modo che potessero affrontare il viaggio attraverso le fogne in sicurezza."

# game/episode024.rpy:1398
translate italian ep024_sharard_ee3828e2:

    # "When we finally emerged from the sewers, the shuttle was waiting for us in the same place we’d left it."
    "Quando finalmente siamo usciti dalle fogne, la navetta ci stava aspettando nello stesso posto in cui l’avevamo lasciata."

# game/episode024.rpy:1400
translate italian ep024_sharard_ba1dc994:

    # "In minutes, we had left Sharard and environs."
    "In pochi minuti avevamo lasciato Sharard e dintorni."

# game/episode024.rpy:1401
translate italian ep024_sharard_3534ad2d:

    # "The journey back to the capital took a little longer, due to the amount of new passengers cramming the shuttle."
    "Il viaggio di ritorno verso la capitale è durato un po' più a lungo, a causa della quantità di nuovi passeggeri che riempivano la navetta."

# game/episode024.rpy:1403
translate italian ep024_sharard_824d2099:

    # "Members of the Special Ops team were already waiting for us to receive the diplomats."
    "I membri della squadra delle operazioni speciali stavano già aspettando che ricevessimo i diplomatici."

# game/episode024.rpy:1404
translate italian ep024_sharard_bc521552:

    # "After they were led away for a debriefing, Nkoy Rhedia approached us."
    "Dopo che furono portati via per un debriefing, Nkoy Rhedia si avvicinò a noi."

# game/episode024.rpy:1406
translate italian ep024_sharard_3daf8e26:

    # rh "I reckon your mission was a success?"
    rh "Immagino che la tua missione sia stata un successo?"

# game/episode024.rpy:1407
translate italian ep024_sharard_77cf9d78:

    # c "Very much so."
    c "Molto."

# game/episode024.rpy:1408
translate italian ep024_sharard_304429f9:

    # c "No casualties and a clean getaway."
    c "Nessuna vittima e una fuga pulita."

# game/episode024.rpy:1410
translate italian ep024_sharard_e9ac7481:

    # rh "Good."
    rh "Bene."

# game/episode024.rpy:1411
translate italian ep024_sharard_97f646d7:

    # rh "The rescued diplomats will receive any care and rest they need."
    rh "I diplomatici salvati riceveranno tutte le cure e il riposo di cui avranno bisogno."

# game/episode024.rpy:1412
translate italian ep024_sharard_2517933e:

    # rh "After that, they will join the existing roster of officials already present in the greatship."
    rh "Successivamente, si uniranno all'elenco esistente di funzionari già presenti nella grande nave."

# game/episode024.rpy:1413
translate italian ep024_sharard_81f4ea4d:

    # rh "They’ll join your fleet at the earliest opportunity."
    rh "Si uniranno alla tua flotta il prima possibile."

# game/episode024.rpy:1414
translate italian ep024_sharard_e897fbb0:

    # c "Thank you."
    c "Grazie."

# game/episode024.rpy:1415
translate italian ep024_sharard_0c8ec01a:

    # c "We’ll make our own preparations and meet up with our fleet."
    c "Faremo i nostri preparativi e ci incontreremo con la nostra flotta."

# game/episode024.rpy:1417
translate italian ep024_sharard_a8fa2a0d:

    # rh "The Council of Nkoy thanks you for your service."
    rh "Il Consiglio di Nkoy ti ringrazia per il tuo servizio."

# game/episode024.rpy:1420
translate italian ep024_sharard_b1690635:

    # "Rhedia looked up at us in surprise, as we walked into the room."
    "Rhedia ci guardò sorpresa mentre entravamo nella stanza."

# game/episode024.rpy:1421
translate italian ep024_sharard_39799e10:

    # rh "I didn’t expect to see you again."
    rh "Non mi aspettavo di rivederti."

# game/episode024.rpy:1422
translate italian ep024_sharard_ac2bea30:

    # c "Me neither."
    c "Neanche io."

# game/episode024.rpy:1423
translate italian ep024_sharard_3ba4af50_1:

    # c "We need to hurry."
    c "Dobbiamo sbrigarci."

# game/episode024.rpy:1424
translate italian ep024_sharard_a711fef7_1:

    # c "Are you able to move?"
    c "Sei in grado di muoverti?"

# game/episode024.rpy:1426
translate italian ep024_sharard_28939137:

    # rh "Yes, they didn’t hurt me and fed me just enough."
    rh "Sì, non mi hanno fatto male e mi hanno nutrito quanto basta."

# game/episode024.rpy:1427
translate italian ep024_sharard_136b0e35_1:

    # c "Good, let’s go then, follow me."
    c "Bene, allora andiamo, seguimi."

# game/episode024.rpy:1428
translate italian ep024_sharard_0330d50d_1:

    # c "Speed and stealth are of the essence."
    c "La velocità e la furtività sono essenziali."

# game/episode024.rpy:1431
translate italian ep024_sharard_fdbd512e:

    # "With Rhedia following us, we made our way back to the caved-in room, my sisters and Kit giving us cover."
    "Con Rhedia che ci seguiva, tornammo alla stanza crollata, con le mie sorelle e Kit che ci coprivano."

# game/episode024.rpy:1433
translate italian ep024_sharard_7537f193:

    # "With Rhedia following us, we made our way back to the caved-in room, Lilly, Aven and Kit giving us cover."
    "Con Rhedia che ci seguiva, siamo tornati alla stanza crollata, Lilly, Aven e Kit ci hanno fornito copertura."

# game/episode024.rpy:1435
translate italian ep024_sharard_6ea71a70_1:

    # "Attaching the lines to our harnesses again, we were ready for our descent."
    "Attaccando nuovamente le linee alle nostre imbracature, eravamo pronti per la discesa."

# game/episode024.rpy:1436
translate italian ep024_sharard_ef912c5a_1:

    # c "Hold on tight to me."
    c "Tienimi stretto."

# game/episode024.rpy:1437
translate italian ep024_sharard_e6bf0176:

    # "Rhedia’s grip tightened considerably as we made our way down quickly to the bottom floor."
    "La presa di Rhedia si fece notevolmente più forte mentre scendevamo rapidamente al piano inferiore."

# game/episode024.rpy:1439
translate italian ep024_sharard_326746af_1:

    # "Disengaging the harnesses, we hurried to the sewer hatch."
    "Sganciando le imbracature, ci affrettammo verso il portello della fogna."

# game/episode024.rpy:1441
translate italian ep024_sharard_a2198fd8:

    # "We had a spare helmet for Rhedia to wear, so she could make the journey through the sewer safely."
    "Avevamo un casco di riserva da far indossare a Rhedia, in modo che potesse affrontare il viaggio attraverso le fogne in sicurezza."

# game/episode024.rpy:1443
translate italian ep024_sharard_ee3828e2_1:

    # "When we finally emerged from the sewers, the shuttle was waiting for us in the same place we’d left it."
    "Quando finalmente siamo usciti dalle fogne, la navetta ci stava aspettando nello stesso posto in cui l’avevamo lasciata."

# game/episode024.rpy:1445
translate italian ep024_sharard_ba1dc994_1:

    # "In minutes, we had left Sharard and environs."
    "In pochi minuti avevamo lasciato Sharard e dintorni."

# game/episode024.rpy:1447
translate italian ep024_sharard_6fb599dd:

    # rh "Thank you for coming to my rescue."
    rh "Grazie per essere venuto in mio soccorso."

# game/episode024.rpy:1448
translate italian ep024_sharard_0af645df:

    # rh "There was talk of moving me to another location, so you were right on time."
    rh "Si parlava di trasferirmi in un altro posto, quindi eri puntuale."

# game/episode024.rpy:1449
translate italian ep024_sharard_bcc4f190:

    # c "Somewhere more remote?"
    c "Un posto più remoto?"

# game/episode024.rpy:1451
translate italian ep024_sharard_7857a373:

    # rh "Most likely."
    rh "Più probabilmente."

# game/episode024.rpy:1452
translate italian ep024_sharard_b9af99ca:

    # rh "Nkoy Arlya wants me forgotten."
    rh "Nkoy Arlya vuole che mi dimentichi."

# game/episode024.rpy:1453
translate italian ep024_sharard_945af355:

    # c "Killing you seemed like an easier way out."
    c "Ucciderti sembrava una via d'uscita più semplice."

# game/episode024.rpy:1455
translate italian ep024_sharard_338a6bab:

    # rh "I have every confidence she was planning on doing so, but not before my reputation was tarnished and my death would have been a mere blip in the news cycle."
    rh "Ho piena fiducia che avesse intenzione di farlo, ma non prima che la mia reputazione fosse offuscata e la mia morte sarebbe stata un semplice incidente nel ciclo delle notizie."

# game/episode024.rpy:1456
translate italian ep024_sharard_f6083752:

    # rh "I’m glad you were able to prevent that."
    rh "Sono felice che tu sia riuscito a impedirlo."

# game/episode024.rpy:1457
translate italian ep024_sharard_23a9231f:

    # c "So am I."
    c "Anch'io."

# game/episode024.rpy:1459
translate italian ep024_sharard_638397df:

    # rh "But I guess you haven’t come to my aid just out of the goodness of your hearts."
    rh "Ma immagino che non siate venuti in mio aiuto solo per la bontà dei vostri cuori."

# game/episode024.rpy:1460
translate italian ep024_sharard_4c7c17c6:

    # c "I wish I could say otherwise, but no."
    c "Vorrei poter dire il contrario, ma no."

# game/episode024.rpy:1462
translate italian ep024_sharard_49c6d020:

    # "We quickly explained our purpose of returning to Uailea and Ziv’s attempt to rally support."
    "Abbiamo spiegato rapidamente il nostro scopo di tornare a Uailea e il tentativo di Ziv di raccogliere consensi."

# game/episode024.rpy:1464
translate italian ep024_sharard_89456fc2:

    # rh "I see."
    rh "Vedo."

# game/episode024.rpy:1465
translate italian ep024_sharard_9e706367:

    # rh "That’s quite the cause you’ve taken up, a lot of responsibility to bear."
    rh "Questa è proprio la causa che hai intrapreso, molte responsabilità da sopportare."

# game/episode024.rpy:1466
translate italian ep024_sharard_859acf06:

    # c "Yes, and that’s why we need help."
    c "Sì, ed è per questo che abbiamo bisogno di aiuto."

# game/episode024.rpy:1468
translate italian ep024_sharard_9e3f8ef4:

    # rh "We can certainly assist you with any diplomatic matters."
    rh "Possiamo certamente aiutarvi con qualsiasi questione diplomatica."

# game/episode024.rpy:1469
translate italian ep024_sharard_41a85fc5:

    # rh "I know I still have allies, so they are the first people I will reach out to."
    rh "So di avere ancora degli alleati, quindi saranno loro le prime persone a cui mi rivolgerò."

# game/episode024.rpy:1471
translate italian ep024_sharard_7f07fc82:

    # zi "Is it safe for you to remain on Uailea, Nkoy Rhedia?"
    zi "È sicuro per te rimanere su Uailea, Nkoy Rhedia?"

# game/episode024.rpy:1473
translate italian ep024_sharard_92b00b73:

    # rh "No, I imagine my time still allowed on this planet is rather short."
    rh "No, immagino che il tempo che mi è ancora concesso su questo pianeta sia piuttosto breve."

# game/episode024.rpy:1474
translate italian ep024_sharard_2112e4f1:

    # rh "My followers have a greatship docked in Ysteresh."
    rh "I miei seguaci hanno una grande nave attraccata a Ysteresh."

# game/episode024.rpy:1475
translate italian ep024_sharard_e5d867fa:

    # rh "I’ll gather the support I can muster and take off from Ysteresh to join your fleet."
    rh "Raccoglierò tutto il sostegno possibile e decollerò da Ysteresh per unirmi alla tua flotta."

# game/episode024.rpy:1476
translate italian ep024_sharard_1e9dbef8:

    # c "Should we take you to Ysteresh?"
    c "Dovremmo portarti a Ysteresh?"

# game/episode024.rpy:1478
translate italian ep024_sharard_8fbe412e:

    # rh "No, could you drop me off at these coordinates?"
    rh "No, potresti lasciarmi a queste coordinate?"

# game/episode024.rpy:1479
translate italian ep024_sharard_b9deee49:

    # rh "My followers will smuggle me to where I’m needed."
    rh "I miei seguaci mi porteranno clandestinamente dove c’è bisogno di me."

# game/episode024.rpy:1480
translate italian ep024_sharard_7f3454bb:

    # rh "Could I use the shuttle comms for a second?"
    rh "Posso usare le comunicazioni della navetta per un secondo?"

# game/episode024.rpy:1482
translate italian ep024_sharard_b3d3e123:

    # "We reached Rhedia’s destination in under an hour, a nondescript shack at the side of an empty dirt road."
    "Abbiamo raggiunto la destinazione di Rhedia in meno di un'ora, una baracca anonima sul lato di una strada sterrata deserta."

# game/episode024.rpy:1483
translate italian ep024_sharard_a324b409:

    # c "Will you be all right?"
    c "Starai bene?"

# game/episode024.rpy:1485
translate italian ep024_sharard_e600be3f:

    # rh "Yes, my followers are on their way and will be here any minute."
    rh "Sì, i miei follower stanno arrivando e saranno qui a minuti."

# game/episode024.rpy:1486
translate italian ep024_sharard_09ef8c13:

    # rh "I’ll be in contact as soon as the greatship is ready to join your fleet."
    rh "Ti contatterò non appena la grande nave sarà pronta per unirsi alla tua flotta."

# game/episode024.rpy:1488
translate italian ep024_sharard_d0b4618c:

    # zi "Thank you, Nkoy Rhedia."
    zi "Grazie, Nkoy Rhedia."

# game/episode024.rpy:1489
translate italian ep024_sharard_0f69df95:

    # rh "No, thank you all."
    rh "No, grazie a tutti."

# game/episode024.rpy:1490
translate italian ep024_sharard_71d8213a:

    # rh "Without you, I’d have been locked up in a windowless cell for the rest of my short life."
    rh "Senza di te, sarei stato rinchiuso in una cella senza finestre per il resto della mia breve vita."

# game/episode024.rpy:1492
translate italian ep024_sharard_dc5629fd:

    # "We took the shuttle back to the capital."
    "Riprendiamo la navetta per tornare nella capitale."

# game/episode024.rpy:1494
translate italian ep024_sharard_0ccbc9a5:

    # "No officials were waiting to detain us upon our arrival."
    "Nessun funzionario era in attesa di trattenerci al nostro arrivo."

# game/episode024.rpy:1495
translate italian ep024_sharard_1bc858b6:

    # "I decided it was better not to wait for the moment the officials did arrive and cleared out the apartment."
    "Ho deciso che era meglio non aspettare il momento in cui arrivavano i funzionari e sgomberavano l'appartamento."

# game/episode024.rpy:1496
translate italian ep024_sharard_9b4406ba:

    # "Céline had been busy getting the Iron Bastard ready for its next journey."
    "Céline era impegnata a preparare l'Iron Bastard per il suo prossimo viaggio."

# game/episode024.rpy:1498
translate italian ep024_sharard_ed21100c:

    # "We took off to rejoin the Tubloshi fleet not soon after our return to the capital."
    "Decollammo per ricongiungerci alla flotta Tubloshi non subito dopo il nostro ritorno nella capitale."

# game/episode024.rpy:1499
translate italian ep024_sharard_776d7a7f:

    # "As we were about to break Uailea’s atmosphere, a message pinged on the ship’s comms."
    "Mentre stavamo per rompere l'atmosfera di Uailea, un messaggio risuonò nelle comunicazioni della nave."

# game/episode024.rpy:1501
translate italian ep024_sharard_d77f9328:

    # c "Nkoy Arlya, I’m honored you’re seeing us off with a personal message."
    c "Nkoy Arlya, sono onorato che tu ci saluti con un messaggio personale."

# game/episode024.rpy:1502
translate italian ep024_sharard_d6aebc9a:

    # arl "I know what you did, [p_name]."
    arl "So cosa hai fatto, [p_name]."

# game/episode024.rpy:1503
translate italian ep024_sharard_adc7d363:

    # arl "That was a bold move, stealing Rhedia from me."
    arl "È stata una mossa coraggiosa, portarmi via Rhedia."

# game/episode024.rpy:1504
translate italian ep024_sharard_971b28b2:

    # arl "A futile gesture though, because I’ll find her and put her out of her misery for good."
    arl "Un gesto inutile però, perché la troverò e metterò fine alla sua miseria per sempre."

# game/episode024.rpy:1505
translate italian ep024_sharard_a623868a:

    # c "I don’t know what you’re talking about, but I sure don’t doubt your tenacity."
    c "Non so di cosa stai parlando, ma di sicuro non dubito della tua tenacia."

# game/episode024.rpy:1506
translate italian ep024_sharard_86f9cf5c:

    # c "Good luck running that corrupt government of yours."
    c "Buona fortuna con il tuo governo corrotto."

# game/episode024.rpy:1507
translate italian ep024_sharard_b096121e:

    # c "I’m sure we’ll meet again."
    c "Sono sicuro che ci incontreremo di nuovo."

# game/episode024.rpy:1508
translate italian ep024_sharard_074d794d:

    # arl "If you survive that long."
    arl "Se sopravvivi così a lungo."

# game/episode024.rpy:1509
translate italian ep024_sharard_acd328f5:

    # c "Sure, though I aim to live a long and happy life."
    c "Certo, anche se il mio obiettivo è vivere una vita lunga e felice."

# game/episode024.rpy:1510
translate italian ep024_sharard_26fff1da:

    # c "Bye now."
    c "Ciao, per ora."

# game/episode024.rpy:1511
translate italian ep024_sharard_22cf0b31:

    # "Arlya clearly didn’t deem that worthy of a response, because after an audible click, only static could be heard on the comms."
    "Arlya chiaramente non lo ritenne degno di risposta, perché dopo un clic udibile, nelle comunicazioni si sentiva solo rumore statico."

# game/episode024.rpy:1518
translate italian ep024_uailea_departure_f24995ea:

    # "The Tubloshi fleet was waiting for us in the designated spot."
    "La flotta Tubloshi ci aspettava nel luogo designato."

# game/episode024.rpy:1521
translate italian ep024_uailea_departure_391aaf0b:

    # "After a few days, we received a message from Rhedia."
    "Dopo alcuni giorni abbiamo ricevuto un messaggio da Rhedia."

# game/episode024.rpy:1522
translate italian ep024_uailea_departure_35be6150:

    # "She had escaped with a group of diplomats on the greatship from the shipyard at Ysteresh and was due to arrive in a few minutes."
    "Era fuggita con un gruppo di diplomatici sulla grande nave dal cantiere navale di Ysteresh e sarebbe dovuta arrivare entro pochi minuti."

# game/episode024.rpy:1524
translate italian ep024_uailea_departure_da205589:

    # "Sure enough, the greatship appeared on our screens not soon after."
    "Come previsto, la grande nave è apparsa sui nostri schermi non subito dopo."

# game/episode024.rpy:1525
translate italian ep024_uailea_departure_a6036227:

    # rh "Greetings, Captain of the Iron Bastard."
    rh "Saluti, Capitano del Bastardo di Ferro."

# game/episode024.rpy:1526
translate italian ep024_uailea_departure_8bf043ef:

    # c "Greetings, Nkoy Rhedia."
    c "Saluti, Nkoy Rhedia."

# game/episode024.rpy:1527
translate italian ep024_uailea_departure_2e7c14ca:

    # c "I take you had no trouble getting off Uailea."
    c "Immagino che tu non abbia avuto problemi a lasciare Uailea."

# game/episode024.rpy:1528
translate italian ep024_uailea_departure_98a8bffd:

    # rh "Our departure was unopposed."
    rh "La nostra partenza è stata incontrastata."

# game/episode024.rpy:1529
translate italian ep024_uailea_departure_02f76b03:

    # rh "I have a large group of diplomats ready to do their duty."
    rh "Ho un folto gruppo di diplomatici pronti a fare il loro dovere."

# game/episode024.rpy:1530
translate italian ep024_uailea_departure_c6c14683:

    # c "Very good."
    c "Molto bene."

# game/episode024.rpy:1531
translate italian ep024_uailea_departure_88dc96e8:

    # c "The Tubloshi commander will provide you with coordinates and assist you in any way."
    c "Il comandante Tubloshi ti fornirà le coordinate e ti assisterà in ogni modo."

# game/episode024.rpy:1532
translate italian ep024_uailea_departure_89391e09:

    # c "We will travel elsewhere, but will join up with you all to discuss our progress."
    c "Viaggeremo altrove, ma ci uniremo a tutti voi per discutere dei nostri progressi."

# game/episode024.rpy:1533
translate italian ep024_uailea_departure_c392d773:

    # rh "Very good."
    rh "Molto bene."

# game/episode024.rpy:1534
translate italian ep024_uailea_departure_6294542d:

    # rh "Greatship Tamramxi out."
    rh "Greatship Tamramxi fuori."

# game/episode024.rpy:1536
translate italian ep024_uailea_departure_4ac807e5:

    # "After a few hours, the greatship containing the Rhenkoy diplomats joined us."
    "Dopo alcune ore, la grande nave contenente i diplomatici Rhenkoy ci raggiunse."

# game/episode024.rpy:1538
translate italian ep024_uailea_departure_1204ae86:

    # "The Tubloshi and Rhenkoy headed out to their coordinates."
    "Il Tubloshi e il Rhenkoy si diressero verso le loro coordinate."

# game/episode024.rpy:1543
translate italian ep024_uailea_departure_abffdf4e:

    # "Eva joined me on the bridge."
    "Eva mi raggiunse sul ponte."

# game/episode024.rpy:1544
translate italian ep024_uailea_departure_d07f606b:

    # c "Ready to go back to Erigone?"
    c "Pronti a tornare ad Erigone?"

# game/episode024.rpy:1545
translate italian ep024_uailea_departure_2212a7a5:

    # e "Not exactly, but I don’t think we have much choice."
    e "Non esattamente, ma non credo che abbiamo molta scelta."

# game/episode024.rpy:1546
translate italian ep024_uailea_departure_30a6904a:

    # c "No, I don’t think we have."
    c "No, non penso che lo abbiamo fatto."

# game/episode024.rpy:1547
translate italian ep024_uailea_departure_7059ef02:

    # c "Céline, plot a course to Erigone, the Virgin Queen is ready to claim her throne."
    c "Céline, traccia una rotta verso Erigone, la Regina Vergine è pronta a reclamare il suo trono."

# game/episode024.rpy:1554
translate italian ep024_uailea_jade_1a42b171:

    # "Jade had asked me to come to a spot overlooking the Uailea capital."
    "Jade mi aveva chiesto di venire in un punto che domina la capitale Uailea."

# game/episode024.rpy:1555
translate italian ep024_uailea_jade_46b5ecf2:

    # "I found her sitting on a rock, staring at the sky."
    "L'ho trovata seduta su una roccia, che fissava il cielo."

# game/episode024.rpy:1556
translate italian ep024_uailea_jade_2a411c02:

    # c "Hey Jade, everything all right?"
    c "Ehi Giada, tutto bene?"

# game/episode024.rpy:1558
translate italian ep024_uailea_jade_cd88fbb2:

    # j "Hey!"
    j "EHI!"

# game/episode024.rpy:1559
translate italian ep024_uailea_jade_547e7778:

    # j "No, I’m not all right, I feel fantastic!"
    j "No, non sto bene, mi sento benissimo!"

# game/episode024.rpy:1561
translate italian ep024_uailea_jade_17a19df9:

    # j "[p_name_short], we’re having a baby!"
    j "[p_name_short], stiamo per avere un bambino!"

# game/episode024.rpy:1565
translate italian ep024_uailea_jade_558e76fa:

    # j "The treatment worked!"
    j "Il trattamento ha funzionato!"

# game/episode024.rpy:1566
translate italian ep024_uailea_jade_49cff13e:

    # c "Jade, that’s such good news!"
    c "Giada, che bella notizia!"

# game/episode024.rpy:1568
translate italian ep024_uailea_jade_3c4c0930:

    # "I crawled onto the rock and took Jade into my arms."
    "Strisciai sulla roccia e presi Jade tra le braccia."

# game/episode024.rpy:1569
