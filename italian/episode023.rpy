translate italian episode023_48558049:

    # ra "There’s no other word for it."
    ra "Non c’è altra parola per descriverlo."

# game/episode023.rpy:282
translate italian episode023_1bd3355a:

    # ra "I miss you so much."
    ra "Mi manchi tanto."

# game/episode023.rpy:283
translate italian episode023_6cb3b9c4:

    # ra "I love you, [p_name_short]."
    ra "Ti amo, [p_name_short]."

# game/episode023.rpy:287
