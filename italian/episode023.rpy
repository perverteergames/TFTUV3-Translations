translate italian ep023_crew_cbad1f14:

    # "On that sour note, all the girls left us."
    "Con quella nota amara, tutte le ragazze ci hanno lasciato."

# game/episode023.rpy:1395
translate italian ep023_crew_fc5824f3:

    # "Nadya was still sitting on my bed, looking a little forlorn."
    "Nadya era ancora seduta sul mio letto e sembrava un po' abbandonata."

# game/episode023.rpy:1396
translate italian ep023_crew_810d8bd6:

    # na "I wanted to tell you earlier in person, but you were just out of the medbay."
    na "Avrei voluto dirtelo prima di persona, ma eri appena uscito dall'infermeria."

# game/episode023.rpy:1398
translate italian ep023_crew_f0fc7517:

    # na "And then Lilly and Aven made their announcements..."
    na "E poi Lilly e Aven hanno fatto i loro annunci..."

# game/episode023.rpy:1400
translate italian ep023_crew_2f70b940:

    # na "And then Lilly made her announcement..."
    na "E poi Lilly fece il suo annuncio..."

# game/episode023.rpy:1402
translate italian ep023_crew_c96ac942:

    # na "And then Aven made her announcement..."
    na "E poi Aven ha fatto il suo annuncio..."

# game/episode023.rpy:1403
translate italian ep023_crew_cf099f60:

    # c "You were worried I wouldn’t be able to take the shock?"
    c "Eri preoccupato che non sarei riuscito a sopportare lo shock?"

# game/episode023.rpy:1405
translate italian ep023_crew_610711a1:

    # na "Maybe...{w} Something like that."
    na "Forse...{w} Qualcosa del genere."

# game/episode023.rpy:1406
translate italian ep023_crew_96f19fbc:

    # na "Maybe you’d be disappointed..."
    na "Forse rimarrai deluso..."

# game/episode023.rpy:1407
translate italian ep023_crew_fc1d68d9:

    # c "Disappointed?"
    c "Deluso?"

# game/episode023.rpy:1409
translate italian ep023_crew_d3d2a588:

    # c "I’m over the moon, Mom!"
    c "Sono al settimo cielo, mamma!"

# game/episode023.rpy:1411
translate italian ep023_crew_7e206ad0:

    # c "I’m over the moon!"
    c "Sono al settimo cielo!"

# game/episode023.rpy:1412
translate italian ep023_crew_46c0697a:

    # c "We talked it over, didn’t we?"
    c "Ne abbiamo parlato, vero?"

# game/episode023.rpy:1413
translate italian ep023_crew_373f1bd2:

    # c "We both decided we wanted this, and I still do."
    c "Entrambi abbiamo deciso che lo volevamo, e lo faccio ancora."

# game/episode023.rpy:1414
translate italian ep023_crew_8acef7ce:

    # c "You don’t know how happy you’ve made me."
    c "Non sai quanto mi hai reso felice."

# game/episode023.rpy:1416
translate italian ep023_crew_93495d47:

    # na "Sorry, [p_name_short], I don’t know what came over me."
    na "Mi spiace, [p_name_short], non so cosa mi sia preso."

# game/episode023.rpy:1417
translate italian ep023_crew_4c8f87ca:

    # na "With all that happened on Petrarch and you being in a coma, I just started to panic."
    na "Con tutto quello che è successo a Petrarca e il fatto che tu fossi in coma, ho iniziato a farmi prendere dal panico."

# game/episode023.rpy:1418
translate italian ep023_crew_6ca12e31:

    # na "What if you’d come out of that coma all changed?"
    na "E se uscissi dal coma tutto cambiato?"

# game/episode023.rpy:1419
translate italian ep023_crew_6d199864:

    # na "We’d be all alone in the galaxy, running from the Sovereignty and my pregnancy would be a risk, a liability even."
    na "Saremmo tutti soli nella galassia, a scappare dalla Sovranità e la mia gravidanza sarebbe un rischio, addirittura una responsabilità."

# game/episode023.rpy:1420
translate italian ep023_crew_38163117:

    # c "I would never think something like that."
    c "Non penserei mai una cosa del genere."

# game/episode023.rpy:1421
translate italian ep023_crew_dfd98ce4:

    # na "I know, and I’m sorry."
    na "Lo so e mi dispiace."

# game/episode023.rpy:1422
translate italian ep023_crew_478dc73f:

    # na "I just don’t want to lose you."
    na "È solo che non voglio perderti."

# game/episode023.rpy:1423
translate italian ep023_crew_fc9b6787:

    # c "You won’t, and I won’t let anything happen to you and the baby."
    c "Non lo farai e non permetterò che succeda nulla a te e al bambino."

# game/episode023.rpy:1424
translate italian ep023_crew_2bb9cdd8:

    # c "Shall we talk about happy things now, there’s been enough doom and gloom for one day, I’d say?"
    c "Vogliamo parlare di cose felici adesso, per oggi c'è stata già abbastanza tristezza e tristezza, direi?"

# game/episode023.rpy:1426
translate italian ep023_crew_d5a29f5b:

    # na "I agree."
    na "Sono d'accordo."

# game/episode023.rpy:1427
translate italian ep023_crew_23d8719d:

    # c "How long have you known?"
    c "Da quanto tempo lo sai?"

# game/episode023.rpy:1428
translate italian ep023_crew_b6f7749e:

    # na "A few weeks now."
    na "Alcune settimane ormai."

# game/episode023.rpy:1429
translate italian ep023_crew_1eb64a23:

    # na "I did a test when we were back on the Bastard, taking turns watching over you."
    na "Ho fatto un test quando eravamo di nuovo sulla Bastard, facendo a turno per sorvegliarti."

# game/episode023.rpy:1431
translate italian ep023_crew_b8c800aa:

    # na "I was so happy at first, [p_name_short], becoming a mother again!"
    na "All'inizio ero così felice, [p_name_short], di diventare di nuovo madre!"

# game/episode023.rpy:1433
translate italian ep023_crew_6352beed:

    # na "I was so happy at first, [p_name_short], becoming a mother!"
    na "All'inizio ero così felice, [p_name_short], di diventare madre!"

# game/episode023.rpy:1435
translate italian ep023_crew_caa59837:

    # na "Only after I told you the news at your bedside, did the worry set in."
    na "Solo dopo che ti ho raccontato la notizia al tuo capezzale, la preoccupazione ha preso il sopravvento."

# game/episode023.rpy:1437
translate italian ep023_crew_6fc4b47c:

    # na "The girl’s reaction just now was what I feared too."
    na "Anche la reazione della ragazza in quel momento era ciò che temevo."

# game/episode023.rpy:1438
translate italian ep023_crew_847acb4f:

    # c "Don’t worry, they’ll come around."
    c "Non preoccuparti, arriveranno."

# game/episode023.rpy:1440
translate italian ep023_crew_326035d3:

    # na "Aven’s reaction just now was what I feared too."
    na "Anche la reazione di Aven in quel momento era ciò che temevo."

# game/episode023.rpy:1441
translate italian ep023_crew_7ae0bbbc:

    # c "Don’t worry, she’ll come around."
    c "Non preoccuparti, lei tornerà."

# game/episode023.rpy:1443
translate italian ep023_crew_4f8c38e8:

    # na "Lilly’s reaction just now was what I feared too."
    na "La reazione di Lilly proprio adesso era ciò che temevo anch'io."

# game/episode023.rpy:1444
translate italian ep023_crew_7ae0bbbc_1:

    # c "Don’t worry, she’ll come around."
    c "Non preoccuparti, lei tornerà."

# game/episode023.rpy:1446
translate italian ep023_crew_76baf0b0:

    # na "Eva’s reaction just now was what I feared too."
    na "La reazione di Eva proprio adesso era quella che temevo anch'io."

# game/episode023.rpy:1447
translate italian ep023_crew_7ae0bbbc_2:

    # c "Don’t worry, she’ll come around."
    c "Non preoccuparti, lei tornerà."

# game/episode023.rpy:1449
translate italian ep023_crew_a4c59678:

    # na "I’m not so sure."
    na "Non ne sono così sicuro."

# game/episode023.rpy:1450
translate italian ep023_crew_bed8d552:

    # c "They might not accept our love, but they’ll have to deal with the fact that you’re pregnant sooner or later."
    c "Potrebbero non accettare il nostro amore, ma prima o poi dovranno fare i conti con il fatto che sei incinta."

# game/episode023.rpy:1451
translate italian ep023_crew_3ed1b816:

    # na "I hope so, [p_name_short], I really hope so."
    na "Lo spero, [p_name_short], lo spero davvero."

# game/episode023.rpy:1452
translate italian ep023_crew_56c3579f:

    # c "We’ll get through this."
    c "Supereremo tutto questo."

# game/episode023.rpy:1453
translate italian ep023_crew_598fe70e:

    # c "Our child is going to grow up in peace with a loving mother and father."
    c "Nostro figlio crescerà in pace con una madre e un padre amorevoli."

# game/episode023.rpy:1456
translate italian ep023_crew_4a05bada:

    # "My mother smiled hopefully and rested her head against my shoulder."
    "Mia madre sorrise speranzosa e appoggiò la testa sulla mia spalla."

# game/episode023.rpy:1458
translate italian ep023_crew_aee88a27:

    # "Nadya smiled hopefully and rested her head against my shoulder."
    "Nadya sorrise speranzosa e appoggiò la testa sulla mia spalla."

# game/episode023.rpy:1460
translate italian ep023_crew_18902aa3:

    # na "Could you perhaps visit my quarters later?"
    na "Potresti forse visitare i miei alloggi più tardi?"

# game/episode023.rpy:1461
translate italian ep023_crew_8657d262:

    # na "To spend the night, I mean."
    na "Per passare la notte, intendo."

# game/episode023.rpy:1462
translate italian ep023_crew_64584fdf:

    # c "Of course I’ll come."
    c "Certo che verrò."

# game/episode023.rpy:1463
translate italian ep023_crew_4c71d833:

    # na "Thank you."
    na "Grazie."

# game/episode023.rpy:1464
translate italian ep023_crew_53d9d2ea:

    # na "I just want you close after being separated for so long."
    na "Voglio solo che tu sia vicino dopo essere stato separato per così tanto tempo."

# game/episode023.rpy:1466
translate italian ep023_crew_7d43a4a6:

    # "We sat in silence until we both decided it was time to brave the outside world."
    "Restammo seduti in silenzio finché entrambi non decidemmo che era ora di sfidare il mondo esterno."

# game/episode023.rpy:1473
translate italian ep023_crew_6eb8a8b7:

    # av "Now you have to tell us all about your pregnancy, Mom."
    av "Ora devi raccontarci tutto della tua gravidanza, mamma."

# game/episode023.rpy:1475
translate italian ep023_crew_c7cefeac:

    # av "Now you have to tell us all about your pregnancy, Nadya."
    av "Ora devi raccontarci tutto della tua gravidanza, Nadya."

# game/episode023.rpy:1476
translate italian ep023_crew_204d0ca6:

    # e "Yes, how long have you known?!"
    e "Sì, da quanto tempo lo sai?!"

# game/episode023.rpy:1478
translate italian ep023_crew_5115fd37:

    # "I left the girls talking exuberantly about their mother’s happy news and prepared to inform the rest of the crew."
    "Ho lasciato le ragazze parlare con esuberanza della felice notizia della madre e mi sono preparata ad informare il resto dell'equipaggio."

# game/episode023.rpy:1480
translate italian ep023_crew_8b2422f6:

    # "I left the girls talking exuberantly about Nadya’s happy news and prepared to inform the rest of the crew."
    "Ho lasciato le ragazze parlare con esuberanza della lieta notizia di Nadya e mi sono preparato ad informare il resto dell'equipaggio."

# game/episode023.rpy:1482
translate italian ep023_crew_8a18dd1c:

    # c "Right, that’s all for now, thank you all."
    c "Bene, per ora è tutto, grazie a tutti."

# game/episode023.rpy:1484
translate italian ep023_crew_2eeff45f:

    # "The girls left my quarters and I got busy preparing to inform the rest of the crew."
    "Le ragazze lasciarono i miei alloggi e io mi occupai dei preparativi per informare il resto dell'equipaggio."

# game/episode023.rpy:1491
translate italian ep023_tubloshi_1200c6d0:

    # "The following morning, Aven let me know that one of our first diplomatic overtures had borne fruit."
    "La mattina seguente, Aven mi fece sapere che una delle nostre prime aperture diplomatiche aveva dato i suoi frutti."

# game/episode023.rpy:1492
translate italian ep023_tubloshi_d7992da9:

    # "The Tubloshi had responded almost immediately to our invitation and arranged for a rendezvous in a neutral location."
    "I Tubloshi avevano risposto quasi subito al nostro invito e avevano fissato un appuntamento in un luogo neutrale."

# game/episode023.rpy:1493
translate italian ep023_tubloshi_4eeaff58:

    # "I joined Céline and her on the bridge as we made our approach."
    "Ho raggiunto Céline e lei sul ponte mentre ci avvicinavamo."

# game/episode023.rpy:1494
translate italian ep023_tubloshi_717fed81:

    # c "It’s happening."
    c "Sta succedendo."

# game/episode023.rpy:1495
translate italian ep023_tubloshi_18e204b6:

    # c "Did they seem friendly in their message?"
    c "Sembravano amichevoli nel loro messaggio?"

# game/episode023.rpy:1497
translate italian ep023_tubloshi_26f80052:

    # av "They were formal, but nothing overtly friendly, nor hostile."
    av "Erano formali, ma niente di apertamente amichevoli, né ostili."

# game/episode023.rpy:1498
translate italian ep023_tubloshi_2564a2dc:

    # c "I guess we’ll know soon enough."
    c "Immagino che lo sapremo abbastanza presto."

# game/episode023.rpy:1499
translate italian ep023_tubloshi_e0b2338e:

    # c "Be ready to jump as soon as you notice something out of the ordinary, Céline."
    c "Preparati a saltare non appena noti qualcosa fuori dall'ordinario, Céline."

# game/episode023.rpy:1501
translate italian ep023_tubloshi_1605c824:

    # ce "I will."
    ce "Lo farò."

# game/episode023.rpy:1502
translate italian ep023_tubloshi_7164ea82:

    # c "Weapons at the ready, Aven."
    c "Armi pronte, Aven."

# game/episode023.rpy:1504
translate italian ep023_tubloshi_5ebe1729:

    # "Almost immediately after we entered the agreed-upon system, a large warship dropped out of hyperspace."
    "Quasi immediatamente dopo essere entrati nel sistema concordato, una grande nave da guerra è caduta dall'iperspazio."

# game/episode023.rpy:1506
translate italian ep023_tubloshi_21b75fbf:

    # av "That’s them."
    av "Sono loro."

# game/episode023.rpy:1507
translate italian ep023_tubloshi_cd3f6780:

    # ce "They’re hailing us already."
    ce "Ci stanno già chiamando."

# game/episode023.rpy:1508
translate italian ep023_tubloshi_624bee8f:

    # c "Put them through."
    c "Fateli passare."

# game/episode023.rpy:1509
translate italian ep023_tubloshi_4a6a1489:

    # "A familiar sounding voice resonated through the bridge."
    "Una voce dal suono familiare risuonò attraverso il ponte."

# game/episode023.rpy:1510
translate italian ep023_tubloshi_836beadd:

    # ha "Greetings, [p_name] of the Humans."
    ha "Saluti, [p_name] degli Umani."

# game/episode023.rpy:1511
translate italian ep023_tubloshi_926e6f41:

    # c "Greetings, Mighty Warriors of the Tubloshi, I’m overjoyed that you honor us with your presence."
    c "Saluti, potenti guerrieri del Tubloshi, sono felicissimo che ci onorate con la vostra presenza."

# game/episode023.rpy:1513
translate italian ep023_tubloshi_856672f0:

    # ha "As you well should, [p_name] of the Humans."
    ha "Come dovresti fare, [p_name] degli Umani."

# game/episode023.rpy:1514
translate italian ep023_tubloshi_e9da77e6:

    # ha "We have received your missive and have reluctantly agreed to discuss its contents."
    ha "Abbiamo ricevuto la tua missiva e abbiamo accettato con riluttanza di discuterne il contenuto."

# game/episode023.rpy:1515
translate italian ep023_tubloshi_2457721a:

    # ha "You may dock with our ship and await our coming in the vestibule."
    ha "Potete attraccare alla nostra nave e attendere il nostro arrivo nel vestibolo."

# game/episode023.rpy:1517
translate italian ep023_tubloshi_2065df64:

    # ha "The honor is ours, [p_name] of the Humans."
    ha "L'onore è nostro, [p_name] degli Umani."

# game/episode023.rpy:1518
translate italian ep023_tubloshi_53a988ab:

    # ha "We have received your missive and would like to discuss its content in the comfort of our ship."
    ha "Abbiamo ricevuto la tua missiva e vorremmo discuterne il contenuto nel comfort della nostra nave."

# game/episode023.rpy:1519
translate italian ep023_tubloshi_00998f18:

    # ha "You may dock with our ship, and we will welcome you personally."
    ha "Puoi attraccare con la nostra nave e ti accoglieremo personalmente."

# game/episode023.rpy:1520
translate italian ep023_tubloshi_811a6e8d:

    # c "Of course, we’ll dock immediately."
    c "Naturalmente attraccheremo immediatamente."

# game/episode023.rpy:1522
translate italian ep023_tubloshi_90add027:

