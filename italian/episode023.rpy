# game/episode023.rpy:1227
translate italian ep023_crew_fd59213e:

    # l "You’re going to be very busy, both of you, becoming a grandmother and mother at roughly the same time."
    l "Sarete molto impegnate, entrambe, e diventerete nonna e madre più o meno nello stesso periodo."

# game/episode023.rpy:1229
translate italian ep023_crew_22447154:

    # l "You’re going to be very busy, both of you, with several children on the way at roughly the same time."
    l "Sarete molto impegnati entrambi, con diversi bambini in arrivo più o meno nello stesso momento."

# game/episode023.rpy:1230
translate italian ep023_crew_7e1d61f4:

    # l "I’m so happy we all get to experience this!"
    l "Sono così felice che tutti possiamo sperimentarlo!"

# game/episode023.rpy:1232
translate italian ep023_crew_ff64f6b5:

    # av "Yeah, congrats, [p_name_short]."
    av "Sì, congratulazioni, [p_name_short]."

# game/episode023.rpy:1234
translate italian ep023_crew_7639647a:

    # av "The ship sure is going to be crowded after a few months."
    av "La nave sarà sicuramente affollata dopo pochi mesi."

# game/episode023.rpy:1239
translate italian ep023_crew_fd5fb505:

    # c "Okay, let's focus on the crisis at hand."
    c "Ok, concentriamoci sulla crisi in corso."

# game/episode023.rpy:1241
translate italian ep023_crew_d2c7979c:

    # c "Thanks all."
    c "Grazie a tutti."

# game/episode023.rpy:1244
translate italian ep023_crew_8067c3c3:

    # c "Mom, I’m very much thinking of the future."
    c "Mamma, penso moltissimo al futuro."

# game/episode023.rpy:1246
translate italian ep023_crew_e2830944:

    # c "Nadya, I’m very much thinking of the future."
    c "Nadya, penso moltissimo al futuro."

# game/episode023.rpy:1247
translate italian ep023_crew_63f79ed3:

    # c "I don’t want our children to grow up as prey, hunted by the Sovereignty."
    c "Non voglio che i nostri figli crescano come prede, braccati dalla Sovranità."

# game/episode023.rpy:1248
translate italian ep023_crew_ff95ce8b:

    # c "I want them to have a good life, in freedom and prosperity."
    c "Voglio che abbiano una bella vita, nella libertà e nella prosperità."

# game/episode023.rpy:1250
translate italian ep023_crew_e81dfaa3:

    # c "I am thinking of the future."
    c "Sto pensando al futuro."

# game/episode023.rpy:1251
translate italian ep023_crew_38e1f8f2:

    # c "I don’t want to live in fear, hunted by the Sovereignty."
    c "Non voglio vivere nella paura, braccato dalla Sovranità."

# game/episode023.rpy:1252
translate italian ep023_crew_ca4dc15f:

    # c "I want us to have a good life, in freedom and prosperity."
    c "Voglio che abbiamo una bella vita, nella libertà e nella prosperità."

# game/episode023.rpy:1253
translate italian ep023_crew_e8901e79:

    # c "If we don’t act now, we’ll die."
    c "Se non agiamo adesso, moriremo."

# game/episode023.rpy:1254
translate italian ep023_crew_344eadde:

    # c "Maybe not tomorrow, but we will get killed at some point."
    c "Forse non domani, ma prima o poi verremo uccisi."

# game/episode023.rpy:1255
translate italian ep023_crew_2166685d:

    # c "So we’re going to build alliances, and strike at the heart of the Sovereignty when we’re ready."
    c "Quindi costruiremo alleanze e colpiremo il cuore della sovranità quando saremo pronti."

# game/episode023.rpy:1256
translate italian ep023_crew_6273f75c:

    # c "The resistance will be planned carefully and with as little risk as possible."
    c "La resistenza sarà pianificata attentamente e con il minor rischio possibile."

# game/episode023.rpy:1258
translate italian ep023_crew_f731484f:

    # na "You want to take on your father personally, isn’t that right?"
    na "Vuoi affrontare tuo padre personalmente, non è vero?"

# game/episode023.rpy:1259
translate italian ep023_crew_d8b6a2a8:

    # c "Yes, I want to."
    c "Sì, lo voglio."

# game/episode023.rpy:1260
translate italian ep023_crew_5e4241fe:

    # c "But only after we found out the extent of his powers and the level of protection surrounding him."
    c "Ma solo dopo aver scoperto la portata dei suoi poteri e il livello di protezione che lo circonda."

# game/episode023.rpy:1261
translate italian ep023_crew_2fa65c1a:

    # c "I don’t plan on barging into Sovereignty space to try and get a shot at him."
    c "Non ho intenzione di irrompere nello spazio di Sovereignty per cercare di sparargli."

# game/episode023.rpy:1262
translate italian ep023_crew_887639ff:

    # c "When the time comes, we’re going to thoroughly plan an operation and execute it."
    c "Quando arriverà il momento, pianificheremo a fondo un’operazione e la eseguiremo."

# game/episode023.rpy:1263
translate italian ep023_crew_804c8600:

    # c "Agust and I have undergone the same power transfer, so we should be evenly matched."
    c "Io e Agust abbiamo subito lo stesso trasferimento di potere, quindi dovremmo essere alla pari."

# game/episode023.rpy:1264
translate italian ep023_crew_df69ba69:

    # c "That said, if we can prevent hand-to-hand combat and just nuke the bastard to oblivion, I’m all for it."
    c "Detto questo, se riusciamo a prevenire il combattimento corpo a corpo e a annientare il bastardo con una bomba atomica, sono assolutamente a favore."

# game/episode023.rpy:1266
translate italian ep023_crew_e34b83a3:

    # c "Do you really want to be on the run perpetually, Mom?"
    c "Vuoi davvero essere perennemente in fuga, mamma?"

# game/episode023.rpy:1268
translate italian ep023_crew_68373360:

    # c "Do you really want to be on the run perpetually, Nadya?"
    c "Vuoi davvero essere perennemente in fuga, Nadya?"

# game/episode023.rpy:1270
translate italian ep023_crew_98f28b3a:

    # na "No, I don’t."
    na "No, non lo so."

# game/episode023.rpy:1271
translate italian ep023_crew_c8fce727:

    # na "But the alternative scares me."
    na "Ma l’alternativa mi spaventa."

# game/episode023.rpy:1272
translate italian ep023_crew_e629dc11:

    # c "Does it scare you more than the prospect of a premature death at the hand of a Sovereignty assassin?"
    c "Ti spaventa più della prospettiva di una morte prematura per mano di un assassino della Sovranità?"

# game/episode023.rpy:1274
translate italian ep023_crew_be2ab9b0:

    # na "I...{w} No, it doesn’t."
    na "Io...{w} No, non è così."

# game/episode023.rpy:1275
translate italian ep023_crew_0cac1fc5:

    # na "It’s a brave thing to do, what you’re planning."
    na "È una cosa coraggiosa da fare, quello che stai pianificando."

# game/episode023.rpy:1277
translate italian ep023_crew_26e0fadc:

    # na "And my reasons are entirely selfish."
    na "E le mie ragioni sono del tutto egoistiche."

# game/episode023.rpy:1278
translate italian ep023_crew_0c08ec9e:

    # na "But the prospect of getting embroiled in a war frightens me, [p_name_short]."
    na "Ma la prospettiva di rimanere coinvolto in una guerra mi spaventa, [p_name_short]."

# game/episode023.rpy:1280
translate italian ep023_crew_ddbe4b11:

    # na "I just want us to be happy together, me, you and the baby."
    na "Voglio solo che siamo felici insieme, io, te e il bambino."

# game/episode023.rpy:1285
translate italian ep023_crew_e05100ab:

    # "I took Nadya into my arms and rocked her back and forth, her tears staining my shirt."
    "Ho preso Nadya tra le braccia e l'ho cullata avanti e indietro, mentre le sue lacrime mi macchiavano la camicia."

# game/episode023.rpy:1287
translate italian ep023_crew_a508201a:

    # c "I’m going to keep you safe, Mom."
    c "Ti terrò al sicuro, mamma."

# game/episode023.rpy:1289
translate italian ep023_crew_214ba421:

    # c "I’m going to keep you safe, Nadya."
    c "Ti terrò al sicuro, Nadya."

# game/episode023.rpy:1290
translate italian ep023_crew_5328f6f7:

    # c "I’m going to keep us all safe."
    c "Ci terrò tutti al sicuro."

# game/episode023.rpy:1291
translate italian ep023_crew_e7164f81:

    # na "My boy, my darling boy."
    na "Ragazzo mio, mio ​​caro ragazzo."

# game/episode023.rpy:1296
translate italian ep023_crew_0bfb8646:

    # "When Nadya stepped back, she looked determined."
    "Quando Nadya fece un passo indietro, sembrava determinata."

# game/episode023.rpy:1298
translate italian ep023_crew_c1cf2f6b:

    # na "Alright, let’s do this."
    na "Va bene, facciamolo."

# game/episode023.rpy:1299
translate italian ep023_crew_139c6bba:

    # c "Good."
    c "Bene."

# game/episode023.rpy:1300
translate italian ep023_crew_dc29a20c:

    # c "We’ll bring the rest of the crew up to speed as soon as possible."
    c "Aggiorneremo il resto dell'equipaggio il prima possibile."

# game/episode023.rpy:1302
translate italian ep023_crew_36508727:

    # l "Jade and Ziv could send out feelers to their people?"
    l "Jade e Ziv potrebbero mandare dei sensori alla loro gente?"

# game/episode023.rpy:1303
translate italian ep023_crew_a6e2f947:

    # c "Yes, that’s a good idea."
    c "Sì, è una buona idea."

# game/episode023.rpy:1304
translate italian ep023_crew_f0c32e50:

    # c "I’ll ask Céline to contact the Tubloshi and the R’o."
    c "Chiederò a Céline di contattare i Tubloshi e i R'o."

# game/episode023.rpy:1305
translate italian ep023_crew_99fe0eb8:

    # c "Eva, do you have any means to get word out to the Acarhyn?"
    c "Eva, hai qualche mezzo per informare gli Acarhyn?"

# game/episode023.rpy:1307
translate italian ep023_crew_dd7e1a4f:

    # e "I hope so."
    e "Lo spero."

# game/episode023.rpy:1309
translate italian ep023_crew_230e0d4d:

    # e "The warrior caste might be our best bet, so I’ll try to get in contact with Rahia."
    e "La casta dei guerrieri potrebbe essere la soluzione migliore, quindi cercherò di mettermi in contatto con Rahia."

# game/episode023.rpy:1310
translate italian ep023_crew_7ddf6adc:

    # c "Good, I hope the priest caste didn’t come out on top."
    c "Bene, spero che non sia venuta fuori la casta sacerdotale."

# game/episode023.rpy:1312
translate italian ep023_crew_67564099:

    # e "I’ll try to get in contact with them."
    e "Proverò a mettermi in contatto con loro."

# game/episode023.rpy:1313
translate italian ep023_crew_e02c0aa4:

    # e "We burned a lot of bridges when we left Erigone though."
    e "Però abbiamo bruciato molti ponti quando abbiamo lasciato Erigone."

# game/episode023.rpy:1314
translate italian ep023_crew_5a9a0d7f:

    # c "Yes, I didn’t think we’d ever come back there."
    c "Sì, non pensavo che saremmo mai tornati lì."

# game/episode023.rpy:1315
translate italian ep023_crew_1153473f:

    # c "That girl, Caese, might be a way in."
    c "Quella ragazza, Caese, potrebbe essere un modo per entrare."

# game/episode023.rpy:1316
translate italian ep023_crew_4f380950:

    # c "After we’ve secured the first commitments, we’ll plan a meeting to determine our strategy."
    c "Dopo che ci saremo assicurati i primi impegni, fisseremo un incontro per determinare la nostra strategia."

# game/episode023.rpy:1317
translate italian ep023_crew_d40266a9:

    # c "The promise made to the Scolguin also has to be factored in."
    c "Da tenere in considerazione anche la promessa fatta allo Scolguin."

# game/episode023.rpy:1319
translate italian ep023_crew_4d4cb263:

    # na "Are you planning on breaking your word?"
    na "Hai intenzione di venire meno alla tua parola?"

# game/episode023.rpy:1320
translate italian ep023_crew_8b12fc0a:

    # c "I haven’t decided yet."
    c "Non ho ancora deciso."

# game/episode023.rpy:1327
translate italian ep023_crew_01f9bed4:

    # c "Do we need to discuss Mom’s news in more detail?"
    c "Dobbiamo discutere le notizie della mamma in modo più dettagliato?"

# game/episode023.rpy:1329
