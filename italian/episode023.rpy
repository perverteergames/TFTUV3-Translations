    # "The ship's hum."
    "Il ronzio della nave."

# game/episode023.rpy:288
translate italian episode023_3a900034:

    # "Footsteps in the corridor."
    "Passi nel corridoio."

# game/episode023.rpy:291
translate italian episode023_4ea42452:

    # l "Hey you."
    l "Ei, tu."

# game/episode023.rpy:292
translate italian episode023_50331b85:

    # l "I didn’t come at first."
    l "All'inizio non sono venuto."

# game/episode023.rpy:293
translate italian episode023_0cb810cc:

    # l "Seeing you like this was too painful."
    l "Vederti così è stato troppo doloroso."

# game/episode023.rpy:295
translate italian episode023_a4e36392:

    # l "But Mom, Eva and Aven have stopped by regularly and they say sitting with you helps."
    l "Ma mamma, Eva e Aven vengono regolarmente e dicono che sedersi con te aiuta."

# game/episode023.rpy:297
translate italian episode023_17b5674c:

    # l "But Nadya, Eva and Aven have stopped by regularly and they say sitting with you helps."
    l "Ma Nadya, Eva e Aven vengono regolarmente e dicono che sedersi con te aiuta."

# game/episode023.rpy:299
translate italian episode023_c9efd4b1:

    # l "So here I am."
    l "Quindi eccomi qui."

# game/episode023.rpy:300
translate italian episode023_10fa31dd:

    # l "And there you are..."
    l "Ed eccoti qui..."

# game/episode023.rpy:302
translate italian episode023_958a8b8e:

    # l "I feel so lonely, [p_name_short]."
    l "Mi sento così solo, [p_name_short]."

# game/episode023.rpy:304
translate italian episode023_d7be8a47:

    # l "I miss my big brother, making me laugh, kissing my tears away."
    l "Mi manca il mio fratello maggiore, mi fa ridere, mi bacia via le lacrime."

# game/episode023.rpy:306
translate italian episode023_31ae3b67:

    # l "I miss my friend, making me laugh, kissing my tears away."
    l "Mi manca il mio amico, mi fa ridere, mi bacia via le lacrime."

# game/episode023.rpy:310
translate italian episode023_b67c7b59:

    # l "My pregnancy is still progressing well, according to Thim."
    l "La mia gravidanza sta ancora procedendo bene, secondo Thim."

# game/episode023.rpy:312
translate italian episode023_cd66e0c9:

    # l "My pregnancy is still progressing well, according to the autodoc."
    l "La mia gravidanza sta ancora procedendo bene, secondo l'automedico."

# game/episode023.rpy:313
translate italian episode023_4850da8d:

    # l "But part of me can’t really connect to that feeling of joy."
    l "Ma una parte di me non riesce davvero a connettersi a quella sensazione di gioia."

# game/episode023.rpy:315
translate italian episode023_10e15144:

    # l "I need you for that, I’m certain."
    l "Ho bisogno di te per questo, ne sono certo."

# game/episode023.rpy:316
translate italian episode023_5ff5d397:

    # l "Please wake up."
    l "Per favore svegliati."

# game/episode023.rpy:317
translate italian episode023_fb8dd3e6:

    # l "I love you so much."
    l "Ti amo tanto."

# game/episode023.rpy:320
translate italian episode023_8a9ebd1e:

    # l "I know I’ve said some harsh things before."
    l "So di aver già detto alcune cose dure in passato."

# game/episode023.rpy:321
translate italian episode023_80e0f6cb:

    # l "But I don’t want you to die, [p_name_short], I’d be devastated."
    l "Ma non voglio che tu muoia, [p_name_short], ne sarei devastato."

# game/episode023.rpy:323
translate italian episode023_7e83e846:

    # l "I’m so sorry."
    l "Mi dispiace tanto."

# game/episode023.rpy:326
translate italian episode023_06a002ab:

    # l "I miss my big brother, making me laugh or even just annoy the hell out of me."
    l "Mi manca il mio fratello maggiore, che mi fa ridere o anche solo infastidirmi da morire."

# game/episode023.rpy:328
translate italian episode023_ab2e3a2a:

    # l "I miss my friend, making me laugh or even just annoy the hell out of me."
    l "Mi manca il mio amico, mi fa ridere o anche solo infastidirmi da morire."

# game/episode023.rpy:329
translate italian episode023_5ff5d397_1:

    # l "Please wake up."
    l "Per favore svegliati."

# game/episode023.rpy:331
translate italian episode023_401aa871:

    # "The sounds of someone sobbing."
    "I suoni di qualcuno che singhiozza."

# game/episode023.rpy:332
translate italian episode023_f86012c4:

    # "Footsteps fading away."
    "I passi si allontanano."

# game/episode023.rpy:335
translate italian episode023_3c21f4ef:

    # "Doors opening and closing."
    "Apertura e chiusura delle porte."

# game/episode023.rpy:336
translate italian episode023_ea9ebd70:

    # "Buzzing of a light somewhere up high."
    "Ronzio di una luce da qualche parte in alto."

# game/episode023.rpy:339
translate italian episode023_a5a25551:

    # th "Hey."
    th "EHI."

# game/episode023.rpy:340
translate italian episode023_fd690849:

    # th "So."
    th "COSÌ."

# game/episode023.rpy:341
translate italian episode023_fc4179be:

    # th "Everyone keeps telling me you benefit from hearing our voices."
    th "Tutti continuano a dirmi che trai beneficio dall'ascoltare le nostre voci."

# game/episode023.rpy:342
translate italian episode023_895e5229:

    # th "Seems weird though, talking to someone who doesn’t say anything back."
    th "Sembra strano però parlare con qualcuno che non risponde nulla."

# game/episode023.rpy:344
translate italian episode023_67d96be9:

    # th "Well, here goes."
    th "Bene, ecco qui."

# game/episode023.rpy:345
translate italian episode023_d12fa3f5:

    # th "Fuck."
    th "Fanculo."

# game/episode023.rpy:346
translate italian episode023_523a3303:

    # th "I don’t know what to say."
    th "Non so cosa dire."

# game/episode023.rpy:347
translate italian episode023_fbdb606b:

    # th "The whole crew has been devastated by what happened."
    th "L'intero equipaggio è rimasto sconvolto da quello che è successo."

# game/episode023.rpy:348
translate italian episode023_560add61:

    # th "Nobody smiles anymore."
    th "Nessuno sorride più."

# game/episode023.rpy:349
translate italian episode023_bd33d187:

    # th "Dinner together is a nightmare, with everybody picking at their food."
    th "Cenare insieme è un incubo, con tutti che raccolgono il cibo."

# game/episode023.rpy:352
translate italian episode023_9a4a54ef:

    # th "Eva bursts into tears randomly, but I guess that’s the hormones, so she’s forgiven, considering her pregnancy."
    th "Eva scoppia a piangere in modo casuale, ma immagino che siano gli ormoni, quindi è perdonata, considerando la sua gravidanza."

# game/episode023.rpy:354
translate italian episode023_eac3edd8:

    # th "Lilly bursts into tears randomly and I get that she’s sad, but it’s almost like she’s hormonal or something."
    th "Lilly scoppia a piangere in modo casuale e capisco che è triste, ma è quasi come se fosse sotto shock ormonale o qualcosa del genere."

# game/episode023.rpy:356
translate italian episode023_6be2de5b:

    # th "Aven bursts into tears randomly and I get that she’s sad, but it’s almost like she’s hormonal or something."
    th "Aven scoppia a piangere in modo casuale e capisco che è triste, ma è quasi come se fosse sotto shock ormonale o qualcosa del genere."

# game/episode023.rpy:358
translate italian episode023_be658b24:

    # th "Nadya bursts into tears randomly and I get that she’s sad, but it’s almost like she’s hormonal or something."
    th "Nadya scoppia a piangere in modo casuale e capisco che è triste, ma è quasi come se fosse sotto shock ormonale o qualcosa del genere."

# game/episode023.rpy:360
translate italian episode023_e95b0400:

    # th "Céline’s keeping the ship on a slow burn, waiting for things to change."
    th "Céline sta mantenendo la nave a fuoco lento, in attesa che le cose cambino."

# game/episode023.rpy:361
translate italian episode023_a3b083a2:

    # th "It all seems so pointless."
    th "Sembra tutto così inutile."

# game/episode023.rpy:362
translate italian episode023_11b7423d:

    # th "This is not the first time everybody sat around your bed fearing the worst."
    th "Questa non è la prima volta che tutti si siedono attorno al tuo letto temendo il peggio."

# game/episode023.rpy:363
translate italian episode023_99d308aa:

    # th "So I guess what I’m trying to tell you is that you have got to stop doing this."
    th "Quindi immagino che quello che sto cercando di dirti è che devi smettere di farlo."

# game/episode023.rpy:365
translate italian episode023_c8063796:

    # th "Shit."
    th "Merda."

# game/episode023.rpy:366
translate italian episode023_1fbdab02:

    # th "That didn’t come out right."
    th "Non è andata bene."

# game/episode023.rpy:367
translate italian episode023_ca0d3ddf:

    # th "Okay, we miss you, [p_name_short]."
    th "Ok, ci manchi, [p_name_short]."

# game/episode023.rpy:368
translate italian episode023_3522c826:

    # th "..."
    th "..."

# game/episode023.rpy:370
translate italian episode023_bebe542c:

    # th "I miss you."
    th "Mi manchi."

# game/episode023.rpy:371
translate italian episode023_26f5687c:

    # th "Please come back to us...{w} To me."
    th "Per favore, torna da noi...{w} A me."

# game/episode023.rpy:372
translate italian episode023_a269776b:

    # th "I can’t bear to be without you."
    th "Non posso sopportare di stare senza di te."

# game/episode023.rpy:373
translate italian episode023_847ce0c2:

    # th "Dammit."
    th "Maledizione."

# game/episode023.rpy:375
translate italian episode023_98b74e84:

    # th "I was supposed to only say positive things to you."
    th "Avrei dovuto dirti solo cose positive."

# game/episode023.rpy:376
translate italian episode023_11c8b72a:

    # th "Positivity speeds up your recovery, or some nonsense."
    th "La positività accelera la tua guarigione, o qualche sciocchezza."

# game/episode023.rpy:377
translate italian episode023_167c67e3:

    # th "A broken engine doesn’t spring to life just by saying nice things to it, is all I’m saying."
    th "Un motore rotto non riprende vita semplicemente dicendogli cose carine, è tutto quello che dico."

# game/episode023.rpy:378
translate italian episode023_f5fb1262:

    # th "I’m rambling, aren’t I?"
    th "Sto divagando, vero?"

# game/episode023.rpy:379
translate italian episode023_57603866:

    # th "Yeah, I am."
    th "Sì, lo sono."

# game/episode023.rpy:381
translate italian episode023_996d5e35:

    # th "I’m going back to the engine room to see if I can get that stupid robot of mine to fall in line."
    th "Torno nella sala macchine per vedere se riesco a mettere in riga quel mio stupido robot."

# game/episode023.rpy:382
translate italian episode023_b9314550:

    # th "I’ll be back though, with more cheery words."
    th "Tornerò però, con parole più allegre."

# game/episode023.rpy:386
translate italian episode023_a611d3b4:

    # "Soft lips brushing my forehead."
    "Labbra morbide che mi sfiorano la fronte."

# game/episode023.rpy:387
translate italian episode023_c5cba793:

    # "Sensation returning."
    "Sensazione che ritorna."

# game/episode023.rpy:389
translate italian episode023_14444c91:

    # e "Hey you."
    e "Ei, tu."

# game/episode023.rpy:390
translate italian episode023_b22fe01b:

    # e "Sorry I haven’t been back to the medbay earlier."
    e "Mi dispiace di non essere tornato prima all'infermeria."

# game/episode023.rpy:392
translate italian episode023_9b75fadd:

    # e "Thim didn’t want me to put strain on myself."
    e "Non voleva che mi mettessi a dura prova."

# game/episode023.rpy:394
translate italian episode023_0aababed:

    # e "The autodoc advised against putting strain on myself for a good while."
    e "L'automedico mi ha sconsigliato di mettermi a dura prova per un bel po'."

# game/episode023.rpy:395
translate italian episode023_3105ffc8:

    # e "So I’ve only managed some brief visits."
    e "Quindi ho gestito solo alcune brevi visite."

# game/episode023.rpy:396
translate italian episode023_85171774:

    # e "But I’m cleared now, so nobody can tell me to get more rest."
    e "Ma ora sono libero, quindi nessuno può dirmi di riposarmi di più."

# game/episode023.rpy:397
translate italian episode023_03637b8a:

    # e "I’m so sick of lying in my quarters, wondering how you are."
    e "Sono così stufo di restare sdraiato nei miei alloggi, chiedendomi come stai."

# game/episode023.rpy:400
translate italian episode023_bf6c16af:

    # e "Thim says you’re doing better, that your body is growing stronger again."
    e "Thim dice che stai meglio, che il tuo corpo sta diventando di nuovo più forte."

# game/episode023.rpy:402
translate italian episode023_1340f194:

    # e "The autodoc reports you’re doing better, that your body is growing stronger again."
    e "L'autodoc dice che stai meglio, che il tuo corpo sta diventando di nuovo più forte."

# game/episode023.rpy:403
translate italian episode023_ab0f0137:

    # e "Are you waiting to come back to us, [p_name_short]?"
    e "Aspetti di tornare da noi, [p_name_short]?"

# game/episode023.rpy:405
translate italian episode023_cd30fa3c:

    # e "Because we all need you."
    e "Perché tutti abbiamo bisogno di te."

# game/episode023.rpy:407
translate italian episode023_0184a996:

    # e "I really need you."
    e "Ho davvero bisogno di te."

# game/episode023.rpy:411
translate italian episode023_67fe222c:

    # e "I can feel our baby inside me, [p_name_short]."
    e "Posso sentire il nostro bambino dentro di me, [p_name_short]."

# game/episode023.rpy:412
translate italian episode023_0000a1d8:

    # e "She’s growing fast, I’m already showing."
    e "Sta crescendo velocemente, lo sto già mostrando."

# game/episode023.rpy:413
translate italian episode023_447a6ce7:

    # e "Or he, but I have a feeling it’s a girl."
    e "Oppure lui, ma ho la sensazione che sia una ragazza."

# game/episode023.rpy:415
translate italian episode023_4fb8bd9f:

    # e "I wish you could touch me, feel the changes happening to my body."
    e "Vorrei che potessi toccarmi, sentire i cambiamenti che avvengono nel mio corpo."

# game/episode023.rpy:416
translate italian episode023_6fa3fa9e:

    # e "Maybe you can."
    e "Forse puoi."

# game/episode023.rpy:417
translate italian episode023_e376bf9d:

    # "Fingers brushing mine, lifting my hand."
    "Dita che sfiorano le mie, sollevandomi la mano."

# game/episode023.rpy:419
translate italian episode023_5a747b73:

    # "The warm pulsing feel of her skin."
    "La calda sensazione pulsante della sua pelle."

# game/episode023.rpy:420
translate italian episode023_0163ebbd:

    # e "I’ve put your hand on my belly."
    e "Ho messo la tua mano sulla mia pancia."

# game/episode023.rpy:421
translate italian episode023_c6a38cb5:

    # e "I’ve grown quite a lot, [p_name_short]."
    e "Sono cresciuto parecchio, [p_name_short]."

# game/episode023.rpy:422
translate italian episode023_ddb0cb58:

    # e "Can you feel her?"
    e "La senti?"

# game/episode023.rpy:423
translate italian episode023_1d8e5c25:

    # "Warmth."
    "Calore."

# game/episode023.rpy:424
translate italian episode023_f18dd332:

    # "Life."
    "Vita."

# game/episode023.rpy:428
translate italian episode023_823a9bba:

    # e "I want to feel your touch on my skin again, [p_name_short]."
    e "Voglio sentire di nuovo il tuo tocco sulla mia pelle, [p_name_short]."

# game/episode023.rpy:429
translate italian episode023_8ad97236:

    # e "Make love, like we did before."
    e "Fare l'amore, come abbiamo fatto prima."

# game/episode023.rpy:431
translate italian episode023_e376bf9d_1:

    # "Fingers brushing mine, lifting my hand."
    "Dita che sfiorano le mie, sollevandomi la mano."

# game/episode023.rpy:432
translate italian episode023_5a747b73_1:

    # "The warm pulsing feel of her skin."
    "La calda sensazione pulsante della sua pelle."

# game/episode023.rpy:437
translate italian episode023_925b3b72:

    # "A longing to see her again, so intense it aches."
    "Un desiderio di rivederla, così intenso da far male."

# game/episode023.rpy:439
translate italian episode023_48c7c719:

    # "I willed my eyes open."
    "Ho voluto aprire gli occhi."

# game/episode023.rpy:440
translate italian episode023_f9bf56d7:

    # "They refused."
    "Si sono rifiutati."

# game/episode023.rpy:441
translate italian episode023_8a5ec9da:

    # "I tried again."
    "Ho riprovato."

# game/episode023.rpy:442
translate italian episode023_c90c16eb:

    # "My fingers fluttered against her."
    "Le mie dita svolazzarono contro di lei."

# game/episode023.rpy:443
translate italian episode023_d50ec2ed:

    # "I could hear her gasp."
    "La sentivo sussultare."

# game/episode023.rpy:445
translate italian episode023_d8890e17:

    # e "I think..."
    e "penso..."

# game/episode023.rpy:446
translate italian episode023_ce9235e7:

    # e "I think he’s waking up!"
    e "Penso che si stia svegliando!"

# game/episode023.rpy:449
translate italian episode023_54e3b715:

    # e "Thim!"
    e "Lui!"

# game/episode023.rpy:452
translate italian episode023_d2fd328f:

    # e "Mom!"
    e "Mamma!"

# game/episode023.rpy:454
translate italian episode023_ec7105e8:

    # e "Nadya!"
    e "Nadia!"

# game/episode023.rpy:456
translate italian episode023_4ef7e8d1:

    # e "Are you coming back to me, [p_name_short]?"
    e "Tornerai da me, [p_name_short]?"

# game/episode023.rpy:457
translate italian episode023_f8203b3d:

    # "I managed to crack my eyes open just a little."
    "Riuscii ad aprire appena un po' gli occhi."

# game/episode023.rpy:463
translate italian episode023_2be8003b:

    # "My sister slowly came into focus."
    "Mia sorella lentamente venne messa a fuoco."

# game/episode023.rpy:466
translate italian episode023_ba63cf74:

    # "My girlfriend slowly came into focus."
    "La mia ragazza venne lentamente messa a fuoco."

# game/episode023.rpy:468
translate italian episode023_7758d504:

    # "My friend slowly came into focus."
    "Il mio amico si mise lentamente a fuoco."

# game/episode023.rpy:469
translate italian episode023_20b0a94d:

    # "Tears streaked her cheeks and her fingers clenched around mine."
    "Le lacrime le rigavano le guance e le sue dita stringevano le mie."

# game/episode023.rpy:470
translate italian episode023_db5ea65b:

    # c "E-Eva?"
    c "E-Eva?"

# game/episode023.rpy:471
translate italian episode023_1c0fd383:

    # e "You’re back!"
    e "Sei tornato!"

# game/episode023.rpy:472
translate italian episode023_7eb48208:

    # e "You’re really back!"
    e "Sei davvero tornato!"

# game/episode023.rpy:474
translate italian episode023_a892813c:

    # "Eva kissed the back of my hand and let her tears flow freely."
    "Eva mi baciò il dorso della mano e lasciò che le sue lacrime scorressero liberamente."

# game/episode023.rpy:477
translate italian episode023_10140728:

    # "Thim was hovering in the vicinity, trying to get more readings from the machine I was hooked up to."
    "Thim si aggirava nelle vicinanze, cercando di ottenere più letture dalla macchina a cui ero collegato."

# game/episode023.rpy:480
translate italian episode023_b2a0b317:

    # "Nadya was hovering in the vicinity, clearly just as emotional as her daughter."
    "Nadya si aggirava nelle vicinanze, evidentemente emozionata quanto sua figlia."

# game/episode023.rpy:481
translate italian episode023_6114aa79:

    # c "I feel like I’ve been run over by an especially large motorbike."
    c "Mi sento come se fossi stato investito da una moto particolarmente grande."

# game/episode023.rpy:484
translate italian episode023_7767e07b:

    # t "It was a very close call."
    t "È stata una chiamata molto vicina."

# game/episode023.rpy:485
translate italian episode023_ac640f8e:

    # t "Whatever you did to Eva must have drained you completely."
    t "Qualunque cosa tu abbia fatto a Eva deve averti prosciugato completamente."

# game/episode023.rpy:488
translate italian episode023_1166becc:

    # na "It was a very close call, according to the autodoc."
    na "C'è mancato poco, secondo l'autodoc."

# game/episode023.rpy:489
translate italian episode023_1a06f493:

    # na "Whatever you did to Eva must have drained you completely."
    na "Qualunque cosa tu abbia fatto a Eva deve averti prosciugato completamente."

# game/episode023.rpy:492
translate italian episode023_54085e6f:

    # e "You brought the baby and me back to life, [p_name]."
    e "Hai riportato in vita me e il bambino, [p_name]."

# game/episode023.rpy:495
translate italian episode023_54ade9a3:

    # e "You brought me back to life, [p_name]."
    e "Mi hai riportato in vita, [p_name]."

# game/episode023.rpy:496
translate italian episode023_7c50079c:

    # c "Yes, that’s the last thing I remember."
    c "Sì, questa è l'ultima cosa che ricordo."

# game/episode023.rpy:497
translate italian episode023_88e73660:

    # c "You were dead, and I couldn’t live with that."
    c "Eri morto e non potevo conviverci."

# game/episode023.rpy:500
translate italian episode023_20cef554:

    # t "Most people can’t, but what you did next defies any logical explanation."
    t "La maggior parte delle persone non può, ma ciò che hai fatto dopo sfida qualsiasi spiegazione logica."

# game/episode023.rpy:503
translate italian episode023_80c27a3a:

    # na "I understand completely, but what you did next defies any logical explanation."
    na "Capisco perfettamente, ma quello che hai fatto dopo sfugge a qualsiasi spiegazione logica."

# game/episode023.rpy:508
translate italian episode023_94ae1f61:

    # e "The only thing I remember is that dreadful procedure and then nothing."
    e "L'unica cosa che ricordo è quella procedura terribile e poi niente."

# game/episode023.rpy:509
translate italian episode023_c1e58e0b:

    # e "Next thing I open my eyes and I’m with you, unconscious but holding me close."
    e "La prossima cosa che apro gli occhi e sono con te, privo di sensi ma che mi tiene stretto."

# game/episode023.rpy:510
translate italian episode023_97d79519:

    # c "I don’t know exactly."
    c "Non lo so esattamente."

# game/episode023.rpy:511
translate italian episode023_e729de63:

    # c "I just became very aware of my surroundings and it was so clear what I needed to do, so I just did it."
    c "Sono diventato molto consapevole di ciò che mi circondava ed era così chiaro cosa dovevo fare, quindi l'ho fatto e basta."

# game/episode023.rpy:513
translate italian episode023_dbfa98e7:

    # c "I understood what made your body and the baby’s tick, so I fixed it."
    c "Ho capito cosa faceva battere il tuo corpo e quello del bambino, quindi ho risolto il problema."

# game/episode023.rpy:515
translate italian episode023_8bd39c35:

    # c "I understood what made your body tick, so I fixed it."
    c "Ho capito cosa faceva funzionare il tuo corpo, quindi ho risolto il problema."

# game/episode023.rpy:518
translate italian episode023_7b8df70e:

    # t "So you fixed it..."
    t "Quindi hai risolto..."

# game/episode023.rpy:520
translate italian episode023_e56a6a4b:

    # t "Your sister isn’t a broken watch, [p_name]."
    t "Tua sorella non è un orologio rotto, [p_name]."

# game/episode023.rpy:522
translate italian episode023_ff455a72:

    # t "Eva isn’t a broken watch, [p_name]."
    t "Eva non è un orologio rotto, [p_name]."

# game/episode023.rpy:523
translate italian episode023_2ae62dd0:

    # c "Hey, I’ve just come out of a coma, so think of your bedside manner, Doctor T."
    c "Ehi, sono appena uscito dal coma, quindi pensa ai tuoi modi al capezzale, dottor T."

# game/episode023.rpy:525
translate italian episode023_6680f7bb:

    # t "Well, broken watch or not, whatever you did worked."
    t "Beh, orologio rotto o no, qualunque cosa tu abbia fatto ha funzionato."

# game/episode023.rpy:527
translate italian episode023_c7233ddf:

    # t "Eva and her baby are as healthy as she could be."
    t "Eva e il suo bambino sono sani quanto lei."

# game/episode023.rpy:529
translate italian episode023_85127ec1:

    # t "Eva is as healthy as she could be."
    t "Eva è sana come potrebbe essere."

# game/episode023.rpy:532
translate italian episode023_d253377c:

    # na "That sounds too simple, but it worked."
    na "Sembra troppo semplice, ma ha funzionato."

# game/episode023.rpy:535
translate italian episode023_c866ef7b:

    # na "The autodoc tells us that Eva and her baby are as healthy as she could be."
    na "L'automedico ci dice che Eva e il suo bambino sono sani quanto lei."

# game/episode023.rpy:537
translate italian episode023_ea1bb8de:

    # na "The autodoc tells us that Eva is as healthy as she could be."
    na "L'automedico ci dice che Eva è sana come dovrebbe."

# game/episode023.rpy:542
translate italian episode023_92da59e0:

    # e "Could you do it again?"
    e "Potresti farlo di nuovo?"

# game/episode023.rpy:543
translate italian episode023_3ea4478f:

    # e "Bring someone back to life, I mean."
    e "Riportare qualcuno in vita, intendo."

# game/episode023.rpy:544
translate italian episode023_68e69dd0:

    # c "I don’t think so."
    c "Non credo."

# game/episode023.rpy:545
translate italian episode023_b5edda9a:

    # c "This attempt nearly killed me, so I might not be so lucky when there’s a next time."
    c "Questo tentativo mi ha quasi ucciso, quindi potrei non essere così fortunato quando ci sarà la prossima volta."

# game/episode023.rpy:546
translate italian episode023_8ba2bfde:

    # c "That said, the procedure on Petrarch has changed me and I need to find out to what extent when I’m able."
    c "Detto questo, la procedura su Petrarca mi ha cambiato e devo scoprire fino a che punto quando potrò."

# game/episode023.rpy:547
translate italian episode023_359a4a65:

    # c "Maybe we could set up some tests?"
    c "Magari potremmo organizzare dei test?"

# game/episode023.rpy:550
translate italian episode023_56524555:

    # t "I think this is far enough, as exertion goes."
    t "Penso che questo sia abbastanza lontano, per quanto riguarda lo sforzo."

# game/episode023.rpy:551
translate italian episode023_5b84f2cc:

    # t "You need to rest, [p_name], gather your strength."
    t "Hai bisogno di riposarti, [p_name], di raccogliere le forze."

# game/episode023.rpy:553
translate italian episode023_66fb92f5:

    # t "After that you can play guinea pig in any experiment you like to set up."
    t "Dopodiché potrai fare da cavia in qualsiasi esperimento tu voglia organizzare."

# game/episode023.rpy:556
translate italian episode023_ac889366:

    # na "I think this is far enough, as exertion goes."
    na "Penso che questo sia abbastanza lontano, per quanto riguarda lo sforzo."

# game/episode023.rpy:557
translate italian episode023_b07fb92e:

    # na "You need to rest, [p_name], gather your strength."
    na "Hai bisogno di riposarti, [p_name], di raccogliere le forze."

# game/episode023.rpy:559
translate italian episode023_e28772d4:

    # na "Any tests will have to be conducted after you’re able to function again."
    na "Eventuali test dovranno essere condotti dopo che sarai di nuovo in grado di funzionare."

# game/episode023.rpy:560
translate italian episode023_5f082dca:

    # c "I’ll be a good patient."
    c "Sarò un buon paziente."

# game/episode023.rpy:561
translate italian episode023_70415271:

    # c "But I want to get back to work as soon as I’m able."
    c "Ma voglio tornare al lavoro non appena posso."

# game/episode023.rpy:564
translate italian episode023_48e4c222:

    # t "I’ll release you as soon as I deem you fit."
    t "Ti rilascerò non appena lo ritengo opportuno."

# game/episode023.rpy:566
translate italian episode023_c4a7dd92:

    # t "Considering you came out of your coma seemingly unharmed, I think you’ll be up and about in no time."
    t "Considerando che sei uscito dal coma apparentemente illeso, penso che ti rimetterai in piedi in pochissimo tempo."

# game/episode023.rpy:569
translate italian episode023_953b10e5:

    # na "Of course, you’ll be released as soon as the autodoc deems you fit."
    na "Naturalmente verrai rilasciato non appena l’autodoc ti riterrà idoneo."

# game/episode023.rpy:571
translate italian episode023_772e5071:

    # c "One last thing though."
    c "Un'ultima cosa però."

# game/episode023.rpy:572
translate italian episode023_1da3ddfb:

    # c "What about Petrarch?"
    c "E Petrarca?"

# game/episode023.rpy:577
translate italian episode023_063b315a:

    # e "What about it?"
    e "Che ne dici?"

# game/episode023.rpy:578
translate italian episode023_8356c041:

    # c "We’re nowhere near that planet, are we?"
    c "Non siamo neanche lontanamente vicini a quel pianeta, vero?"

# game/episode023.rpy:581
translate italian episode023_5d1facfb:

    # t "No, we left that godforsaken place behind a long time ago."
    t "No, ci siamo lasciati alle spalle quel posto dimenticato da Dio molto tempo fa."

# game/episode023.rpy:584
translate italian episode023_4aa93a46:

    # na "No, we left that godforsaken place behind a long time ago."
    na "No, ci siamo lasciati alle spalle quel posto dimenticato da Dio molto tempo fa."

# game/episode023.rpy:585
translate italian episode023_57a76272:

    # c "Did you destroy everything like we planned?"
    c "Hai distrutto tutto come avevamo pianificato?"

# game/episode023.rpy:590
translate italian episode023_e7fb7c51:

    # e "Yes, we laid waste to the entire planet."
    e "Sì, abbiamo devastato l'intero pianeta."

# game/episode023.rpy:591
translate italian episode023_d8e67e51:

    # e "When it became clear the Sovereignty wasn’t about to return to the planet’s surface, Thyia headed a team to sabotage any structure the Bastard’s scanners could pick up."
    e "Quando divenne chiaro che la Sovereignty non sarebbe tornata sulla superficie del pianeta, Thyia guidò una squadra per sabotare qualsiasi struttura che gli scanner del Bastardo potessero rilevare."

# game/episode023.rpy:592
translate italian episode023_1e9b3252:

    # e "It took several weeks, but they managed to destroy any computer or record on that planet."
    e "Ci sono volute diverse settimane, ma sono riusciti a distruggere qualsiasi computer o registrazione su quel pianeta."

# game/episode023.rpy:593
translate italian episode023_53b2c4b4:

    # c "Good, sounds like she salted the earth thoroughly."
    c "Bene, sembra che abbia salato bene la terra."

# game/episode023.rpy:596
translate italian episode023_8a662f02:

    # t "She sure did."
    t "Di sicuro lo ha fatto."

# game/episode023.rpy:597
translate italian episode023_02fa0c61:

    # t "Now rest, [p_name_short]."
    t "Adesso riposati, [p_name_short]."

# game/episode023.rpy:600
translate italian episode023_6c782f6f:

    # na "She sure did."
    na "Di sicuro lo ha fatto."

# game/episode023.rpy:601
translate italian episode023_580b7598:

    # na "Now rest, [p_name_short]."
    na "Adesso riposati, [p_name_short]."

# game/episode023.rpy:603
translate italian episode023_f70fcf0b:

    # c "I will, thanks Mom."
    c "Lo farò, grazie mamma."

# game/episode023.rpy:605
translate italian episode023_a86df597:

    # c "I will, thanks."
    c "Lo farò, grazie."

# game/episode023.rpy:608
translate italian episode023_76375f12:

    # "Thim was right, it didn’t take long for me to recover."
    "Aveva ragione, non mi ci è voluto molto per riprendermi."

# game/episode023.rpy:610
translate italian episode023_1846d65d:

    # "It didn’t take long for me to recover."
    "Non mi ci è voluto molto per riprendermi."

# game/episode023.rpy:612
translate italian episode023_d4f6f6e5:

    # "I was able to walk short distances unaided after a few days."
    "Dopo pochi giorni sono stato in grado di camminare per brevi distanze senza aiuto."

# game/episode023.rpy:614
translate italian episode023_8c714597:

    # "When I could roam around the immediate surroundings of the medbay without needing several hours of sleep afterward, Thim deemed me fit enough for release out of the medbay."
    "Quando ho potuto vagare per le immediate vicinanze dell'infermeria senza aver bisogno di diverse ore di sonno, Thim mi ha ritenuto abbastanza in forma per essere rilasciato dall'infermeria."

# game/episode023.rpy:616
translate italian episode023_4ee63d89:

    # "When I could roam around the immediate surroundings of the medbay without needing several hours of sleep afterward, the autodoc deemed me fit enough for release out of the medbay."
    "Quando ho potuto vagare per le immediate vicinanze dell'infermeria senza aver bisogno di diverse ore di sonno, l'automedico mi ha ritenuto abbastanza in forma per essere rilasciato dall'infermeria."

# game/episode023.rpy:617
translate italian episode023_4e3275c2:

    # "The atmosphere on the ship seemed oddly muted."
    "L'atmosfera sulla nave sembrava stranamente attenuata."

# game/episode023.rpy:618
translate italian episode023_027009d3:

    # "After our escape from Petrarch, the Iron Bastard had wandered aimlessly through the void, burning minimal amounts of fuel."
    "Dopo la nostra fuga da Petrarca, il Bastardo di Ferro aveva vagato senza meta nel vuoto, bruciando quantità minime di carburante."

# game/episode023.rpy:619
translate italian episode023_7c58c16e:

    # "Daily life on the ship appeared to be in stasis, like everybody was waiting for our next move."
    "La vita quotidiana sulla nave sembrava essere in stasi, come se tutti stessero aspettando la nostra prossima mossa."

# game/episode023.rpy:620
translate italian episode023_ff99f3de:

    # "I had a pretty clear idea of what that would be."
    "Avevo un’idea abbastanza chiara di cosa sarebbe stato."

# game/episode023.rpy:623
translate italian episode023_cf24eb80:

    # "As I was exiting the medbay to take up permanent residence in my quarters again, I ran into Kit, who immediately bundled me up in a tight embrace."
    "Mentre stavo uscendo dall'infermeria per riprendere la residenza permanente nei miei alloggi, mi sono imbattuto in Kit, che mi ha immediatamente avvolto in uno stretto abbraccio."

# game/episode023.rpy:624
translate italian episode023_3e68ffdc:

    # ki "He lives!"
    ki "Lui vive!"

# game/episode023.rpy:625
translate italian episode023_92b6f895:

    # c "You’re not getting rid of me that easily."
    c "Non ti libererai di me così facilmente."

# game/episode023.rpy:627
translate italian episode023_5f2c73a0:

    # ki "Guess not."
    ki "Immagino di no."

# game/episode023.rpy:628
translate italian episode023_f0014524:

    # ki "I was just on my way to visit you."
    ki "Stavo proprio venendo a trovarti."

# game/episode023.rpy:629
translate italian episode023_77f54146:

    # c "Well, I’m out of the medbay."
    c "Bene, sono fuori dall'infermeria."

# game/episode023.rpy:631
translate italian episode023_4489f01e:

    # c "Thim cleared me."
    c "Mi ha scagionato."

# game/episode023.rpy:633
translate italian episode023_79aebaf4:

    # c "Autodoc cleared me."
    c "Autodoc mi ha autorizzato."

# game/episode023.rpy:634
translate italian episode023_f112e9bd:

    # ki "You’re looking well, considering."
    ki "Stai bene, tutto sommato."

# game/episode023.rpy:635
translate italian episode023_dd20ffbf:

    # c "Thanks."
    c "Grazie."

# game/episode023.rpy:637
translate italian episode023_5097a3af:

    # ki "You did put us through a lot though."
    ki "Ci hai messo a dura prova, però."

# game/episode023.rpy:638
translate italian episode023_7d284297:

    # ki "Me especially."
    ki "Io soprattutto."

# game/episode023.rpy:639
translate italian episode023_5cb2f875:

    # c "You?"
    c "Voi?"

# game/episode023.rpy:641
translate italian episode023_e0f2be8d:

    # ki "Yeah, me."
    ki "Sì, io."

# game/episode023.rpy:643
translate italian episode023_1c809045:

    # ki "Have you any idea how hard it is to live on a ship filled with inconsolable women?"
    ki "Hai idea di quanto sia difficile vivere su una nave piena di donne inconsolabili?"

# game/episode023.rpy:644
translate italian episode023_53d0d88d:

    # ki "Teary-eyed dinners, girls storming out of emotionally charged crew meetings..."
    ki "Cene con gli occhi pieni di lacrime, ragazze che abbandonano le riunioni dell'equipaggio cariche di emozione..."

# game/episode023.rpy:645
translate italian episode023_24ec7353:

    # c "Wow, yeah, such hardship!"
    c "Wow, sì, che difficoltà!"

# game/episode023.rpy:648
translate italian episode023_bdd44f06:

    # ki "And I guess seeing my best friend in a coma after saving his sister also did a number on me."
    ki "E immagino che anche vedere il mio migliore amico in coma dopo aver salvato sua sorella abbia avuto un effetto negativo su di me."

# game/episode023.rpy:650
translate italian episode023_b0e9333c:

    # ki "And I guess seeing my best friend in a coma after saving his girlfriend also did a number on me."
    ki "E immagino che anche vedere il mio migliore amico in coma dopo aver salvato la sua ragazza abbia fatto un certo effetto su di me."

# game/episode023.rpy:652
translate italian episode023_5c193ec7:

    # ki "And I guess seeing my best friend in a coma after saving Eva also did a number on me."
    ki "E immagino che anche vedere la mia migliore amica in coma dopo aver salvato Eva abbia fatto un certo effetto su di me."

# game/episode023.rpy:653
translate italian episode023_14878f71:

    # c "Your concern is touching, as always."
    c "La tua preoccupazione è commovente, come sempre."

# game/episode023.rpy:655
translate italian episode023_380ca4f4:

    # ki "Seriously though, man, I’m glad you’re back."
    ki "Sul serio, amico, sono felice che tu sia tornato."

# game/episode023.rpy:656
translate italian episode023_a41dd6b9:

    # ki "Everybody was so shaken up after Petrarch."
    ki "Tutti erano così scossi dopo Petrarca."

# game/episode023.rpy:658
translate italian episode023_c4370bab:

    # ki "Now we can hopefully return to normalcy again."
    ki "Ora si può sperare di tornare nuovamente alla normalità."

# game/episode023.rpy:659
translate italian episode023_2e3786a9:

    # c "I think normal went out of the window a long time ago, ever since we hijacked the Enfield."
    c "I think normal went out of the window a long time ago, ever since we hijacked the Enfield."

# game/episode023.rpy:661
translate italian episode023_4d4bccc3:

    # ki "I’ll settle for less crazy then, or batshit insane with a smidge of ordinary."
    ki "Allora mi accontenterò di meno pazzo, o di un pazzo da schifo con un pizzico di ordinario."

# game/episode023.rpy:663
translate italian episode023_1f078415:

    # ki "Have you decided what to do?"
    ki "Hai deciso cosa fare?"

# game/episode023.rpy:664
translate italian episode023_a0a78da1:

    # c "I was planning on going to my quarters."
    c "Avevo intenzione di andare nei miei alloggi."

# game/episode023.rpy:666
translate italian episode023_d7db845b:

    # ki "Right, small steps."
    ki "Esatto, piccoli passi."

# game/episode023.rpy:667
translate italian episode023_a9939298:

    # c "After that we can plan our next moves."
    c "Dopodiché potremo pianificare le nostre prossime mosse."

# game/episode023.rpy:668
translate italian episode023_bb5dea9e:

    # c "My dad is going to pay for what he did to Eva."
    c "Mio padre pagherà per quello che ha fatto a Eva."

# game/episode023.rpy:670
translate italian episode023_0ab58add:

    # ki "Good, as long as we make that fucker bleed slowly."
    ki "Bene, purché facciamo sanguinare lentamente quello stronzo."

# game/episode023.rpy:671
translate italian episode023_6fe62597:

    # c "You can be sure of that."
    c "Puoi starne certo."

# game/episode023.rpy:672
translate italian episode023_0c0a65b9:

    # ki "Let me know when you’re ready to share your plans, I’ll be ready."
    ki "Fammi sapere quando sei pronto per condividere i tuoi piani, sarò pronto."

# game/episode023.rpy:673
translate italian episode023_46a18351:

    # c "Thanks, Kit."
    c "Grazie,Kit."

# game/episode023.rpy:675
translate italian episode023_2dd67298:

    # ki "Now, I’ll let you hobble back to your quarters."
    ki "Ora ti lascerò tornare zoppicando nei tuoi alloggi."

# game/episode023.rpy:676
translate italian episode023_cb46a39e:

    # c "Considerate as ever."
    c "Premuroso come sempre."

# game/episode023.rpy:678
translate italian episode023_6ef7c8a0:

    # ki "That’s me!"
    ki "Sono io!"

# game/episode023.rpy:710
translate italian ep023_test_79293035:

    # "My mother and Thim were already waiting for me in the medbay."
    "Mia madre e Thim mi stavano già aspettando nell'infermeria."

# game/episode023.rpy:712
translate italian ep023_test_80c7f2e4:

    # "Nadya and Thim were already waiting for me in the medbay."
    "Nadya e Thim mi stavano già aspettando nell'infermeria."

# game/episode023.rpy:716
translate italian ep023_test_6e3e5e9a:

    # "My mother was already waiting for me in the medbay."
    "Mia madre mi stava già aspettando nell'infermeria."

# game/episode023.rpy:718
translate italian ep023_test_b2967624:

    # "Nadya was already waiting for me in the medbay."
    "Nadya mi stava già aspettando nell'infermeria."

# game/episode023.rpy:721
translate italian ep023_test_acb5e4a0:

    # t "Ready to be a guinea pig?"
    t "Pronto per essere una cavia?"

# game/episode023.rpy:722
translate italian ep023_test_1f1e745d:

    # c "Yeah, let’s get this over with."
    c "Sì, finiamola."

# game/episode023.rpy:723
translate italian ep023_test_da9c1392:

    # "We wanted to recreate the setup from the simulation on Petrarch."
    "Abbiamo voluto ricreare l'allestimento della simulazione su Petrarca."

# game/episode023.rpy:724
translate italian ep023_test_6b296f87:

    # "Levitating a small object from a tabletop probably causes the least amount of strain."
    "Far levitare un piccolo oggetto da un tavolo probabilmente provoca il minor sforzo possibile."

# game/episode023.rpy:725
translate italian ep023_test_da726db0:

    # "Thim hooked me up to various monitors and indicated I could proceed."
    "Thim mi ha collegato a vari monitor e mi ha indicato che potevo procedere."

# game/episode023.rpy:727
translate italian ep023_test_c858b7d1:

    # na "Stop, as soon as you feel something is wrong."
    na "Fermati non appena senti che qualcosa non va."

# game/episode023.rpy:728
translate italian ep023_test_50d00926:

    # c "I will, don’t worry."
    c "Lo farò, non preoccuparti."

# game/episode023.rpy:729
translate italian ep023_test_5a6f5568:

    # t "You don’t want to go all out, just start with something simple."
    t "Non vuoi esagerare, inizia semplicemente con qualcosa di semplice."

# game/episode023.rpy:730
translate italian ep023_test_0157ae03:

    # c "Right, here goes."
    c "Giusto, ecco qui."

# game/episode023.rpy:733
translate italian ep023_test_5b8a5fe5:

    # na "The autodoc scanning routine has been activated."
    na "La routine di scansione autodoc è stata attivata."

# game/episode023.rpy:734
translate italian ep023_test_3c3e01b2:

    # c "Let’s get this over with."
    c "Facciamola finita."

# game/episode023.rpy:735
translate italian ep023_test_da9c1392_1:

    # "We wanted to recreate the setup from the simulation on Petrarch."
    "Abbiamo voluto ricreare l'allestimento della simulazione su Petrarca."

# game/episode023.rpy:736
translate italian ep023_test_6b296f87_1:

    # "Levitating a small object from a tabletop probably causes the least amount of strain."
    "Far levitare un piccolo oggetto da un tavolo probabilmente provoca il minor sforzo possibile."

# game/episode023.rpy:737
translate italian ep023_test_64395d5e:

    # "Nadya hooked me up to various monitors and indicated I could proceed."
