# game/episode025.rpy:69
translate russian episode025_bd708d91:

    # "Our arrival at Erigone was a lot different compared to the last time we visited."
    "Наше прибытие на Эригон сильно отличалось от нашего последнего визита."

# game/episode025.rpy:70
translate russian episode025_f7486443:

    # "The graveyard of destroyed ships didn’t surprise us, nor were we targeted by missiles this time around."
    "Кладбище разбитых кораблей нас не удивило, да и на этот раз по нам не выпустили ракеты."

# game/episode025.rpy:71
translate russian episode025_7c8c2ced:

    # "It probably helped that Eva knew the proper authorization codes."
    "Вероятно, нам повезло, что Еве были известны нужные коды авторизации."

# game/episode025.rpy:72
translate russian episode025_b128ff81:

    # "As soon as we broke orbit, the lush forests of Erigone greeted us."
    "Стоило нам выйти на орбиту, как нас встретили густые леса Эригона."

# game/episode025.rpy:77
translate russian episode025_1b68d19c:

    # "The verdant sight was marred by large plumes of smoke in the distance."
    "Идиллическую картину омрачали гигантские клубы дыма вдали."

# game/episode025.rpy:78
translate russian episode025_e57f93f3:

    # "We picked up a radio signal almost immediately."
    "Мы почти сразу же поймали радиосигнал."

# game/episode025.rpy:84
translate russian episode025_daeeb94f:

    # av "The signal is from the Citadel."
    av "Сигнал исходит из Цитадели."

# game/episode025.rpy:85
translate russian episode025_5066ff8d:

    # c "Put it through."
    c "Соединяй."

# game/episode025.rpy:87
translate russian episode025_a52c3096:

    # woman "Erigone welcomes the Virgin Queen."
    woman "Эригон приветствует Королеву-Девственницу."

# game/episode025.rpy:88
translate russian episode025_6d1b41ec:

    # woman "Commander Rahia would like to request an official audience."
    woman "Командир Рахия хотела бы попросить официальной аудиенции."

# game/episode025.rpy:89
translate russian episode025_9c06534a:

    # woman "Guest rooms are being prepared as we speak."
    woman "Подготовка гостевых кают уже ведётся."

# game/episode025.rpy:90
translate russian episode025_92474673:

    # e "We thank you."
    e "Мы благодарим вас."

# game/episode025.rpy:91
translate russian episode025_f5627722:

    # e "Commander Rahia’s request is hereby granted."
    e "Запрос командира Рахии официально одобрен."

# game/episode025.rpy:96
translate russian episode025_337b3696:

    # c "I forgot how much it turns me on when you’re being all royal."
    c "Я и забыл, как сильно меня заводит, когда ты ведёшь себя по-королевски."

# game/episode025.rpy:97
translate russian episode025_b750d9ea:

    # e "Shut up, or I’ll let them behead you."
    e "Заткнись, или я позволю им тебя обезглавить."

# game/episode025.rpy:98
translate russian episode025_248fa3d5:

    # c "Apologies, my Queen."
    c "Прошу прощения, моя Королева."

# game/episode025.rpy:99
translate russian episode025_8871399a:

    # c "It seems Rahia has survived whatever war they’ve been fighting with the Priest caste so far."
    c "Похоже, Рахии пока удалось пережить всё, через что им пришлось пройти в войне с кастой Жрецов."

# game/episode025.rpy:100
translate russian episode025_8184c7e4:

    # e "Yes, it seems so."
    e "Да, похоже на то."

# game/episode025.rpy:101
translate russian episode025_0df4792a:

    # e "Did you notice that black smoke on the horizon?"
    e "Ты заметил чёрный дым на горизонте?"

# game/episode025.rpy:102
translate russian episode025_b184f765:

    # c "I did, yes."
    c "Ага, заметил."

# game/episode025.rpy:103
translate russian episode025_26156857:

    # e "I don’t think the war with the Priest caste is over."
    e "Не думаю, что война с кастой Жрецов закончилась."

# game/episode025.rpy:104
translate russian episode025_ac2bea30:

    # c "Me neither."
    c "Я тоже."

# game/episode025.rpy:105
translate russian episode025_495608ce:

    # c "Rahia will undoubtedly bring us up to speed."
    c "Рахия наверняка введёт нас в курс дела."

# game/episode025.rpy:108
translate russian episode025_9d8ecbb9:

    # av "The signal is from the Aegisthus Shipyards."
    av "Сигнал поступает с Верфей Эгисфа."

# game/episode025.rpy:109
translate russian episode025_5066ff8d_1:

    # c "Put it through."
    c "Соединяй."

# game/episode025.rpy:110
translate russian episode025_e14b2a00:

    # woman "Erigone is overjoyed by the Virgin Queen’s renewed presence."
    woman "Эригон безумно рад, что Королева-Девственница снова с нами."

# game/episode025.rpy:111
translate russian episode025_2fa03145:

    # woman "Head Priestess Keodele humbly requests an audience."
    woman "Верховная Жрица Кеодели смиренно просит о встрече."

# game/episode025.rpy:112
translate russian episode025_68c83f09:

    # woman "Guest lodgings are being prepared and will be ready once you have landed."
    woman "Гостевые покои уже готовят и закончат к вашему прибытию."

# game/episode025.rpy:113
translate russian episode025_92474673_1:

    # e "We thank you."
    e "Мы благодарим вас."

# game/episode025.rpy:114
translate russian episode025_d5a50623:

    # e "The Head Priestess’s request is hereby granted."
    e "Запрос Верховной Жрицы официально одобрен."

# game/episode025.rpy:119
translate russian episode025_337b3696_1:

    # c "I forgot how much it turns me on when you’re being all royal."
    c "Я и забыл, как сильно меня заводит, когда ты ведёшь себя по-королевски."

# game/episode025.rpy:120
translate russian episode025_b750d9ea_1:

    # e "Shut up, or I’ll let them behead you."
    e "Заткнись, или я позволю им тебя обезглавить."

# game/episode025.rpy:121
translate russian episode025_248fa3d5_1:

    # c "Apologies, my Queen."
    c "Прошу прощения, моя Королева."

# game/episode025.rpy:122
translate russian episode025_a0812fc7:

    # c "It seems the acolyte has usurped the position of her former master."
    c "Похоже, послушница узурпировала положение своего бывшего хозяина."

# game/episode025.rpy:124
translate russian episode025_b9da0975:

    # e "Like mother, like daughter..."
    e "Что мать, что дочь..."

# game/episode025.rpy:125
translate russian episode025_112e561f:

    # c "I hope she’s more malleable than her mother."
    c "Надеюсь, она куда податливее своей матери."

# game/episode025.rpy:127
translate russian episode025_3248ce92:

    # e "She didn’t strike me as an ambitious type."
    e "Она не показалась мне амбициозной личностью."

# game/episode025.rpy:128
translate russian episode025_370293fd:

    # c "The quiet ones never do."
    c "В тихом омуте черти водятся."

# game/episode025.rpy:129
translate russian episode025_0df4792a_1:

    # e "Did you notice that black smoke on the horizon?"
    e "Ты заметил чёрный дым на горизонте?"

# game/episode025.rpy:130
translate russian episode025_b184f765_1:

    # c "I did, yes."
    c "Ага, заметил."

# game/episode025.rpy:131
translate russian episode025_d49884ae:

    # e "I think they’re still at war with the Warrior caste."
    e "Думаю, они всё ещё в состоянии войны с кастой Воинов."

# game/episode025.rpy:132
translate russian episode025_a15e975e:

    # c "That seems likely."
    c "Похоже на то."

# game/episode025.rpy:133
translate russian episode025_7084f486:

    # c "I’m sure Keodele will fill us in on all that."
    c "Уверен, Кеодели нас во всём просветит."

# game/episode025.rpy:140
translate russian episode025_76280e80:

    # "We took our time adjusting to life in the Citadel."
    "Нам потребовалось время, чтобы привыкнуть к жизни в Цитадели."

# game/episode025.rpy:141
translate russian episode025_dfab6f02:

    # "A bustle of activity went on day and night, which was a marked change to living on the Bastard."
    "Днём и ночью здесь кипела жизнь, что сильно отличалось от жизни на Ублюдке."

# game/episode025.rpy:142
translate russian episode025_a50c9c26:

    # "The Citadel and immediate environs were deemed safe and its border patrolled heavily."
    "Цитадель и её ближайшие окрестности считались безопасными, а граница усиленно патрулировалась."

# game/episode025.rpy:143
translate russian episode025_69d45064:

    # "We were allowed to roam the Citadel grounds and the jungle surrounding the complex."
    "Нам разрешили бродить по территории Цитадели и джунглям, окружающим комплекс."

# game/episode025.rpy:144
translate russian episode025_9935f772:

    # "Eva was often called into meetings, so we didn’t see much of her."
    "Еву часто вызывали на собрания, так что виделись мы с ней редко."

# game/episode025.rpy:145
translate russian episode025_6b459ae2:

    # "The others roamed the halls and enjoyed the short respite from being in transit for so long."
    "Остальные бродили по залам и наслаждались короткой передышкой после столь долгого пребывания в пути."

# game/episode025.rpy:148
translate russian episode025_8601b255:

    # "We took our time adjusting to life at the Shipyards."
    "Нам потребовалось время, чтобы привыкнуть к жизни на Верфях."

# game/episode025.rpy:149
translate russian episode025_dfab6f02_1:

    # "A bustle of activity went on day and night, which was a marked change to living on the Bastard."
    "Днём и ночью здесь кипела жизнь, что сильно отличалось от жизни на Ублюдке."

# game/episode025.rpy:150
translate russian episode025_4be7fe43:

    # "The Shipyards and immediate environs were deemed safe and its border patrolled heavily."
    "Верфи и её ближайшие окрестности считались безопасными, а граница усиленно патрулировалась."

# game/episode025.rpy:151
translate russian episode025_aceb520b:

    # "We were allowed to roam the grounds and the jungle surrounding the complex."
    "Нам разрешили бродить по территории и джунглям, окружающим комплекс."

# game/episode025.rpy:152
translate russian episode025_dfd08f74:

    # "The crew enjoyed the short respite from being in transit for so long."
    "Экипаж наслаждался короткой передышкой после столь долгого пребывания в пути."

# game/episode025.rpy:190
translate russian ep025_erigone_rahia_9128cb48:

    # "The Citadel appeared to be in a state of emergency."
    "Похоже, в Цитадели царила чрезвычайная обстановка."

# game/episode025.rpy:191
translate russian ep025_erigone_rahia_aa77e911:

    # "Many warriors roamed the halls and the many open areas were used for weapons training."
    "По залам бродило множество воинов, а многие открытые площадки использовались для тренировок с оружием."

# game/episode025.rpy:192
translate russian ep025_erigone_rahia_f61aa3e6:

    # "We were assigned the same rooms as before, Eva had the royal quarters at her disposal."
    "Нам были отведены те же комнаты, что и раньше, в распоряжении Евы были королевские покои."

# game/episode025.rpy:193
translate russian ep025_erigone_rahia_7a43811d:

    # "It was there that Rahia came to meet us later in the day."
    "Именно туда позже пришла Рахия, чтобы встретиться с нами."

# game/episode025.rpy:198
translate russian ep025_erigone_rahia_441f0136:

    # rah "Apologies for the delay, my Queen."
    rah "Прошу прощения за задержку, моя Королева."

# game/episode025.rpy:199
translate russian ep025_erigone_rahia_214e1a7e:

    # rah "It seems that my days are filled with overlong strategy meetings."
    rah "Кажется, мои дни превратились в затянувшиеся стратегические совещания."

# game/episode025.rpy:200
translate russian ep025_erigone_rahia_9c9cd6a3:

    # e "No apologies necessary."
    e "Не нужно извиняться."

# game/episode025.rpy:201
translate russian ep025_erigone_rahia_9be95fa2:

    # e "And please call me Eva when we’re in private."
    e "И, пожалуйста, наедине называй меня Евой."

# game/episode025.rpy:206
translate russian ep025_erigone_rahia_d324f40b:

    # rah "Of course, Your Majesty."
    rah "Конечно, Ваше Величество."

# game/episode025.rpy:207
translate russian ep025_erigone_rahia_ca3df884:

    # "I couldn’t suppress a grin when I saw Eva struggle to keep herself from rolling her eyes."
    "Я не смог сдержать улыбки, когда увидел, как Ева изо всех сил старается не закатить глаза."

# game/episode025.rpy:208
translate russian ep025_erigone_rahia_6f7c6c07:

    # e "Has the conflict with the Priests not been resolved?"
    e "Конфликт со Жрецами не разрешился?"

# game/episode025.rpy:210
translate russian ep025_erigone_rahia_1788fd64:

    # rah "I’m afraid not."
    rah "Боюсь, что нет."

# game/episode025.rpy:211
translate russian ep025_erigone_rahia_798dce2f:

    # rah "After your departure, there were months of heavy fighting where we managed to recapture the Citadel."
    rah "После вашего отбытия несколько месяцев шли жестокие бои, и нам удалось отбить Цитадель."

# game/episode025.rpy:212
translate russian ep025_erigone_rahia_077aab6b:

    # rah "It was a close thing and I believe we were only able to assert our dominance because the Priest caste was momentarily distracted by Erylin’s betrayal."
    rah "Победа далась нам с трудом. Думаю, мы смогли одержать верх лишь потому, что предательство Эрилин на время отвлекло Жрецов."

# game/episode025.rpy:213
translate russian ep025_erigone_rahia_fe98398f:

    # c "Yes, we saw her again."
    c "Да, мы снова с ней встретились."

# game/episode025.rpy:214
translate russian ep025_erigone_rahia_631b5bc8:

    # c "She struck a deal with the Confessor."
    c "Она заключила сделку с Исповедником."

# game/episode025.rpy:215
translate russian ep025_erigone_rahia_bf0cb5c1:

    # rah "She did."
    rah "Всё верно."

# game/episode025.rpy:216
translate russian ep025_erigone_rahia_1322eb0c:

    # rah "I believe she was to take the entire Priest caste with her, but many refused."
    rah "Насколько я понимаю, она собиралась забрать с собой всю касту Жрецов, но многие отказались."

# game/episode025.rpy:218
translate russian ep025_erigone_rahia_d887540c:

    # rah "It was her own daughter, Keodele, who led the revolt."
    rah "Именно её дочь Кеодели возглавила восстание."

# game/episode025.rpy:220
translate russian ep025_erigone_rahia_8eabe267:

    # rah "It was her own acolyte, Keodele, who led the revolt."
    rah "Именно её послушница Кеодели возглавила восстание."

# game/episode025.rpy:221
translate russian ep025_erigone_rahia_c1b77330:

    # c "Typical..."
    c "Ну конечно..."

# game/episode025.rpy:223
translate russian ep025_erigone_rahia_23d97181:

    # rah "At first we counted our blessings, but Keodele turned out to be much worse compared to Erylin."
    rah "Поначалу мы думали, что нам повезло, но Кеодели оказалась ещё хуже Эрилин."

# game/episode025.rpy:224
translate russian ep025_erigone_rahia_4475a397:

    # c "She did?"
    c "Серьёзно?"

# game/episode025.rpy:225
translate russian ep025_erigone_rahia_280e737d:

    # rah "Erylin always put her own interests first."
    rah "Эрилин всегда ставила свои собственные интересы на первое место."

# game/episode025.rpy:226
translate russian ep025_erigone_rahia_f052640b:

    # rah "I doubt she was a true believer, but a power player at heart."
    rah "Думаю, религия была для неё лишь прикрытием. По сути, она просто стремилась к власти."

# game/episode025.rpy:228
translate russian ep025_erigone_rahia_764c087c:

    # rah "Keodele is a true zealot and all the more dangerous for it."
    rah "Кеодели - настоящая фанатичка, и именно поэтому она ещё опаснее."

# game/episode025.rpy:229
translate russian ep025_erigone_rahia_4d3f3918:

    # c "In what way?"
    c "В каком смысле?"

# game/episode025.rpy:230
translate russian ep025_erigone_rahia_4f463806:

    # rah "The Priest caste has become more organized and more martial."
    rah "Каста Жрецов стала более сплочённой и воинственной."

# game/episode025.rpy:231
translate russian ep025_erigone_rahia_7e57f0f2:

    # rah "We’ve defended ourselves against two waves of attacks on the Citadel so far."
    rah "Пока что нам удалось отбить две волны атак на Цитадель."

# game/episode025.rpy:232
translate russian ep025_erigone_rahia_bb5644f3:

    # rah "The attacks were timed so that we didn’t have time to launch counterattacks on the Aegisthus Shipyards."
    rah "Атаки были спланированы так, чтобы мы не успевали нанести ответный удар по Верфям Эгисфа."

# game/episode025.rpy:234
translate russian ep025_erigone_rahia_a9991033:

    # e "That’s their base of operations?"
    e "Это их главная база?"

# game/episode025.rpy:236
translate russian ep025_erigone_rahia_83f9a79b:

    # rah "It is, yes."
    rah "Да."

# game/episode025.rpy:237
translate russian ep025_erigone_rahia_9631363f:

    # rah "They moved in almost right after you departed from the shipyard."
    rah "Они обосновались там почти сразу после того, как вы покинули верфь."

# game/episode025.rpy:238
translate russian ep025_erigone_rahia_d814d3c3:

    # rah "It’s been a while since the last attack, but intelligence suggests that they’re gearing up for a large strike soon."
    rah "С последней атаки прошло немало времени, но судя по разведданным, скоро они нанесут мощный удар."

# game/episode025.rpy:239
translate russian ep025_erigone_rahia_280dc0a5:

    # rah "An attack that would break the Citadel’s defences once and for all."
    rah "Удар, который окончательно сокрушит оборону Цитадели."

# game/episode025.rpy:240
translate russian ep025_erigone_rahia_dfb08ade:

    # c "The Priest caste must be feeling confident then?"
    c "Значит, теперь каста Жрецов думает, что им всё по силам?"

# game/episode025.rpy:241
translate russian ep025_erigone_rahia_3be709bd:

    # rah "They are."
    rah "Верно."

# game/episode025.rpy:243
translate russian ep025_erigone_rahia_dd1e3bae:

    # rah "Keodele’s sermons inspire them, but she has also started up a genetics program."
    rah "Кеодели вдохновляет их своими проповедями, но она ещё и запустила генетическую программу."

# game/episode025.rpy:248
translate russian ep025_erigone_rahia_bcbee5cc:

    # rah "The treatments are said to be inspired by our Creator."
    rah "Говорят, эти методы лечения вдохновлены нашим Создателем."

# game/episode025.rpy:249
translate russian ep025_erigone_rahia_5f69fdfb:

    # e "You sound doubtful."
    e "В твоём голосе слышится сомнение."

# game/episode025.rpy:251
translate russian ep025_erigone_rahia_e241668b:

    # rah "Well, reports are scarce, because the program is very secret."
    rah "Ну, информации почти нет, ведь программа строго секретная."

# game/episode025.rpy:252
translate russian ep025_erigone_rahia_88d9d15b:

    # rah "But what we have learned is troubling."
    rah "Но то, что нам удалось узнать, довольно тревожно."

# game/episode025.rpy:253
translate russian ep025_erigone_rahia_61779ba2:

    # rah "Keodele has apparently sanctioned direct experiments on her fellow Acarhyn in order to boost musculature and stamina."
    rah "Судя по всему, Кеодели дала добро на эксперименты над своими собратьями-Акархинами, чтобы сделать их сильнее и выносливее."

# game/episode025.rpy:254
translate russian ep025_erigone_rahia_4675368f:

    # c "I take it they don’t perform those experiments on volunteer subjects?"
    c "Я так понимаю, добровольцев для таких экспериментов у них не находится?"

# game/episode025.rpy:256
translate russian ep025_erigone_rahia_d609384e:

    # rah "Some Priests do, probably."
    rah "Вероятно, парочка таких Жрецов находится."

# game/episode025.rpy:257
translate russian ep025_erigone_rahia_d8cf8a15:

    # rah "The majority are prisoners and the local populace, by my reports."
    rah "По моим данным, большинство из них - заключённые и местные жители."

# game/episode025.rpy:258
translate russian ep025_erigone_rahia_302e366a:

    # c "So members of the Warrior caste and bystanders?"
    c "То есть представители касты Воинов и посторонние?"

# game/episode025.rpy:260
translate russian ep025_erigone_rahia_776f4ece:

    # rah "Yes, mostly."
    rah "Да, преимущественно."

# game/episode025.rpy:261
translate russian ep025_erigone_rahia_07aec9f6:

    # rah "We’ve encountered some of the early experiments on the battlefield."
    rah "Нам уже доводилось сталкиваться с результатами ранних экспериментов на поле боя."

# game/episode025.rpy:262
translate russian ep025_erigone_rahia_2442e2c8:

    # rah "They’re formidable foes."
    rah "Это весьма грозные противники."

# game/episode025.rpy:263
translate russian ep025_erigone_rahia_1e199295:

    # rah "Keodele has dubbed them Brutes."
    rah "Кеодели окрестила их Громилами."

# game/episode025.rpy:264
translate russian ep025_erigone_rahia_2df0a0c3:

    # c "Very original."
    c "Весьма оригинально."

# game/episode025.rpy:267
translate russian ep025_erigone_rahia_439d7f9e:

    # rah "You have to forgive her, as she only had her mother and scripture during her upbringing."
    rah "Её можно понять, она ведь кроме матери и писания ничего не знала в детстве."

# game/episode025.rpy:269
translate russian ep025_erigone_rahia_d01096cf:

    # rah "You have to forgive her, as she only had Erylin and scripture during her acolyte training."
    rah "Её можно понять, ведь в годы обучения на послушницу у неё были лишь Эрилин и писание."

# game/episode025.rpy:270
translate russian ep025_erigone_rahia_2793f552:

    # rah "But the Brutes are large, powerful and quick for their size."
    rah "Но эти Громилы крупные, сильные и для своих размеров очень быстрые."

# game/episode025.rpy:272
translate russian ep025_erigone_rahia_732b1cf8:

    # rah "We’ve managed to capture one or two of the units and had a hard time keeping them contained."
    rah "Нам удалось поймать парочку особей, но с удержанием пришлось повозиться."

# game/episode025.rpy:273
translate russian ep025_erigone_rahia_e315e371:

    # rah "Both of them never made it past the fourth day of captivity."
    rah "Обе умерли на четвёртый день в неволе."

# game/episode025.rpy:274
translate russian ep025_erigone_rahia_7e1239d2:

    # rah "And that wasn’t because they were mistreated, or denied food or care."
    rah "И дело тут вовсе не в плохом обращении, голоде или отсутствии ухода."

# game/episode025.rpy:275
translate russian ep025_erigone_rahia_d798522d:

    # c "Some genetic deficiency?"
    c "Какой-то генетический дефект?"

# game/episode025.rpy:276
translate russian ep025_erigone_rahia_a5accdd1:

    # rah "Autopsy confirmed that one caught the common cold and her body couldn’t battle the symptoms."
    rah "Вскрытие показало, что одна из них подхватила простуду, а организм не смог справиться с симптомами."

# game/episode025.rpy:277
translate russian ep025_erigone_rahia_16761da6:

    # rah "The other woman had a small laceration near her toes."
    rah "У другой девушки обнаружили небольшой порез возле пальцев ноги."

# game/episode025.rpy:278
translate russian ep025_erigone_rahia_baa4623e:

    # rah "She died of blood poisoning within hours after the cut became infected."
    rah "Она умерла от заражения крови через несколько часов после того, как рана воспалилась."

# game/episode025.rpy:283
translate russian ep025_erigone_rahia_32f27d87:

    # e "So the Brutes come with an expiration date as soon as they’ve been created."
    e "Получается, эти Громилы с самого создания обречены."

# game/episode025.rpy:285
translate russian ep025_erigone_rahia_b91c99f0:

    # rah "It appears so."
    rah "Похоже на то."

# game/episode025.rpy:286
translate russian ep025_erigone_rahia_e3acff5a:

    # c "I guess sneaking someone inside Aegisthus Shipyards and sneezing all over the place is out of the question?"
    c "Значит, тайком протащить кого-нибудь на Верфи Эгисфа и там всё вокруг обчихать не получится?"

# game/episode025.rpy:288
translate russian ep025_erigone_rahia_93b1c5b5:

    # rah "I’m afraid biological warfare is very much against Acarhyn law."
    rah "Боюсь, биологические оружие у Акархинов категорически вне закона."

# game/episode025.rpy:301
translate russian ep025_erigone_rahia_d37e9228:

    # rah "The Citadel has staved off the attacks from the Priest caste so far and I’m confident we’ll do so again."
    rah "Цитадель до сих пор сдерживала атаки касты Жрецов, и я уверена, что в этот раз тоже выстоим."

# game/episode025.rpy:302
translate russian ep025_erigone_rahia_bfdda158:

    # rah "You’re safe within the walls of the Citadel, but I urge Your Majesty to evacuate as soon as the tide of battle turns against us."
    rah "В стенах Цитадели вам ничего не угрожает, но я настоятельно советую Вашему Величеству эвакуироваться, если ход битвы изменится не в нашу пользу."

# game/episode025.rpy:307
translate russian ep025_erigone_rahia_2e8a5fe0:

    # e "Of course."
    e "Разумеется."

# game/episode025.rpy:309
translate russian ep025_erigone_rahia_b98b79b0:

    # rah "It would be a privilege if you were to speak to the troops at some point during your stay."
    rah "Для нас было бы честью, если бы вы нашли время обратиться к войскам во время своего пребывания здесь."

# game/episode025.rpy:314
translate russian ep025_erigone_rahia_8f988b15:

    # e "Yes, I’ll schedule an address for tomorrow."
    e "Да, я запланирую выступление на завтра."

# game/episode025.rpy:316
translate russian ep025_erigone_rahia_7f606ac4:

    # rah "Do you wish to be present at the strategic briefings in the coming days?"
    rah "Желаете присутстовать на стратегических совещаниях в ближайшие дни?"

# game/episode025.rpy:321
translate russian ep025_erigone_rahia_75f4a0fd:

    # e "Yes, that would be helpful."
    e "Да, это было бы полезно."

# game/episode025.rpy:323
translate russian ep025_erigone_rahia_8dda470c:

    # e "My brother wishes to join in as well."
    e "Мой брат тоже желает присоединиться."

# game/episode025.rpy:325
translate russian ep025_erigone_rahia_b1f7f198:

    # e "[p_name] wishes to join in as well."
    e "[p_name] тоже желает присоединиться."

# game/episode025.rpy:327
translate russian ep025_erigone_rahia_d15c5734:

    # rah "Very good."
    rah "Отлично."

# game/episode025.rpy:332
translate russian ep025_erigone_rahia_74f67de1:

    # e "We have a request of our own which I would like to propose at one of those meetings."
    e "У нас также есть одна просьба, которую я хотела бы озвучить на одном из этих собраний."

# game/episode025.rpy:334
translate russian ep025_erigone_rahia_e78c327c:

    # rah "Of course, I’ll amend the agenda."
    rah "Конечно, я внесу это в повестку."

# game/episode025.rpy:339
translate russian ep025_erigone_rahia_c7a6de9e:

    # e "I know you’ve been preoccupied with battling the Priest caste and that Erigone is in isolation by design, but we have a request to make."
    e "Я понимаю, что сейчас всё ваше внимание сосредоточено на борьбе с кастой Жрецов, а Эригон изолирован не случайно, но мы хотели бы обратиться к вам с просьбой."

# game/episode025.rpy:340
translate russian ep025_erigone_rahia_19169806:

    # e "There’s a war brewing between the Sovereignty and the rest of the known universe and without a strong coalition to oppose them, the outcome looks grim."
    e "Назревает война между Суверенитетом и всем остальным известным миром, и без сильной коалиции, способной ему противостоять, дело может кончиться плохо."

# game/episode025.rpy:342
translate russian ep025_erigone_rahia_bbbbc63e:

    # rah "I see."
    rah "Понятно."

# game/episode025.rpy:343
translate russian ep025_erigone_rahia_ae827db6:

    # rah "Is there a direct threat to Erigone?"
    rah "Эригону что-то напрямую угрожает?"

# game/episode025.rpy:344
translate russian ep025_erigone_rahia_f41ba07d:

    # c "Not yet."
    c "Пока нет."

# game/episode025.rpy:345
translate russian ep025_erigone_rahia_2b4c8d8d:

    # c "But the location of the planet is known to Sovereignty, as is its significance."
    c "Но Суверенитету известно местоположение планеты, как и её значение."

# game/episode025.rpy:346
translate russian ep025_erigone_rahia_0e70340f:

    # rah "Significance?"
    rah "Значение?"

# game/episode025.rpy:347
translate russian ep025_erigone_rahia_c372e6f6:

    # c "The new leader of the Sovereignty is our father."
    c "Во главе Суверенитета теперь наш отец."

# game/episode025.rpy:348
translate russian ep025_erigone_rahia_8426c05d:

    # c "I’m fairly certain he’ll view the conquest of Erigone, ruled by his daughter, as a nice propaganda stunt."
    c "Я почти уверен, что он сочтёт завоевание Эригона, которым правит его дочь, отличным пропагандистским ходом."

# game/episode025.rpy:350
translate russian ep025_erigone_rahia_2c8f8589:

    # rah "We have a lot to discuss then."
    rah "Тогда нам многое предстоит обсудить."

# game/episode025.rpy:351
translate russian ep025_erigone_rahia_0026b10c:

    # rah "I will say this though, as long as the civil war on Erigone has not been resolved, I don’t see how we can make a meaningful contribution to a possible war effort."
    rah "Но скажу одно: пока гражданская война на Эригоне не закончится, от нас в возможной войне будет мало толку."

# game/episode025.rpy:352
translate russian ep025_erigone_rahia_24366554:

    # c "I understand."
    c "Я понимаю."

# game/episode025.rpy:357
translate russian ep025_erigone_rahia_a5c2c953:

    # e "All we ask is for our request to be heard."
    e "Мы лишь просим выслушать нашу просьбу."

# game/episode025.rpy:359
translate russian ep025_erigone_rahia_dea3d9f7:

    # rah "That goes without saying, anything for our Queen."
    rah "Само собой. Для нашей Королевы - всё что угодно."

# game/episode025.rpy:360
translate russian ep025_erigone_rahia_4be9aefb:

    # rah "I’ll leave you both to settle and will forward the invitation to the next war council."
    rah "Я оставлю вас двоих обустраиваться, а приглашение на следующий военный совет направлю позднее."

# game/episode025.rpy:365
translate russian ep025_erigone_keodele_2512af87:

    # "We passed mechs, battleships and other military craft on our way to the main building."
    "На пути к главному зданию нам встретились мехи, боевые корабли и прочая военная техника."

# game/episode025.rpy:366
translate russian ep025_erigone_keodele_dcc5a8d8:

    # "All personnel were clearly briefed on our arrival and we were not stopped once."
    "Весь персонал, похоже, был предупреждён о нашем прибытии, и нас ни разу не остановили."

# game/episode025.rpy:371
translate russian ep025_erigone_keodele_d12a78ea:

    # "A contingent of priests was waiting for us in one of the hangar bays, Keodele in front."
    "В одном из ангаров нас уже ждала группа жрецов, с Кеодели во главе."

# game/episode025.rpy:372
translate russian ep025_erigone_keodele_0241d947:

    # "Outwardly, there was nothing visible of the timid and shy acolyte that accompanied the High Priestess everywhere, when Erylin was still in power."
    "На первый взгляд, в ней уже ничего не осталось от той робкой и застенчивой послушницы, которая повсюду сопровождала Верховную Жрицу, когда Эрилин была у власти."

# game/episode025.rpy:373
translate russian ep025_erigone_keodele_7385027e:

    # "Still clad in red, Keodele wore the vestments of a High Priestess and the other priests seem to defer to her."
    "Кеодели по-прежнему была в красном, в облачении Верховной Жрицы, и остальные жрецы, похоже, считались с ней."

# game/episode025.rpy:375
translate russian ep025_erigone_keodele_46748f57:

    # keo "Welcome, Virgin Queen."
    keo "Добро пожаловать, Королева-Девственница."

# game/episode025.rpy:376
translate russian ep025_erigone_keodele_43757ceb:

    # keo "We are once more honored by Your Presence."
    keo "Мы снова удостоены Вашего Присутствия."

# game/episode025.rpy:378
translate russian ep025_erigone_keodele_2446e0e4:

    # e "The pleasure is ours, High Priestess."
    e "Взаимно, Верховная Жрица."

# game/episode025.rpy:379
translate russian ep025_erigone_keodele_3ad53f81:

    # e "Erigone seems to be at war."
    e "Похоже, Эригон в состоянии войны."

# game/episode025.rpy:381
translate russian ep025_erigone_keodele_f6efd5fd:

    # keo "Yes, the Warrior caste continues to be a major nuisance."
    keo "Да, каста Воинов по-прежнему доставляет немало хлопот."

# game/episode025.rpy:382
translate russian ep025_erigone_keodele_f8f83e56:

    # keo "We are making good progress and have them cornered inside the Citadel, but their resistance remains."
    keo "Мы добиваемся значительных успехов и загоняем их в угол внутри Цитадели, но они продолжают сопротивляться."

# game/episode025.rpy:384
translate russian ep025_erigone_keodele_3e8671f8:

    # keo "The Warrior caste took advantage of my mother’s betrayal to launch an all out assault."
    keo "Каста Воинов воспользовалась предательством моей матери, чтобы начать полномасштабную атаку."

# game/episode025.rpy:386
translate russian ep025_erigone_keodele_4c746745:

    # keo "The Warrior caste took advantage of High Priest Erylin’s betrayal to launch an all out assault."
    keo "Каста Воинов воспользовалась предательством Высшей Жрицы Эрилин, чтобы начать полномасштабную атаку."

# game/episode025.rpy:388
translate russian ep025_erigone_keodele_7325d03e:

    # keo "We barely managed to survive that first attack, our sphere of influence reduced to the Aegisthus Shipyards and its immediate surroundings."
    keo "Нам едва удалось пережить первую атаку, наша сфера влияния сократилась до Верфей Эгисфа и их ближайших окрестностей."

# game/episode025.rpy:389
translate russian ep025_erigone_keodele_480e40c5:

    # keo "Over the many months we have slowly, but surely regained control of large swaths of Erigone."
    keo "В течение многих месяцев мы медленно, но верно восстанавливали контроль над обширными территориями Эригона."

# game/episode025.rpy:394
translate russian ep025_erigone_keodele_1263c90e:

    # e "We have met Erylin, she seems to have struck a deal with the Confessor."
    e "Мы встретили Эрилин, похоже, она заключила сделку с Исповедником."

# game/episode025.rpy:396
translate russian ep025_erigone_keodele_ca51fd82:

    # keo "She did, leaving us to deal with the mess she had created."
    keo "Да, оставив нас разбираться с тем беспорядком, который она устроила."

# game/episode025.rpy:397
translate russian ep025_erigone_keodele_013688a3:

    # keo "She wanted to take the entirety of my flock with her, but many refused."
    keo "Она хотела забрать с собой всю мою паству, но многие отказались."

# game/episode025.rpy:398
translate russian ep025_erigone_keodele_24349a87:

    # keo "I led the revolt against her insidious attempts at sedition myself, which saved the Priest caste from splintering entirely."
    keo "Я сама возглавила восстание против её коварных попыток подстрекательства к мятежу, что спасло касту Жрецов от полного раскола."

# game/episode025.rpy:403
translate russian ep025_erigone_keodele_a9ebb7b1:

    # e "You are to be commended for your bravery."
    e "Следует похвалить тебя за храбрость."

# game/episode025.rpy:405
translate russian ep025_erigone_keodele_61511319:

    # keo "Thank you, Your Majesty."
    keo "Благодарю, Ваше Величество."

# game/episode025.rpy:406
translate russian ep025_erigone_keodele_2a0849a3:

    # keo "We have trained and honed our martial skills in order to keep the enemy at bay."
    keo "Мы тренировались и оттачивали наши боевые навыки, чтобы держать врага на расстоянии."

# game/episode025.rpy:407
translate russian ep025_erigone_keodele_ea91d9d1:

    # keo "I think Your Majesty will be very impressed by the transformation of our order."
    keo "Думаю, Ваше Величество будет очень впечатлена преобразованием нашего ордена."

# game/episode025.rpy:412
translate russian ep025_erigone_keodele_a8cdd9ea:

    # e "I’m sure we will be."
    e "Я в этом не сомневаюсь."

# game/episode025.rpy:414
translate russian ep025_erigone_keodele_395ec5e6:

    # keo "It’s my hope that you will personally attend one of the Holy Sermons."
    keo "Я надеюсь, что вы лично посетите одну из Священных Проповедей."

# game/episode025.rpy:415
translate russian ep025_erigone_keodele_1cc98dda:

    # keo "Several new sisters are to be welcomed to the fold, their enhanced martial capabilities will be a great tool to smite our enemies."
    keo "Скоро к нам присоединятся несколько новых сестёр, с их улучшенными боевыми навыками нам будет гораздо проще расправляться с врагами."

# game/episode025.rpy:416
translate russian ep025_erigone_keodele_628dd240:

    # keo "The Light of our Creator smiles upon these new Champions and the Priest caste as a whole."
    keo "Свет нашего Создателя озаряет этих новых Чемпионов и касту Жрецов в целом."

# game/episode025.rpy:421
translate russian ep025_erigone_keodele_a1449ba2:

    # e "We’d be honored to attend one of your sermons."
    e "Для нас будет честью присутствовать на одной из ваших проповедей."

# game/episode025.rpy:423
translate russian ep025_erigone_keodele_841d4507:

    # keo "I’m glad to hear it."
    keo "Я рада это слышать."

# game/episode025.rpy:424
translate russian ep025_erigone_keodele_a5f53ec3:

    # keo "Rooms have been prepared for Your Majesty and her companions."
    keo "Для Вашего Величества и её спутников подготовлены комнаты."

# game/episode025.rpy:425
translate russian ep025_erigone_keodele_ab3cd007:

    # keo "We will see to it that Your Majesty will enjoy her stay to the fullest."
    keo "Мы позаботимся о том, чтобы Ваше Величество в полной мере насладилось своим пребыванием."

# game/episode025.rpy:430
translate russian ep025_erigone_keodele_92474673:

    # e "We thank you."
    e "Мы благодарим вас."

# game/episode025.rpy:431
translate russian ep025_erigone_keodele_f6beabc6:

    # e "We would also like to speak with you on official matters."
    e "Мы также хотели бы обсудить с вами официальные вопросы."

# game/episode025.rpy:432
translate russian ep025_erigone_keodele_6f29973e:

    # e "We are aware that battling the Warrior caste preoccupies you all at the moment and that Erigone is in isolation by design, but we have a request to make."
    e "Мы понимаем, что в данный момент всё ваше внимание сосредоточено на борьбе с кастой Воинов, а Эригон изолирован не случайно, но мы хотели бы обратиться к вам с просьбой."

# game/episode025.rpy:433
translate russian ep025_erigone_keodele_19169806:

    # e "There’s a war brewing between the Sovereignty and the rest of the known universe and without a strong coalition to oppose them, the outcome looks grim."
    e "Назревает война между Суверенитетом и всем остальным известным миром, и без сильной коалиции, способной ему противостоять, дело может кончиться плохо."

# game/episode025.rpy:435
translate russian ep025_erigone_keodele_0869fac6:

    # keo "That’s worrying indeed."
    keo "Это действительно вызывает беспокойство."

# game/episode025.rpy:436
translate russian ep025_erigone_keodele_fe5b6cd6:

    # keo "Is Erigone under direct threat of these enemy forces?"
    keo "Эригон находится под непосредственной угрозой со стороны этих вражеских сил?"

# game/episode025.rpy:441
translate russian ep025_erigone_keodele_530032ee:

    # e "Not yet."
    e "Пока нет."

# game/episode025.rpy:442
translate russian ep025_erigone_keodele_bf041693:

    # e "But Erigone’s location and its significance are known to the Sovereignty."
    e "Но Суверенитету известно местоположение Эригона, как и его значение."

# game/episode025.rpy:444
translate russian ep025_erigone_keodele_1287db91:

    # keo "Its significance, Your Majesty?"
    keo "Его значение, Ваше Величество?"

# game/episode025.rpy:450
translate russian ep025_erigone_keodele_e4634a64:

    # e "The new leader of the Sovereignty is our father."
    e "Во главе Суверенитета теперь наш отец."

# game/episode025.rpy:451
translate russian ep025_erigone_keodele_34baa4e7:

    # e "It’s almost certain that he’ll view the conquest of Erigone, the seat of his daughter’s power, as an opportunity to create propaganda for the Sovereignty."
    e "Почти наверняка он расценит завоевание Эригона - центра власти своей дочери - как возможность создать пропаганду в пользу Суверенитета."

# game/episode025.rpy:453
translate russian ep025_erigone_keodele_86eb046c:

    # e "The new leader of the Sovereignty is [p_name]’s father."
    e "Во главе Суверенитета теперь отец [p_name]."

# game/episode025.rpy:454
translate russian ep025_erigone_keodele_04162c40:

    # e "It’s almost certain that he’ll view the conquest of Erigone, the seat of my power, as an opportunity to create propaganda for the Sovereignty."
    e "Почти наверняка он расценит завоевание Эригона — центра мой власти - как возможность создать пропаганду в пользу Суверенитета."

# game/episode025.rpy:456
translate russian ep025_erigone_keodele_90038fdc:

    # keo "I see."
    keo "Понятно."

# game/episode025.rpy:457
translate russian ep025_erigone_keodele_62f757bf:

    # keo "We should discuss these matters at Your Majesty’s convenience."
    keo "Мы должны обсудить эти вопросы в удобное для Вашего Величества время."

# game/episode025.rpy:458
translate russian ep025_erigone_keodele_0ce752e1:

    # keo "I would like to point out that as long as Erigone is divided in war, we will not be able to make a meaningful contribution to a possible war effort."
    keo "Хотела бы отметить: пока в Эригоне идёт междоусобная война, рассчитывать на нашу серьёзную поддержку не стоит."

# game/episode025.rpy:463
translate russian ep025_erigone_keodele_5d4a0355:

    # e "We understand."
    e "Мы понимаем."

# game/episode025.rpy:464
translate russian ep025_erigone_keodele_499cf609:

    # e "Resolving the current crisis is Our greatest priority."
    e "Для нас сейчас самое важное - разобраться с этим кризисом."

# game/episode025.rpy:466
translate russian ep025_erigone_keodele_69b42594:

    # keo "Thank you, my Queen."
    keo "Благодарю, моя Королева."

# game/episode025.rpy:467
translate russian ep025_erigone_keodele_ff87797d:

    # keo "I’ll leave you all to settle and we will speak soon of the matters at hand."
    keo "Я оставлю вас обустраиваться, а вскоре мы обсудим предстоящие дела."

# game/episode025.rpy:477
translate russian ep025_erigone_council_7736bf8f:

    # "The War Council had gathered in the throne room of the Citadel."
    "Военный совет собрался в тронном зале Цитадели."

# game/episode025.rpy:479
translate russian ep025_erigone_council_6a18bbf1:

    # "My sister was expected to preside over the meeting and had asked some of us to attend as well."
    "Ожидалось, что моя сестра будет председательствовать на собрании, и она попросила некоторых из нас тоже присутствовать."

# game/episode025.rpy:481
translate russian ep025_erigone_council_5e81569d:

    # "Eva was expected to preside over the meeting and had asked some of us to attend as well."
    "Ожидалось, что Ева будет председательствовать на собрании, и она попросила некоторых из нас тоже присутствовать."

# game/episode025.rpy:482
translate russian ep025_erigone_council_7ca9fd1d:

    # "The first hours were spent detailing recent troop movements and the general state of the battlefield."
    "Первые часы были посвящены подробному обсуждению недавних передвижений войск и общего положения дел на поле боя."

# game/episode025.rpy:483
translate russian ep025_erigone_council_67e1d696:

    # "The general consensus among the officers was that the Priest caste were likely gearing up to execute a final push in order to take the Citadel and environs."
    "Среди офицеров сложилось общее мнение, что каста Жрецов, вероятно, готовится к решающему наступлению с целью захватить Цитадель и прилегающие территории."

# game/episode025.rpy:485
translate russian ep025_erigone_council_5c9c0c24:

    # rah "By making certain routes inaccessible and blowing up a few bridges, we are effectively funnelling the army of the Priests along this route."
    rah "Перекрыв отдельные маршруты и взорвав несколько мостов, мы фактически загоняем армию Жрецов на этот путь."

# game/episode025.rpy:486
translate russian ep025_erigone_council_bccdb278:

    # rah "We should be able to ambush them and stage a confrontation here."
    rah "Здесь мы сможем устроить засаду и дать им бой."

# game/episode025.rpy:487
translate russian ep025_erigone_council_d214ba17:

    # rah "The terrain will work in favor for us."
    rah "Рельеф сыграет нам на руку."

# game/episode025.rpy:488
translate russian ep025_erigone_council_2e960094:

    # rah "The mountain range will obscure our aerial assault until the last moment."
    rah "Горный хребет будет скрывать наш воздушный удар до самого последнего момента."

# game/episode025.rpy:489
translate russian ep025_erigone_council_b60275a7:

    # rah "After the bombardment, our ground troops will sweep in to deal with the remaining enemy forces."
    rah "Как только закончится обстрел, наши наземные войска пойдут в наступление и ликвидируют оставшиеся подразделения врага."

# game/episode025.rpy:490
translate russian ep025_erigone_council_7a1879c7:

    # "All the gathered officers nodded in assent and looked at Eva to give her final approval."
    "Все собравшиеся офицеры кивнули в знак согласия и посмотрели на Еву, ожидая её окончательного одобрения."

# game/episode025.rpy:495
translate russian ep025_erigone_council_1ed32b1d:

    # e "We are pleased with the thorough preparations you have all undertaken."
    e "Мы довольны той тщательной подготовкой, которую вы все провели."

# game/episode025.rpy:496
translate russian ep025_erigone_council_b5596d49:

    # e "The battle will be a defining moment in Acarhyn history."
    e "Эта битва станет переломным моментом в истории Акархина."

# game/episode025.rpy:497
translate russian ep025_erigone_council_2e27981a:

    # e "And we are certain the Warrior caste will prevail and that together we will be able to usher our nation into a time of peace and prosperity."
    e "И мы уверены, что каста Воинов одержит победу и что вместе мы сможем привести нашу нацию к эпохе мира и процветания."

# game/episode025.rpy:498
translate russian ep025_erigone_council_d47322eb:

    # e "The threat against Erigone doesn’t just come from the inside though."
    e "Но угроза для Эригона исходит не только изнутри."

# game/episode025.rpy:499
translate russian ep025_erigone_council_0865cfd3:

    # e "As we speak, forces are gathering in order to conquer large swaths of the known universe."
    e "Тем временем собираются силы, чтобы захватить огромные территории известной нам Вселенной."

# game/episode025.rpy:500
translate russian ep025_erigone_council_25e4d7ff:

    # e "The Sovereignty has begun a campaign that will reshape the universe into a radically different place, if unopposed."
    e "Суверенитет начал кампанию, и если его не остановить, он перекроит Вселенную до неузнаваемости."

# game/episode025.rpy:501
translate russian ep025_erigone_council_f6a01a72:

    # e "Many worlds have already fallen under the thrall of the Sovereignty and many more will follow, Erigone included."
    e "Многие миры уже пали перед Суверенитетом, и за ними последуют многие другие, Эригон не станет исключением."

# game/episode025.rpy:505
translate russian ep025_erigone_council_effc1526:

    # woman "Is there reason to believe the Sovereignty has any special interest in Erigone, Your Majesty?"
    woman "Есть ли основания полагать, что Суверенитет особенно заинтересован в Эригоне, Ваше Величество?"

# game/episode025.rpy:511
translate russian ep025_erigone_council_773a8423:

    # e "Our father has usurped the mantle of leader of the Sovereignty and is directly responsible for these recent acts of aggression."
    e "Наш отец узурпировал власть и стал во главе Суверенитета, и именно он несёт прямую ответственность за недавние акты агрессии."

# game/episode025.rpy:512
translate russian ep025_erigone_council_42d91e86:

    # e "Our father has hunted us relentlessly and performed unspeakable experiments on Our Person."
    e "Наш отец неустанно преследовал нас и проводил над нами немыслимые эксперименты."

# game/episode025.rpy:513
translate russian ep025_erigone_council_186c6e59:

    # e "The traitor Erylin is known to be in league with Our father."
    e "Известно, что предательница Эрилин заодно с нашим отцом."

# game/episode025.rpy:515
translate russian ep025_erigone_council_d7065310:

    # e "Agust has usurped the mantle of leader of the Sovereignty and is directly responsible for these recent acts of aggression."
    e "Агуст узурпировал власть и стал во главе Суверенитета, и именно он несёт прямую ответственность за недавние акты агрессии."

# game/episode025.rpy:516
translate russian ep025_erigone_council_c809b4f3:

    # e "This man has hunted us relentlessly and performed unspeakable experiments on Our Person."
    e "Этот человек неустанно преследовал нас и проводил над нами немыслимые эксперименты."

# game/episode025.rpy:517
translate russian ep025_erigone_council_161ea975:

    # e "The traitor Erylin is known to be in league with Agust."
    e "Известно, что предательница Эрилин заодно с Агустом."

# game/episode025.rpy:518
translate russian ep025_erigone_council_24cf6d9f:

    # e "Subjugating Erigone or perhaps worse, is almost a certainty if we do not act now."
    e "Если мы не начнём действовать прямо сейчас, покорение Эригона - а возможно, и нечто худшее - практически неизбежно."

# game/episode025.rpy:523
translate russian ep025_erigone_council_93f9dd93:

    # e "We therefore humbly request you to join the alliance that we have been building, in order to combat the threat of the Sovereignty."
    e "Поэтому мы смиренно просим вас присоединиться к формируемому нами альянсу для борьбы с угрозой со стороны Суверенитета."

# game/episode025.rpy:524
translate russian ep025_erigone_council_24cd62fe:

    # "As Eva indicated she was done presenting her proposal, the Acarhyn commanders began to converse among themselves."
    "Когда Ева дала понять, что закончила излагать своё предложение, командиры Акархинов принялись обсуждать его между собой."

# game/episode025.rpy:525
translate russian ep025_erigone_council_db9f4e6d:

    # "The discussions were heated, but ultimately all commanders seemed to defer to Rahia, who was the first to address Eva again."
    "Обсуждение было бурным, но в итоге все командиры, похоже, оставили последнее слово за Рахией, и именно она первой вновь обратилась к Еве."

# game/episode025.rpy:527
translate russian ep025_erigone_council_41b01d87:

    # rah "My Queen."
    rah "Моя Королева."

# game/episode025.rpy:528
translate russian ep025_erigone_council_5379db5b:

    # rah "Our intelligence supports Your Majesty’s claims about the Sovereignty and their invasion."
    rah "Наша разведка подтверждает заявления Вашего Величества о Суверенитете и их вторжении."

# game/episode025.rpy:529
translate russian ep025_erigone_council_51135858:

    # rah "With Erigone still divided in civil war, we cannot afford to focus our efforts on two fronts."
    rah "Пока Эригон погружён в гражданскую войну, мы не можем позволить себе воевать на два фронта."

# game/episode025.rpy:530
translate russian ep025_erigone_council_fbad2743:

    # rah "We advise to resolve the conflict with the Priest caste first, before committing any troops to the alliance."
    rah "Советуем сперва уладить конфликт с кастой Жрецов и только после этого направлять войска в альянс."

# game/episode025.rpy:531
translate russian ep025_erigone_council_1d74edfc:

    # rah "The coming battle we’ve spoken of before will decide the outcome of the civil war."
    rah "Предстоящая битва, о которой мы уже говорили, определит исход гражданской войны."

# game/episode025.rpy:532
translate russian ep025_erigone_council_0c20ed5c:

    # rah "We will strike divisively and end this conflict in one fell swoop, after which all of Erigon’s military might will be available to the alliance."
    rah "Мы нанесём решающий удар и одним махом положим конец этому конфликту, после чего вся военная мощь Эригона будет в распоряжении альянса."

# game/episode025.rpy:537
translate russian ep025_erigone_council_92474673:

    # e "We thank you."
    e "Мы благодарим вас."

# game/episode025.rpy:538
translate russian ep025_erigone_council_9933c72d:

    # e "The Warrior caste raises valid concerns about Erigone’s internal security."
    e "Опасения касты Воинов по поводу внутренней безопасности Эригона вполне обоснованны."

# game/episode025.rpy:539
translate russian ep025_erigone_council_a6943a07:

    # e "We agree that the conflict with the Priest case must be resolved first and grant you full permission to deal with the situation as you see fit."
    e "Мы согласны, что прежде всего нужно уладить конфликт с кастой Жрецов, и даём вам полную свободу действий - решайте этот вопрос, как сочтёте нужным."

# game/episode025.rpy:541
translate russian ep025_erigone_council_80052ee9:

    # rah "Thank you, Your Majesty."
    rah "Благодарю, Ваше Величество."

# game/episode025.rpy:542
translate russian ep025_erigone_council_4740ebdf:

    # rah "I’ve instructed our scouts to alert us the minute there is movement in our direction from Aegisthus Shipyards."
    rah "Я велела нашим разведчикам сразу доложить, если кто-нибудь двинется в нашу сторону со стороны Верфей Эгисфа."

# game/episode025.rpy:543
translate russian ep025_erigone_council_728eaf73:

    # rah "Teams are already underway to prepare for the ambush."
    rah "Группы уже выдвинулись, что подготовить засаду."

# game/episode025.rpy:544
translate russian ep025_erigone_council_7751eee2:

    # rah "I will instruct others to make preparations for a military campaign outside Erigone’s planetary sphere."
    rah "Я велю остальным начать подготовку к военной кампании за пределами сферы Эригона."

# game/episode025.rpy:549
translate russian ep025_erigone_council_574484dd:

    # e "This meeting is now adjourned."
    e "На этом собрание объявляю оконченным."

# game/episode025.rpy:554
translate russian ep025_erigone_council_05453b25:

    # "The commanders all left the throne room, leaving us behind."
    "Все командиры покинули тронный зал, оставив нас одних."

# game/episode025.rpy:555
translate russian ep025_erigone_council_64e92085:

    # c "I guess this is the best we could have hoped for."
    c "Пожалуй, это лучшее, на что мы могли рассчитывать."

# game/episode025.rpy:556
translate russian ep025_erigone_council_5f2b7137:

    # e "Yes, I don’t see how this could have gone any different."
    e "Да, по-другому, мне кажется, и быть не могло."

# game/episode025.rpy:557
translate russian ep025_erigone_council_25377112:

    # e "If the Warrior caste were to leave the planet now, Keodele and her priests would have no trouble taking the Citadel and squashing any opposition."
    e "Если каста Воинов сейчас покинет планету, Кеодели и её жрецы без труда захватят Цитадель и подавят всякое сопротивление."

# game/episode025.rpy:558
translate russian ep025_erigone_council_b74ce565:

    # c "Let’s hope the ambush will go as planned."
    c "Будем надеяться, что с засадой всё пройдёт как надо."

# game/episode025.rpy:563
translate russian ep025_erigone_council_d65cd2e8:

    # e "Nothing more we can do, I’m afraid."
    e "Боюсь, больше нам ничего не остаётся."

# game/episode025.rpy:564
translate russian ep025_erigone_council_53ecca32:

    # e "Shall we go back to my quarters?"
    e "Вернёмся ко мне?"

# game/episode025.rpy:565
translate russian ep025_erigone_council_346f428a:

    # e "This throne isn’t the most comfortable, nor are these royal robes."
    e "Этот трон не сказать чтобы удобный, да и в этих королевских одеяниях не особо комфортно."

# game/episode025.rpy:567
translate russian ep025_erigone_council_e2853c15:

    # c "I think you look very sexy."
    c "Как по мне, выглядишь ты сексуально."

# game/episode025.rpy:568
translate russian ep025_erigone_council_e83825a0:

    # c "Hottest Queen ever!"
    c "Самая Горячая Королева на свете!"

# game/episode025.rpy:573
translate russian ep025_erigone_council_2c479b13:

    # e "[p_name_short], if you utter one more word..."
    e "[p_name_short], ещё одно слово..."

# game/episode025.rpy:574
translate russian ep025_erigone_council_20d59369:

    # c "Yes, yes, call off the headsman already!"
    c "Да, да, срочно зовите палача!"

# game/episode025.rpy:575
translate russian ep025_erigone_council_c14aca59:

    # "Bickering good-naturedly, we headed back to Eva’s quarters."
    "Продолжая по-доброму препираться, мы отправились обратно в покои Евы."

# game/episode025.rpy:577
translate russian ep025_erigone_council_7207060f:

    # "We headed back to Eva’s quarters."
    "Мы отправились обратно в покои Евы."

# game/episode025.rpy:583
translate russian ep025_erigone_sermon_b6a9c254:

    # "Keodele’s sermon was to be held inside a large hall of the Shipyards."
    "Проповедь Кеодели должна была состояться в большом зале Верфей."

# game/episode025.rpy:585
translate russian ep025_erigone_sermon_d26f61a5:

    # "Several priests came to remind us about the imminent event, giving the impression that our attendance was far from optional."
    "Несколько жрецов пришли напомнить нам о предстоящем мероприятии - и по всему было видно, что наше присутствие не обсуждается."

# game/episode025.rpy:586
translate russian ep025_erigone_sermon_6bc3af24:

    # "All priests rose as Eva entered the chamber."
    "Все жрецы встали, когда Ева вошла в зал."

# game/episode025.rpy:587
translate russian ep025_erigone_sermon_5a403dae:

    # "Keodele stood in front of a large altar, looking quite regal in her High Priest attire."
    "Кеодели стояла перед большим алтарём, выглядя весьма величественно в облачении Верховной Жрицы."

# game/episode025.rpy:592
translate russian ep025_erigone_sermon_ead6a6e6:

    # keo "Welcome, we are graced by Your Presence, Your Majesty."
    keo "Ваше Присутствие - великая честь для нас, Ваше Величество."

# game/episode025.rpy:593
translate russian ep025_erigone_sermon_12968fba:

    # e "We are pleased to attend your sermon, High Priestess."
    e "Для нас большая честь присутствовать на вашей проповеди, Верховная Жрица."

# game/episode025.rpy:595
translate russian ep025_erigone_sermon_05cf9bb7:

    # "Once we were standing at the front of the crowd, Keodele launched into a lengthy homily on the virtues of the Acarhyn’s alleged creator."
    "Когда мы оказались перед толпой, Кеодели пустилась в длинную проповедь о достоинствах предполагаемого создателя Акархинов."

# game/episode025.rpy:596
translate russian ep025_erigone_sermon_f374e906:

    # "Her lecture put a great emphasis on genetic manipulation and its supposed positive aspects."
    "Особое внимание в своей лекции она уделила генетическим манипуляциям и их якобы положительным сторонам."

# game/episode025.rpy:597
translate russian ep025_erigone_sermon_b446359f:

    # "I could tell she was paving the way for something and considering the rapt attention of her audience, she was succeeding."
    "Я понял, что она к чему-то подводит, и, судя по тому, как внимательно её слушали, добивалась своего."

# game/episode025.rpy:599
translate russian ep025_erigone_sermon_ff29d223:

    # keo "With the knowledge granted us by the Creator, we will smite our enemies!"
    keo "С помощью знаний, дарованных нам Создателем, мы сокрушим наших врагов!"

# game/episode025.rpy:600
translate russian ep025_erigone_sermon_08bc9582:

    # keo "Erigone will become a tranquil, verdant paradise once more."
    keo "Эригон вновь станет мирным и цветущим раем."

# game/episode025.rpy:601
translate russian ep025_erigone_sermon_5d319799:

    # keo "Sisters, in a few days we will finally strike a crippling blow to the Warrior caste."
    keo "Сёстры, через несколько дней мы наконец нанесём сокрушительный удар по касте Воинов."

# game/episode025.rpy:602
translate russian ep025_erigone_sermon_4948f401:

    # keo "We will go to battle and deal with the threat once and for all."
    keo "Мы отправимся в бой и раз и навсегда покончим с этой угрозой."

# game/episode025.rpy:603
translate russian ep025_erigone_sermon_f0939e2f:

    # keo "Complete surrender of the Warrior caste is what we will accomplish."
    keo "Мы добьёмся полной капитуляции касты Воинов."

# game/episode025.rpy:604
translate russian ep025_erigone_sermon_e5490f64:

    # keo "Once we have achieved this, the Priest caste will venture out on behest of our Queen and spread the Holy Word of our Creator to the rest of the universe."
    keo "Как только мы добьёмся этого, каста Жрецов выйдет в мир по велению Нашей Королевы и понесёт Святое Слово нашего Создателя во все уголки вселенной."

# game/episode025.rpy:606
translate russian ep025_erigone_sermon_df07b5df:

    # "A deafening cheer erupted from the many priests that were in attendance."
    "Толпа жрецов разразилась оглушительными возгласами ликования."

# game/episode025.rpy:607
translate russian ep025_erigone_sermon_5c57d90b:

    # "Keodele inclined her head toward Eva."
    "Кеодели слегка наклонила голову в сторону Евы."

# game/episode025.rpy:608
translate russian ep025_erigone_sermon_af516b14:

    # "We had secured our commitment to the war against the Sovereignty."
    "Мы заручились обязательством вступить в войну против Суверенитета."

# game/episode025.rpy:610
translate russian ep025_erigone_sermon_40deaa3a:

    # keo "Rejoice, Sisters!"
    keo "Ликуйте, Сёстры!"

# game/episode025.rpy:611
translate russian ep025_erigone_sermon_edbf7904:

    # keo "Another regiment of Brutes has matured, who will help us achieve our victory."
    keo "Созрел ещё один полк Громил, и он поможет нам победить."

# game/episode025.rpy:613
translate russian ep025_erigone_sermon_639e51f2:

    # "Heavy footsteps resounded in the hallway behind us."
    "Позади нас в коридоре раздались тяжёлые шаги."

# game/episode025.rpy:614
translate russian ep025_erigone_sermon_c23c10ed:

    # "Two priestesses entered the hall, flanking a monstrous figure, who dominated the chamber."
    "В зал вошли две жрицы, ведя по центру между собой чудовищное существо, которое сразу приковывало к себе всё внимание."

# game/episode025.rpy:615
translate russian ep025_erigone_sermon_07614f98:

    # "The monstrosity halted before Keodele."
    "Чудовищное создание остановилось перед Кеодели."

# game/episode025.rpy:617
translate russian ep025_erigone_sermon_3e848fee:

    # keo "Behold, our latest addition to the war effort."
    keo "Узрите наше новое оружие для войны."

# game/episode025.rpy:618
translate russian ep025_erigone_sermon_4796677a:

    # keo "This Brute is bigger, better and stronger than the generation before her."
    keo "Эта Громила крупнее, совершеннее и мощнее предыдущего поколения."

# game/episode025.rpy:620
translate russian ep025_erigone_sermon_b79c6c17:

    # "The High Priestess didn’t seem fazed, but concerned murmurs emanated from the audience."
    "Верховная Жрица выглядела совершенно невозмутимо, но вот среди толпы послышались встревоженные перешёптывания."

# game/episode025.rpy:621
translate russian ep025_erigone_sermon_a3b0fd6b:

    # keo "Are you ready to fight?"
    keo "Готова к бою?"

# game/episode025.rpy:622
translate russian ep025_erigone_sermon_cf49a1e3:

    # "The Brute grunted in response."
    "Громила фыркнула в ответ."

# game/episode025.rpy:623
translate russian ep025_erigone_sermon_08f65a16:

    # keo "I say, are you ready to fight?!"
    keo "Я спрашиваю, готова к бою?"

# game/episode025.rpy:625
translate russian ep025_erigone_sermon_784a0cd8:

    # "Prompted by Keodele, the Brute let out an ear-splitting roar, which blended with the cheers that now erupted from the other priestesses."
    "Подзадоренная Кеодели, Громила издала оглушительный рёв, который слился с ликующими возгласами остальных жриц."

# game/episode025.rpy:626
translate russian ep025_erigone_sermon_fe8c4ba5:

    # "When the noise had died down, the Brute was guided back out of the room."
    "Когда шум стих, Громилу увели из комнаты."

# game/episode025.rpy:628
translate russian ep025_erigone_sermon_5e1fdcc8:

    # "Keodele spewed more religious platitudes and issued a final battle prayer to close off the ritual."
    "Кеодели выдала ещё порцию религиозных банальностей и завершила ритуал напутственной молитвой."

# game/episode025.rpy:629
translate russian ep025_erigone_sermon_e9b1bd3b:

    # "As the room emptied, she came toward us."
    "Когда комната опустела, она подошла к нам."

# game/episode025.rpy:643
translate russian ep025_erigone_sermon_c69e1d3e:

    # keo "What did you think, My Queen?"
    keo "Что скажете, Моя Королева?"

# game/episode025.rpy:648
translate russian ep025_erigone_sermon_fbe3bb3d:

    # e "An impressive display of strength, to be sure."
    e "Впечатляющая демонстрация силы, ничего не скажешь."

# game/episode025.rpy:649
translate russian ep025_erigone_sermon_79f742f0:

    # e "We take it you are confident about your chances against the Warrior caste."
    e "Мы так полагаем, вы уверены, что сможете одолеть касту Воинов?"

# game/episode025.rpy:651
translate russian ep025_erigone_sermon_22a7678b:

    # keo "Very much so, Your Majesty."
    keo "Ещё как, Ваше Величество."

# game/episode025.rpy:652
translate russian ep025_erigone_sermon_d3dc1630:

    # keo "We will crush the Warrior caste and deal with their civil disobedience once and for all."
    keo "Мы сокрушим касту Воинов и раз и навсегда покончим с их гражданским неповиновением."

# game/episode025.rpy:657
translate russian ep025_erigone_sermon_14259d8b:

    # e "Very good."
    e "Прекрасно."

# game/episode025.rpy:658
translate russian ep025_erigone_sermon_def39184:

    # e "We were interested in learning more about the Brutes."
    e "Нам хотелось побольше узнать о Громилах."

# game/episode025.rpy:660
translate russian ep025_erigone_sermon_7fff13ee:

    # keo "Of course, Your Majesty."
    keo "Разумеется, Ваше Величество."

# game/episode025.rpy:661
translate russian ep025_erigone_sermon_d8e97708:

    # keo "Allow me to accompany you to the facility where we work on creating the Perfections of the Creator’s Vision."
    keo "Позвольте мне сопроводить вас в комплекс, где мы работаем над созданием Совершенств Замысла Создателя."

# game/episode025.rpy:666
translate russian ep025_erigone_sermon_d7aabed6:

    # "Keodele seemed to be utterly sincere uttering that last statement."
    "Казалось, Кеодели говорила это совершенно искренне."

# game/episode025.rpy:671
translate russian ep025_erigone_sermon_7c234bb8:

    # "We followed her through the complex to a gate, guarded by two Priestesses."
    "Мы последовали за ней через комплекс к воротам, охраняемым двумя жрицами."

# game/episode025.rpy:672
translate russian ep025_erigone_sermon_1372b687:

    # keo "The Queen wishes to inspect our work."
    keo "Королева желает ознакомиться с плодами нашей работы."

# game/episode025.rpy:677
translate russian ep025_erigone_sermon_a3d93b2a:

    # "The gate gave access to a large laboratory."
    "Ворота вели в большую лабораторию."

# game/episode025.rpy:678
translate russian ep025_erigone_sermon_9a56a47e:

    # keo "This is the main operating theatre, where the Potentials are treated."
    keo "Это главная операционная, где лечат Кандидатов."

# game/episode025.rpy:679
translate russian ep025_erigone_sermon_fb16370d:

    # e "Treated how?"
    e "И как их лечат?"

# game/episode025.rpy:680
translate russian ep025_erigone_sermon_18ba773b:

    # keo "Over the course of several days, they’re given various substances, allowing for rapid muscle growth and other physical enhancers."
    keo "В течение нескольких дней им вводят различные вещества, которы ускоряют рост мышц и усиливают другие физические характеристики."

# game/episode025.rpy:681
translate russian ep025_erigone_sermon_69e6930a:

    # keo "We start with a regular Acarhyn and develop it into a more perfect being, following the Sacred Tenets of Our Creator in the process."
    keo "Мы начинаем с обычного Акархина и в процессе превращаем его в более совершенное существо, следуя Священным Заповедям Нашего Создателя."

# game/episode025.rpy:686
translate russian ep025_erigone_sermon_7c8e78e6:

    # e "So you are enhancing their abilities and physical appearance?"
    e "То есть вы совершенствуете их способности и физические характеристики?"

# game/episode025.rpy:688
translate russian ep025_erigone_sermon_99b463f0:

    # keo "Certainly, Your Majesty."
    keo "Совершенно верно, Ваше Величество."

# game/episode025.rpy:689
translate russian ep025_erigone_sermon_fd222c60:

    # keo "The resulting Brute is a stronger and in many ways better Acarhyn."
    keo "В результате получается более мощный и во многих отношениях улучшенный Акархин - Громила."

# game/episode025.rpy:690
translate russian ep025_erigone_sermon_3cdb1bc4:

    # keo "A formidable opponent on the battlefield and a cunning strategist, despite appearances to the contrary."
    keo "Грозный противник на поле боя и искусный стратег, хотя с виду и не скажешь."

# game/episode025.rpy:691
translate russian ep025_erigone_sermon_41ccef43:

    # e "And all of the Brutes are volunteers?"
    e "И все Громилы - добровольцы?"

# game/episode025.rpy:693
translate russian ep025_erigone_sermon_16245d0e:

    # keo "Many of them are."
    keo "Большая их часть."

# game/episode025.rpy:694
translate russian ep025_erigone_sermon_79e51c8c:

    # keo "The need for an edge against the Warrior caste is so great, however, that we have decided to ask the general populace to sacrifice their own for the greater good."
    keo "Однако необходимость получить преимущество над кастой Воинов настолько велика, что мы решили обратиться к простому народу с просьбой принести своих в жертву ради общего блага."

# game/episode025.rpy:695
translate russian ep025_erigone_sermon_d1adc652:

    # keo "We are also still perfecting the process of creating Brutes."
    keo "Мы также продолжаем совершенствовать процесс создания Громил."

# game/episode025.rpy:696
translate russian ep025_erigone_sermon_80f20374:

    # keo "The current generation has a significantly longer lifespan than the previous iterations."
    keo "Нынешнее поколение живёт намного дольше предыдущих."

# game/episode025.rpy:697
translate russian ep025_erigone_sermon_f2fcdd41:

    # keo "Infections are an issue, for example."
    keo "С инфекциями, например, есть проблемы."

# game/episode025.rpy:698
translate russian ep025_erigone_sermon_34c686e6:

    # keo "But I am sure we will weed these kinks out as soon as possible."
    keo "Но я уверена, что совсем скоро мы устраним все эти шероховатости."

# game/episode025.rpy:699
translate russian ep025_erigone_sermon_f08dd06d:

    # c "How long a lifespan are we talking about exactly?"
    c "И сколько они теперь живут?"

# game/episode025.rpy:701
translate russian ep025_erigone_sermon_b775fd52:

    # keo "Several months."
    keo "Несколько месяцев."

# game/episode025.rpy:702
translate russian ep025_erigone_sermon_951b83ca:

    # c "Months..."
    c "Месяцев..."

# game/episode025.rpy:703
translate russian ep025_erigone_sermon_8e7282da:

    # keo "Considering the first Brute lasted only two hours, I’d say that’s much progress indeed."
    keo "Учитывая, что первая Громила прожила всего два часа, я бы сказала, что прогресс весьма существенный."

# game/episode025.rpy:704
translate russian ep025_erigone_sermon_6b5fd326:

    # keo "As I’ve said, illness is our main factor of concern now."
    keo "Как я уже говорила, болезнь сейчас - наша главная проблема."

# game/episode025.rpy:705
translate russian ep025_erigone_sermon_a752bc73:

    # keo "Once a Brute is infected with even the most common maladies, they will often succumb within the hour."
    keo "Стоит Громиле заразиться даже самой обычной болезнью, как зачастую уже в течение часа они погибают."

# game/episode025.rpy:710
translate russian ep025_erigone_sermon_caadb990:

    # e "They die within an hour of a cold?"
    e "Они умирают от обычной простуды меньше чем за час?"

# game/episode025.rpy:712
translate russian ep025_erigone_sermon_6a4644e3:

    # keo "Unfortunately so."
    keo "К сожалению, да."

# game/episode025.rpy:713
translate russian ep025_erigone_sermon_aa3ee9ee:

    # keo "There have been several promising theories regarding the cause and proposals to fix this."
    keo "Есть несколько многообещающих теорий о том, чем это вызвано и как это исправить."

# game/episode025.rpy:714
translate russian ep025_erigone_sermon_f254ec78:

    # "Eva was clearly horrified by Keodele’s clinical discussions of what amounted to human experimenting."
    "Ева явно пришла в ужас от того, как бесстрастно Кеодели рассуждала о фактически проводимых над людьми экспериментах."

# game/episode025.rpy:723
translate russian ep025_erigone_sermon_6dbba6cc:

    # "Before she could voice her opinion, we were interrupted by a Priest."
    "Прежде чем она успела высказать своё мнение, нас прервала жрица."

# game/episode025.rpy:726
translate russian ep025_erigone_sermon_2e19b3fd:

    # woman "High Priestess, your attendance is required at once."
    woman "Верховная Жрица, вас срочно вызывают."

# game/episode025.rpy:727
translate russian ep025_erigone_sermon_3c682f28:

    # keo "Of course."
    keo "Конечно."

# game/episode025.rpy:729
translate russian ep025_erigone_sermon_134e1384:

    # keo "Your Majesty, if you’ll please excuse me."
    keo "Ваше Величество, прошу меня извинить."

# game/episode025.rpy:730
translate russian ep025_erigone_sermon_5587e3d2:

    # keo "I will be at Your Majesty’s disposal as soon as I conclude this business."
    keo "Как только улажу этот вопрос, я буду в полном распоряжении Вашего Величества."

# game/episode025.rpy:731
translate russian ep025_erigone_sermon_44c9741e:

    # keo "I’ll instruct one of the guards to escort you back to your quarters once you’re ready."
    keo "Я велю одному из стражников проводить вас в ваши покои, как только вы будете готовы."

# game/episode025.rpy:736
translate russian ep025_erigone_sermon_cebc7832:

    # "Keodele left us in the laboratory to deal with whatever crisis she was called away for."
    "Кеодели оставила нас в лаборатории, а сама ушла разбираться с каким-то срочным делом."

# game/episode025.rpy:741
translate russian ep025_erigone_sermon_a364c45b:

    # e "I’m going to demand she put a stop to this."
    e "Я потребую от неё немедленно это прекратить."

# game/episode025.rpy:742
translate russian ep025_erigone_sermon_e09729fd:

    # e "They’re forcibly taking civilians and conducting experiments on them."
    e "Они хватают мирных жителей силой и проводят над ними эксперименты."

# game/episode025.rpy:746
translate russian ep025_erigone_sermon_89ea8804:

    # c "Yeah, it’s sickening."
    c "Да, это мерзко."

# game/episode025.rpy:747
translate russian ep025_erigone_sermon_eb83abc1:

    # c "No amount of religious window-dressing can ever hide the fact of what they’re doing."
    c "Никаким религиозным лоском не прикрыть того, что они творят."

# game/episode025.rpy:748
translate russian ep025_erigone_sermon_b390f688:

    # e "I’m going to formally demand they put a stop to this."
    e "Я официально потребую от них немедленно это прекратить."

# game/episode025.rpy:749
translate russian ep025_erigone_sermon_ea4adb02:

    # c "I’m not sure Keodele will listen to you, but it’s good to make yourself heard."
    c "Не уверен, что Кеодели тебя послушает, но высказаться всё равно стоит."

# game/episode025.rpy:750
translate russian ep025_erigone_sermon_05364ff8:

    # e "Agreed."
    e "Согласна."

# game/episode025.rpy:755
translate russian ep025_erigone_sermon_73a1b510:

    # e "Shall we leave this place?"
    e "Пойдём отсюда?"

# game/episode025.rpy:756
translate russian ep025_erigone_sermon_bee33b8a:

    # c "Yes, not much we can do here, I’m afraid."
    c "Да, боюсь, тут мы мало что можем сделать."

# game/episode025.rpy:758
translate russian ep025_erigone_sermon_d58538a7:

    # c "The Priests are currently at war."
    c "Жрецы сейчас ведут войну."

# game/episode025.rpy:759
translate russian ep025_erigone_sermon_8cfb0dc4:

    # c "I think they need every advantage they can get."
    c "Думаю, им сейчас нужно использовать любую возможность."

# game/episode025.rpy:764
translate russian ep025_erigone_sermon_645d328e:

    # e "It’s illegal by any moral or legal code in existence!"
    e "Это незаконно по любым существующим моральным или правовым нормам."

# game/episode025.rpy:765
translate russian ep025_erigone_sermon_b390f688_1:

    # e "I’m going to formally demand they put a stop to this."
    e "Я официально потребую от них немедленно это прекратить."

# game/episode025.rpy:766
translate russian ep025_erigone_sermon_fbb7cdb5:

    # c "I’m not sure Keodele will listen to you."
    c "Сомневаюсь, что Кеодели тебя послушает."

# game/episode025.rpy:767
translate russian ep025_erigone_sermon_1d7a4bc4:

    # c "And we need their help after they defeat the Warrior caste."
    c "И нам понадобится их помощь после того, как они одолеют касту Воинов."

# game/episode025.rpy:772
translate russian ep025_erigone_sermon_7cf9b849:

    # e "I don’t care."
    e "Мне всё равно."

# game/episode025.rpy:773
translate russian ep025_erigone_sermon_52773d55:

    # e "You’re right that we need them, so I won't risk our alliance with the Priest caste, but I won’t be complicit in this."
    e "Ты прав, они нам нужны, поэтому я не буду ставить под угрозу наш союз с кастой Жрецов, но соучастником этого я не буду."

# game/episode025.rpy:778
translate russian ep025_erigone_sermon_73a1b510_1:

    # e "Shall we leave this place?"
    e "Пойдём отсюда?"

# game/episode025.rpy:780
translate russian ep025_erigone_sermon_056c3112:

    # "Eva and I left the laboratory and headed back to our quarters."
    "Мы с Евой покинули лабораторию и отправились по своим комната."

# game/episode025.rpy:791
translate russian ep025_erigone_battle_c4494b81:

    # "Asked by Rahia, Eva was to address the troops on the eve of the Battle for Erigone."
    "По просьбе Рахии Ева должна была обратиться к войскам накануне битвы за Эригон."

# game/episode025.rpy:792
translate russian ep025_erigone_battle_8f9c092d:

    # "In the courtyard of the Citadel, Eva was standing on a podium."
    "Во дворе Цитадели на помосте стояла Ева."

# game/episode025.rpy:798
translate russian ep025_erigone_battle_c1b0af03:

    # "Asked by Keodele, Eva was to address the troops on the eve of the Battle for Erigone."
    "По просьбе Кеодели Ева должна была обратиться к войскам накануне битвы за Эригон."

# game/episode025.rpy:799
translate russian ep025_erigone_battle_cfd4f455:

    # "On the tarmac in front of the main building of the Shipyards, Eva was standing on a podium."
    "На асфальтированной площадке перед главным зданием Верфей стояла Ева."

# game/episode025.rpy:800
translate russian ep025_erigone_battle_c70c5a8e:

    # e "My fellow Acarhyn."
    e "Мои сёстры-Акархины."

# game/episode025.rpy:801
translate russian ep025_erigone_battle_80a6322a:

    # e "Tomorrow will be a defining day for our nation."
    e "Завтрашний день определит будущее нашего народа."

# game/episode025.rpy:807
translate russian ep025_erigone_battle_af6e89c2:

    # e "Tomorrow, the Priest caste will be stopped."
    e "Завтра мы остановим касту Жрецов."

# game/episode025.rpy:813
translate russian ep025_erigone_battle_06d247a7:

    # e "Tomorrow, the Warrior caste will be stopped."
    e "Завтра мы остановим касту Воинов."

# game/episode025.rpy:814
translate russian ep025_erigone_battle_67a0f211:

    # e "Tomorrow, the corruption of Erigone will come to an end."
    e "Завтра разложению Эригона придёт конец."

# game/episode025.rpy:816
translate russian ep025_erigone_battle_2788c826:

    # e "For too long, the Priest caste has tried to assert its dominion, but we will have it no more."
    e "Слишком долго каста Жрецов пыталась утвердить своё господство, но этому больше не бывать."

# game/episode025.rpy:817
translate russian ep025_erigone_battle_e4533c11:

    # e "We say no to forced religious doctrine."
    e "Мы говорим 'нет' навязанным религиозным догмам."

# game/episode025.rpy:819
translate russian ep025_erigone_battle_38cb6bf7:

    # e "For too long, the Warrior caste has tried to assert its dominion, but we will have it no more."
    e "Слишком долго каста Воинов пыталась утвердить своё господство, но этому больше не бывать."

# game/episode025.rpy:820
translate russian ep025_erigone_battle_cb9acf15:

    # e "We say no to violent oppression."
    e "Мы говорим 'нет' насилию и угнетению."

# game/episode025.rpy:821
translate russian ep025_erigone_battle_8a54e1ed:

    # e "We say no to not being able to express ourselves freely."
    e "Мы говорим 'нет' запрету на свободное самовыражение."

# game/episode025.rpy:823
translate russian ep025_erigone_battle_b40dd230:

    # e "We say no to the scheming, the cronyism and outright bribery that has come to symbolize the Priest caste."
    e "Мы говорим 'нет' интригам, кумовству и откровенной коррупции, ставшими символом касты Жрецов."

# game/episode025.rpy:825
translate russian ep025_erigone_battle_60cdad02:

    # e "We say no to the scheming, the cronyism and outright bribery that has come to symbolize the Warrior caste."
    e "Мы говорим 'нет' интригам, кумовству и откровенной коррупции, ставшими символом касты Воинов."

# game/episode025.rpy:826
translate russian ep025_erigone_battle_c91d2221:

    # e "Erigone belongs to the Acarhyn."
    e "Эригон принадлежит Акархинам."

# game/episode025.rpy:827
translate russian ep025_erigone_battle_d0c6631c:

    # e "Tomorrow we will take back our beautiful planet and ensure a lasting peace!"
    e "Завтра мы вернём себе нашу прекрасную планету и установим прочный мир!"

# game/episode025.rpy:828
translate russian ep025_erigone_battle_e058b2fc:

    # e "A new dawn for the Acarhyn approaches!"
    e "Новая эра для Акархинов уже близко!"

# game/episode025.rpy:829
translate russian ep025_erigone_battle_783ca07a:

    # e "Fight like furies and victory will be ours!"
    e "Сражайтесь со всей яростью - и победа будет нашей!"

# game/episode025.rpy:835
translate russian ep025_erigone_battle_a2caec33:

    # "A rapturous roar emanated from the crowd of Acarhyn Warriors."
    "Толпа Воинов-Акархинов разразилась восторженным рёвом."

# game/episode025.rpy:841
translate russian ep025_erigone_battle_a2097f59:

    # "A rapturous roar emanated from the crowd of Acarhyn Priests."
    "Толпа Жрецов-Акархинов разразилась восторженным рёвом."

# game/episode025.rpy:842
translate russian ep025_erigone_battle_d6631c7d:

    # "I could tell Eva was relieved by how her short speech was received."
    "Ева явно почувствовала облегчение, когда увидела, как публика отреагировала на её короткую речь."

# game/episode025.rpy:844
translate russian ep025_erigone_battle_973034b2:

    # "The loyalty of the Warriors was by no means a sure thing, but a public appearance by their Virgin Queen certainly helped."
    "Верность Воинов вовсе не была гарантирована, но публичное появление их Девы-Королевы определённо помогло."

# game/episode025.rpy:846
translate russian ep025_erigone_battle_48f1096a:

    # "The loyalty of the Priests was by no means a sure thing, but a public appearance by their Virgin Queen certainly helped."
    "Верность Жрецов вовсе не была гарантирована, но публичное появление их Девы-Королевы определённо помогло."

# game/episode025.rpy:854
translate russian ep025_erigone_battle_8f12b348:

    # l "I’m sure this makes me a bad person, but I’m so glad I’m not in Eva’s shoes."
    l "Знаю, наверное, это звучит ужасно, но я очень рада, что мне не приходится быть на месте Евы."

# game/episode025.rpy:855
translate russian ep025_erigone_battle_aed7d681:

    # c "Because you don’t like to wear elaborate dresses?"
    c "Потому что ты не любишь носить вычурные платья?"

# game/episode025.rpy:856
translate russian ep025_erigone_battle_f2914141:

    # l "That too, but I was referring to giving public speeches to hundreds of bloodthirsty women."
    l "И это тоже, но я имела в виду речи перед сотнями жаждущих крови женщин."

# game/episode025.rpy:857
translate russian ep025_erigone_battle_67f6475a:

    # c "Eva certainly didn’t choose this, but I think she did very well."
    c "Ева явно не сама на это подписывалась, но, думаю, она отлично справилась."

# game/episode025.rpy:862
translate russian ep025_erigone_battle_c6575405:

    # l "She did."
    l "Это точно."

# game/episode025.rpy:863
translate russian ep025_erigone_battle_de1d6e4b:

    # l "No guarantee the fight tomorrow will be a success though."
    l "Хотя нет никакой гарантии, что завтра мы победим."

# game/episode025.rpy:864
translate russian ep025_erigone_battle_f9f1f56f:

    # l "Nor are we sure that the Acarhyn will fight for us."
    l "Да и нет уверенности, будут ли Акархины сражаться на нашей стороне."

# game/episode025.rpy:865
translate russian ep025_erigone_battle_bb78aab7:

    # c "I know."
    c "Я в этом уверен."

# game/episode025.rpy:866
translate russian ep025_erigone_battle_935aa765:

    # c "But at least we have done everything in our power to make the possible alliance a success."
    c "Но мы хотя бы сделали всё возможное, чтобы наш возможный союз удался."

# game/episode025.rpy:871
translate russian ep025_erigone_battle_42055667:

    # l "I guess so."
    l "Пожалуй."

# game/episode025.rpy:872
translate russian ep025_erigone_battle_c80e9693:

    # l "Though I can’t say I’m looking forward to being on the Bastard while it provides air support."
    l "Хотя не могу сказать, что горю желанием находиться на Ублюдке, пока он оказывает поддержку с воздуха."

# game/episode025.rpy:874
translate russian ep025_erigone_battle_529c8141:

    # c "It was an explicit request from Rahia, so it didn’t seem something we could refuse."
    c "Рахия сама об этом попросила, так что отказать ей вроде как не получалось."

# game/episode025.rpy:876
translate russian ep025_erigone_battle_519dbb62:

    # c "It was an explicit request from Keodele, so it didn’t seem something we could refuse."
    c "Кеодели сама об этом попросила, так что отказать ей вроде как не получалось."

# game/episode025.rpy:877
translate russian ep025_erigone_battle_c424a372:

    # c "I’d understand if you’d rather kept Eva company."
    c "Я бы понял, если бы ты предпочла остаться с Евой."

# game/episode025.rpy:882
translate russian ep025_erigone_battle_e976f0b0:

    # l "No, I’m coming with."
    l "Нет, я с тобой."

# game/episode025.rpy:883
translate russian ep025_erigone_battle_14841dd0:

    # l "Too curious what that new dawn for the Acarhyn is all about..."
    l "Слишком уж хочется узнать, что же это за «новая заря» для Акархинов..."

# game/episode025.rpy:887
translate russian ep025_erigone_battle_44ea2915:

    # "We were up early to see the first wave of Warriors head out to the staging grounds, to begin the first stage of the Battle for Erigone."
    "Мы встали пораньше, чтобы увидеть, как первые отряды Воинов отправляются на позиции перед первым этапом битвы за Эригон."

# game/episode025.rpy:890
translate russian ep025_erigone_battle_1fe4a0f2:

    # "We were up early to see the first wave of Priests head out to the staging grounds, to begin the first stage of the Battle for Erigone."
    "Мы встали пораньше, чтобы увидеть, как первые отряды Жрецов отправляются на позиции перед первым этапом битвы за Эригон."

# game/episode025.rpy:892
translate russian ep025_erigone_battle_7ba5bc94:

    # "Acarhyn engineers had loaded the Bastard with several bombs, arguably the first time the ships’ bays were actually loaded with ordnance."
    "Акархины-инженеры загрузили на Ублюдка несколько бомб, пожалуй, впервые грузовые отсеки корабля использовались по назначению - для боеприпасов."

# game/episode025.rpy:893
translate russian ep025_erigone_battle_9cc6f630:

    # "Thyia and Céline had gone over the Bastard’s guns and cannons to ensure they were still working."
    "Тхия и Селин проверили пушки и орудия Ублюдка, чтобы убедиться, что они исправны."

# game/episode025.rpy:898
translate russian ep025_erigone_battle_bc7dc44a:

    # "The first wave of Acarhyn aircraft took off from the landing pad."
    "Первая группа кораблей Акархинов взмыла с посадочной площадки."

# game/episode025.rpy:899
translate russian ep025_erigone_battle_7272ca58:

    # "We were scheduled to accompany the second wave."
    "Мы должны были отправиться вместе со второй группой."

# game/episode025.rpy:904
translate russian ep025_erigone_battle_5254fa93:

    # "As soon as the signal came over the radio, Céline took us into the air."
    "Как только по рации поступил сигнал, Селин подняла нас в воздух."

# game/episode025.rpy:905
translate russian ep025_erigone_battle_14f9de13:

    # "Flying formation, we quickly covered a lot of ground."
    "Держа строй, мы быстро преодолели большое расстояние."

# game/episode025.rpy:907
translate russian ep025_erigone_battle_c37d11e8:

    # "Explosions could be seen in the distance and smoke trailed on the horizon."
    "Вдалеке то и дело вспыхивали взрывы, а по горизонту стелился дым."

# game/episode025.rpy:908
translate russian ep025_erigone_battle_fbb5585c:

    # "Aven let out an audible gasp as we made a pass over the battlefield."
    "Эвин невольно ахнула, когда мы пролетели над полем боя."

# game/episode025.rpy:910
translate russian ep025_erigone_battle_a293bdb3:

    # "Several mechs were shooting at each other, Acarhyn swarming around its legs."
    "Несколько мехов вели огонь друг по другу, а Акархины роились у них под ногами."

# game/episode025.rpy:911
translate russian ep025_erigone_battle_93501333:

    # "It was impossible to tell whose side was winning, such was the chaos on the ground."
    "Из-за царившего внизу хаоса невозможно было понять, кто побеждает."

# game/episode025.rpy:916
translate russian ep025_erigone_battle_26adcf18:

    # ce "We’re being target-locked by multiple gun batteries."
    ce "Нас взяли на прицел сразу несколько огневых батарей."

# game/episode025.rpy:917
translate russian ep025_erigone_battle_96e7b7c3:

    # c "Evasive maneuvers!"
    c "Уходим от огня!"

# game/episode025.rpy:919
translate russian ep025_erigone_battle_52137f66:

    # "The Bastard and several other ships in the formation spun away from the center of the battlefield."
    "Ублюдок и ещё несколько кораблей в строю резко развернулись, удаляясь от центра поля боя."

# game/episode025.rpy:920
translate russian ep025_erigone_battle_0d7221b0:

    # "The enemy attempted to jam our comms at that moment and a couple of other ships must have failed to receive the command to break off."
    "В этот момент противник попытался заглушить наши каналы связи, и, видимо, пара других кораблей не получила приказ отступить."

# game/episode025.rpy:923
translate russian ep025_erigone_battle_e22a18c0:

    # "The gun batteries of the Priest caste, hidden in the trees, belched fire at the remaining ships flying straight on."
    "Скрытые среди деревьев орудийные батареи касты Жрецов изрыгнули огонь по оставшимся кораблям, продолжавшим лететь прямо вперёд."

# game/episode025.rpy:925
translate russian ep025_erigone_battle_2f1b2275:

    # "The gun batteries of the Warrior caste, hidden in the trees, belched fire at the remaining ships flying straight on."
    "Скрытые среди деревьев орудийные батареи касты Воинов изрыгнули огонь по оставшимся кораблям, продолжавшим лететь прямо вперёд."

# game/episode025.rpy:926
translate russian ep025_erigone_battle_28970140:

    # "Three were hit, one plunged smoking toward the ground and the others exploded in mid-air."
    "Три корабля были подбиты: один, оставляя за собой дым, рухнул вниз, а два других взорвались в воздухе."

# game/episode025.rpy:928
translate russian ep025_erigone_battle_e536765e:

    # ce "We’re no longer being targeted."
    ce "Нас больше не держат на прицеле."

# game/episode025.rpy:929
translate russian ep025_erigone_battle_6b4b5b37:

    # "Taking advantage of the reloading, our formation sped forward to the tree line."
    "Воспользовавшись тем, что противник перезаряжался, наш строй устремился к линии деревьев."

# game/episode025.rpy:932
translate russian ep025_erigone_battle_990ee997:

    # "As expected, a contingent of Priest vehicles was approaching the battlefield, hidden by the cover of the trees."
    "Как и ожидалось, отряд техники Жрецов уже приближался к полю боя, прикрываясь деревьями."

# game/episode025.rpy:934
translate russian ep025_erigone_battle_06d7efac:

    # "As expected, a contingent of Warrior vehicles was approaching the battlefield, hidden by the cover of the trees."
    "Как и ожидалось, отряд техники Воинов уже приближался к полю боя, прикрываясь деревьями."

# game/episode025.rpy:935
translate russian ep025_erigone_battle_f87459ac:

    # "We were cleared hot by the Acarhyn command, while the Bastard had commenced its first pass."
    "Командование Акархинов разрешило нам открыть огонь, а Ублюдок уже начал свой первый заход."

# game/episode025.rpy:937
translate russian ep025_erigone_battle_dd19228c:

    # c "Two away."
    c "Осталось два."

# game/episode025.rpy:938
translate russian ep025_erigone_battle_7f601f96:

    # av "Two away."
    av "Осталось два."

# game/episode025.rpy:939
translate russian ep025_erigone_battle_3c1fe5df:

    # "Aven had launched two bombs and followed their trajectory closely."
    "Эвин сбросила две бомбы и внимательно следила за их траекторией."

# game/episode025.rpy:940
translate russian ep025_erigone_battle_bcdbc216:

    # av "One and two landed on the mark."
    av "Обе угодили точно в цель."

# game/episode025.rpy:941
translate russian ep025_erigone_battle_5c4db647:

    # av "Fifteen vehicles have been destroyed."
    av "Уничтожено пятнадцать единиц техники."

# game/episode025.rpy:942
translate russian ep025_erigone_battle_b8601c84:

    # c "Ready for pass two."
    c "Готовимся ко второму заходу."

# game/episode025.rpy:944
translate russian ep025_erigone_battle_75846845:

    # "The carnage of the bomb run was visible on our scopes."
    "Ужасные последствия бомбардировки были видны на наших экранах."

# game/episode025.rpy:945
translate russian ep025_erigone_battle_1f4ad429:

    # "Several other ships of our formation had scored direct hits and the convoy of vehicles was in complete disarray."
    "Несколько других кораблей нашего строя также поразили цели, и в колонне техники начался полный хаос."

# game/episode025.rpy:946
translate russian ep025_erigone_battle_f7ab16f7:

    # "The second run would most likely wipe out the entire supply line."
    "Второй заход почти наверняка уничтожит всю линию снабжения."

# game/episode025.rpy:947
translate russian ep025_erigone_battle_a761a061:

    # "If the other attack groups were successful, the remaining supply lines would be completely cut off, isolating the troops already on the central battlefield."
    "Если остальные ударные группы добьются успеха, оставшиеся линии снабжения будут полностью перерезаны, изолировав войска, уже находящиеся на центральном поле боя."

# game/episode025.rpy:948
translate russian ep025_erigone_battle_4a71db9c:

    # "As the formation began its second fly-over, our scanners lit up with enemy contacts."
    "Во время второго пролёта наши сканеры засекли несколько вражеских целей."

# game/episode025.rpy:953
translate russian ep025_erigone_battle_aa46d434:

    # th "We’ve got company."
    th "У нас гости."

# game/episode025.rpy:956
translate russian ep025_erigone_battle_e9414618:

    # "A wing of fighters from the Priest caste was suddenly bearing upon us."
    "Внезапно звено истребителей касты Жрецов взяло курс прямо на нас."

# game/episode025.rpy:958
translate russian ep025_erigone_battle_dc3f9390:

    # "A wing of fighters from the Warrior caste was suddenly bearing upon us."
    "Внезапно звено истребителей касты Воинов взяло курс прямо на нас."

# game/episode025.rpy:959
translate russian ep025_erigone_battle_4b1a0d5a:

    # c "Take them out."
    c "Уничтожаем их."

# game/episode025.rpy:961
translate russian ep025_erigone_battle_237a4d8d:

    # "The ship’s cannon joined the barrage coming from the other ships in our formation."
    "Пушка нашего корабля присоединилась к огню остальных кораблей нашего строя."

# game/episode025.rpy:964
translate russian ep025_erigone_battle_89961d4b:

    # "The Priests returned fire."
    "Жрецы открыли ответный огонь."

# game/episode025.rpy:966
translate russian ep025_erigone_battle_235b48b4:

    # "The Warriors returned fire."
    "Воины открыли ответный огонь."

# game/episode025.rpy:967
translate russian ep025_erigone_battle_d664d87f:

    # "The Bastard’s shields were pelted with energy bolts."
    "Энергетические заряды градом обрушились на щиты Ублюдка."

# game/episode025.rpy:969
translate russian ep025_erigone_battle_fb966fe5:

    # av "Shields at eighty percent."
    av "Целостность щитов - 80%%."

# game/episode025.rpy:971
translate russian ep025_erigone_battle_55b5361f:

    # "One of the ships in our group must have taken a direct hit, because it hurtled toward the tree tops and exploded on impact."
    "Один из кораблей нашего строя, должно быть, получил прямое попадание, потому что его понесло к верхушкам деревьев, и при столкновении он взорвался."

# game/episode025.rpy:972
translate russian ep025_erigone_battle_d8231ba0:

    # "There were fourteen enemy aircraft remaining, as we had turned five of them into slag already."
    "В строю противника оставалось четырнадцать кораблей - пятерых мы уже превратили в металлолом."

# game/episode025.rpy:974
translate russian ep025_erigone_battle_47833637:

    # "Our group still outnumbered the Priests, but another volley could tip the odds unfavorably."
    "Наша группа всё ещё превосходила Жрецов числом, но ещё один залп мог лишить нас этого преимущества."

# game/episode025.rpy:975
translate russian ep025_erigone_battle_28a8e266:

    # "The Bastard’s cannon spewed more fire and our guns rattled multiple rounds in the direction of the Priests."
    "Пушка Ублюдка извергла новый поток огня, а наши орудия выпустили несколько залпов в сторону Жрецов."

# game/episode025.rpy:977
translate russian ep025_erigone_battle_20518ba6:

    # "Our group still outnumbered the Warriors, but another volley could tip the odds unfavorably."
    "Наша группа всё ещё превосходила Воинов числом, но ещё один залп мог лишить нас этого преимущества."

# game/episode025.rpy:978
translate russian ep025_erigone_battle_ddebab35:

    # "The Bastard’s cannon spewed more fire and our guns rattled multiple rounds in the direction of the Warriors."
    "Пушка Ублюдка извергла новый поток огня, а наши орудия выпустили несколько залпов в сторону Воинов."

# game/episode025.rpy:980
translate russian ep025_erigone_battle_9054d0f5:

    # av "Three hits."
    av "Три попадания."

# game/episode025.rpy:982
translate russian ep025_erigone_battle_9682b2fe:

    # "The engine of one ship caught fire and it started losing altitude quickly before exploding among the trees."
    "Двигатель одного из кораблей загорелся, и тот начал быстро терять высоту, после чего взорвался среди деревьев."

# game/episode025.rpy:983
translate russian ep025_erigone_battle_f91f09f3:

    # "The other two were direct hits, exploding in the air and raining debris all over the convoy below."
    "Два других корабля были поражены прямым попаданием и взорвались в воздухе, осыпав обломками колонну под ними."

# game/episode025.rpy:984
translate russian ep025_erigone_battle_f6ff01e3:

    # "Our fellow pilots were similarly lucky, reducing the enemy group to just two ships."
    "Наши товарищи-пилоты тоже не подвели, сократив группу противника до двух кораблей."

# game/episode025.rpy:987
translate russian ep025_erigone_battle_ed0322bf:

    # "Sensing the game was up, the remaining two Priests tried to flee, several long range missiles trailing their ships."
    "Поняв, что им конец, два оставшихся корабля Жрецов попытались уйти, а следом за ними устремились несколько ракет дальнего действия."

# game/episode025.rpy:989
translate russian ep025_erigone_battle_b8ff9c50:

    # "Sensing the game was up, the remaining two Warriors tried to flee, several long range missiles trailing their ships."
    "Поняв, что им конец, два оставшихся корабля Воинов попытались уйти, а следом за ними устремились несколько ракет дальнего действия."

# game/episode025.rpy:990
translate russian ep025_erigone_battle_eee783a6:

    # "They were unable to outrun the missiles and each ship exploded before they were able to return to safety."
    "Они не смогли оторваться от преследовавших их ракет, и оба корабля взорвались ещё до возвращения в безопасную зону."

# game/episode025.rpy:992
translate russian ep025_erigone_battle_086f5edd:

    # "With the threat dealt with and the convoy in ruins, we were about to head back to the Citadel, but an urgent comms message interrupted our departure."
    "Разобравшись с угрозой и оставив от колонны одни руины, мы уже собирались возвращаться в Цитадель, но тут по связи поступило срочное сообщение."

# game/episode025.rpy:994
translate russian ep025_erigone_battle_2611403e:

    # "With the threat dealt with and the convoy in ruins, we were about to head back to the Shipyards, but an urgent comms message interrupted our departure."
    "Разобравшись с угрозой и оставив от колонны одни руины, мы уже собирались возвращаться на Верфи, но тут по связи поступило срочное сообщение."

# game/episode025.rpy:997
translate russian ep025_erigone_battle_56ce6f6b:

    # woman "Urgent message to all active forces."
    woman "Срочное сообщение всем действующим силам."

# game/episode025.rpy:999
translate russian ep025_erigone_battle_0141ba92:

    # woman "Commander Rahia is isolated and taking heavy fire."
    woman "Командир Рахия отрезана от остальных и попала под плотный огонь."

# game/episode025.rpy:1001
translate russian ep025_erigone_battle_99e98a43:

    # woman "High Priestess Keodele is isolated and taking heavy fire."
    woman "Верховная Жрица Кеодели отрезана от остальных и попала под плотный огонь."

# game/episode025.rpy:1002
translate russian ep025_erigone_battle_d2091f62:

    # woman "Extraction required."
    woman "Требуется немедленная эвакуация."

# game/episode025.rpy:1003
translate russian ep025_erigone_battle_bcaf3f10:

    # woman "All units please respond."
    woman "Всем подразделениям, отзовитесь."

# game/episode025.rpy:1015
translate russian ep025_erigone_battle_9e73aa2e:

    # c "We’re not equipped to handle an extraction, head back to the Citadel as planned."
    c "У нас нет возможности провести эвакуацию, возвращайтесь в Цитадель согласно плану."

# game/episode025.rpy:1017
translate russian ep025_erigone_battle_dc7d66c7:

    # c "We’re not equipped to handle an extraction, head back to the Shipyards as planned."
    c "У нас нет возможности провести эвакуацию, возвращайтесь на Верфи согласно плану."

# game/episode025.rpy:1018
translate russian ep025_erigone_battle_6d047732:

    # ce "Of course, heading back now."
    ce "Поняла, возвращаемся."

# game/episode025.rpy:1027
translate russian ep025_erigone_rescue_d8906617:

    # c "Open a comms channel, Céline."
    c "Селин, открой канал связи."

# game/episode025.rpy:1028
translate russian ep025_erigone_rescue_00c71e9f:

    # ce "Comms channel open."
    ce "Канал связи открыт."

# game/episode025.rpy:1029
translate russian ep025_erigone_rescue_55e8bf0c:

    # c "This is [p_name] of the Iron Bastard, responding to Acarhyn command."
    c "На связи [p_name] с Железного Ублюдка, отвечаю командованию Акархинов."

# game/episode025.rpy:1031
translate russian ep025_erigone_rescue_733a8d28:

    # c "We are near Commander Rahia and will move to evacuate."
    c "Мы рядом с Командиром Рахией и направляемся к ней для эвакуации."

# game/episode025.rpy:1033
translate russian ep025_erigone_rescue_4b71b563:

    # c "We are near High Priestess Keodele and will move to evacuate."
    c "Мы рядом с Верховной Жрицей Кеодели и направляемся к ней для эвакуации."

# game/episode025.rpy:1034
translate russian ep025_erigone_rescue_041adb43:

    # woman "Roger that."
    woman "Подтверждаю."

# game/episode025.rpy:1035
translate russian ep025_erigone_rescue_8cfe687e:

    # woman "Exact coordinates have been sent."
    woman "Точные координаты отправлены."

# game/episode025.rpy:1038
translate russian ep025_erigone_rescue_ae555bf8:

    # "The Bastard and several other ships broke formation and headed toward the location of Rahia."
    "Ублюдок и несколько других кораблей покинули строй и направились к месту, где находилась Рахия."

# game/episode025.rpy:1039
translate russian ep025_erigone_rescue_182d1f7c:

    # "Close to the extraction site, a couple of burnt out vehicles were visible, probably Rahia’s transport."
    "Недалеко от места эвакуации виднелись две обгоревшие машины - вероятно, транспорт Рахии."

# game/episode025.rpy:1041
translate russian ep025_erigone_rescue_4d3db699:

    # "The Bastard and several other ships broke formation and headed toward the location of Keodele."
    "Ублюдок и несколько других кораблей покинули строй направились к месту, где находилась Кеодели."

# game/episode025.rpy:1042
translate russian ep025_erigone_rescue_0de57213:

    # "Close to the extraction site, a couple of burnt out vehicles were visible, probably Keodele’s transport."
    "Недалеко от места эвакуации виднелись две обгоревшие машины - вероятно, транспорт Кеодели."

# game/episode025.rpy:1044
translate russian ep025_erigone_rescue_0328ca29:

    # "Aven, Thyia, Kit and I were already in the cargo bay, ready to drop out of the Bastard and begin the extraction."
    "Мы с Эвин, Тхией и Китом уже находились в грузовом отсеке, готовые высадиться из Ублюдка и начать эвакуацию."

# game/episode025.rpy:1045
translate russian ep025_erigone_rescue_1a68ac83:

    # "The Bastard and the Acarhyn ships would provide cover from the air."
    "Ублюдок и корабли Акархинов будут прикрывать нас с воздуха."

# game/episode025.rpy:1046
translate russian ep025_erigone_rescue_3d33410a:

    # ce "Ready for extraction."
    ce "Готовы к высадке."

# game/episode025.rpy:1047
translate russian ep025_erigone_rescue_8502e70a:

    # ce "Opening bay doors."
    ce "Открываю створки отсека."

# game/episode025.rpy:1049
translate russian ep025_erigone_rescue_ea33654c:

    # "The cargo bay doors slowly opened and strong gusts of wind filled the room."
    "Створки грузового отсека медленно открылись, и в отсек ворвались мощные порывы ветра."

# game/episode025.rpy:1050
translate russian ep025_erigone_rescue_01a396c6:

    # "The Bastard was flying as low as possible in order for us to rappel down among the trees."
    "Ублюдок летел так низко, как только мог, чтобы мы могли спуститься по верёвкам среди деревьев."

# game/episode025.rpy:1051
translate russian ep025_erigone_rescue_65f60860:

    # "A clearing approached and the Bastard remained stationary in the air to allow us to quickly make the descent."
    "Впереди показалась поляна, и Ублюдок завис в воздухе, дав нам возможность быстро спуститься."

# game/episode025.rpy:1054
translate russian ep025_erigone_rescue_9a1b1e23:

    # "Once we had disengaged our zip lines, we all brandished our weapons and headed to Rahia’s location."
    "Отцепив спусковые тросы, мы все достали оружие и направились к месту, где находилась Рахия."

# game/episode025.rpy:1056
translate russian ep025_erigone_rescue_1faed7dd:

    # "Once we had disengaged our zip lines, we all brandished our weapons and headed to Keodele’s location."
    "Отцепив спусковые тросы, мы все достали оружие и направились к месту, где находилась Кеодели."

# game/episode025.rpy:1057
translate russian ep025_erigone_rescue_3c64a8d9:

    # "Explosions could be heard around us and the jungle roared as parts of it were glowing with orange fire."
    "Со всех сторон доносились взрывы, а джунгли гремели, местами озарённые оранжевым огнём."

# game/episode025.rpy:1060
translate russian ep025_erigone_rescue_678e6c73:

    # "We cleared this part of the jungle unopposed and were almost upon Rahia."
    "Мы без сопротивления прошли этот участок джунглей и уже почти добрались до Рахии."

# game/episode025.rpy:1063
translate russian ep025_erigone_rescue_c03d70e9:

    # "We cleared this part of the jungle unopposed and were almost upon Keodele."
    "Мы без сопротивления прошли этот участок джунглей и уже почти добрались до Кеодели."

# game/episode025.rpy:1065
translate russian ep025_erigone_rescue_277d4833:

    # "After signalling we were friendly, we made our final approach."
    "Дав понять, что мы свои, мы пошли на сближение."

# game/episode025.rpy:1066
translate russian ep025_erigone_rescue_6b573788:

    # "A contingent of Acarhyn soldiers welcomed us, while continuing to scan the battlefield."
    "Нас встретил отряд солдат-Акархинов, продолжавших следить за обстановкой на поле боя."

# game/episode025.rpy:1068
translate russian ep025_erigone_rescue_3be7a1ac:

    # woman "Commander Rahia is over here."
    woman "Командир Рахия здесь."

# game/episode025.rpy:1070
translate russian ep025_erigone_rescue_8b736915:

    # woman "High Priestess Keodele is over here."
    woman "Верховная Жрица Кеодели здесь."

# game/episode025.rpy:1071
translate russian ep025_erigone_rescue_5d888b2c:

    # woman "She has a broken ankle, but is otherwise fit to talk and give orders."
    woman "У неё сломана лодыжка, но больше ничего серьёзного - говорить и отдавать приказы в состоянии."

# game/episode025.rpy:1072
translate russian ep025_erigone_rescue_21f74726:

    # c "Good to see you in one piece."
    c "Хорошо, что ты цела и невредима."

# game/episode025.rpy:1075
translate russian ep025_erigone_rescue_df73dcb6:

    # rah "Thanks, that ambush nearly did us in."
    rah "Спасибо, мы едва пережили ту засаду."

# game/episode025.rpy:1078
translate russian ep025_erigone_rescue_f070814f:

    # keo "My Brutes fought valiantly until the end, but there were just too many warriors."
    keo "Мои Громилы доблестно сражались до самого конца, но воинов оказалось слишком много."

# game/episode025.rpy:1079
translate russian ep025_erigone_rescue_a711fef7:

    # c "Are you able to move?"
    c "Идти можешь?"

# game/episode025.rpy:1081
translate russian ep025_erigone_rescue_40015a04:

    # rah "Yes, if I can lean on somebody."
    rah "Да, если мне будет на кого опереться."

# game/episode025.rpy:1082
translate russian ep025_erigone_rescue_64bffc43:

    # rah "I’m slow, so the Priests will have a field day as soon as they have a clear shot at us."
    rah "Я не могу быстро двигаться, так что Жрецам будет раздолье, как только они получат возможность нормально прицелиться в нас."

# game/episode025.rpy:1083
translate russian ep025_erigone_rescue_9cc16b33:

    # c "Any of them hiding nearby?"
    c "Они здесь поблизости есть?"

# game/episode025.rpy:1084
translate russian ep025_erigone_rescue_2c02947a:

    # rah "Yes, we’ve been taking intermittent fire from the tree line over there."
    rah "Да, оттуда, из-за линии деревьев, по нам время от времени ведут огонь."

# game/episode025.rpy:1086
translate russian ep025_erigone_rescue_e57178a4:

    # keo "Only when assisted."
    keo "Только с чьей-нибудь помощью."

# game/episode025.rpy:1087
translate russian ep025_erigone_rescue_47fa7cf0:

    # keo "I won’t be quick though, so we’ll be exposed when we approach your ship."
    keo "Только быстро идти я не смогу, так что на подходе к вашему кораблю мы окажемся совершенно беззащитны."

# game/episode025.rpy:1088
translate russian ep025_erigone_rescue_581b2dbb:

    # c "Any warriors in the vicinity?"
    c "Есть ли поблизости воины?"

# game/episode025.rpy:1089
translate russian ep025_erigone_rescue_893e7a07:

    # keo "Yes, there are several in the trees over there."
    keo "Да, вон в тех деревьях прячется парочка."

# game/episode025.rpy:1090
translate russian ep025_erigone_rescue_3df35c3d:

    # c "We’ll give them something to keep them busy."
    c "Мы найдём, чем их занять."

# game/episode025.rpy:1092
translate russian ep025_erigone_rescue_325d3d6d:

    # rah "Acarhyn, moving out on my mark."
    rah "Акархины, выдвигаемся по моей команде."

# game/episode025.rpy:1093
translate russian ep025_erigone_rescue_fe81d847:

    # "The Warriors all voiced their acceptance and we made ready to rendezvous with the Bastard."
    "Воины один за другим подтвердили готовность, и мы приготовились к встрече с Ублюдком."

# game/episode025.rpy:1095
translate russian ep025_erigone_rescue_67a1eafd:

    # keo "Sisters, on me."
    keo "Сёстры, за мной."

# game/episode025.rpy:1096
translate russian ep025_erigone_rescue_f45201cc:

    # "The Priests all voiced their acceptance and we made ready to rendezvous with the Bastard."
    "Жрицы одна за другой подтвердили готовность, и мы приготовились к встрече с Ублюдком."

# game/episode025.rpy:1101
translate russian ep025_erigone_rescue_16c47c38:

    # "The allied ships were sweeping overhead, peppering the tree line, where the Acarhyn were supposedly holed up, with a barrage of gunfire."
    "Союзные корабли кружили над нами, поливая огнём линию деревьев, в которой, как предполагалось, укрывались Акархины."

# game/episode025.rpy:1102
translate russian ep025_erigone_rescue_15d69bf7:

    # "At that point, we made a sprint across the clearing, to the spot where the Bastard would pick us up."
    "После этого мы со всех ног бросились через поляну к месту, где нас должен был подобрать Ублюдок."

# game/episode025.rpy:1104
translate russian ep025_erigone_rescue_c357858a:

    # "Rahia limped in the middle of the group, supported by two Acarhyn."
    "Рахия хромала в центре группы, опираясь на двух Акархинов."

# game/episode025.rpy:1106
translate russian ep025_erigone_rescue_67583348:

    # "Keodele limped in the middle of the group, supported by two Acarhyn."
    "Кеодели хромала в центре группы, опираясь на двух Акархинов."

# game/episode025.rpy:1107
translate russian ep025_erigone_rescue_404981dc:

    # "Scattered bursts of gunfire came from the tree line, missing us by several meters."
    "Из-за линии деревьев по нам время от времени стреляли, но пули ложились в нескольких метрах от нас."

# game/episode025.rpy:1108
translate russian ep025_erigone_rescue_7a131576:

    # "We’d nearly reached the pickup point when the trees ahead of us began to shake."
    "Мы почти добрались до точки эвакуации, когда деревья впереди начали сотрясаться."

# game/episode025.rpy:1111
translate russian ep025_erigone_rescue_c76dadea:

    # "Two Brutes came through the foliage, blocking our way forward."
    "Из зарослей показались две Громилы, перекрыв нам дорогу."

# game/episode025.rpy:1118
translate russian ep025_erigone_rescue_13eac10b:

    # ki "Fuck, you didn’t tell me they were that big!"
    ki "Пиздец, ты не говорил, что они такие здоровые!"

# game/episode025.rpy:1119
translate russian ep025_erigone_rescue_37dc6778:

    # woman "Acarhyn on me, we’ll distract them."
    woman "Акархины, за мной, отвлечём их."

# game/episode025.rpy:1120
translate russian ep025_erigone_rescue_f9caa826:

    # woman "You make sure the Commander gets safely inside the ship."
    woman "Проследите, чтобы Командир благополучно добралась до корабля."

# game/episode025.rpy:1121
translate russian ep025_erigone_rescue_a4bfc132:

    # "The Warriors ran toward the Brutes, shooting at them as they came closer."
    "Воины бросились к Громилам, поливая их огнём на ходу."

# game/episode025.rpy:1122
translate russian ep025_erigone_rescue_fa407c63:

    # "Their fire didn’t even make a dent in the Brute’s armor."
    "Их выстрелы даже не смогли пробить броню Громил."

# game/episode025.rpy:1123
translate russian ep025_erigone_rescue_708fab2e:

    # c "Run!"
    c "Бегите!"

# game/episode025.rpy:1124
translate russian ep025_erigone_rescue_de2bfdd3:

    # "We all broke into a frenzied run, Rahia being bodily dragged along with her escort."
    "Мы все бросились бежать, а Рахию её сопровождающим пришлось буквально тащить за собой."

# game/episode025.rpy:1126
translate russian ep025_erigone_rescue_dcfe4c27:

    # "Meanwhile, the Acarhyn had ditched their guns and brandished their swords."
    "Тем временем Акархины бросили оружие и обнажили мечи."

# game/episode025.rpy:1127
translate russian ep025_erigone_rescue_3c77c1c4:

    # "It seemed that the metal of the swords, coated in venom, would be able to harm the Brutes."
    "Похоже, покрытые ядом мечи смогут причинить Громилам хоть какой-то вред."

# game/episode025.rpy:1128
translate russian ep025_erigone_rescue_1fb68e64:

    # "One of the Brutes swung her own sword and swept it across a group of Acarhyn in a wide arc."
    "Одна из Громил взмахнула своим мечом, и широким взмахом обрушил его на группу Акархинов."

# game/episode025.rpy:1130
translate russian ep025_erigone_rescue_17c71733:

    # "Most were able to dodge the swing, but one Acarhyn wasn’t so lucky."
    "Большинство смогли увернуться, но одному Акархину не повезло."

# game/episode025.rpy:1131
translate russian ep025_erigone_rescue_094d1dfe:

    # "Her head was severed and a fountain of blood sprayed from her ragged neck."
    "Ей отсекло голову, а из её изуродованной шеи хлынула кровь."

# game/episode025.rpy:1132
translate russian ep025_erigone_rescue_1566b162:

    # "The Brute roared in delight and took a defensive stance, swatting away the Acarhyn attacks."
    "Громила довольно взревела и встала в защитную стойку, отмахиваясь от атаки Акархинов."

# game/episode025.rpy:1133
translate russian ep025_erigone_rescue_cee1cacc:

    # "One of the Warriors was able to sink her sword in one of the Brute’s left calf."
    "Одной из Воинов удалось поразить мечом левую икру одной из Громил."

# game/episode025.rpy:1135
translate russian ep025_erigone_rescue_17327a43:

    # "The Brute roared in pain and focused solely on the Warrior that had wounded her."
    "Громила взревела от боли и целиком переключила своё внимание на Воина, которая её ранила."

# game/episode025.rpy:1136
translate russian ep025_erigone_rescue_0c617617:

    # "One of her massive hands shot out and grabbed the Acarhyn by her arm, wrenching the sword out of her grip."
    "Одна из её огромных ручищ метнулась вперёд и схватила Акархина за руку, вырвав меч из её хватки."

# game/episode025.rpy:1137
translate russian ep025_erigone_rescue_e70a3143:

    # "The Brute lifted the helpless Acarhyn off her feet and swung her into the air, eventually impaling her on the Brute’s wicked sword."
    "Громила подняла беспомощного Акархина над землёй и подбросила её вверх, а затем насадила на свой устрашающий меч."

# game/episode025.rpy:1138
translate russian ep025_erigone_rescue_e19b41b0:

    # "The Acarhyn used this distraction to further wound the Brute and were able to lacerate the creature’s skin multiple times."
    "Акархины воспользовались этим замешательством, чтобы ещё сильнее ранить Громилу, оставив на её коже множество порезов."

# game/episode025.rpy:1139
translate russian ep025_erigone_rescue_00e2eeac:

    # "The other Brute was kept busy by several Acarhyn dancing around her, trying to hit the creature in the back."
    "Несколько Акархинов отвлекали другую Громилу, кружась вокруг неё и пытаясь ударить в спину."

# game/episode025.rpy:1140
translate russian ep025_erigone_rescue_5e89ef85:

    # "Discarding the limp body of the Acarhyn, the Brute resumed her fighting stance."
    "Отшвырнув обмякшее тело Акархина, Громила снова приняла боевую стойку."

# game/episode025.rpy:1141
translate russian ep025_erigone_rescue_272ad362:

    # "Swinging her sword again, the Brute tried to replicate her earlier attack, but wavered."
    "Вновь взмахнув мечом, Громила попыталась повторить прежнюю атаку, но на этот раз дрогнула."

# game/episode025.rpy:1143
translate russian ep025_erigone_rescue_f64aa50d:

    # "For a moment, the Brute held her sword aloft, ready to make a horizontal arc."
    "На мгновение Громила замерла с поднятым мечом, готовясь провести им горизонтальный взмах."

# game/episode025.rpy:1144
translate russian ep025_erigone_rescue_7123e4b7:

    # "Suddenly, snot started streaming out of the bottom of her helmet, soon mixed with a foamy substance that must have been her saliva."
    "Вдруг из-под её шлема потекли сопли, вскоре смешавшись с пеной - судя по всему, слюной."

# game/episode025.rpy:1146
translate russian ep025_erigone_rescue_510b8190:

    # "The sword clattered to the ground as the Brute tipped over and fell face forward on the ground."
    "Меч с грохотом упал на землю, а Громила завалилась вперёд и рухнула лицом вниз."

# game/episode025.rpy:1147
translate russian ep025_erigone_rescue_c9f4bd01:

    # "The Acarhyn cheered, but didn’t have long to celebrate, because the other Brute rushed them from the side."
    "Акархины радостно закричали, однако их радость быстро оборвалась, поскольку вторая Громила внезапно рванула на них сбоку."

# game/episode025.rpy:1149
translate russian ep025_erigone_rescue_6536bf0b:

    # "She was able to impale one Acarhyn, as her fist connected with the face of another."
    "Она успела пронзить одного Акархина, одновременно впечатав кулак в лицо другого."

# game/episode025.rpy:1150
translate russian ep025_erigone_rescue_0a6563ec:

    # "A sickening crunch and the other Acarhyn fell to the ground, her face caved in from where it had connected with the Brute’s mailed fist."
    "Раздался жуткий хруст, и другой Акархин рухнул на землю - её лицо оказалось смято ударом бронированного кулака Громилы."

# game/episode025.rpy:1152
translate russian ep025_erigone_rescue_2be66752:

    # "We had made progress in the meantime and were nearly at the spot where the Bastard would pick us up."
    "За это время мы успели продвинуться вперёд и были уже почти у места, где нас должен был подобрать Ублюдок."

# game/episode025.rpy:1153
translate russian ep025_erigone_rescue_9cddd59e:

    # "The engines of our ship could already be heard in the near distance."
    "Уже совсем рядом слышался гул двигателей нашего корабля."

# game/episode025.rpy:1154
translate russian ep025_erigone_rescue_a343dc27:

    # "The remaining Brute must have heard it too, because she suddenly veered from fighting the Acarhyn and sprinted toward us."
    "Должно быть, оставшаяся Громила тоже это услышала, потому что внезапно прекратила сражаться с Акархинами и рванула к нам."

# game/episode025.rpy:1156
translate russian ep025_erigone_rescue_32f16a58:

    # av "Fuck, she’s going to trample us."
    av "Блять, она же нас раздавит."

# game/episode025.rpy:1157
translate russian ep025_erigone_rescue_b5ec2470:

    # rah "Run!{w} Just leave me!"
    rah "Бегите!{w} Оставьте меня!"

# game/episode025.rpy:1159
translate russian ep025_erigone_rescue_e2244a09:

    # "I took a grenade from my belt, pulled the pin and lobbed it into the Brute’s path."
    "Я выхватил гранату с пояса, выдернул чеку и бросил прямо под ноги Громиле."

# game/episode025.rpy:1160
translate russian ep025_erigone_rescue_e1d08a9b:

    # "Because they were trailing far behind her already, I prayed that the Acarhyn pursuing the Brute wouldn’t be caught in the explosion."
    "Акархины уже плелись далеко позади, и я молился, чтобы преследующие Громилу не оказались в эпицентре взрыва."

# game/episode025.rpy:1161
translate russian ep025_erigone_rescue_5ea71efd:

    # "The grenade flew with perfect accuracy at the Brute’s feet."
    "Граната с идеальной точностью упала прямо к ногам Громилы."

# game/episode025.rpy:1163
translate russian ep025_erigone_rescue_486b6458:

    # "She had just about passed the explosive when it detonated."
    "Она едва успела пройти мимо гранаты, как та взорвалась."

# game/episode025.rpy:1164
translate russian ep025_erigone_rescue_ae5836ae:

    # "For a moment, the Brute was lit up in orange flames."
    "На мгновение Громила оказалась объята оранжевым пламенем."

# game/episode025.rpy:1165
translate russian ep025_erigone_rescue_ae964380:

    # "Incredibly, it didn’t kill the creature in one fell swoop, she must have crossed the explosive by several meters when it detonated."
    "Невероятно, но взрыв не убил существо на месте, должно быть, к моменту детонации она успела отойти от гранаты на несколько метров."

# game/episode025.rpy:1167
translate russian ep025_erigone_rescue_7acb5423:

    # "However, her armor had caught fire and she was furiously swatting away the flames."
    "Однако её броня загорелась, и она в ярости принялась сбивать с себя огонь."

# game/episode025.rpy:1168
translate russian ep025_erigone_rescue_528aadf1:

    # "Behind her, the group of Acarhyn was scattered, most of them sitting dazed in the grass."
    "Группа Акархинов позади неё была раскидана кто где, и большинство из них сидели в траве, ошеломлённые взрывом."

# game/episode025.rpy:1169
translate russian ep025_erigone_rescue_750d4efc:

    # "I was relieved to see that all of them rapidly stood up and resumed their pursuit."
    "К моему облегчению, все они быстро поднялись на ноги и возобновили преследование."

# game/episode025.rpy:1171
translate russian ep025_erigone_rescue_c2a9c4f9:

    # "To keep the Brute occupied, I ordered everyone to fire on her."
    "Чтобы отвлечь Громилу, я приказал всем стрелять по ней."

# game/episode025.rpy:1172
translate russian ep025_erigone_rescue_8313ac5e:

    # "Predictably, this enraged the creature considerably."
    "Как и следовало ожидать, это привело Громилу в ярость."

# game/episode025.rpy:1173
translate russian ep025_erigone_rescue_5d90cd73:

    # "Smouldering, she lumbered toward us, now at half her original speed."
    "Окутанная дымом, она медленно поплелась к нам, двигаясь теперь вдвое медленнее прежнего."

# game/episode025.rpy:1174
translate russian ep025_erigone_rescue_7a7ac6dd:

    # c "Run for it, our ship is nearby!"
    c "Бежим, наш корабль уже рядом!"

# game/episode025.rpy:1176
translate russian ep025_erigone_rescue_021f54be:

    # "We broke into a jog, dragging Rahia along with us."
    "Мы перешли на бег, таща Рахию за собой."

# game/episode025.rpy:1177
translate russian ep025_erigone_rescue_578ee754:

    # "The fight with the Brutes had already depleted the Acarhyn warriors and a renewed confrontation might prove fatal, even though the Brute was maimed."
    "Сражение с Громилами уже сильно измотало Акархинских воинов, и новая схватка могла оказаться для них смертельной, несмотря на тяжёлые ранения Громилы."

# game/episode025.rpy:1179
translate russian ep025_erigone_rescue_d0825503:

    # "The Bastard came into view, it’s cargo bay door already opening."
    "Впереди показался Ублюдок, и створки его грузового отсека уже открывались."

# game/episode025.rpy:1180
translate russian ep025_erigone_rescue_b4fe89af:

    # "The Brute was hot on our tail, screaming in rage."
    "Громила преследовала нас по пятам, вопя от ярости."

# game/episode025.rpy:1181
translate russian ep025_erigone_rescue_a673b234:

    # "One of the Acarhyn warriors tripped over a rock and fell to the ground."
    "Одна из Акархинских воинов споткнулась о камень и упала."

# game/episode025.rpy:1183
translate russian ep025_erigone_rescue_6e5d6c5c:

    # "There wasn’t any time to rescue her, as the Brute pounced on her and pounded the helpless woman into the ground."
    "Времени спасти её у нас не было, Громила набросилась на неё и принялась вколачивать беспомощную женщину в землю."

# game/episode025.rpy:1184
translate russian ep025_erigone_rescue_33894058:

    # "We were near the cargo hold when the Bastard’s cannon swung toward the colossal creature."
    "Мы почти добрались до грузового отсека, когда пушка Ублюдка повернулась в сторону гигантского существа."

# game/episode025.rpy:1186
translate russian ep025_erigone_rescue_203e4bd9:

    # "The Brute was stopped dead in her tracks by several volleys of the cannon."
    "Громила была буквально остановлена на месте несколькими залпами из пушки."

# game/episode025.rpy:1187
translate russian ep025_erigone_rescue_f84eba8f:

    # "The energy bolts burnt holes in her armor until one lucky shot slipped through the visor of her helmet."
    "Энергетические заряды один за другим прожигали её броню, пока один из них не угодил прямо в визор шлема."

# game/episode025.rpy:1189
translate russian ep025_erigone_rescue_d844d14a:

    # "After a wet pop, the creature staggered backward and crashed to the ground."
    "С мерзким хлюпающим звуком существо пошатнулось, попятилось назад и рухнуло на землю."

# game/episode025.rpy:1191
translate russian ep025_erigone_rescue_e9cfdd7e:

    # "We bundled Rahia inside the ship and the Bastard took off toward the Citadel."
    "Мы затащили Рахию на борт, и Ублюдок взял курс на Цитадель."

# game/episode025.rpy:1194
translate russian ep025_erigone_rescue_490e77c4:

    # "Several mechs came through the foliage, blocking our way forward."
    "Из зарослей показались несколько мехов, перекрыв нам дорогу."

# game/episode025.rpy:1195
translate russian ep025_erigone_rescue_f5ad950f:

    # ki "Fuck, we’ve got company."
    ki "Блять, у нас тут гости."

# game/episode025.rpy:1196
translate russian ep025_erigone_rescue_37dc6778_1:

    # woman "Acarhyn on me, we’ll distract them."
    woman "Акархины, за мной, отвлечём их."

# game/episode025.rpy:1197
translate russian ep025_erigone_rescue_c654d0ae:

    # woman "You make sure the High Priestess gets safely inside the ship."
    woman "Проследите, чтобы Верховная Жрица благополучно добралась до корабля."

# game/episode025.rpy:1199
translate russian ep025_erigone_rescue_ced770b5:

    # "The Priests engaged the mechs, shooting at them from a distance."
    "Жрецы атаковали мехов, ведя по ним огонь с расстояния."

# game/episode025.rpy:1200
translate russian ep025_erigone_rescue_a4a65b6e:

    # "One mech nearly buckled under the barrage of fire, but advanced steadily after recovering."
    "Один из мехов пошатнулся под градом выстрелов, но быстро оправился и продолжил двигаться вперёд."

# game/episode025.rpy:1201
translate russian ep025_erigone_rescue_5a9f2fd2:

    # "A spray of bullets from the mechs took out several Priestesses and they were forced to find cover."
    "Шквал пуль, выпущенных мехами, поразил нескольких Жриц, и им пришлось искать укрытие."

# game/episode025.rpy:1203
translate russian ep025_erigone_rescue_ff06d273:

    # "As the mechs were still occupied with the Priestesses, we ran further toward the Bastard, Keodele limping along with us."
    "Пока мехи продолжали сражаться с Жрицами, мы рванули дальше к Ублюдку, а Кеодели, прихрамывая, поспевала за нами."

# game/episode025.rpy:1204
translate russian ep025_erigone_rescue_cb883e70:

    # "Gunfire could be heard behind us, the mechs appeared to have our rearguard pinned down."
    "Позади нас раздавалась стрельба - похоже, мехи прижали наш арьергард."

# game/episode025.rpy:1205
translate russian ep025_erigone_rescue_7ebf6739:

    # "When the gunfire stopped, we knew that the mechs were after us."
    "Когда стрельба прекратилась, стало ясно, что мехи преследуют нас."

# game/episode025.rpy:1207
translate russian ep025_erigone_rescue_e7658ddd:

    # "A small group of Priestesses reached us and confirmed our suspicions."
    "Вскоре нас настигла небольшая группа Жриц и подтвердила наши опасения."

# game/episode025.rpy:1208
translate russian ep025_erigone_rescue_95348ab2:

    # woman "Heavy losses, we had to retreat."
    woman "После тяжёлых потерь нам пришлось отступить."

# game/episode025.rpy:1209
translate russian ep025_erigone_rescue_7fca5538:

    # woman "We don’t have much time."
    woman "У нас совсем мало времени."

# game/episode025.rpy:1210
translate russian ep025_erigone_rescue_6e780ad3:

    # "The mechs were now very close, breaking through the dense foliage of the jungle almost unimpeded."
    "Мехи уже подобрались совсем близко, практически без помех пробиваясь сквозь густые заросли джунглей."

# game/episode025.rpy:1211
translate russian ep025_erigone_rescue_d059cdc8:

    # "The Bastard still wasn’t in sight and we wouldn’t be able to survive another confrontation with the mechs on our own."
    "Ублюдка всё ещё не было видно, а ещё одной встречи с мехами нам в одиночку не пережить."

# game/episode025.rpy:1213
translate russian ep025_erigone_rescue_10bf3f89:

    # "One of the Acarhyn screamed as gunfire caught her in the back."
    "Одна из Акархинов вскрикнула, когда пули попали ей в спину."

# game/episode025.rpy:1215
translate russian ep025_erigone_rescue_967e4bcd:

    # "She fell to the ground and was immediately trampled by one of the mechs."
    "Она рухнула на землю, и один из мехов тут же её затоптал."

# game/episode025.rpy:1216
translate russian ep025_erigone_rescue_46ef70bf:

    # c "Take cover!"
    c "В укрытие!"

# game/episode025.rpy:1218
translate russian ep025_erigone_rescue_7f61bf68:

    # "A barrage of gunfire peppered the clearing where we were just moments before."
    "Шквал выстрелов изрешетил поляну, на которой мы только что находились."

# game/episode025.rpy:1219
translate russian ep025_erigone_rescue_b6d7767a:

    # "It was only a matter of time before the mechs would be able to reach us with their superior firepower."
    "Было лишь вопросом времени, когда мехи смогут добраться до нас благодаря своему превосходству в огневой мощи."

# game/episode025.rpy:1221
translate russian ep025_erigone_rescue_41980751:

    # "As I was thinking desperately of ways to get us back on the Bastard in one piece, several colossal creatures suddenly crashed through the foliage."
    "Пока я отчаянно пытался придумать, как добраться до Ублюдка целыми и невредимыми, из зарослей внезапно вырвалось несколько огромных существ."

# game/episode025.rpy:1222
translate russian ep025_erigone_rescue_97af6bb9:

    # "The Brutes took the mechs completely by surprise."
    "Громилы застали мехов врасплох."

# game/episode025.rpy:1224
translate russian ep025_erigone_rescue_57094369:

    # "Two of them swung their big swords and severed both arms of one mech in a spray of sparks."
    "Двое Громил взмахнули огромными мечами и отсекли меху обе руки, во все стороны брызнули искры."

# game/episode025.rpy:1225
translate russian ep025_erigone_rescue_3b53601b:

    # "Defenceless, the mech was destroyed in a matter of seconds."
    "Лишившись возможности защищаться, мех был уничтожен за считанные секунды."

# game/episode025.rpy:1227
translate russian ep025_erigone_rescue_eafcc12d:

    # "The piloting Acarhyn warrior was pulled screaming from the wreckage and one of the Brutes pulled her head clean off her body without breaking a sweat."
    "Кричащую Акархина-пилота вытащили из обломков, и Громила одним движением оторвала ей голову."

# game/episode025.rpy:1228
translate russian ep025_erigone_rescue_2b4d2934:

    # "The remaining mechs now fired upon the Brutes."
    "Оставшиеся мехи открыли огонь по Громилам."

# game/episode025.rpy:1229
translate russian ep025_erigone_rescue_29164d34:

    # "Their armor took a lot of the heat, but I could see the Brutes straining under the firepower of the mechs."
    "Их броня принимала на себя большую часть огня, но было видно, как Громилы из последних сил держатся под огнём мехов."

# game/episode025.rpy:1230
translate russian ep025_erigone_rescue_9ca47ddf:

    # "The mechs distracted, this had to be our moment."
    "Мехи отвлеклись - это был наш шанс."

# game/episode025.rpy:1232
translate russian ep025_erigone_rescue_7a7ac6dd_1:

    # c "Run for it, our ship is nearby!"
    c "Бежим! Наш корабль уже близко!"

# game/episode025.rpy:1233
translate russian ep025_erigone_rescue_4d6adfa6:

    # "We broke into a jog, dragging Keodele along with us."
    "Мы перешли на бег, таща Кеодели за собой."

# game/episode025.rpy:1234
translate russian ep025_erigone_rescue_d0825503_1:

    # "The Bastard came into view, it’s cargo bay door already opening."
    "Впереди показался Ублюдок, и створки его грузового отсека уже открывались."

# game/episode025.rpy:1235
translate russian ep025_erigone_rescue_11fb27fa:

    # "The mechs had obviously dealt with the Brutes definitively and were once again in pursuit."
    "Похоже, мехи окончательно разобрались с Громилами и вновь пустились за нами."

# game/episode025.rpy:1237
translate russian ep025_erigone_rescue_628a6970:

    # "We were near the cargo hold when the Bastard’s cannon swung toward the line of mechs."
    "Мы почти добрались до грузового отсека, когда пушка Ублюдка повернулась в сторону строя мехов."

# game/episode025.rpy:1238
translate russian ep025_erigone_rescue_617a7b7b:

    # "The mechs lit up in flames after receiving several volleys of the cannon."
    "Мехи вспыхнули, охваченные пламенем, после нескольких залпов из пушки."

# game/episode025.rpy:1240
translate russian ep025_erigone_rescue_74ee19cb:

    # "Two of the mechs were reduced to smoking ruins, the other two were burning and permanently out of commission."
    "Два меха превратились в дымящиеся обломки, а два других горели и были окончательно выведены из строя."

# game/episode025.rpy:1242
translate russian ep025_erigone_rescue_feccb5b6:

    # "We bundled Keodele inside the ship and the Bastard took off toward the Shipyards."
    "Мы затащили Кеодели на борт, и Ублюдок взял курс на Верфи."

# game/episode025.rpy:1251
translate russian ep025_erigone_aftermath_d5232ce7:

    # "As soon as we arrived at the Citadel, we handed over Rahia so she could receive the required medical care."
    "Сразу после прибытия в Цитадель мы передали Рахию медикам для оказания необходимой медицинской помощи."

# game/episode025.rpy:1254
translate russian ep025_erigone_aftermath_232bb737:

    # "As soon as we arrived at the Shipyards, we handed over Keodele so she could receive the required medical care."
    "Сразу после прибытия на Верфи мы передали Кеодели медикам для оказания необходимой медицинской помощи."

# game/episode025.rpy:1255
translate russian ep025_erigone_aftermath_1d43f512:

    # "We stayed near the Iron Bastard, waiting for any news from the battlefield."
    "Мы оставались рядом с Железным Ублюдком, ожидая новостей с поля боя."

# game/episode025.rpy:1258
translate russian ep025_erigone_aftermath_452a9c40:

    # "After we arrived at the Citadel, we stayed near the Iron Bastard, waiting for any news from the battlefield."
    "После прибытия в Цитадель мы оставались рядом с Железным Ублюдком, ожидая новостей с поля боя."

# game/episode025.rpy:1260
translate russian ep025_erigone_aftermath_dbbbd0ed:

    # "After we arrived at the Shipyards, we stayed near the Iron Bastard, waiting for any news from the battlefield."
    "После прибытия на Верфи мы оставались рядом с Железным Ублюдком, ожидая новостей с поля боя."

# game/episode025.rpy:1261
translate russian ep025_erigone_aftermath_fb6fc5b7:

    # "Despite the heavy fighting, our ship had come out with barely a scratch."
    "Несмотря на ожесточённые бои, наш корабль отделался лишь парой царапин."

# game/episode025.rpy:1266
translate russian ep025_erigone_aftermath_730fb30d:

    # "The same couldn’t be said for the troops and ordnance returning from the jungle."
    "Но того же нельзя было сказать о войсках и технике, возвращавшихся из джунглей."

# game/episode025.rpy:1268
translate russian ep025_erigone_aftermath_872367e1:

    # "The Warrior caste had clearly encountered heavy opposition."
    "Судя по всему, каста Воинов встретила ожесточённое сопротивление."

# game/episode025.rpy:1270
translate russian ep025_erigone_aftermath_e4e2a2fb:

    # "The Priest caste had clearly encountered heavy opposition."
    "Судя по всему, каста Жрецов встретила ожесточённое сопротивление."

# game/episode025.rpy:1271
translate russian ep025_erigone_aftermath_4954a9ff:

    # "The outcome of the battle was still very much unknown."
    "Исход битвы по-прежнему оставался под вопросом."

# game/episode025.rpy:1282
translate russian ep025_erigone_aftermath_426fc3a8:

    # "Eva joined us soon after our arrival and we brought her up to speed with the latest developments."
    "Ева присоединилась к нам вскоре после прибытия, и мы ввели её в курс последних событий."

# game/episode025.rpy:1291
translate russian ep025_erigone_aftermath_ab83de61:

    # "Several hours passed until a group of Acarhyn returned."
    "Лишь несколько часов спустя вернулась группа Акархинов."

# game/episode025.rpy:1292
translate russian ep025_erigone_aftermath_b3a8c9b2:

    # "They looked rather grim and forlorn."
    "Выглядели они довольно мрачно и подавленно."

# game/episode025.rpy:1297
translate russian ep025_erigone_aftermath_e458c067:

    # woman "Greetings, Your Majesty."
    woman "Приветствую, Ваше Величество."

# game/episode025.rpy:1298
translate russian ep025_erigone_aftermath_a5c5b985:

    # woman "The war is over."
    woman "Война окончена."

# game/episode025.rpy:1300
translate russian ep025_erigone_aftermath_1cafa0bb:

    # woman "We’re fighting the last vestiges of Priest resistance, but they’re fighting a losing battle."
    woman "Мы подавляем последние остатки сопротивления Жрецов, но они уже обречены на поражение."

# game/episode025.rpy:1301
translate russian ep025_erigone_aftermath_2ec3d010:

    # woman "Tomorrow will be a day of mourning for the loss of our Commander."
    woman "Завтра будет днём скорби по нашему погибшему Командиру."

# game/episode025.rpy:1302
translate russian ep025_erigone_aftermath_70b842ca:

    # woman "Commander Rahia perished on the battlefield."
    woman "Командир Рахия пала на поле боя."

# game/episode025.rpy:1304
translate russian ep025_erigone_aftermath_78ed9151:

    # woman "We’re fighting the last vestiges of Warrior resistance, but they’re fighting a losing battle."
    woman "Мы подавляем последние остатки сопротивления Воинов, но они уже обречены на поражение."

# game/episode025.rpy:1305
translate russian ep025_erigone_aftermath_68b3791a:

    # woman "Tomorrow will be a day of mourning for the loss of our High Priestess."
    woman "Завтра будет днём скорби по нашей погибшей Верховной Жрице."

# game/episode025.rpy:1306
translate russian ep025_erigone_aftermath_76c83223:

    # woman "High Priestess Keodele perished on the battlefield."
    woman "Верховная Жрица Кеодели пала на поле боя."

# game/episode025.rpy:1307
translate russian ep025_erigone_aftermath_f3b2e923:

    # woman "Her rescue came too late."
    woman "К сожалению, её спасли слишком поздно."

# game/episode025.rpy:1312
translate russian ep025_erigone_aftermath_225763cf:

    # e "Her bravery and mettle were unparalleled."
    e "Её мужество и отвага не знали себе равных."

# game/episode025.rpy:1313
translate russian ep025_erigone_aftermath_6c409f3e:

    # e "She will receive a funeral with full honors."
    e "Её похоронят со всеми подобающими почестями."

# game/episode025.rpy:1318
translate russian ep025_erigone_aftermath_6a23da66:

    # woman "Of course, Your Majesty."
    woman "Конечно, Ваше Высочество."

# game/episode025.rpy:1319
translate russian ep025_erigone_aftermath_38789e09:

    # "The Acarhyn left us to talk amongst ourselves."
    "Акархины ушли, оставив нас одних."

# game/episode025.rpy:1324
translate russian ep025_erigone_aftermath_177b4765:

    # av "This is a blow for us."
    av "Для нас это большая потеря."

# game/episode025.rpy:1326
translate russian ep025_erigone_aftermath_54fd3ecc:

    # av "Rahia was an ally."
    av "Рахия была нашим союзником."

# game/episode025.rpy:1328
translate russian ep025_erigone_aftermath_b2107857:

    # av "Keodele was an ally, albeit a reluctant one."
    av "Кеодели была нашей союзницей, пусть и весьма неохотной."

# game/episode025.rpy:1329
translate russian ep025_erigone_aftermath_26e2c7f1:

    # c "Yes, she was."
    c "Да, всё так."

# game/episode025.rpy:1334
translate russian ep025_erigone_aftermath_71475c83:

    # l "Should we have participated in the attempt to rescue her?"
    l "Стоило ли нам участвовать в попытке спасти её?"

# game/episode025.rpy:1335
translate russian ep025_erigone_aftermath_56be2fbf:

    # c "That would have been a suicide run."
    c "Это была бы верная смерть."

# game/episode025.rpy:1336
translate russian ep025_erigone_aftermath_a5a7719c:

    # c "You all saw the chaos on the battlefield."
    c "Вы все видели, какой хаос царил на поле боя."

# game/episode025.rpy:1337
translate russian ep025_erigone_aftermath_34bd489d:

    # c "The Bastard was in no shape to touch down amidst all that."
    c "Ублюдок был не в том состоянии, чтобы садиться в такой обстановке."

# game/episode025.rpy:1342
translate russian ep025_erigone_aftermath_a84bedf1:

    # na "The only thing we can do now is hope for the best."
    na "Теперь нам остаётся надеяться лишь на лучшее."

# game/episode025.rpy:1347
translate russian ep025_erigone_aftermath_23e2cfd6:

    # "The Acarhyn were right to surmise that the fighting would stop soon."
    "Акархины верно предсказали скорое окончание боёв."

# game/episode025.rpy:1348
translate russian ep025_erigone_aftermath_a7546641:

    # "No more gunfire could be heard when darkness fell."
    "С наступлением темноты стрельба стихла."

# game/episode025.rpy:1351
translate russian ep025_erigone_aftermath_3ef3376f:

    # "Captured priests were led into the Citadel."
    "Пленных Жрецов провели в Цитадель."

# game/episode025.rpy:1354
translate russian ep025_erigone_aftermath_b5757ba3:

    # "Captured warriors were led into the Shipyards."
    "Пленных Воинов провели на Верфи."

# game/episode025.rpy:1355
translate russian ep025_erigone_aftermath_7fc04698:

    # "Though everyone appeared to be glad the conflict was over, the atmosphere was very muted."
    "Хотя казалось, что все рады окончанию конфликта, атмосфера стояла очень гнетущая."

# game/episode025.rpy:1361
translate russian ep025_erigone_aftermath_4dfd6db1:

    # "This continued the next day, when Rahia’s funeral was held."
    "Это продолжилось и на следующий день, когда состоялись похороны Рахии."

# game/episode025.rpy:1362
translate russian ep025_erigone_aftermath_cda37602:

    # "Eva was required to oversee the proceedings and lit Rahia’s funeral pyre."
    "Еве надлежало присутствовать при церемонии - она и зажгла погребальный костёр Рахии."

# game/episode025.rpy:1365
translate russian ep025_erigone_aftermath_81d9d0eb:

    # "This continued the next day, when Keodele’s funeral was held."
    "Это продолжилось и на следующий день, когда состоялись похороны Кеодели."

# game/episode025.rpy:1366
translate russian ep025_erigone_aftermath_9e292821:

    # "Eva was required to oversee the proceedings and lit Keodele’s funeral pyre."
    "Еве надлежало присутствовать при церемонии - она и зажгла погребальный костёр Кеодели."

# game/episode025.rpy:1368
translate russian ep025_erigone_aftermath_8bceff4c:

    # "Several days after the funeral, a group of Acarhyn requested an audience with their queen."
    "Спустя несколько дней после похорон группа Акархинов запросила аудиенцию у королевы."

# game/episode025.rpy:1369
translate russian ep025_erigone_aftermath_0a09474a:

    # "As we were preparing to leave Erigone, we agreed to meet them near the Bastard."
    "Перед отлётом с Эригона мы договорились встретиться с ними у Ублюдка."

# game/episode025.rpy:1380
translate russian ep025_erigone_aftermath_5a753fcb:

    # woman "My Queen, we have come to pledge our support to the mission Your Majesty has asked us to join."
    woman "Моя Королева, мы явились, чтобы присягнуть на верность миссии, которой Ваше Величество просили нас присоединиться."

# game/episode025.rpy:1381
translate russian ep025_erigone_aftermath_6b74cd68:

    # woman "The Acarhyn will defeat the Sovereignty once and for all!"
    woman "Акархины покончат с Суверенитетом раз и навсегда!"

# game/episode025.rpy:1392
translate russian ep025_erigone_aftermath_92474673:

    # e "We thank you."
    e "Мы благодарим вас."

# game/episode025.rpy:1393
translate russian ep025_erigone_aftermath_5e09efe2:

    # e "Your pledge of allegiance is honorable and just, befitting of a true Acarhyn."
    e "Ваша присяга на верность - благородна и справедлива, как и подобает истинным Акархинам."

# game/episode025.rpy:1404
translate russian ep025_erigone_aftermath_f3ede4bf:

    # woman "Thank you, Your Majesty."
    woman "Благодарю, Ваше Высочество."

# game/episode025.rpy:1405
translate russian ep025_erigone_aftermath_e033414a:

    # woman "Our only regret is that not all of us will be able to join the fight."
    woman "Мы сожалеем лишь об одном: не все из нас смогут принять участие в бою."

# game/episode025.rpy:1406
translate russian ep025_erigone_aftermath_9bced104:

    # woman "Erigone needs to be rebuilt and our caste is in need of new leadership."
    woman "Эригон предстоит восстановить, а нашей касте - обрести новых лидеров."

# game/episode025.rpy:1408
translate russian ep025_erigone_aftermath_511f7d1d:

    # woman "Choosing a new Commander will be difficult."
    woman "Выбрать нового Командира будет непросто."

# game/episode025.rpy:1410
translate russian ep025_erigone_aftermath_c4d34907:

    # woman "Choosing a new High Priestess will be difficult."
    woman "Выбрать новую Верховную Жрицу будет непросто."

# game/episode025.rpy:1421
translate russian ep025_erigone_aftermath_6c8945ca:

    # e "We recognize your hardship, which makes your pledge all the more worthy."
    e "Нам ведомы ваши лишения, отчего ваша преданность обретает особую значимость."

# game/episode025.rpy:1422
translate russian ep025_erigone_aftermath_1bd12c65:

    # c "My crew will coordinate with you on how to join the forces that have already gathered in opposition against the Sovereignty."
    c "Мой экипаж свяжется с вами, чтобы согласовать порядок присоединения к силам, уже собравшимся для противостояния Суверенитету."

# game/episode025.rpy:1424
translate russian ep025_erigone_aftermath_fc2df6fb:

    # "This surely wasn’t the most ideal outcome, but we had no choice but to accept it."
    "Пусть это и не лучший расклад, но у нас не было иного пути, кроме как принять его."

# game/episode025.rpy:1425
translate russian ep025_erigone_aftermath_a67c6b43:

    # "Céline and Thyia provided the Acarhyn with the necessary information to join up with the fleet we had already amassed."
    "Селин и Тхия передали Акархинам всю необходимую информацию, чтобы те могли присоединиться к нашим уже собранным силам."

# game/episode025.rpy:1426
translate russian ep025_erigone_aftermath_2bf1e69a:

    # "We would be joining up with the fleet too, to see if the Rhenkoy and Tubloshi had made progress in recruiting new forces into the fold."
    "Мы также должны были присоединиться к флоту и выяснить, продвинулись ли Ренкой и Тублоши в привлечении новых сил на нашу сторону."

# game/episode025.rpy:1430
translate russian ep025_erigone_aftermath_c90687f9:

    # "Several hours passed until a group of Acarhyn returned, Rahia among them."
    "Несколько часов спустя вернулась группа Акархинов, и Рахия была среди них."

# game/episode025.rpy:1436
translate russian ep025_erigone_aftermath_b27dbce7:

    # "Several hours passed until a group of Acarhyn returned, Keodele among them."
    "Несколько часов спустя вернулась группа Акархинов, и Кеодели была среди них."

# game/episode025.rpy:1437
translate russian ep025_erigone_aftermath_85f6a0c6:

    # "She still had trouble walking, but looked a little less worse for wear."
    "Передвигалась она всё ещё с трудом, но выглядела уже немного лучше."

# game/episode025.rpy:1440
translate russian ep025_erigone_aftermath_abed9d08:

    # rah "Your Majesty, I’m pleased to announce that the war is over."
    rah "Ваше Величество, с радостью сообщаю, что война окончена."

# game/episode025.rpy:1441
translate russian ep025_erigone_aftermath_5b278a9b:

    # rah "We’re dealing with some small Priest caste remnants, but they don’t pose a lasting threat."
    rah "Мы разбираемся с остатками касты Жрецов, но серьёзной угрозы они уже не представляют."

# game/episode025.rpy:1442
translate russian ep025_erigone_aftermath_1f9240dd:

    # rah "Keodele has been captured and is currently imprisoned in the Citadel dungeons."
    rah "Кеодели схвачена и сейчас находится в темницах Цитадели."

# game/episode025.rpy:1443
translate russian ep025_erigone_aftermath_6aca2d14:

    # rah "Her trial will be tomorrow and Your Majesty is kindly asked to attend."
    rah "Судить её будут завтра, и Ваше Величество любезно приглашается на него."

# game/episode025.rpy:1448
translate russian ep025_erigone_aftermath_f6e589f8:

    # e "Thank you, commander."
    e "Благодарю вас, командир."

# game/episode025.rpy:1449
translate russian ep025_erigone_aftermath_9aa253fc:

    # e "You have fought valiantly and helped us secure the victory the Acarhyn people so desperately needed."
    e "Вы проявили доблесть в бою и помогли нам одержать столь необходимую народу Акархинов победу."

# game/episode025.rpy:1450
translate russian ep025_erigone_aftermath_28ecae96:

    # e "We will of course attend the trial of the traitor Keodele tomorrow."
    e "Разумеется, завтра мы будем присутствовать на суде над предательницей Кеодели."

# game/episode025.rpy:1452
translate russian ep025_erigone_aftermath_53921eb5:

    # "The Acarhyn left us and we all headed back to our quarters for some much-needed sleep."
    "Акархины ушли, после чего мы все вернулись в свои покои и легли спать - сон нам был крайне необходим."

# game/episode025.rpy:1454
translate russian ep025_erigone_aftermath_43577c94:

    # "Some intermittent gunfire could be heard during the night, but eventually this all stopped."
    "Ночью время от времени были слышны выстрелы, но в конце концов и они стихли."

# game/episode025.rpy:1455
translate russian ep025_erigone_aftermath_32fd5cb3:

    # "Rahia was right in presuming that any remaining resistance would soon be broken."
    "Рахия верно предсказала, что последние очаги сопротивления вскоре будут подавлены."

# game/episode025.rpy:1457
translate russian ep025_erigone_aftermath_7754fc85:

    # "A steady stream of captured priests were led into the Citadel during the early morning."
    "С раннего утра в Цитадель непрерывным потоком приводили пленных жрецов."

# game/episode025.rpy:1462
translate russian ep025_erigone_aftermath_3e105349:

    # "The trial of Keodele took place around midday in the courtyard of the Citadel."
    "Суд над Кеодели состоялся около полудня во дворе Цитадели."

# game/episode025.rpy:1463
translate russian ep025_erigone_aftermath_c5a90a19:

    # "Eva had already been fetched and was standing on the dais in the courtyard, joined by Rahia."
    "Еву уже привели во двор, и на возвышении она стояла рядом с Рахией."

# game/episode025.rpy:1464
translate russian ep025_erigone_aftermath_527f6c57:

    # "A group of Acarhyn stood on the side of the platform and served as a jury."
    "Сбоку от помоста стояла группа Акархинов, исполнявшая роль присяжных."

# game/episode025.rpy:1469
translate russian ep025_erigone_aftermath_39dbfc87:

    # "The former High Priestess was standing barefeet on the rough wooden boards and looked rather less stately than before."
    "Бывшая Верховная Жрица стояла босиком на грубых деревянных досках и выглядела уже далеко не так величественно, как прежде."

# game/episode025.rpy:1470
translate russian ep025_erigone_aftermath_753b7eaf:

    # "Her gaze was defiant though."
    "Но взгляд её оставался вызывающим."

# game/episode025.rpy:1471
translate russian ep025_erigone_aftermath_4194cd32:

    # "Nothing of the timid acolyte I encountered before remained."
    "От той робкой послушницы, которую я когда-то встретил, не осталось и следа."

# game/episode025.rpy:1472
translate russian ep025_erigone_aftermath_6bcc20d8:

    # "I could see why she’d been able to rally the Priest caste around her and inspire them to rebel against the Warriors."
    "Теперь я понимал, как ей удалось объединить вокруг себя касту Жрецов и поднять их на восстание против Воинов."

# game/episode025.rpy:1473
translate russian ep025_erigone_aftermath_bfdfc8c7:

    # "All of that bravado was now moot and Keodele seemed to have deduced what her final fate would be."
    "Вся её прежняя бравада теперь была бессмысленна, и, судя по всему, Кеодели уже догадалась, какая судьба её ждёт."

# game/episode025.rpy:1475
translate russian ep025_erigone_aftermath_e116f1b4:

    # rah "Acarhyn!"
    rah "Акархины!"

# game/episode025.rpy:1476
translate russian ep025_erigone_aftermath_6b679e9f:

    # rah "The war is over."
    rah "Война окончена."

# game/episode025.rpy:1477
translate russian ep025_erigone_aftermath_96621cda:

    # rah "Erigone will be rebuilt and returned to its former glory."
    rah "Эригон будет восстановлен и обретёт былое величие."

# game/episode025.rpy:1479
translate russian ep025_erigone_aftermath_38c13164:

    # rah "The Priest caste will be curtailed and regulated."
    rah "Каста жрецов будет подвергнута ограничениям и строгому регулированию."

# game/episode025.rpy:1480
translate russian ep025_erigone_aftermath_4e72e06a:

    # rah "Priests will no longer be allowed to bear arms."
    rah "Отныне Жрецам будет запрещено носить оружие."

# game/episode025.rpy:1481
translate russian ep025_erigone_aftermath_52207feb:

    # rah "Any gatherings of ten or more people are forbidden, unless officially sanctioned by the Erigone government."
    rah "Любые собрания численностью десять и более человек запрещены, если только они не санкционированы правительством Эригона."

# game/episode025.rpy:1482
translate russian ep025_erigone_aftermath_2d4896df:

    # rah "Any Priestesses who wish to give up their calling are free to do so, without fear of repercussions."
    rah "Любая жрица, решившая отказаться от своего служения, может сделать это, не опасаясь последствий."

# game/episode025.rpy:1483
translate russian ep025_erigone_aftermath_95304af6:

    # rah "Any Priestesses who wish to join the Warrior caste and contribute to the rebuilding of Erigone are welcome to do so."
    rah "Жрицы, желающие присоединиться к касте Воинов и помочь в восстановлении Эригона, будут с радостью приняты."

# game/episode025.rpy:1485
translate russian ep025_erigone_aftermath_0bb01d77:

    # rah "This conflict has served as a line drawn under any hostilities among the castes."
    rah "Этот конфликт положил конец вражде между кастами."

# game/episode025.rpy:1486
translate russian ep025_erigone_aftermath_df56b3d0:

    # rah "However, the instigators of the rebellion must be brought to justice."
    rah "Однако зачинщики восстания должны быть привлечены к ответственности."

# game/episode025.rpy:1488
translate russian ep025_erigone_aftermath_ba1e5c2a:

    # rah "Keodele, former High Priestess of the Priest caste, is the first to be tried."
    rah "Кеодели, бывшая Верховная Жрица касты Жрецов, первой предстанет перед судом."

# game/episode025.rpy:1489
translate russian ep025_erigone_aftermath_2ad5104a:

    # rah "Many of her lieutenants will be brought to justice in the coming days."
    rah "В ближайшие дни многие из её соратников предстанут перед судом."

# game/episode025.rpy:1491
translate russian ep025_erigone_aftermath_85bc64a2:

    # rah "Justice will be done."
    rah "Правосудие свершится."

# game/episode025.rpy:1492
translate russian ep025_erigone_aftermath_94c27711:

    # rah "This court is now in session."
    rah "Суд объявляется открытым."

# game/episode025.rpy:1494
translate russian ep025_erigone_aftermath_724d4226:

    # rah "Keodele, you stand accused of high treason in your attempt to eradicate the Warrior caste."
    rah "Кеодели, вы обвиняетесь в государственной измене, совершённой с целью уничтожения касты Воинов."

# game/episode025.rpy:1495
translate russian ep025_erigone_aftermath_da479a11:

    # rah "Furthermore, you are accused of giving the order to perform experiments on unwilling Acarhyn."
    rah "Помимо этого, вы обвиняетесь в том, что отдали приказ проводить эксперименты над Акархинами против их воли."

# game/episode025.rpy:1496
translate russian ep025_erigone_aftermath_9f3d8bb8:

    # rah "The so-called Brutes, created on your instigation, were used as troops in the conflict."
    rah "Так называемые Громилы, созданные по вашей инициативе, использовались в качестве солдат в этом конфликте."

# game/episode025.rpy:1497
translate russian ep025_erigone_aftermath_a5890d40:

    # rah "Many of them perished on the battlefield or because of their extremely short lifespans."
    rah "Многие из них погибли на поле боя или стали жертвами своей крайне короткой продолжительности жизни."

# game/episode025.rpy:1498
translate russian ep025_erigone_aftermath_1da25d6d:

    # rah "How do you plead?"
    rah "Вы признаёте свою вину?"

# game/episode025.rpy:1500
translate russian ep025_erigone_aftermath_5c0f6cf4:

    # keo "Not guilty."
    keo "Не признаю себя виновной."

# game/episode025.rpy:1502
translate russian ep025_erigone_aftermath_74bf7f87:

    # rah "Do you deny conspiring against the Warrior caste?"
    rah "Вы отрицаете факт заговора против касты Воинов?"

# game/episode025.rpy:1503
translate russian ep025_erigone_aftermath_0785f90e:

    # rah "Do you deny giving the order to experiment on your fellow Acarhyn?"
    rah "Вы отрицаете, что отдали приказ проводить эксперименты над своими сородичами-Акархинами?"

# game/episode025.rpy:1505
translate russian ep025_erigone_aftermath_f99b03b9:

    # keo "I do not."
    keo "Не отрицаю."

# game/episode025.rpy:1506
translate russian ep025_erigone_aftermath_24a8c1db:

    # keo "I did what was necessary."
    keo "Я сделала то, что должна была."

# game/episode025.rpy:1507
translate russian ep025_erigone_aftermath_83b646be:

    # keo "And I’d do it again."
    keo "И сделала бы это снова."

# game/episode025.rpy:1512
translate russian ep025_erigone_aftermath_9b2eca6a:

    # "This statement elicited gasps from the audience."
    "От этих слов в зале раздались изумлённые возгласы."

# game/episode025.rpy:1513
translate russian ep025_erigone_aftermath_9fc2f544:

    # "The trial went on for quite some time, though everyone already knew the outcome."
    "Суд продолжался довольно долго, хотя все уже знали, чем он закончится."

# game/episode025.rpy:1514
translate russian ep025_erigone_aftermath_4c9db5fd:

    # "Ample amounts of evidence were presented and never refuted by Keodele."
    "Было представлено множество доказательств, и Кеодели не опровергла ни одного из них."

# game/episode025.rpy:1515
translate russian ep025_erigone_aftermath_5e6dcf69:

    # "Keodele might not have pleaded guilty, but never denied any of her actions."
    "Кеодели могла и не признать себя виновной, но при этом не отрицала ни одного из своих поступков."

# game/episode025.rpy:1516
translate russian ep025_erigone_aftermath_8998a2b6:

    # "The guilty verdict from the jury came as no surprise to anyone, including Keodele."
    "Обвинительный вердикт присяжных ни для кого не стал неожиданностью, включая саму Кеодели."

# game/episode025.rpy:1517
translate russian ep025_erigone_aftermath_a5f00871:

    # "It fell to Eva to read out the sentence."
    "Еве предстояло огласить приговор."

# game/episode025.rpy:1522
translate russian ep025_erigone_aftermath_7565a4a7:

    # e "Keodele, this court deems you guilty of war crimes, crimes against the Acarhyn people and high treason."
    e "Кеодели, суд признаёт вас виновной в совершении военных преступлений, преступлений против народа Акархинов и государственной измене."

# game/episode025.rpy:1523
translate russian ep025_erigone_aftermath_8889a604:

    # e "The Acarhyn know only one sentence for these crimes."
    e "За такие преступления у Акархинов предусмотрен лишь один приговор."

# game/episode025.rpy:1524
translate russian ep025_erigone_aftermath_a96abd78:

    # e "You are to be executed, effective immediately."
    e "Вы приговорены к смертной казни. Приговор вступает в силу немедленно."

# game/episode025.rpy:1526
translate russian ep025_erigone_aftermath_34409500:

    # keo "Everything I did, was for the benefit of Acarhynkind."
    keo "Всё, что я делала, я делала ради блага Акархинов."

# game/episode025.rpy:1527
translate russian ep025_erigone_aftermath_d5d1d8e6:

    # keo "I have no remorse."
    keo "Я ни о чём не жалею."

# game/episode025.rpy:1528
translate russian ep025_erigone_aftermath_1142065e:

    # keo "You may kill me, but my dream of a better Erigone will live on in the hearts of my true believers."
    keo "Вы можете убить меня, но моя мечта о лучшем Эригоне продолжит жить в сердцах моих истинных последователей."

# game/episode025.rpy:1533
translate russian ep025_erigone_aftermath_465f16fd:

    # "A chopping block had been fetched and Rahia had drawn her sword."
    "Принесли плаху, и Рахия обнажила меч."

# game/episode025.rpy:1534
translate russian ep025_erigone_aftermath_7f6e75fa:

    # "Keodele was made to let her head rest on the block."
    "Кеодели приказали положить голову на плаху."

# game/episode025.rpy:1536
translate russian ep025_erigone_aftermath_4bd7a52b:

    # "With one stroke, Rahia severed Keodele’s head from her body."
    "Одним ударом Рахия отсекла голову Кеодели."

# game/episode025.rpy:1537
translate russian ep025_erigone_aftermath_26df63cc:

    # "There were no cheers or any reaction from the audience."
    "Из толпы не раздалось ни возгласов, ни какой-либо другой реакции."

# game/episode025.rpy:1539
translate russian ep025_erigone_aftermath_9edfe287:

    # "We all left the courtyard in silence."
    "Мы все молча покинули двор."

# game/episode025.rpy:1540
translate russian ep025_erigone_aftermath_7de803e7:

    # "The trials continued during the coming days and many executions followed."
    "В последующие дни суды продолжились, за ними последовали многочисленные казни."

# game/episode025.rpy:1541
translate russian ep025_erigone_aftermath_b31ff031:

    # "We didn’t attend those, as we were too busy preparing the Bastard to leave Erigone."
    "Мы на них не присутствовали, поскольку были слишком заняты подготовкой Ублюдка к отлёту с Эригона."

# game/episode025.rpy:1546
translate russian ep025_erigone_aftermath_e349d7b1:

    # "Rahia visited us a few days before we were scheduled to leave."
    "За несколько дней до нашего отлёта к нам пришла Рахия."

# game/episode025.rpy:1547
translate russian ep025_erigone_aftermath_56ecd585:

    # rah "My Queen, the Acarhyn Council has reached a verdict on joining the mission Your Majesty has proposed."
    rah "Моя Королева, Совет Акархинов вынес решение относительно участия в миссии, которую предложило Ваше Величество."

# game/episode025.rpy:1548
translate russian ep025_erigone_aftermath_64390812:

    # rah "I have come to formally pledge our support to the alliance against the Sovereignty."
    rah "Я пришла официально заявить о нашей поддержке альянса в борьбе против Суверенитета."

# game/episode025.rpy:1553
translate russian ep025_erigone_aftermath_92474673_1:

    # e "We thank you."
    e "Мы благодарим вас."

# game/episode025.rpy:1554
translate russian ep025_erigone_aftermath_5e09efe2_1:

    # e "Your pledge of allegiance is honorable and just, befitting of a true Acarhyn."
    e "Ваша присяга на верность - благородна и справедлива, как и подобает истинным Акархинам."

# game/episode025.rpy:1556
translate russian ep025_erigone_aftermath_80052ee9:

    # rah "Thank you, Your Majesty."
    rah "Благодарю, Ваше Высочество."

# game/episode025.rpy:1557
translate russian ep025_erigone_aftermath_70152226:

    # rah "The Priest caste has been decimated and no further rebellions are expected."
    rah "Каста Жрецов понесла огромные потери, и новых восстаний не предвидится."

# game/episode025.rpy:1558
translate russian ep025_erigone_aftermath_bf043df9:

    # rah "A contingent of Acarhyn will remain on Erigone, overseeing the repairs and restoring order to our lands."
    rah "Часть Акархинов останется на Эригоне, чтобы контролировать восстановительные работы и наведение порядка на наших землях."

# game/episode025.rpy:1559
translate russian ep025_erigone_aftermath_ca0a86f0:

    # rah "I will personally lead the Acarhyn who’ll be joining the alliance against the Sovereignty."
    rah "Я лично возглавлю Акархинов, которые присоединятся к альянсу в борьбе против Суверенитета."

# game/episode025.rpy:1564
translate russian ep025_erigone_aftermath_e9cc8ef1:

    # e "We thank you again for your cooperation."
    e "Мы ещё раз благодарим вас за сотрудничество."

# game/episode025.rpy:1565
translate russian ep025_erigone_aftermath_1bd12c65_1:

    # c "My crew will coordinate with you on how to join the forces that have already gathered in opposition against the Sovereignty."
    c "Мой экипаж свяжется с вами, чтобы согласовать порядок присоединения к силам, уже собравшимся для противостояния Суверенитету."

# game/episode025.rpy:1567
translate russian ep025_erigone_aftermath_a67c6b43_1:

    # "Céline and Thyia provided the Acarhyn with the necessary information to join up with the fleet we had already amassed."
    "Селин и Тхия передали Акархинам всю необходимую информацию, чтобы те могли присоединиться к нашим уже собранным силам."

# game/episode025.rpy:1568
translate russian ep025_erigone_aftermath_2bb8ca6b:

    # "Rahia and her Acarhyn would depart at the same time we would be joining up with the fleet."
    "Рахия и её Акархины должны были отправиться в тот же момент, когда мы должны были присоединиться к флоту."

# game/episode025.rpy:1569
translate russian ep025_erigone_aftermath_4fa22838:

    # "The addition of all those Acarhyn Warriors was a definitive win for us and we were curious to see if the Rhenkoy and Tubloshi had made progress in recruiting new forces into the fold."
    "Присоединение всех этих Акархинов-Воинов стало для нас несомненным успехом, и нам было интересно узнать, удалось ли Ренкой и Тублоши привлечь новые силы в наши ряды."

# game/episode025.rpy:1572
translate russian ep025_erigone_aftermath_56e24973:

    # keo "Your Majesty, we have vanquished our foes."
    keo "Ваше Величество, мы сокрушили наших врагов."

# game/episode025.rpy:1573
translate russian ep025_erigone_aftermath_717d53d7:

    # keo "The conflict is over."
    keo "Конфликт окончен."

# game/episode025.rpy:1574
translate russian ep025_erigone_aftermath_a96057b8:

    # keo "Some of the Warrior caste still oppose us, but they are not a lasting threat and will be dealt with soon enough."
    keo "Часть касты Воинов всё ещё оказывает сопротивление, но серьёзной долгосрочной угрозы они не представляют и вскоре будут подавлены."

# game/episode025.rpy:1575
translate russian ep025_erigone_aftermath_35e71953:

    # keo "Commander Rahia has been taken prisoner and is being held in the Shipyards until her execution tomorrow."
    keo "Командир Рахия взята в плен и сейчас содержится на Верфях в ожидании казни, назначенной на завтра."

# game/episode025.rpy:1576
translate russian ep025_erigone_aftermath_94f150eb:

    # keo "Your Majesty is expected to oversee the proceedings."
    keo "Ожидается, что Ваше Величество будет лично присутствовать и контролировать ход разбирательства."

# game/episode025.rpy:1581
translate russian ep025_erigone_aftermath_ceb9a47a:

    # e "Of course we will attend, High Priestess."
    e "Разумеется, мы будем присутствовать, Верховная Жрица."

# game/episode025.rpy:1582
translate russian ep025_erigone_aftermath_9aa253fc_1:

    # e "You have fought valiantly and helped us secure the victory the Acarhyn people so desperately needed."
    e "Вы проявили доблесть в бою и помогли нам одержать столь необходимую народу Акархинов победу."

# game/episode025.rpy:1583
translate russian ep025_erigone_aftermath_a27087d5:

    # e "We will of course attend the trial of the traitor Rahia tomorrow."
    e "Разумеется, завтра мы будем присутствовать на суде над предательницей Рахией."

# game/episode025.rpy:1585
translate russian ep025_erigone_aftermath_53921eb5_1:

    # "The Acarhyn left us and we all headed back to our quarters for some much-needed sleep."
    "Акархины ушли, после чего мы все вернулись в свои покои и легли спать - сон нам был крайне необходим."

# game/episode025.rpy:1587
translate russian ep025_erigone_aftermath_43577c94_1:

    # "Some intermittent gunfire could be heard during the night, but eventually this all stopped."
    "Ночью время от времени были слышны выстрелы, но в конце концов и они стихли."

# game/episode025.rpy:1588
translate russian ep025_erigone_aftermath_4c1ecc18:

    # "Keodele was right in presuming that any remaining resistance would soon be broken."
    "Кеодели верно предсказала, что последние очаги сопротивления вскоре будут подавлены."

# game/episode025.rpy:1590
translate russian ep025_erigone_aftermath_77183b2c:

    # "A steady stream of captured priests were led into the Shipyards during the early morning."
    "С раннего утра на Верфи непрерывным потоком приводили пленных Воинов."

# game/episode025.rpy:1595
translate russian ep025_erigone_aftermath_7fc435aa:

    # "The trial of Rahia took place around midday."
    "Суд над Рахией состоялся около полудня."

# game/episode025.rpy:1596
translate russian ep025_erigone_aftermath_db39e09a:

    # "Eva had already been fetched and was standing in front of the main building, joined by Keodele."
    "Еву уже привели во двор, и она стояла перед главным зданием рядом с Кеодели."

# game/episode025.rpy:1601
translate russian ep025_erigone_aftermath_64250a1b:

    # "The former Commander of the Warrior Caste was kneeling on the asphalt next to a chopping block and looked rather less powerful than before."
    "Бывший Командир касты Воинов стояла на коленях на асфальте рядом с плахой и выглядела уже далеко не так могущественно, как прежде."

# game/episode025.rpy:1602
translate russian ep025_erigone_aftermath_f31ed611:

    # "It was clear she had been treated badly, but her gaze was defiant though."
    "Было очевидно, что обращались с ней плохо, но её взгляд оставался вызывающим."

# game/episode025.rpy:1603
translate russian ep025_erigone_aftermath_9de0c0d6:

    # "Rahia seemed to have deduced what her final fate would be and was resigned to it."
    "Рахия, по всей видимости, уже догадалась о своей участи и смирилась с неизбежным."

# game/episode025.rpy:1605
translate russian ep025_erigone_aftermath_81364d92:

    # keo "Sisters!"
    keo "Сёстры!"

# game/episode025.rpy:1606
translate russian ep025_erigone_aftermath_b90e00b7:

    # keo "We have prevailed!"
    keo "Мы одержали победу!"

# game/episode025.rpy:1607
translate russian ep025_erigone_aftermath_fcce5175:

    # keo "Our Creator has blessed us with this victory over the insidious Warrior caste."
    keo "Наш Создатель даровал нам победу над коварной кастой Воинов."

# game/episode025.rpy:1608
translate russian ep025_erigone_aftermath_1101fc12:

    # keo "Together, we will rebuild Erigone and return it to its rightful glory."
    keo "Вместе мы восстановим Эригон и вернём ему былое величие."

# game/episode025.rpy:1610
translate russian ep025_erigone_aftermath_c30906d1:

    # keo "The Warrior caste is hereby forbidden and any remaining member will be hunted and killed."
    keo "Отныне существование касты Воинов объявляется вне закона, а всех оставшихся её членов будут выслеживать и уничтожать."

# game/episode025.rpy:1611
translate russian ep025_erigone_aftermath_79e2653b:

    # keo "The Priest caste is the ultimate authority on Erigone, as it should have been from the very start."
    keo "Каста Жрецов - высшая власть на Эригоне, как и было предначертано с самого начала."

# game/episode025.rpy:1613
translate russian ep025_erigone_aftermath_d50b2907:

    # keo "We will bring peace and prosperity to these lands."
    keo "Мы принесём этим землям мир и процветание."

# game/episode025.rpy:1614
translate russian ep025_erigone_aftermath_02cd598b:

    # keo "A golden future awaits us, but first we must deal with the past."
    keo "Впереди нас ждёт светлое будущее, но прежде нам предстоит разобраться с прошлым."

# game/episode025.rpy:1616
translate russian ep025_erigone_aftermath_cc39db72:

    # keo "The traitorous firebrands of the unjust rebellion will be brought to justice."
    keo "Предатели-зачинщики этого несправедливого восстания предстанут перед судом."

# game/episode025.rpy:1617
translate russian ep025_erigone_aftermath_eee080b7:

    # keo "Rahia, former Commander of the Warrior caste, is the first to learn of her fate."
    keo "Рахия, бывшая Командир касты Воинов, первой узнает о своей участи."

# game/episode025.rpy:1618
translate russian ep025_erigone_aftermath_4a6d2c62:

    # keo "Many of her lieutenants will be brought to justice in the coming days."
    keo "В ближайшие дни многие из её соратников предстанут перед судом."

# game/episode025.rpy:1620
translate russian ep025_erigone_aftermath_ea1e18eb:

    # keo "Justice will be done."
    keo "Правосудие свершится."

# game/episode025.rpy:1621
translate russian ep025_erigone_aftermath_ce045cd0:

    # keo "Rahia, you stand accused of high treason in your attempt to eradicate the Warrior caste and subvert the power that rightfully belongs to the Priest caste."
    keo "Рахия, вы обвиняетесь в государственной измене за попытку искоренить касту Воинов и подорвать власть, по праву принадлежащую касте Жрецов."

# game/episode025.rpy:1622
translate russian ep025_erigone_aftermath_8fdc5659:

    # keo "The sentence for these crimes is death."
    keo "Наказание за эти преступления - смертная казнь."

# game/episode025.rpy:1624
translate russian ep025_erigone_aftermath_80adb918:

    # rah "I defended Erigone from the threat that is the Priest caste."
    rah "Я защищала Эригон от угрозы, которую представляет собой каста Жрецов."

# game/episode025.rpy:1625
translate russian ep025_erigone_aftermath_edc7e8a0:

    # rah "The teachings of Keodele and her ilk will be your ruin."
    rah "Учения Кеодели и ей подобных станут вашей погибелью."

# game/episode025.rpy:1626
translate russian ep025_erigone_aftermath_c6380bfd:

    # rah "Mark my words, I-"
    rah "Запомните мои слова, я-"

# game/episode025.rpy:1628
translate russian ep025_erigone_aftermath_073ba1c1:

    # "The rest of Rahia’s speech was cut off as one of the guards beat her to the ground."
    "Её речь оборвалась, когда одна из стражниц ударила Рахию, повалив её на землю."

# game/episode025.rpy:1633
translate russian ep025_erigone_aftermath_78735fd9:

    # "A Priestess approached, carrying a large blade."
    "К Рахии подошла жрица с большим клинком в руках."

# game/episode025.rpy:1634
translate russian ep025_erigone_aftermath_51c38b42:

    # "Rahia was forced to rest her head on the block."
    "Рахии приказали положить голову на блок."

# game/episode025.rpy:1636
translate russian ep025_erigone_aftermath_e464e8d0:

    # "With one stroke, the executioner severed Rahia’s head from her body."
    "Одним ударом палач отсёк голову Рахии."

# game/episode025.rpy:1637
translate russian ep025_erigone_aftermath_75c0dd0d:

    # "The amassed Priest caste cheered as the former Commander bled out on the block."
    "Собравшиеся Жрецы ликовали, пока бывшая Командир истекала кровью на плахе."

# game/episode025.rpy:1639
translate russian ep025_erigone_aftermath_4aa68de4:

    # "We left the scene in silence, while Keodele resumed her speech and the Acarhyn cheered on."
    "Мы молча покинули место казни, в то время как Кеодели продолжила свою речь, а Акархины продолжали ликовать."

# game/episode025.rpy:1640
translate russian ep025_erigone_aftermath_4d6659d9:

    # "The executions continued during the coming days, sometimes consisting of entire groups of warriors."
    "В последующие дни казни продолжились, порой целыми группами казнили Воинов."

# game/episode025.rpy:1641
translate russian ep025_erigone_aftermath_3d65610e:

    # "We didn’t attend, as we were too busy preparing the Bastard to leave Erigone."
    "Мы на них не присутствовали, поскольку были слишком заняты подготовкой Ублюдка к отлёту с Эригона."

# game/episode025.rpy:1643
translate russian ep025_erigone_aftermath_d02770f3:

    # "Keodele visited us a few days before we were scheduled to leave."
    "За несколько дней до нашего отлёта к нам пришла Кеодели."

# game/episode025.rpy:1644
translate russian ep025_erigone_aftermath_d9101374:

    # keo "My Queen, the Priest caste has reached a verdict on joining the mission Your Majesty has proposed."
    keo "Моя Королева, каста Жрецов вынесла решение относительно участия в миссии, которую предложило Ваше Величество."

# game/episode025.rpy:1645
translate russian ep025_erigone_aftermath_28574089:

    # keo "We formally pledge our support to the alliance against the Sovereignty."
    keo "Мы официально заявляем о своей поддержке альянса в борьбе против Суверенитета."

# game/episode025.rpy:1650
translate russian ep025_erigone_aftermath_92474673_2:

    # e "We thank you."
    e "Мы благодарим вас."

# game/episode025.rpy:1651
translate russian ep025_erigone_aftermath_5e09efe2_2:

    # e "Your pledge of allegiance is honorable and just, befitting of a true Acarhyn."
    e "Ваша присяга на верность - благородна и справедлива, как и подобает истинным Акархинам."

# game/episode025.rpy:1653
translate russian ep025_erigone_aftermath_61511319:

    # keo "Thank you, Your Majesty."
    keo "Благодарю, Ваше Высочество."

# game/episode025.rpy:1654
translate russian ep025_erigone_aftermath_e329a757:

    # keo "The Warrior caste has been all but eradicated and no further uprisings are expected."
    keo "Каста Воинов практически уничтожена, и новых восстаний не ожидается."

# game/episode025.rpy:1655
translate russian ep025_erigone_aftermath_b7a777ab:

    # keo "We have full control of Erigone and will continue to repair and restore Erigone in the image of our Creator."
    keo "Эригон полностью под нашим контролем, и мы продолжим восстанавливать его по замыслу нашего Создателя."

# game/episode025.rpy:1656
translate russian ep025_erigone_aftermath_2db7500e:

    # keo "A contingent of Priests and several ships have been selected to join the alliance against the Sovereignty."
    keo "Мы отобрали отряд Жрецов и несколько кораблей, которые присоединятся к альянсу против Суверенитета."

# game/episode025.rpy:1657
translate russian ep025_erigone_aftermath_c28b1552:

    # keo "I will personally lead them."
    keo "Я лично поведу их."

# game/episode025.rpy:1662
translate russian ep025_erigone_aftermath_e9cc8ef1_1:

    # e "We thank you again for your cooperation."
    e "Мы ещё раз благодарим вас за сотрудничество."

# game/episode025.rpy:1663
translate russian ep025_erigone_aftermath_1bd12c65_2:

    # c "My crew will coordinate with you on how to join the forces that have already gathered in opposition against the Sovereignty."
    c "Мой экипаж свяжется с вами, чтобы согласовать порядок присоединения к силам, уже собравшимся для противостояния Суверенитету."

# game/episode025.rpy:1665
translate russian ep025_erigone_aftermath_a67c6b43_2:

    # "Céline and Thyia provided the Acarhyn with the necessary information to join up with the fleet we had already amassed."
    "Селин и Тхия передали Акархинам всю необходимую информацию, чтобы те могли присоединиться к нашим уже собранным силам."

# game/episode025.rpy:1666
translate russian ep025_erigone_aftermath_ab042ed8:

    # "Keodele and her Acarhyn would depart at the same time we would be joining up with the fleet."
    "Кеодели и её Акархины должны были отправиться в тот же момент, когда мы должны были присоединиться к флоту."

# game/episode025.rpy:1667
translate russian ep025_erigone_aftermath_35567863:

    # "The addition of all those Acarhyn Priestesses was a definitive win for us and we were curious to see if the Rhenkoy and Tubloshi had made progress in recruiting new forces into the fold."
    "Присоединение всех этих Акархинов-Жрецов стало для нас несомненным успехом, и нам было интересно узнать, удалось ли Ренкой и Тублоши привлечь новые силы в наши ряды."

# game/episode025.rpy:1673
translate russian ep025_erigone_aftermath_1600c88f:

    # "Eva was busy for the last days we remained on Erigone."
    "Последние дни, что мы провели на Эригоне, Ева была занята."

# game/episode025.rpy:1674
translate russian ep025_erigone_aftermath_179fa86e:

    # "She had to chair several meetings regarding the rebuilding of Erigone."
    "Ей пришлось провести несколько совещаний, посвящённых восстановлению Эригона."

# game/episode025.rpy:1677
translate russian ep025_erigone_aftermath_2b0326fd:

    # "Those meetings were exhausting, as she had to deal with several warring factions among the Warrior caste."
    "Эти совещания были очень утомительными, ведь ей приходилось иметь дело с несколькими враждующими группировками внутри касты Воинов."

# game/episode025.rpy:1679
translate russian ep025_erigone_aftermath_31f816f1:

    # "Those meetings were exhausting, as she had to deal with several warring factions among the Priest caste."
    "Эти совещания были очень утомительными, ведь ей приходилось иметь дело с несколькими враждующими группировками внутри касты Жрецов."

# game/episode025.rpy:1680
translate russian ep025_erigone_aftermath_08c2640f:

    # "The caste had no clear leader and the power vacuum created a slew of problems."
    "У касты не было явного лидера, а образовавшийся вакуум власти породил множество проблем."

# game/episode025.rpy:1681
translate russian ep025_erigone_aftermath_de355ead:

    # "Tensions continued to run high and the risk of another conflict was just a matter of time."
    "Обстановка оставалась крайне напряжённой, и новый конфликт был лишь вопросом времени."

# game/episode025.rpy:1682
translate russian ep025_erigone_aftermath_7e6f4ee0:

    # "If we were to ever return to Erigone, it would remain to be seen what would be left of the planet and its people."
    "Если нам когда-нибудь доведётся вернуться на Эригон, ещё неизвестно, что останется от планеты и её народа."

# game/episode025.rpy:1683
translate russian ep025_erigone_aftermath_15460400:

    # "However, we had more pressing matters to attend to and Eva did what she could."
    "Однако у нас были дела поважнее, а Ева делала всё, что было в её силах."

# game/episode025.rpy:1686
translate russian ep025_erigone_aftermath_38eb8054:

    # "Those meetings were exhausting, but as the Warrior caste truly listened to her input, she deemed it all worthwhile."
    "Эти совещания были очень утомительными, но Воины действительно прислушивались к её мнению, и она считала, что всё это того стоило."

# game/episode025.rpy:1687
translate russian ep025_erigone_aftermath_1aeebf65:

    # "She managed to persuade the Warriors to let civilian representatives attend the meetings and have a say in how Erigone should be governed."
    "Ей удалось убедить Воинов позволить представителям гражданского населения присутствовать на совещаниях и иметь право голоса в вопросах управления Эригоном."

# game/episode025.rpy:1689
translate russian ep025_erigone_aftermath_b3093c49:

    # "The meetings were exhausting and Eva was mostly there as a figurehead."
    "Совещания выматывали, а Ева в основном присутствовала там лишь для видимости."

# game/episode025.rpy:1690
translate russian ep025_erigone_aftermath_804e520e:

    # "Keodele exerted a lot of influence and singlehandedly decided on most of the major issues."
    "Кеодели имела огромное влияние и единолично принимала решения по большинству важных вопросов."

# game/episode025.rpy:1691
translate russian ep025_erigone_aftermath_16431723:

    # "Several of her loyalists were already in place to lead Erigone in her absence."
    "Несколько её верных последователей уже были готовы управлять Эригоном в её отсутствие."

# game/episode025.rpy:1692
translate russian ep025_erigone_aftermath_1d3280fe:

    # "There was no doubt that the High Priestess would still have a firm grip on the planet, even if she would be off-planet to join the fleet."
    "Не было сомнений, что Верховная Жрица по-прежнему будет крепко держать Эригон под своим контролем, даже если покинет планету, чтобы присоединиться к флоту."

# game/episode025.rpy:1700
translate russian ep025_erigone_aftermath_310a5d0f:

    # "When Eva returned to the Bastard, we were ready to leave."
    "Когда Ева вернулась на Ублюдок, мы уже были готовы отправляться."

# game/episode025.rpy:1701
translate russian ep025_erigone_aftermath_508ff706:

    # "Several Acarhyn ships were already in orbit and ready to leave for the coordinates they’d received from Céline."
    "Несколько кораблей Акархинов уже находились на орбите и были готовы отправиться по координатам, полученным от Селин."

# game/episode025.rpy:1704
translate russian ep025_erigone_aftermath_be79ce2d:

    # woman "The Warrior caste is ready for take-off."
    woman "Каста Воинов готова отправляться."

# game/episode025.rpy:1706
translate russian ep025_erigone_aftermath_cc22bc7b:

    # woman "The Priest caste is ready for take-off."
    woman "Каста Жрецов готова отправляться."

# game/episode025.rpy:1707
translate russian ep025_erigone_aftermath_6ea77f30:

    # woman "We’ll join you at the rendezvous point."
    woman "Увидимся с вами в точке встречи."

# game/episode025.rpy:1710
translate russian ep025_erigone_aftermath_6cde3923:

    # rah "The Warrior caste is ready for take-off."
    rah "Каста Воинов готова отправляться."

# game/episode025.rpy:1711
translate russian ep025_erigone_aftermath_017bc996:

    # rah "We’ll join you at the rendezvous point."
    rah "Увидимся с вами в точке встречи."

# game/episode025.rpy:1713
translate russian ep025_erigone_aftermath_b0e877a2:

    # keo "The Priest caste is ready for launch."
    keo "Каста Жрецов готова отправляться."

# game/episode025.rpy:1714
translate russian ep025_erigone_aftermath_b96f792d:

    # keo "We’ll join you at the rendezvous point."
    keo "Увидимся с вами в точке встречи."

# game/episode025.rpy:1715
translate russian ep025_erigone_aftermath_11e73def:

    # c "Acknowledged."
    c "Принято."

# game/episode025.rpy:1716
translate russian ep025_erigone_aftermath_168792e7:

    # c "See you soon."
    c "До скорой встречи."

# game/episode025.rpy:1717
translate russian ep025_erigone_aftermath_9e137c85:

    # c "Bastard out."
    c "Ублюдок, конец связи."

# game/episode025.rpy:1720
translate russian ep025_erigone_aftermath_fa3a696b:

    # "The Bastard rose from the jungle canopy and quickly left the planet’s surface behind."
    "Ублюдок взмыл над джунглями и быстро оставил поверхность планеты позади."

# game/episode025.rpy:1723
translate russian ep025_erigone_aftermath_85b5c226:

    # "The Bastard rose from the Shipyards and quickly left the planet’s surface behind."
    "Ублюдок взмыл над Верфями и быстро оставил поверхность планеты позади."

# game/episode025.rpy:1725
translate russian ep025_erigone_aftermath_d515a42a:

    # "Once we were out of Erigone’s orbital sphere, we punched in the coordinates to join our Rhenkoy and Tubloshi allies."
    "Как только мы покинули орбиту Эригона, мы ввели координаты и взяли курс на наших союзников — Ренкой и Тублоши."

# game/episode025.rpy:1726
translate russian ep025_erigone_aftermath_b8e93eb4:

    # "Several messages suddenly arrived, held up by the communications blockade in effect on Erigone."
    "Внезапно поступило несколько сообщений, до этого задержанных из-за блокады связи на Эригоне."

# game/episode025.rpy:1728
translate russian ep025_erigone_aftermath_a4e99845:

    # "One message caught my attention and I brought the video up on my screen."
    "Одно сообщение привлекло моё внимание, и я вывел видео на экран."

# game/episode025.rpy:1729
translate russian ep025_erigone_aftermath_e80e1d48:

    # "It was one of the Confessor’s Handmaidens."
    "На видео была одна из Прислужниц Исповедника."

# game/episode025.rpy:1732
translate russian ep025_erigone_aftermath_d0edc910:

    # woman "We formally request a meeting with the crew of the Iron Bastard."
    woman "Мы официально запрашиваем встречу с экипажем Железного Ублюдка."

# game/episode025.rpy:1733
translate russian ep025_erigone_aftermath_9d23fec5:

    # woman "Please respond and meet us at these coordinates."
    woman "Будем ждать вашего ответа и встречи с вами по указанным координатам."

# game/episode025.rpy:1734
translate russian ep025_erigone_aftermath_03fdd0d3:

    # "The last time we encountered the Handmaidens was on Petrarch, before the Confessor’s demise."
    "В последний раз мы пересекались с Прислужницами на Петрарке, ещё до кончины Исповедника."

# game/episode025.rpy:1736
translate russian ep025_erigone_aftermath_3eb9971c:

    # av "Why would they reach out to us?"
    av "Зачем им понадобилось с нами связываться?"

# game/episode025.rpy:1737
translate russian ep025_erigone_aftermath_8caa2926:

    # av "We killed their master..."
    av "Мы же убили их хозяина..."

# game/episode025.rpy:1738
translate russian ep025_erigone_aftermath_2c20cd2b:

    # c "I haven’t got a clue."
    c "Понятия не имею."

# game/episode025.rpy:1739
translate russian ep025_erigone_aftermath_468fc1e8:

    # av "It could be a trap."
    av "Не исключено, что это ловушка."

# game/episode025.rpy:1740
translate russian ep025_erigone_aftermath_41155672:

    # c "Yes, it could be."
    c "Да, вполне."

# game/episode025.rpy:1741
translate russian ep025_erigone_aftermath_d9b641da:

    # c "Only one way to find out."
    c "Есть лишь один способ это выяснить."

# game/episode025.rpy:1742
translate russian ep025_erigone_aftermath_f045f336:

    # c "Céline, change of plans, we’re making a detour."
    c "Селин, планы изменились, мы сделаем крюк."

# game/episode025.rpy:1744
translate russian ep025_erigone_aftermath_00e5bbfc:

    # "Céline punched in the new coordinates, pointing the Bastard to the Handmaiden’s location."
    "Селин ввела новые координаты, направив Ублюдка к месту нахождения Прислужницы."

# game/episode025.rpy:1760
translate russian ep025_erigone_e_b166ee2e:

    # "Eva was resting in her quarters when I came to visit her."
    "Ева отдыхала у себя, когда я пришёл её навестить."

# game/episode025.rpy:1761
translate russian ep025_erigone_e_984a0153:

    # c "Hey there."
    c "Приветики."

# game/episode025.rpy:1762
translate russian ep025_erigone_e_50edab85:

    # c "Everything all right with you?"
    c "У тебя всё хорошо?"

# game/episode025.rpy:1764
translate russian ep025_erigone_e_d9249210:

    # e "Just a little tired."
    e "Просто немного устала."

# game/episode025.rpy:1765
translate russian ep025_erigone_e_ec9e7952:

    # e "Carrying all this extra weight around sure is exhausting."
    e "С таким дополнительным весом и правда устаёшь."

# game/episode025.rpy:1766
translate russian ep025_erigone_e_0b529335:

    # c "Take all the rest you need."
    c "Отдыхай столько, сколько нужно."

# game/episode025.rpy:1768
translate russian ep025_erigone_e_3593a416:

    # e "Yes, I’m fine."
    e "Да, я в норме."

# game/episode025.rpy:1770
translate russian ep025_erigone_e_2c992148:

    # c "Mind if I join you?"
    c "Можно к тебе?"

# game/episode025.rpy:1771
translate russian ep025_erigone_e_a0808f6b:

    # e "Of course not!"
    e "Да, конечно!"

# game/episode025.rpy:1783
translate russian ep025_erigone_e_0e40381b:

    # e "Do you think the Warriors’ plan will succeed?"
    e "Как думаешь, план Воинов сработает?"

# game/episode025.rpy:1784
translate russian ep025_erigone_e_352251fe:

    # c "It looked strong on paper."
    c "На бумаге план выглядел вполне убедительно."

# game/episode025.rpy:1785
translate russian ep025_erigone_e_3e360437:

    # c "I just hope there won’t be a lot of surprises once they execute the ambush."
    c "Остаётся надеяться, что во время засады не возникнет неприятных сюрпризов."

# game/episode025.rpy:1790
translate russian ep025_erigone_e_b1363a05:

    # e "There are always surprises."
    e "Сюрпризы найдутся всегда."

# game/episode025.rpy:1791
translate russian ep025_erigone_e_0db77c9b:

    # e "Will we be required to join the operation?"
    e "Нам придётся участвовать в этой операции?"

# game/episode025.rpy:1792
translate russian ep025_erigone_e_95ee4203:

    # c "Yes, we are."
    c "Ага."

# game/episode025.rpy:1793
translate russian ep025_erigone_e_7a5c7787:

    # c "The rest of the crew has been talking to the Warriors."
    c "Остальные из экипажа уже успели поговорить с Воинами."

# game/episode025.rpy:1794
translate russian ep025_erigone_e_d0bebbd7:

    # c "The Priest caste is light on fighter planes, so the Warriors are hoping to overwhelm the sky."
    c "У касты Жрецов нехватка истребителей, поэтому Воины рассчитывают подавить их численным превосходством в воздухе."

# game/episode025.rpy:1795
translate russian ep025_erigone_e_b872a09c:

    # c "The Bastard is going to assist from the air during the assault."
    c "Ублюдок будет поддерживать наступление с воздуха."

# game/episode025.rpy:1800
translate russian ep025_erigone_e_67632972:

    # e "Can’t say I’m looking forward to that part of the operation."
    e "Не скажу, что я в предвкушении этой части операции."

# game/episode025.rpy:1801
translate russian ep025_erigone_e_e3f85eeb:

    # c "I believe you are required to stay behind."
    c "Полагаю, тебе придётся остаться здесь."

# game/episode025.rpy:1802
translate russian ep025_erigone_e_60965691:

    # e "Yes, I figured."
    e "Да, я это уже поняла."

# game/episode025.rpy:1803
translate russian ep025_erigone_e_fe6aef30:

    # e "No place for a Queen on the battlefield..."
    e "Королеве не место на поле боя..."

# game/episode025.rpy:1805
translate russian ep025_erigone_e_cb7b2233:

    # c "Did you have a talk with Keodele?"
    c "Ты поговорила с Кеодели?"

# game/episode025.rpy:1810
translate russian ep025_erigone_e_765cc51b:

    # e "Yes, a very disappointing one."
    e "Да, разговор оставил желать лучшего."

# game/episode025.rpy:1811
translate russian ep025_erigone_e_4e0e2d4b:

    # e "They’re going ahead with creating more Brutes, despite any reservations I have."
    e "Они продолжают создавать новых Громил, несмотря на все мои возражения."

# game/episode025.rpy:1812
translate russian ep025_erigone_e_dd940e0d:

    # c "So, essentially, she doesn’t respect the Queen’s authority?"
    c "Получается, она не признаёт авторитет Королевы?"

# game/episode025.rpy:1813
translate russian ep025_erigone_e_753f0a50:

    # e "Yes, that’s what it comes down to."
    e "Да, именно к этому всё и сводится."

# game/episode025.rpy:1814
translate russian ep025_erigone_e_cb6170d6:

    # e "She told me much more politely and couched in a lot of niceties."
    e "Она сказала мне то же самое, только гораздо вежливее и с кучей любезностей."

# game/episode025.rpy:1815
translate russian ep025_erigone_e_c1634fec:

    # c "Keodele must have had a lot of practice."
    c "Должно быть, у Кеодели большой опыт."

# game/episode025.rpy:1816
translate russian ep025_erigone_e_8591f216:

    # e "Yes, she must have."
    e "Да, похоже на то."

# game/episode025.rpy:1817
translate russian ep025_erigone_e_afe7c65e:

    # e "Be careful with her, though."
    e "Но будь с ней осторожен."

# game/episode025.rpy:1822
translate russian ep025_erigone_e_9e645497:

    # e "I’m sure they’ll join our alliance as soon as they’re able, but I don’t think they’re a reliable partner in the long run."
    e "Уверена, они присоединятся к нашему альянсу при первой возможности, но в долгосрочной перспективе я бы на них не рассчитывала."

# game/episode025.rpy:1824
translate russian ep025_erigone_e_3fa85fc6:

    # c "Erylin showed a penchant for backstabbing, so I’m sure her daughter learned from the very best."
    c "Эрилин имела привычку наносить удар в спину, так что её дочь наверняка училась у лучшей."

# game/episode025.rpy:1826
translate russian ep025_erigone_e_a50c29d0:

    # c "Erylin showed a penchant for backstabbing, so I’m sure her acolyte learned from the very best."
    c "Эрилин имела привычку наносить удар в спину, так что её послушница наверняка училась у лучшей."

# game/episode025.rpy:1827
translate russian ep025_erigone_e_6361c8c3:

    # e "Yeah..."
    e "Ага..."

# game/episode025.rpy:1828
translate russian ep025_erigone_e_a5d9a0c6:

    # e "Still, watch out for her, she’s as driven as any zealot."
    e "Но всё равно будь с ней начеку - она так же одержима своей целью, как любая фанатичка."

# game/episode025.rpy:1829
translate russian ep025_erigone_e_b7f4b180:

    # c "Noted."
    c "Учту."

# game/episode025.rpy:1830
translate russian ep025_erigone_e_18bfb04c:

    # e "Are we joining the coming battle?"
    e "Мы будем участвовать в предстоящей битве?"

# game/episode025.rpy:1831
translate russian ep025_erigone_e_08d4abeb:

    # c "Yes, we will."
    c "Да, будем."

# game/episode025.rpy:1832
translate russian ep025_erigone_e_47a63336:

    # c "The rest of the crew has been talking to the Priestesses."
    c "Остальные из экипажа уже успели поговорить с Жрецами."

# game/episode025.rpy:1833
translate russian ep025_erigone_e_1388f1a2:

    # c "They’re light on fighter planes, so the Bastard is going to assist from the air during the assault."
    c "У них нехватка истребителей, так что Ублюдок будет поддерживать наступление с воздуха."

# game/episode025.rpy:1838
translate russian ep025_erigone_e_67632972_1:

    # e "Can’t say I’m looking forward to that part of the operation."
    e "Не скажу, что я в предвкушении этой части операции."

# game/episode025.rpy:1839
translate russian ep025_erigone_e_e3f85eeb_1:

    # c "I believe you are required to stay behind."
    c "Полагаю, тебе придётся остаться здесь."

# game/episode025.rpy:1840
translate russian ep025_erigone_e_60965691_1:

    # e "Yes, I figured."
    e "Да, я это уже поняла."

# game/episode025.rpy:1845
translate russian ep025_erigone_e_fe6aef30_1:

    # e "No place for a Queen on the battlefield..."
    e "Королеве не место на поле боя..."

# game/episode025.rpy:1857
translate russian ep025_erigone_e_aca8de24:

    # e "I wish we could just be together."
    e "Жаль, что мы не можем просто быть вместе."

# game/episode025.rpy:1858
translate russian ep025_erigone_e_1244497d:

    # e "Be done with all that we are involved at the moment."
    e "Сначала бы закончить со всем, во что мы сейчас ввязались."

# game/episode025.rpy:1860
translate russian ep025_erigone_e_0cd670e0:

    # e "Just you, me and the baby living our lives."
    e "Только ты, я и ребёнок, живущие спокойно своей жизнью."

# game/episode025.rpy:1861
translate russian ep025_erigone_e_f263d194:

    # c "I feel the same."
    c "Я тоже этого хочу."

# game/episode025.rpy:1862
translate russian ep025_erigone_e_d1db6a03:

    # c "And I promise you we will, after we’ve dealt with Dad and the Sovereignty."
    c "И я обещаю, что так и будет, после того как мы покончим с отцом и Суверенитетом."

# game/episode025.rpy:1873
translate russian ep025_erigone_e_9002f38f:

    # e "Don’t make promises you can’t keep."
    e "Не давай обещаний, которых не сможешь сдержать."

# game/episode025.rpy:1874
translate russian ep025_erigone_e_62cc254b:

    # e "I’m sure there’ll always be another crisis."
    e "Уверена, потом обязательно случится какой-нибудь новый кризис."

# game/episode025.rpy:1875
translate russian ep025_erigone_e_7a5902d0:

    # c "I’m sure there will be, but I’m done after this."
    c "Уверен, наверняка так и будет, но после этого с меня хватит."

# game/episode025.rpy:1876
translate russian ep025_erigone_e_8ae1b8cc:

    # c "It’s a promise I absolutely intend to keep."
    c "Я твёрдо намерен сдержать это обещание."

# game/episode025.rpy:1887
translate russian ep025_erigone_e_5473a803:

    # e "I’m hoping we both can."
    e "Надеюсь, что нам обоим это удастся."

# game/episode025.rpy:1899
translate russian ep025_erigone_e_25e56f13:

    # "I kissed my sister and we lay in each other’s arms for a long while."
    "Я поцеловал свою сестру, и мы долго лежали в объятиях друг друга."

# game/episode025.rpy:1901
translate russian ep025_erigone_e_62b9a7fa:

    # "I kissed my girlfriend and we lay in each other’s arms for a long while."
    "Я поцеловал свою девушку, и мы долго лежали в объятиях друг друга."

# game/episode025.rpy:1902
translate russian ep025_erigone_e_c7a622ee:

    # "When dinner was announced, we had to leave, but not before promising Eva I’d meet her later."
    "Когда объявили ужин, нам пришлось уйти, но перед этим я пообещал Еве, что увижусь с ней позже."

# game/episode025.rpy:1904
translate russian ep025_erigone_e_13158e12:

    # c "I’ll leave you to rest for a while."
    c "Тогда я оставлю тебя отдыхать."

# game/episode025.rpy:1912
translate russian ep025_quarters_ziv_b562a367:

    # "Even though we were assigned quarters in the Citadel, Ziv had asked me to come by her quarters on the Iron Bastard."
    "Хотя нам выделили комнаты в Цитадели, Зив попросила меня заглянуть к ней в каюту на Железном Ублюдке."

# game/episode025.rpy:1915
translate russian ep025_quarters_ziv_29fc7396:

    # "Even though we were assigned quarters in the Shipyards, Ziv had asked me to come by her quarters on the Iron Bastard."
    "Хотя нам выделили комнаты на Верфях, Зив попросила меня заглянуть к ней в каюту на Железном Ублюдке."

# game/episode025.rpy:1917
translate russian ep025_quarters_ziv_195f53d0:

    # "Her door was open and I found Ziv standing on her bed with her eyes closed, completely naked."
    "Дверь была открыта, и я застал Зив, стоящую на кровати с закрытыми глазами, абсолютно голую."

# game/episode025.rpy:1918
translate russian ep025_quarters_ziv_96877540:

    # c "Ah...{w} Hi."
    c "Э-э...{w} Привет."

# game/episode025.rpy:1920
translate russian ep025_quarters_ziv_4571fee3:

    # zi "Oh, [p_name]."
    zi "О, [p_name]."

# game/episode025.rpy:1921
translate russian ep025_quarters_ziv_a678e94f:

    # zi "I was centering myself."
    zi "Я старалась обрести внутреннее равновесие."

# game/episode025.rpy:1922
translate russian ep025_quarters_ziv_f7f0dc51:

    # c "Should I come back later?"
    c "Мне зайти попозже?"

# game/episode025.rpy:1924
translate russian ep025_quarters_ziv_197d4735:

    # zi "No, no, please stay."
    zi "Нет, нет, пожалуйста, останься."

# game/episode025.rpy:1925
translate russian ep025_quarters_ziv_0dbd9e7e:

    # "There was a nervous quality to her voice, easily detectable because she normally appeared so composed."
    "В её голосе слышалось волнение, что было особенно заметно, поскольку обычно она казалась очень собранной."

# game/episode025.rpy:1926
translate russian ep025_quarters_ziv_e4403132:

    # c "You’re looking very beautiful today."
    c "Ты сегодня просто прекрасно выглядишь."

# game/episode025.rpy:1927
translate russian ep025_quarters_ziv_d2e75395:

    # zi "Thanks."
    zi "Спасибо."

# game/episode025.rpy:1928
translate russian ep025_quarters_ziv_d21c4563:

    # zi "Being naked helps the centering process."
    zi "Нагота помогает обрести внутреннее равновесие."

# game/episode025.rpy:1929
translate russian ep025_quarters_ziv_e5191510:

    # c "I’m not complaining at all."
    c "Да я только за."

# game/episode025.rpy:1930
translate russian ep025_quarters_ziv_a2270094:

    # c "What exactly does this centering mean?"
    c "А что именно значит обретение внутреннего равновесия?"

# game/episode025.rpy:1931
translate russian ep025_quarters_ziv_b8db1dcf:

    # zi "It’s a process where a Rhenkoy becomes more attuned to their senses."
    zi "Это процесс, благодаря которому Ренкой становится более восприимчивым к своим ощущениям."

# game/episode025.rpy:1932
translate russian ep025_quarters_ziv_20e8e87e:

    # zi "It helps to achieve a level of calm during emotional distress."
    zi "Это помогает сохранять спокойствие, когда тебя захлёстывают эмоции."

# game/episode025.rpy:1933
translate russian ep025_quarters_ziv_1fbc096b:

    # c "Is something the matter with you?"
    c "У тебя что-то случилось?"

# game/episode025.rpy:1936
translate russian ep025_quarters_ziv_439c7017:

    # zi "That’s what I wanted to talk to you about."
    zi "Вот об этом я и хотела с тобой поговорить."

# game/episode025.rpy:1937
translate russian ep025_quarters_ziv_bafa6c2f:

    # zi "It’s a delicate matter, that’s why I requested us to meet on the Iron Bastard."
    zi "Дело довольно деликатное, поэтому я и предложила тебе встретиться на Железном Ублюдке."

# game/episode025.rpy:1938
translate russian ep025_quarters_ziv_89257688:

    # zi "I don’t want anyone to walk in on us."
    zi "Не хочу, чтобы кто-нибудь нас застал."

# game/episode025.rpy:1940
translate russian ep025_quarters_ziv_838e751f:

    # c "Little chance of that, everybody is back in the Citadel."
    c "Такое маловероятно, все вернулись в Цитадель."

# game/episode025.rpy:1942
translate russian ep025_quarters_ziv_80f2a6dd:

    # c "Little chance of that, everybody is back in the Shipyards."
    c "Такое маловероятно, все вернулись на Верфи."

# game/episode025.rpy:1944
translate russian ep025_quarters_ziv_87dcfd4a:

    # zi "Good."
    zi "Хорошо."

# game/episode025.rpy:1945
translate russian ep025_quarters_ziv_36f470fe:

    # zi "We have spoken about this before and you were positive at that time, as was I."
    zi "Мы уже это обсуждали, и тогда мы оба смотрели на это положительно."

# game/episode025.rpy:1947
translate russian ep025_quarters_ziv_aa698e85:

    # zi "Despite that, finding out was a shock."
    zi "Но всё равно меня это шокировало."

# game/episode025.rpy:1948
translate russian ep025_quarters_ziv_083576d9:

    # c "Ziv, are you talking about-"
    c "Зив, ты сейчас о-"

# game/episode025.rpy:1949
translate russian ep025_quarters_ziv_cb170553:

    # zi "I’m pregnant, [p_name_short]."
    zi "Я беременна, [p_name_short]."

# game/episode025.rpy:1953
translate russian ep025_quarters_ziv_fcdc6c3e:

    # c "But that’s fantastic news!"
    c "Но это же просто замечательная новость!"

# game/episode025.rpy:1954
translate russian ep025_quarters_ziv_9abb28a2:

    # c "Have you been lying here for hours, dreading to tell me the news?"
    c "Ты что, столько времени здесь лежала и боялась мне всё рассказать?"

# game/episode025.rpy:1955
translate russian ep025_quarters_ziv_50a5b587:

    # zi "I was centering myself..."
    zi "Я старалась обрести внутреннее равновесие..."

# game/episode025.rpy:1956
translate russian ep025_quarters_ziv_52cb9d94:

    # c "You were worrying and mulling."
    c "Ты переживала и всё прокручивала в голове."

# game/episode025.rpy:1958
translate russian ep025_quarters_ziv_bcc58a38:

    # zi "Yes, I was."
    zi "Да..."

# game/episode025.rpy:1959
